+/// Detect a coincident boundary at a face-interior query using exact surfaces.
+///
+/// The parameter triangles locate the point in the trimmed domain; testing the
+/// supporting surface alone would also accept its unbounded extension.
+fn coincident_boundary<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    candidate: &Face<Point3, AltCurve<C, S>, S>,
+    point: Point3,
+    normal: Vector3,
+    shell: &Shell<Point3, C, S>,
+    polygons: &PolyShell,
+) -> Option<bool> {
+    shell.iter().zip(polygons).find_map(|(face, polygon)| {
+        let surface = face.surface();
+        let (u, v) = surface.search_parameter(point, None, 100)?;
+        let other = surface.normal(u, v).normalize();
+        if !normal.cross(other).near(&Vector3::zero()) {
+            return None;
+        }
+        // A single tangent point does not establish a shared face patch.
+        let shared_support = candidate
+            .boundary_iters()
+            .into_iter()
+            .flatten()
+            .all(|edge| {
+                let curve = edge.curve();
+                let (start, end) = curve.range_tuple();
+                [start, (start + end) / 2.0, end]
+                    .into_iter()
+                    .all(|parameter| {
+                        surface
+                            .search_parameter(curve.evaluate(parameter), None, 100)
+                            .is_some()
+                    })
+            });
+        if !shared_support {
+            return None;
+        }
+        let mesh = polygon.surface()?;
+        let uv = Vector2::new(u, v);
+        let contains = mesh.face_iter().any(|vertices| {
+            (2..vertices.len()).any(|index| {
+                let triangle = [vertices[0], vertices[index - 1], vertices[index]];
+                let [Some(a), Some(b), Some(c)] =
+                    triangle.map(|vertex| vertex.uv.map(|index| mesh.uv_coords()[index]))
+                else {
+                    return false;
+                };
+                let cross = |a: Vector2, b: Vector2| a.x * b.y - a.y * b.x;
+                let area = cross(b - a, c - a);
+                let weights = [
+                    cross(b - uv, c - uv),
+                    cross(c - uv, a - uv),
+                    cross(a - uv, b - uv),
+                ];
+                area != 0.0 && weights.iter().all(|weight| weight * area >= 0.0)
+            })
+        });
+        contains.then(|| (normal.dot(other) > 0.0) == face.orientation())
+    })
+}
