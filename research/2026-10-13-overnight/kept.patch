+fn boolean_classic<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    tol: f64,
+    operation: Operation,
+) -> ClassicResult<Solid<Point3, C, S>> {
+    if !tol.is_finite() || tol <= 0.0 {
+        return Err(ShapeOpsError::InvalidTolerance);
+    }
+    let shell0: Shell<Point3, C, S> = solid0.face_iter().cloned().collect();
+    let mut shell1: Shell<Point3, C, S> = solid1.face_iter().cloned().collect();
+    let (name, at_infinity) = match operation {
+        Operation::Intersection => ("and", 0),
+        Operation::Union => ("or", 0),
+        Operation::Difference => {
+            shell1.iter_mut().for_each(|face| {
+                face.invert();
+            });
+            ("difference", 1)
+        }
+    };
+    if shell0.is_empty() || shell1.is_empty() {
+        // These are set identities for valid empty operands, before any geometric operation.
+        let shell = match operation {
+            Operation::Intersection => Shell::default(),
+            Operation::Difference => shell0,
+            Operation::Union => {
+                if shell0.is_empty() {
+                    shell1
+                } else {
+                    shell0
+                }
+            }
+        };
+        finalize(name, shell)
+    } else {
+        // Prepare intersections once. A failed divider may retry the same
+        // exact loop stores without repeating tessellation or marching.
+        let prepared = process_one_pair_of_shells(shell0, shell1, tol, at_infinity);
+        let assemble = |division| {
+            let divide = prepared
+                .as_ref()
+                .ok_or(ShapeOpsError::EmptyOutputShell { operation: name })?;
+            let ([and_shell, or_shell], contacts) =
+                divide(division).ok_or(ShapeOpsError::EmptyOutputShell { operation: name })?;
+            let selected = match operation {
+                Operation::Union => or_shell,
+                Operation::Intersection | Operation::Difference => and_shell,
+            };
+            let converted = altshell_to_shell(&selected)
+                .ok_or(ShapeOpsError::AltShellConversionFailed { operation: name })?;
+            let shell = if contacts {
+                sew_contacts(converted, tol)
+                    .ok_or(ShapeOpsError::AltShellConversionFailed { operation: name })?
+            } else {
+                converted
+            };
+            // An empty boundary is a valid empty result; pipeline failure is not.
+            finalize(name, shell)
+        };
+        assemble(FaceDivision::Classic)
+            .or_else(|error| planar_boolean(solid0, solid1, operation, true).ok_or(error))
+            .or_else(|error| {
+                sweep_boolean(solid0, solid1, operation, tol, FaceDivision::Classic).ok_or(error)
+            })
+            .or_else(|error| assemble(FaceDivision::Nested).or(Err(error)))
+            .or_else(|error| {
+                sweep_boolean(solid0, solid1, operation, tol, FaceDivision::Nested).ok_or(error)
+            })
+    }
+}
+
+fn boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    tol: f64,
+    operation: Operation,
+) -> ClassicResult<Solid<Point3, C, S>> {
+    if !tol.is_finite() || tol <= 0.0 {
+        Err(ShapeOpsError::InvalidTolerance)
+    } else if solid0.is_empty() || solid1.is_empty() {
+        boolean_classic(solid0, solid1, tol, operation)
+    } else if let Some(solid) = planar_boolean(solid0, solid1, operation, false) {
+        // A certified arrangement establishes membership on each open cell.
+        // Its empty boundary is therefore a valid empty result, while failure
+        // to certify or assemble an arrangement still requires marching.
+        Ok(solid)
+    } else if let Some(solid) = separated_boolean(solid0, solid1, operation) {
+        Ok(solid)
+    } else {
+        boolean_classic(solid0, solid1, tol, operation).or_else(|error| {
+            if matches!(operation, Operation::Union) {
+                lower_dimensional_union(solid0, solid1).ok_or(error)
+            } else {
+                Err(error)
+            }
+        })
+    }
+}
