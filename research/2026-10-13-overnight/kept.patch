+                    ((i - p..=i).any(|u| (j - q..=j).any(|v| off_plane[u * width + v])))
+                        .then_some(())
+                })
+            })
+        }
+    })
+}
+
+/// Assemble a union whose separating plane contains no open boundary patch.
+///
+/// The input enclosures establish disjoint interiors; [`excludes_plane_patch`]
+/// establishes that no face must be cancelled. All oriented shells therefore
+/// remain in the union, including cavity shells. Shared trim occurrences still
+/// belong to independent material sectors and must retain separate topology.
+/// Cutting the second occurrence changes only its exact curve decomposition.
+/// Trim samples select edges for subdivision, never certify solid separation.
+fn curved_contact_union<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    origin: Point3,
+    normal: Vector3,
+    roundoff: f64,
+) -> Option<Solid<Point3, C, S>> {
+    let mut work = 262_144_usize;
+    excludes_plane_patch(solid0, origin, normal, roundoff, &mut work)?;
+    excludes_plane_patch(solid1, origin, normal, roundoff, &mut work)?;
+    let on_plane = |point| {
+        let (distance, error) = plane_distance(point, origin, normal);
+        distance.is_finite() && distance.abs() <= error.max(roundoff)
+    };
+    let edges0 = solid0
+        .edge_iter()
+        .filter(|edge| on_plane(edge.front().point()) && on_plane(edge.back().point()))
+        .collect::<Vec<_>>();
+    if edges0.is_empty() {
+        return None;
+    }
+    let mut shells1 = solid1.boundaries().clone();
+    let mut visited = HashMap::default();
+    let mut subdivisions = 0_usize;
+    solid1.edge_iter().try_for_each(|edge| {
+        work = work.checked_sub(1)?;
+        if visited.insert(edge.id(), ()).is_some()
+            || !on_plane(edge.front().point())
+            || !on_plane(edge.back().point())
+        {
+            return Some(());
+        }
+        let curve = edge.curve();
+        let (start, end) = curve.range_tuple();
+        let middle = start + (end - start) / 2.0;
+        if !middle.is_finite() || middle <= start || middle >= end {
+            return None;
+        }
+        let point = curve.evaluate(middle);
+        if !on_plane(point) {
+            return Some(());
+        }
+        let coincident = edges0.iter().try_fold(false, |found, other| {
+            work = work.checked_sub(1)?;
+            let a = edge.front().point();
+            let b = edge.back().point();
+            let c = other.front().point();
+            let d = other.back().point();
+            Some(
+                found
+                    || (((a.near(&c) && b.near(&d)) || (a.near(&d) && b.near(&c)))
+                        && on_edge(point, other)),
+            )
+        })?;
+        if coincident {
+            if point.near(&edge.front().point()) || point.near(&edge.back().point()) {
+                return None;
+            }
+            let vertex = Vertex::new(point);
+            let (first, second) = shells1
+                .iter_mut()
+                .find_map(|shell| shell.cut_edge(edge.id(), &vertex))?;
+            if !first.is_geometric_consistent() || !second.is_geometric_consistent() {
+                return None;
+            }
+            subdivisions += 1;
+        }
+        Some(())
+    })?;
+    if subdivisions == 0 {
+        None
+    } else {
+        Solid::try_new(solid0.boundaries().iter().cloned().chain(shells1).collect()).ok()
+    }
+}
+
+/// Apply set identities only after a support enclosure separates the interiors.
+///
+/// Weak separation permits boundary contact: regularized intersection is empty
+/// and subtraction retains the first solid, including its cavity orientations.
+/// Union needs either a strict gap or a certificate excluding shared face patches.
+fn separated_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let (min0, max0) = solid_enclosure(solid0)?;
+    let (min1, max1) = solid_enclosure(solid1)?;
+    let separations = [
+        (min1.x - max0.x, min1.x.abs() + max0.x.abs()),
+        (min0.x - max1.x, min0.x.abs() + max1.x.abs()),
+        (min1.y - max0.y, min1.y.abs() + max0.y.abs()),
+        (min0.y - max1.y, min0.y.abs() + max1.y.abs()),
+        (min1.z - max0.z, min1.z.abs() + max0.z.abs()),
+        (min0.z - max1.z, min0.z.abs() + max1.z.abs()),
+    ];
+    if !separations.iter().any(|(gap, _)| *gap >= 0.0) && !matches!(operation, Operation::Union) {
+        return None;
+    }
+    match operation {
+        Operation::Difference => Some(solid0.clone()),
+        Operation::Intersection => Solid::try_new(Vec::new()).ok(),
+        Operation::Union => {
+            let strict = separations
+                .iter()
+                .any(|(gap, scale)| *gap > 32.0 * f64::EPSILON * scale);
+            if strict {
+                Solid::try_new(
+                    solid0
+                        .boundaries()
+                        .iter()
+                        .chain(solid1.boundaries())
+                        .cloned()
+                        .collect(),
+                )
+                .ok()
+            } else {
+                // Hull bounds include all surface controls, not just vertices.
+                // Only arithmetic roundoff is admitted at a weak separation.
+                (0..3).find_map(|axis| {
+                    let scale =
+                        min0[axis].abs() + max0[axis].abs() + min1[axis].abs() + max1[axis].abs();
+                    let roundoff = 64.0 * f64::EPSILON * scale;
+                    [(max0[axis], min1[axis]), (max1[axis], min0[axis])]
+                        .into_iter()
+                        .find_map(|(a, b)| {
+                            let gap = b - a;
+                            if !roundoff.is_finite() || gap.abs() > roundoff {
+                                return None;
+                            }
+                            let mut origin = Point3::origin();
+                            origin[axis] = a + gap / 2.0;
+                            let mut normal = Vector3::zero();
+                            normal[axis] = 1.0;
+                            curved_contact_union(solid0, solid1, origin, normal, roundoff)
+                        })
+                })
+            }
+        }
+    }
+}
+
+/// One exact section arc of a translational side patch.
+struct SweepArc<C, S> {
+    curve: NurbsCurve<Vector4>,
+    surface: S,
+    orientation: bool,
+    lower: Edge<Point3, C>,
+    upper: Edge<Point3, C>,
+    generators: SmallVec<[Edge<Point3, C>; 2]>,
+}
+
+/// Certify a planar support against its complete homogeneous control net.
+fn certified_plane<S: ShapeOpsSurface>(surface: &S) -> Option<Plane> {
+    let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()? else {
+        return None;
+    };
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    spline
+        .control_points()
+        .iter()
+        .flatten()
+        .all(|control| {
+            let (distance, error) =
+                plane_distance(control.to_point(), plane.origin(), plane.normal());
+            control.w > 0.0 && distance.is_finite() && error.is_finite() && distance.abs() <= error
+        })
+        .then_some(plane)
+}
+
+/// Trim a rational section without cutting at an existing domain endpoint.
+fn section_trim(curve: &NurbsCurve<Vector4>, start: f64, end: f64) -> Option<NurbsCurve<Vector4>> {
+    let (a, b) = curve.range_tuple();
+    if start < a || end > b || start >= end || start.near(&end) {
+        return None;
+    }
+    let mut result = curve.clone();
+    if !end.near(&b) {
+        let _ = result.cut(end);
+    }
+    if !start.near(&a) {
+        result = result.cut(start);
+    }
+    Some(result)
+}
+
+/// Recover a bounded trim parameter, using the endpoints as exact candidates.
+///
+/// A Newton step can move an endpoint query just outside its closed domain even
+/// when the residual is only roundoff. Evaluate the known endpoint parameters
+/// first, with the same geometric membership predicate as the inverse query.
+/// Interior queries still require a parameter within the original trim domain.
+fn sweep_parameter<C>(curve: &C, point: Point3) -> Option<f64>
+where
+    C: BoundedCurve<Point = Point3> + SearchParameter<CurveParameter, Point = Point3>,
+{
+    let (start, end) = curve.range_tuple();
+    let parameter = if curve.front().near(&point) {
+        Some(start)
+    } else if curve.back().near(&point) {
+        Some(end)
+    } else {
+        curve.search_parameter(point, None, 100)
+    }?;
+    (parameter.is_finite()
+        && parameter >= start
+        && parameter <= end
+        && curve.evaluate(parameter).near(&point))
+    .then_some(parameter)
+}
+
+/// Recover a section from a control net with weights constant along translation.
+///
+/// Both cap incidences and all four side trims are checked. The support identity
+/// proves the sweep between the caps, rather than inferring it from vertices.
+fn sweep_arcs<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    bottom: &Plane,
+    translation: Vector3,
+) -> Option<Vec<SweepArc<C, S>>> {
+    let normal = translation.normalize();
+    let top_origin = bottom.origin() + translation;
+    let on_plane = |point, origin| {
+        let (distance, error) = plane_distance(point, origin, normal);
+        distance.is_finite() && distance.abs() <= error
+    };
+    let mut cap_edges = HashMap::default();
+    let mut sides = Vec::new();
+    solid.face_iter().try_for_each(|face| {
+        let cap = certified_plane(&face.surface()).and_then(|plane| {
+            if !plane.normal().cross(normal).so_small() {
+                None
+            } else if on_plane(plane.origin(), bottom.origin()) {
+                Some(false)
+            } else if on_plane(plane.origin(), top_origin) {
+                Some(true)
+            } else {
+                None
+            }
+        });
+        if let Some(top) = cap {
+            face.edge_iter()
+                .try_for_each(|edge| cap_edges.insert(edge.id(), top).is_none().then_some(()))
+        } else {
+            sides.push(face);
+            Some(())
+        }
+    })?;
+    if sides.is_empty() || sides.len() > 128 {
+        return None;
+    }
+    let arcs = sides
+        .into_iter()
+        .map(|face| {
+            let edges = face.edge_iter().collect::<Vec<_>>();
+            if edges.len() != 4 || face.absolute_boundaries().len() != 1 {
+                return None;
+            }
+            let lower = edges
+                .iter()
+                .filter(|edge| cap_edges.get(&edge.id()) == Some(&false))
+                .collect::<Vec<_>>();
+            let upper = edges
+                .iter()
+                .filter(|edge| cap_edges.get(&edge.id()) == Some(&true))
+                .collect::<Vec<_>>();
+            if lower.len() != 1 || upper.len() != 1 {
+                return None;
+            }
+            let lower = lower[0];
+            let upper = upper[0];
+            let surface = face.surface();
+            let mut curve = if certified_plane(&surface).is_some() {
+                // Two distinct planes intersect in exactly one straight line.
+                NurbsCurve::new(BsplineCurve::from(Line(
+                    lower.front().point().to_homogeneous(),
+                    lower.back().point().to_homogeneous(),
+                )))
+            } else {
+                if !surface.supports_exact_patch_domains() {
+                    return None;
+                }
+                let spline = surface.try_into_homogeneous_bspline_surface()?;
+                let controls = spline.control_points();
+                if controls.iter().map(Vec::len).sum::<usize>() > 4096
+                    || !spline.knot_vector_u().is_clamped(spline.udegree())
+                    || !spline.knot_vector_v().is_clamped(spline.vdegree())
+                {
+                    return None;
+                }
+                let (a, b) = if spline.udegree() == 1 && controls.len() == 2 {
+                    (spline.curve_v(0), spline.curve_v(1))
+                } else if spline.vdegree() == 1 && controls.iter().all(|row| row.len() == 2) {
+                    (spline.curve_u(0), spline.curve_u(1))
+                } else {
+                    return None;
+                };
+                let is_lower = on_plane(a.control_point(0).to_point(), bottom.origin());
+                let (a, b) = if is_lower { (a, b) } else { (b, a) };
+                if !a
+                    .control_points()
+                    .iter()
+                    .zip(b.control_points())
+                    .all(|(a, b)| {
+                        let scale = a.magnitude() + b.magnitude();
+                        a.w > 0.0
+                            && b.w > 0.0
+                            && (a.w - b.w).abs() <= 32.0 * f64::EPSILON * scale
+                            && on_plane(a.to_point(), bottom.origin())
+                            && (b.to_point() - a.to_point() - translation).magnitude()
+                                <= 64.0 * f64::EPSILON * (scale + translation.magnitude())
+                    })
+                {
+                    return None;
+                }
+                let full = NurbsCurve::new(a);
+                let a = sweep_parameter(&full, lower.front().point())?;
+                let b = sweep_parameter(&full, lower.back().point())?;
+                let mut curve = section_trim(&full, a.min(b), a.max(b))?;
+                if a > b {
+                    curve.invert();
+                }
+                curve
+            };
+            // The input's oriented side boundary fixes the section winding.
+            if !curve.front().near(&lower.front().point()) {
+                curve.invert();
+            }
+            if !curve.front().near(&lower.front().point())
+                || !curve.back().near(&lower.back().point())
+                || !(curve.front() + translation).near(&upper.back().point())
+                || !(curve.back() + translation).near(&upper.front().point())
+            {
+                return None;
+            }
+            let (start, end) = curve.range_tuple();
+            let lower_curve = lower.curve();
+            let upper_curve = upper.curve();
+            [start, (start + end) / 2.0, end]
+                .into_iter()
+                .try_for_each(|t| {
+                    let point = curve.evaluate(t);
+                    sweep_parameter(&lower_curve, point)?;
+                    sweep_parameter(&upper_curve, point + translation)?;
+                    Some(())
+                })?;
+            edges
+                .iter()
+                .filter(|edge| !cap_edges.contains_key(&edge.id()))
+                .try_for_each(|edge| {
+                    let a = edge.front().point();
+                    let b = edge.back().point();
+                    let delta = b - a;
+                    (delta.near(&translation) || delta.near(&-translation)).then_some(())?;
+                    let curve = edge.curve();
+                    let (a, b) = curve.range_tuple();
+                    [0.25, 0.5, 0.75]
+                        .into_iter()
+                        .all(|s| {
+                            let point = curve.evaluate(a + (b - a) * s);
+                            (point - edge.front().point()).cross(translation).so_small()
+                        })
+                        .then_some(())
+                })?;
+            Some(SweepArc {
+                curve,
+                surface,
+                orientation: face.orientation(),
+                lower: (*lower).clone(),
+                upper: (*upper).clone(),
+                generators: edges
+                    .iter()
+                    .filter(|edge| !cap_edges.contains_key(&edge.id()))
+                    .cloned()
+                    .collect(),
+            })
+        })
+        .collect::<Option<Vec<_>>>()?;
+    (arcs.len() * 2 == cap_edges.len()).then_some(arcs)
+}
+
+/// Isolate section intersections with positive-weight rational convex hulls.
+///
+/// Subdivision uses homogeneous de Casteljau, so no chord can certify separation.
+/// Ambiguous, tangent, or unresolved intersections decline the entire fallback.
+fn section_crossings(
+    a: &NurbsCurve<Vector4>,
+    b: &NurbsCurve<Vector4>,
+    normal: Vector3,
+    work: &mut usize,
+) -> Option<Vec<(f64, f64)>> {
+    let spans = |curve: &NurbsCurve<Vector4>| {
+        curve
+            .non_rationalized()
+            .bezier_decomposition()
+            .into_iter()
+            .map(|span| (span.range_tuple(), span.control_points().clone()))
+            .collect::<Vec<_>>()
+    };
+    let spans_a = spans(a);
+    let spans_b = spans(b);
+    *work = work.checked_sub(spans_a.len().checked_mul(spans_b.len())?)?;
+    let mut stack = spans_a
+        .iter()
+        .flat_map(|a| spans_b.iter().map(move |b| (a.clone(), b.clone(), 0)))
+        .collect::<Vec<_>>();
+    let bounds = |controls: &[Vector4]| {
+        controls.iter().try_fold(
+            (
+                Point3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY),
+                Point3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY),
+            ),
+            |(min, max), control| {
+                let p = control.to_point();
+                (control.w > 0.0 && p.x.is_finite() && p.y.is_finite() && p.z.is_finite())
+                    .then_some((
+                        Point3::new(min.x.min(p.x), min.y.min(p.y), min.z.min(p.z)),
+                        Point3::new(max.x.max(p.x), max.y.max(p.y), max.z.max(p.z)),
+                    ))
+            },
+        )
+    };
+    let split = |controls: &[Vector4]| {
+        let mut row = controls.to_vec();
+        let mut left = vec![row[0]];
+        let mut right = vec![row[row.len() - 1]];
+        while row.len() > 1 {
+            row = row
+                .windows(2)
+                .map(|pair| (pair[0] + pair[1]) / 2.0)
+                .collect();
+            left.push(row[0]);
+            right.push(row[row.len() - 1]);
+        }
+        right.reverse();
+        (left, right)
+    };
+    let mut roots: Vec<(f64, f64)> = Vec::new();
+    while let Some(((ra, ca), (rb, cb), depth)) = stack.pop() {
+        *work = work.checked_sub(ca.len() + cb.len())?;
+        let (mina, maxa) = bounds(&ca)?;
+        let (minb, maxb) = bounds(&cb)?;
+        let separated = (0..3).any(|axis| {
+            let error = 64.0
+                * f64::EPSILON
+                * (mina[axis].abs() + maxa[axis].abs() + minb[axis].abs() + maxb[axis].abs());
+            maxa[axis] < minb[axis] - error || maxb[axis] < mina[axis] - error
+        });
+        if separated {
+            continue;
+        }
+        if depth >= 48 || (mina.near(&maxa) && minb.near(&maxb)) {
+            let (mut u, mut v) = ((ra.0 + ra.1) / 2.0, (rb.0 + rb.1) / 2.0);
+            (0..12).try_for_each(|_| {
+                let delta = a.evaluate(u) - b.evaluate(v);
+                let da = a.derivative(u);
+                let db = b.derivative(v);
+                let determinant = da.cross(db).dot(normal);
+                if !determinant.is_finite() || determinant.so_small() {
+                    return None;
+                }
+                u -= delta.cross(db).dot(normal) / determinant;
+                v -= delta.cross(da).dot(normal) / determinant;
+                (u.is_finite() && v.is_finite()).then_some(())
+            })?;
+            let within = |value: f64, range: (f64, f64)| {
+                (value >= range.0 || value.near(&range.0))
+                    && (value <= range.1 || value.near(&range.1))
+            };
+            if !within(u, ra) || !within(v, rb) || !a.evaluate(u).near(&b.evaluate(v)) {
+                return None;
+            }
+            let ar = a.range_tuple();
+            let br = b.range_tuple();
+            u = u.clamp(ar.0, ar.1);
+            v = v.clamp(br.0, br.1);
+            if !roots.iter().any(|(s, t)| u.near(s) && v.near(t)) {
+                roots.push((u, v));
+            }
+        } else if (maxa - mina).magnitude2() >= (maxb - minb).magnitude2() {
+            let (left, right) = split(&ca);
+            let middle = (ra.0 + ra.1) / 2.0;
+            stack.push((((middle, ra.1), right), (rb, cb.clone()), depth + 1));
+            stack.push((((ra.0, middle), left), (rb, cb), depth + 1));
+        } else {
+            let (left, right) = split(&cb);
+            let middle = (rb.0 + rb.1) / 2.0;
+            stack.push(((ra, ca.clone()), ((middle, rb.1), right), depth + 1));
+            stack.push(((ra, ca), ((rb.0, middle), left), depth + 1));
+        }
+    }
+    Some(roots)
+}
+
+/// Classify a section cell by signed crossings of exact rational curves.
+///
+/// Convex hulls bound the ray length. A ray through a trim endpoint or tangent
+/// is discarded, avoiding double counts and preserving inward cavity windings.
+fn section_inside<C, S>(
+    point: Point3,
+    arcs: &[SweepArc<C, S>],
+    normal: Vector3,
+    work: &mut usize,
+) -> Option<bool> {
+    let radius = arcs.iter().try_fold(0.0_f64, |radius, arc| {
+        arc.curve
+            .control_points()
+            .iter()
+            .try_fold(radius, |radius, control| {
+                *work = work.checked_sub(1)?;
+                let distance = control.to_point().distance(point);
+                (control.w > 0.0 && distance.is_finite()).then_some(radius.max(distance))
+            })
+    })?;
+    if radius == 0.0 {
+        return None;
+    }
+    [
+        Vector3::zero(),
+        Vector3::new(1.0, 2.0, 3.0),
+        Vector3::new(3.0, 1.0, 2.0),
+    ]
+    .into_iter()
+    .find_map(|offset| {
+        let direction = hash::take_one_unit(point + offset);
+        let direction = direction - normal * direction.dot(normal);
+        if direction.so_small() {
+            return None;
+        }
+        let direction = direction.normalize();
+        let ray = NurbsCurve::new(BsplineCurve::from(Line(
+            point.to_homogeneous(),
+            (point + direction * (2.0 * radius)).to_homogeneous(),
+        )));
+        arcs.iter()
+            .try_fold(0_isize, |winding, arc| {
+                let (start, end) = arc.curve.range_tuple();
+                section_crossings(&arc.curve, &ray, normal, work)?
+                    .into_iter()
+                    .try_fold(winding, |winding, (u, v)| {
+                        if u.near(&start) || u.near(&end) || v.so_small() {
+                            return None;
+                        }
+                        let crossing = direction.cross(arc.curve.derivative(u)).dot(normal);
+                        if !crossing.is_finite() || crossing.so_small() {
+                            None
+                        } else {
+                            Some(winding + if crossing > 0.0 { 1 } else { -1 })
+                        }
+                    })
+            })
+            .map(|winding| winding > 0)
+    })
+}
+
+/// Cut a retained input trim, preserving its original curve representation.
+fn sweep_trim_edge<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    edge: &Edge<Point3, C>,
+    front: &Vertex<Point3>,
+    back: &Vertex<Point3>,
+) -> Option<Edge<Point3, C>> {
+    let mut curve = edge.curve();
+    let (start, end) = curve.range_tuple();
+    let a = sweep_parameter(&curve, front.point())?;
+    let b = sweep_parameter(&curve, back.point())?;
+    if a.near(&b) {
+        return None;
+    }
+    let (lower, upper) = (a.min(b), a.max(b));
+    if !upper.near(&end) {
+        let _ = curve.cut(upper);
+    }
+    if !lower.near(&start) {
+        curve = curve.cut(lower);
+    }
+    if a > b {
+        curve.invert();
+    }
+    let edge = Edge::try_new(front, back, curve).ok()?;
+    edge.is_geometric_consistent().then_some(edge)
+}
+
+/// Retain an exact local chart for a certified affine spline generator.
+///
+/// A degree-one parameter direction with constant rational weights is affine.
+/// The other parameter is fixed, so its endpoints determine the complete line.
+fn sweep_line_boundary<S: ShapeOpsSurface>(
+    surface: &S,
+    front: Point3,
+    back: Point3,
+) -> Option<ParameterCurve<BoundaryCurve2D, S>> {
+    let a = surface.search_parameter(front, None, 100)?;
+    let b = surface.search_parameter(back, Some(a), 100)?;
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    let controls = spline.control_points();
+    let affine = if a.0 == b.0 && spline.vdegree() == 1 {
+        controls
+            .iter()
+            .all(|row| row.len() == 2 && row[0].w > 0.0 && row[0].w == row[1].w)
+    } else if a.1 == b.1 && spline.udegree() == 1 && controls.len() == 2 {
+        controls[0]
+            .iter()
+            .zip(&controls[1])
+            .all(|(a, b)| a.w > 0.0 && a.w == b.w)
+    } else {
+        false
+    };
+    affine.then(|| {
+        ParameterCurve::new(
+            BoundaryCurve2D::Line(Line(a.into(), b.into())),
+            surface.clone(),
+        )
+    })
+}
