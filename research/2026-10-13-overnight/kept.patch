+    boundary.iter().try_for_each(|edge| {
+        if replacements.contains_key(&edge.id()) {
+            return Some(());
+        }
+        let mut partners = boundary.iter().filter(|other| {
+            other.id() != edge.id()
+                && edge.front().point().near(&other.back().point())
+                && edge.back().point().near(&other.front().point())
+                && matching_edges(edge, other, tol)
+        });
+        let partner = partners.next()?;
+        if partners.next().is_some() || replacements.contains_key(&partner.id()) {
+            return None;
+        }
+        let joined = Edge::try_new(
+            vertices.get(&edge.front().id())?,
+            vertices.get(&edge.back().id())?,
+            edge.oriented_curve(),
+        )
+        .ok()?;
+        replacements.insert(
+            edge.id(),
+            if edge.orientation() {
+                joined.clone()
+            } else {
+                joined.inverse()
+            },
+        );
+        replacements.insert(
+            partner.id(),
+            if partner.orientation() {
+                joined.inverse()
+            } else {
+                joined
+            },
+        );
+        Some(())
+    })?;
