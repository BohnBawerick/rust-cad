+/// Sew only the open seams left by removing shared patches.
+///
+/// Closed components retain their topology, including components meeting only
+/// at a vertex or an edge. Every seam needs one oppositely directed partner.
+fn sew_contacts<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: Shell<Point3, C, S>,
+    tol: f64,
+) -> Option<Shell<Point3, C, S>> {
+    let boundary: Vec<_> = shell.extract_boundaries().into_iter().flatten().collect();
+    if boundary.is_empty() {
+        return Some(shell);
+    }
+    let mut vertices = HashMap::default();
+    let mut representatives: Vec<Vertex<Point3>> = Vec::new();
+    boundary
+        .iter()
+        .flat_map(|edge| [edge.front(), edge.back()])
+        .for_each(|vertex| {
+            let representative = representatives
+                .iter()
+                .find(|other| vertex.point().near(&other.point()))
+                .cloned()
+                .unwrap_or_else(|| {
+                    representatives.push(vertex.clone());
+                    vertex.clone()
+                });
+            vertices.insert(vertex.id(), representative);
+        });
