+/// Assemble failed common sweeps by cutting input trims and retaining seam identity.
+fn sweep_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+    tol: f64,
+    division: FaceDivision,
+) -> Option<Solid<Point3, C, S>> {
+    if solid0.face_iter().count() > 128 || solid1.face_iter().count() > 128 {
+        return None;
+    }
+    let caps = solid0
+        .face_iter()
+        .filter_map(|face| {
+            let surface = face.surface();
+            // A merged cap may extend past either operand's original trims.
+            // Only an unbounded planar support can carry it without extending
+            // the parameter domain of a bounded spline patch.
+            if surface.supports_exact_patch_domains() {
+                None
+            } else {
+                certified_plane(&surface).map(|plane| (face, plane))
+            }
+        })
+        .collect::<Vec<_>>();
+    let (bottom_face, bottom, top_face, translation, arcs0, arcs1) =
+        caps.iter().enumerate().find_map(|(i, (a, pa))| {
+            caps.iter().skip(i + 1).find_map(|(b, pb)| {
+                if !pa.normal().cross(pb.normal()).so_small() {
+                    return None;
+                }
+                let normal = pa.normal().normalize();
+                let translation = normal * (pb.origin() - pa.origin()).dot(normal);
+                if translation.so_small() {
+                    return None;
+                }
+                let arcs0 = sweep_arcs(solid0, pa, translation)?;
+                let arcs1 = sweep_arcs(solid1, pa, translation)?;
+                Some((*a, *pa, *b, translation, arcs0, arcs1))
+            })
+        })?;
+    let count0 = arcs0.len();
+    let arcs = arcs0.into_iter().chain(arcs1).collect::<Vec<_>>();
+    let mut parameters = arcs
+        .iter()
+        .map(|arc| {
+            let (a, b) = arc.curve.range_tuple();
+            vec![a, b]
+        })
+        .collect::<Vec<_>>();
+    let mut work = 262_144;
+    (0..count0).try_for_each(|i| {
+        (count0..arcs.len()).try_for_each(|j| {
+            section_crossings(&arcs[i].curve, &arcs[j].curve, bottom.normal(), &mut work)?
+                .into_iter()
+                .for_each(|(u, v)| {
+                    parameters[i].push(u);
+                    parameters[j].push(v);
+                });
+            Some(())
+        })
+    })?;
+    let mut patches = Vec::new();
+    arcs.iter()
+        .zip(&mut parameters)
+        .enumerate()
+        .try_for_each(|(index, (arc, parameters))| {
+            parameters.sort_by(f64::total_cmp);
+            parameters.dedup_by(|a, b| (*a).near(&*b));
+            parameters.windows(2).try_for_each(|span| {
+                let point = arc.curve.evaluate((span[0] + span[1]) / 2.0);
+                let in_other = section_inside(
+                    point,
+                    if index < count0 {
+                        &arcs[count0..]
+                    } else {
+                        &arcs[..count0]
+                    },
+                    translation.normalize(),
+                    &mut work,
+                )?;
+                let keep = match operation {
+                    Operation::Intersection => in_other,
+                    Operation::Union => !in_other,
+                    Operation::Difference => in_other == (index >= count0),
+                };
+                if keep {
+                    let reverse = matches!(operation, Operation::Difference) && index >= count0;
+                    let mut curve = section_trim(&arc.curve, span[0], span[1])?;
+                    if reverse {
+                        curve.invert();
+                    }
+                    patches.push(SweepArc {
+                        curve,
+                        surface: arc.surface.clone(),
+                        orientation: arc.orientation != reverse,
+                        lower: arc.lower.clone(),
+                        upper: arc.upper.clone(),
+                        generators: arc.generators.clone(),
+                    });
+                }
+                Some(())
+            })
+        })?;
+    if patches.is_empty() {
+        return if matches!(operation, Operation::Union) {
+            None
+        } else {
+            Solid::try_new(Vec::new()).ok()
+        };
+    }
+    let mut vertices: Vec<(Vertex<Point3>, Vertex<Point3>)> = Vec::new();
+    let indices = patches
+        .iter()
+        .map(|patch| {
+            [patch.curve.front(), patch.curve.back()].map(|point| {
+                if let Some(index) = vertices.iter().position(|(a, _)| a.point().near(&point)) {
+                    index
+                } else {
+                    let index = vertices.len();
+                    vertices.push((Vertex::new(point), Vertex::new(point + translation)));
+                    index
+                }
+            })
+        })
+        .collect::<Vec<_>>();
+    let verticals = vertices
+        .iter()
+        .enumerate()
+        .map(|(index, (a, b))| {
+            let adjacent = indices
+                .iter()
+                .enumerate()
+                .filter(|(_, pair)| pair.contains(&index))
+                .map(|(i, _)| i)
+                .collect::<Vec<_>>();
+            if adjacent.len() != 2 {
+                return None;
+            }
+            let first = &patches[adjacent[0]];
+            let second = &patches[adjacent[1]];
+            let inherited = first.generators.iter().find(|edge| {
+                second
+                    .generators
+                    .iter()
+                    .any(|other| edge.id() == other.id())
+                    && ((edge.front().point().near(&a.point())
+                        && edge.back().point().near(&b.point()))
+                        || (edge.back().point().near(&a.point())
+                            && edge.front().point().near(&b.point())))
+            });
+            let curve = if let Some(edge) = inherited {
+                // A shared input edge already belongs to both incident supports.
+                // In particular, a smooth seam must not become a parameter curve
+                // owned by only one of its distinct surface charts.
+                let mut curve = edge.curve();
+                if !curve.front().near(&a.point()) {
+                    curve.invert();
+                }
+                curve
+            } else {
+                let surface0 = first.surface.clone();
+                let surface1 = second.surface.clone();
+                let uv0 = surface0.search_parameter(a.point(), None, 100)?;
+                let uv1 = surface1.search_parameter(a.point(), None, 100)?;
+                // A new generator needs a transverse intersection. Tangent
+                // contacts cannot acquire an arbitrary SSI parameterization.
+                if surface0
+                    .normal(uv0.0, uv0.1)
+                    .cross(surface1.normal(uv1.0, uv1.1))
+                    .so_small()
+                {
+                    return None;
+                }
+                let boundary0 = sweep_line_boundary(&surface0, a.point(), b.point());
+                let boundary1 = sweep_line_boundary(&surface1, a.point(), b.point());
+                SurfaceCurve::with_boundaries(
+                    surface0,
+                    surface1,
+                    BsplineCurve::from(Line(a.point(), b.point())),
+                    boundary0,
+                    boundary1,
+                )
+                .into()
+            };
+            Edge::try_new(a, b, curve).ok()
+        })
+        .collect::<Option<Vec<Edge<Point3, C>>>>()?;
+    let mut shell = patches
+        .iter()
+        .zip(indices)
+        .map(|(patch, [a, b])| {
+            // Cutting the original trims preserves their spatial geometry and
+            // any exact parameter boundaries supplied by the input API.
+            let lower = sweep_trim_edge::<C, S>(&patch.lower, &vertices[a].0, &vertices[b].0)?;
+            let upper = sweep_trim_edge::<C, S>(&patch.upper, &vertices[a].1, &vertices[b].1)?;
+            let wire = Wire::from(vec![
+                lower,
+                verticals[b].clone(),
+                upper.inverse(),
+                verticals[a].inverse(),
+            ]);
+            let wire = if patch.orientation {
+                wire
+            } else {
+                wire.inverse()
+            };
+            let mut face = Face::try_new(vec![wire], patch.surface.clone()).ok()?;
+            if !patch.orientation {
+                face.invert();
+            }
+            Some(face)
+        })
+        .collect::<Option<Shell<Point3, C, S>>>()?;
+    let boundaries = shell.extract_boundaries();
+    [bottom_face, top_face].into_iter().try_for_each(|cap| {
+        let plane = certified_plane(&cap.surface())?;
+        let wires = boundaries
+            .iter()
+            .filter(|wire| {
+                wire.front_vertex().is_some_and(|vertex| {
+                    let (distance, error) =
+                        plane_distance(vertex.point(), plane.origin(), plane.normal());
+                    distance.abs() <= error
+                })
+            })
+            .map(|wire| {
+                let wire = if cap.orientation() {
+                    wire.inverse()
+                } else {
+                    wire.clone()
+                };
+                loops_store::BoundaryWire::new(wire, loops_store::ShapesOpStatus::And)
+            })
+            .collect::<loops_store::Loops<_, _>>();
+        if wires.is_empty() {
+            return None;
+        }
+        let mut store: loops_store::LoopsStore<_, _> = iter::once(cap).collect();
+        store[0] = wires;
+        let cap_shell = iter::once(cap.clone()).collect();
+        let [mut divided, _, _] =
+            divide_boundary_faces(&cap_shell, &store, tol, division)?.and_or_unknown();
+        shell.append(&mut divided);
+        Some(())
+    })?;
+    if !shell.edge_iter().all(|edge| edge.is_geometric_consistent()) {
+        return None;
+    }
+    Solid::try_new(shell.connected_components()).ok()
+}
