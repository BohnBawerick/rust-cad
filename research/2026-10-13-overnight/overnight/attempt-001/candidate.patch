+/// Choose a point in the relative interior of a trimmed face.
+///
+/// A boundary vertex may also lie on the other solid at a mere contact. Use
+/// the parameter centroid of a large tessellation triangle instead, evaluated
+/// on the original surface. The tessellation is only a classification aid.
+fn interior_point<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    face: &Face<Point3, AltCurve<C, S>, S>,
+    tol: f64,
+) -> Option<Point3> {
+    let shell: AltCurveShell<C, S> = iter::once(face.clone()).collect();
+    let meshed = shell.triangulation(tol);
+    let mesh = meshed.first()?.surface()?;
+    let triangle = mesh
+        .face_iter()
+        .flat_map(|polygon| {
+            (2..polygon.len()).map(move |index| [polygon[0], polygon[index - 1], polygon[index]])
+        })
+        .max_by(|lhs, rhs| {
+            let area = |triangle: &[StandardVertex; 3]| {
+                let [a, b, c] = triangle.map(|vertex| mesh.positions()[vertex.pos]);
+                (b - a).cross(c - a).magnitude2()
+            };
+            area(lhs).total_cmp(&area(rhs))
+        })?;
+    let surface = face.surface();
+    let uv = triangle
+        .iter()
+        .map(|vertex| vertex.uv.map(|index| mesh.uv_coords()[index]))
+        .try_fold(Vector2::zero(), |sum, uv| Some(sum + uv?));
+    let (u, v) = if let Some(uv) = uv {
+        (uv.x / 3.0, uv.y / 3.0)
+    } else {
+        let [a, b, c] = triangle.map(|vertex| mesh.positions()[vertex.pos]);
+        surface.search_nearest_parameter(a + ((b - a) + (c - a)) / 3.0, None, 100)?
+    };
+    Some(surface.evaluate(u, v))
+}
