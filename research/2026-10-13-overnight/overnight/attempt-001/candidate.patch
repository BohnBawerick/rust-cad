+/// Classify against the sum of all oriented boundary shells.
+///
+/// An outward shell contributes one inside; a cavity contributes minus one.
+/// Reversing a bounded solid gives minus one inside and zero outside, so its
+/// complement additionally needs a winding of one at infinity.
+fn inside(point: Point3, shell: &PolyShell, at_infinity: isize) -> Option<bool> {
+    let directions = [
+        hash::take_one_unit(point),
+        hash::take_one_unit(point + Vector3::new(1.0, 2.0, 3.0)),
+        hash::take_one_unit(point + Vector3::new(3.0, 1.0, 2.0)),
+    ];
+    let votes = directions.into_iter().try_fold(0, |votes, direction| {
+        let winding = shell.iter().try_fold(at_infinity, |winding, face| {
+            let crossings = face.surface()?.signed_crossing_faces(point, direction);
+            Some(
+                winding
+                    + if face.orientation() {
+                        crossings
+                    } else {
+                        -crossings
+                    },
+            )
+        })?;
+        Some(votes + usize::from(winding > 0))
+    })?;
+    Some(votes >= 2)
+}
