+/// Fit one intersection span with bounded refinement and fallible projections.
+///
+/// Endpoints are shared between children and kept at the original edge vertices.
+/// Two subdivision levels bound the work per span; the shared projection budget
+/// also bounds the work for all intersection edges in an output shell.
+fn intersection_segment<S: ShapeOpsSurface>(
+    curve: &IntersectionCurve<PolylineCurve<Point3>, S, S>,
+    range: (f64, f64),
+    endpoints: (Point3, Point3),
+    depth: usize,
+    projections: &mut usize,
+) -> Option<BsplineCurve<Point3>> {
+    let (start, end) = range;
+    let (a, d) = endpoints;
+    let width = end - start;
+    *projections = projections.checked_sub(2)?;
+    let b = curve.search_triple(start + width / 3.0, 100)?.0;
+    let c = curve.search_triple(start + width * 2.0 / 3.0, 100)?.0;
+    let controls = vec![
+        a,
+        a + ((b - a) * 18.0 - (c - a) * 9.0 + (d - a) * 2.0) / 6.0,
+        d + ((c - d) * 18.0 - (b - d) * 9.0 + (a - d) * 2.0) / 6.0,
+        d,
+    ];
+    let mut knots = KnotVector::bezier_knot(3);
+    knots.transform(width, start);
+    let segment = BsplineCurve::new(knots, controls);
+    if leader_on_surfaces(curve, &segment) {
+        Some(segment)
+    } else if depth == 0 {
+        None
+    } else {
+        *projections = projections.checked_sub(1)?;
+        let middle = (start + end) / 2.0;
+        let point = curve.search_triple(middle, 100)?.0;
+        let left =
+            intersection_segment(curve, (start, middle), (a, point), depth - 1, projections)?;
+        let right = intersection_segment(curve, (middle, end), (point, d), depth - 1, projections)?;
+        left.try_concat(&right).ok()
+    }
+}
+
+/// Preserve valid leaders, refining only those that miss their exact supports.
+fn intersection_leader<S: ShapeOpsSurface>(
+    curve: &IntersectionCurve<PolylineCurve<Point3>, S, S>,
+    projections: &mut usize,
+) -> Option<BsplineCurve<Point3>> {
+    let points = curve.leader().as_slice();
+    let denominator = (points.len() - 1) as f64;
+    let knots = KnotVector::from(
+        iter::once(0.0)
+            .chain((0..points.len()).map(|index| index as f64 / denominator))
+            .chain(iter::once(1.0))
+            .collect::<Vec<_>>(),
+    );
+    let leader = BsplineCurve::new(knots, points.to_vec());
+    if leader_on_surfaces(curve, &leader) {
+        Some(leader)
+    } else {
+        let first =
+            intersection_segment(curve, (0.0, 1.0), (points[0], points[1]), 2, projections)?;
+        (1..points.len() - 1).try_fold(first, |spline, index| {
+            let segment = intersection_segment(
+                curve,
+                (index as f64, (index + 1) as f64),
+                (points[index], points[index + 1]),
+                2,
+                projections,
+            )?;
+            spline.try_concat(&segment).ok()
+        })
+    }
+}
