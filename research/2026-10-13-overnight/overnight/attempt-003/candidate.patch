+/// Check a leader on both exact supports using continuation in parameter space.
+///
+/// The sampling density follows the spline inclusion check: six samples per
+/// degree per knot span. Hints keep each inverse query local to its predecessor.
+fn leader_on_surfaces<S: ShapeOpsSurface>(
+    curve: &IntersectionCurve<PolylineCurve<Point3>, S, S>,
+    leader: &BsplineCurve<Point3>,
+) -> bool {
+    let surface0 = curve.surface0();
+    let surface1 = curve.surface1();
+    let point = leader.front();
+    let parameters = surface0
+        .search_parameter(point, None, 100)
+        .zip(surface1.search_parameter(point, None, 100));
+    let (knots, _) = leader.knot_vector().to_single_multi();
+    let samples = leader.degree() * 6;
+    parameters
+        .and_then(|parameters| {
+            knots
+                .windows(2)
+                .flat_map(|span| {
+                    (1..=samples).map(move |index| {
+                        span[0] + (span[1] - span[0]) * index as f64 / samples as f64
+                    })
+                })
+                .try_fold(parameters, |(hint0, hint1), parameter| {
+                    let point = leader.evaluate(parameter);
+                    let uv0 = surface0.search_parameter(point, Some(hint0), 100)?;
+                    let uv1 = surface1.search_parameter(point, Some(hint1), 100)?;
+                    (surface0.evaluate(uv0.0, uv0.1).near(&point)
+                        && surface1.evaluate(uv1.0, uv1.1).near(&point))
+                    .then_some((uv0, uv1))
+                })
+        })
+        .is_some()
+}
