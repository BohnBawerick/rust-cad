+/// Recognize coincident supports from their analytic or exact spline data.
+fn same_support<S: ShapeOpsSurface>(a: &S, b: &S) -> bool {
+    match (
+        a.try_into_analytic_surface_kind(),
+        b.try_into_analytic_surface_kind(),
+    ) {
+        (Some(AnalyticSurfaceKind::Plane(a)), Some(AnalyticSurfaceKind::Plane(b))) => {
+            a.normal().cross(b.normal()).near(&Vector3::zero())
+                && (a.origin() - b.origin()).dot(a.normal()).so_small()
+        }
+        _ => a
+            .try_into_homogeneous_bspline_surface()
+            .zip(b.try_into_homogeneous_bspline_surface())
+            .is_some_and(|(a, b)| a == b),
+    }
+}
