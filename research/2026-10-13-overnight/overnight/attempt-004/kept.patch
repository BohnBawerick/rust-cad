+/// Detect positive-area overlap of coplanar triangles by separating axes.
+fn coplanar_overlap(a: &PolygonMesh, b: &PolygonMesh, normal: Vector3) -> bool {
+    let triangles = |mesh: &PolygonMesh| {
+        mesh.face_iter()
+            .flat_map(|face| {
+                (2..face.len())
+                    .map(move |i| [face[0], face[i - 1], face[i]].map(|v| mesh.positions()[v.pos]))
+            })
+            .collect::<Vec<_>>()
+    };
+    let triangles0 = triangles(a);
+    let triangles1 = triangles(b);
+    triangles0.iter().any(|a| {
+        triangles1.iter().any(|b| {
+            [a, b].into_iter().all(|triangle| {
+                (0..3).all(|i| {
+                    let axis = normal.cross(triangle[(i + 1) % 3] - triangle[i]);
+                    let interval = |points: &[Point3; 3]| {
+                        points
+                            .iter()
+                            .map(|p| (*p - a[0]).dot(axis))
+                            .fold((f64::INFINITY, f64::NEG_INFINITY), |(min, max), x| {
+                                (min.min(x), max.max(x))
+                            })
+                    };
+                    let (min0, max0) = interval(a);
+                    let (min1, max1) = interval(b);
+                    max0.min(max1) > min0.max(min1)
+                })
+            })
+        })
+    })
+}
