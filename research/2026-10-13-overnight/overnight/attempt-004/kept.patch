+/// Recognize an already conforming boundary arrangement before marching.
+///
+/// Shared patches must have the same complete trims. All other interference
+/// segments must lie on both existing boundaries. Partial coplanar overlaps
+/// and intersections through face interiors still require subdivision.
+fn conforming_contacts<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell0: &Shell<Point3, C, S>,
+    shell1: &Shell<Point3, C, S>,
+    polygons0: &PolyShell,
+    polygons1: &PolyShell,
+    tol: f64,
+) -> Option<Vec<(usize, usize)>> {
+    let edges0: Vec<Vec<_>> = shell0
+        .iter()
+        .map(|face| face.edge_iter().collect())
+        .collect();
+    let edges1: Vec<Vec<_>> = shell1
+        .iter()
+        .map(|face| face.edge_iter().collect())
+        .collect();
+    let contacts: Vec<_> = shell0
+        .iter()
+        .enumerate()
+        .flat_map(|(i, a)| {
+            let edges0 = &edges0;
+            let edges1 = &edges1;
+            shell1.iter().enumerate().filter_map(move |(j, b)| {
+                // Reject different trims before converting surfaces or intersecting meshes.
+                let matching = edges0[i].len() == edges1[j].len()
+                    && edges0[i].iter().all(|edge0| {
+                        edges1[j]
+                            .iter()
+                            .any(|edge1| matching_edges(edge0, edge1, tol))
+                    })
+                    && edges1[j].iter().all(|edge1| {
+                        edges0[i]
+                            .iter()
+                            .any(|edge0| matching_edges(edge0, edge1, tol))
+                    })
+                    && same_support(&a.surface(), &b.surface());
+                matching.then_some((i, j))
+            })
+        })
+        .collect();
+    // Each patch has one owner in each operand. Ambiguity requires subdivision.
+    if contacts.is_empty()
+        || contacts
+            .iter()
+            .any(|(i, j)| contacts.iter().filter(|(k, l)| i == k || j == l).count() != 1)
+    {
+        return None;
+    }
+    if contacts.len() == shell0.len() && contacts.len() == shell1.len() {
+        return Some(contacts);
+    }
+    shell0.iter().enumerate().try_for_each(|(i, a)| {
+        shell1.iter().enumerate().try_for_each(|(j, b)| {
+            if contacts.contains(&(i, j)) {
+                return Some(());
+            }
+            let mesh0 = polygons0[i].surface()?;
+            let mesh1 = polygons1[j].surface()?;
+            let surface0 = a.surface();
+            let surface1 = b.surface();
+            // Unmatched curved patches require the existing subdivision pipeline.
+            // In particular, a mesh chord is not a separation certificate for them.
+            let (Some(AnalyticSurfaceKind::Plane(plane0)), Some(AnalyticSurfaceKind::Plane(_))) = (
+                surface0.try_into_analytic_surface_kind(),
+                surface1.try_into_analytic_surface_kind(),
+            ) else {
+                return None;
+            };
+            if same_support(&surface0, &surface1)
+                && coplanar_overlap(&mesh0, &mesh1, plane0.normal())
+            {
+                return None;
+            }
+            mesh0
+                .extract_interference(&mesh1)
+                .into_iter()
+                .all(|(p, q)| {
+                    [p, p.midpoint(q), q].into_iter().all(|point| {
+                        edges0[i].iter().any(|edge| on_edge(point, edge))
+                            && edges1[j].iter().any(|edge| on_edge(point, edge))
+                    })
+                })
+                .then_some(())
+        })
+    })?;
+    Some(contacts)
+}
