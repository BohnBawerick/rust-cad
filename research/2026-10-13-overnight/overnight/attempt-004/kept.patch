+/// Test membership in a bounded curve, including the parameter interval.
+fn on_edge<C>(point: Point3, edge: &Edge<Point3, C>) -> bool
+where
+    C: BoundedCurve<Point = Point3> + SearchParameter<CurveParameter, Point = Point3> + Clone,
+{
+    let curve = edge.curve();
+    let (start, end) = curve.range_tuple();
+    curve
+        .search_parameter(point, None, 100)
+        .is_some_and(|t| t >= start && t <= end && curve.evaluate(t).near(&point))
+}
+
+/// Match complete trims in both directions, rather than just their vertices.
+fn matching_edges<C>(a: &Edge<Point3, C>, b: &Edge<Point3, C>, tol: f64) -> bool
+where
+    C: BoundedCurve<Point = Point3>
+        + SearchParameter<CurveParameter, Point = Point3>
+        + ParameterDivision1D<Point = Point3>
+        + Clone,
+{
+    let endpoints_match = (a.front().point().near(&b.front().point())
+        && a.back().point().near(&b.back().point()))
+        || (a.front().point().near(&b.back().point()) && a.back().point().near(&b.front().point()));
+    endpoints_match
+        && [(a, b), (b, a)].into_iter().all(|(source, target)| {
+            let curve = source.curve();
+            let (parameters, points) = curve.parameter_division(curve.range_tuple(), tol);
+            points.into_iter().all(|point| on_edge(point, target))
+                && parameters
+                    .windows(2)
+                    .all(|span| on_edge(curve.evaluate((span[0] + span[1]) / 2.0), target))
+        })
+}
