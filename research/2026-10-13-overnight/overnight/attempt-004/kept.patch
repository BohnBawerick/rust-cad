+/// Sew only the open seams left by removing shared patches.
+///
+/// Closed components retain their topology, including components meeting only
+/// at a vertex or an edge. Every seam needs one oppositely directed partner.
+fn sew_contacts<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: Shell<Point3, C, S>,
+    tol: f64,
+) -> Option<Shell<Point3, C, S>> {
+    let boundary: Vec<_> = shell.extract_boundaries().into_iter().flatten().collect();
+    if boundary.is_empty() {
+        return Some(shell);
+    }
+    let mut vertices = HashMap::default();
+    let mut representatives: Vec<Vertex<Point3>> = Vec::new();
+    boundary
+        .iter()
+        .flat_map(|edge| [edge.front(), edge.back()])
+        .for_each(|vertex| {
+            let representative = representatives
+                .iter()
+                .find(|other| vertex.point().near(&other.point()))
+                .cloned()
+                .unwrap_or_else(|| {
+                    representatives.push(vertex.clone());
+                    vertex.clone()
+                });
+            vertices.insert(vertex.id(), representative);
+        });
+    let mut replacements = HashMap::default();
+    boundary.iter().try_for_each(|edge| {
+        if replacements.contains_key(&edge.id()) {
+            return Some(());
+        }
+        let mut partners = boundary.iter().filter(|other| {
+            other.id() != edge.id()
+                && edge.front().point().near(&other.back().point())
+                && edge.back().point().near(&other.front().point())
+                && matching_edges(edge, other, tol)
+        });
+        let partner = partners.next()?;
+        if partners.next().is_some() || replacements.contains_key(&partner.id()) {
+            return None;
+        }
+        let joined = Edge::try_new(
+            vertices.get(&edge.front().id())?,
+            vertices.get(&edge.back().id())?,
+            edge.oriented_curve(),
+        )
+        .ok()?;
+        replacements.insert(
+            edge.id(),
+            if edge.orientation() {
+                joined.clone()
+            } else {
+                joined.inverse()
+            },
+        );
+        replacements.insert(
+            partner.id(),
+            if partner.orientation() {
+                joined.inverse()
+            } else {
+                joined
+            },
+        );
+        Some(())
+    })?;
+    shell
+        .iter()
+        .map(|face| {
+            let wires = face
+                .absolute_boundaries()
+                .iter()
+                .map(|wire| {
+                    wire.iter()
+                        .map(|edge| {
+                            if !replacements.contains_key(&edge.id()) {
+                                let front = edge.absolute_front();
+                                let back = edge.absolute_back();
+                                let rebuilt = Edge::try_new(
+                                    vertices.get(&front.id()).unwrap_or(front),
+                                    vertices.get(&back.id()).unwrap_or(back),
+                                    edge.curve(),
+                                )
+                                .ok()?;
+                                replacements.insert(edge.id(), rebuilt);
+                            }
+                            let rebuilt = replacements.get(&edge.id())?;
+                            Some(if edge.orientation() {
+                                rebuilt.clone()
+                            } else {
+                                rebuilt.inverse()
+                            })
+                        })
+                        .collect::<Option<Wire<_, _>>>()
+                })
+                .collect::<Option<Vec<_>>>()?;
+            let mut rebuilt = Face::try_new(wires, face.surface()).ok()?;
+            if !face.orientation() {
+                rebuilt.invert();
+            }
+            Some(rebuilt)
+        })
+        .collect()
+}
