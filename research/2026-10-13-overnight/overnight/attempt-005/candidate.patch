+/// Exact planar support and straight boundary segments of one input face.
+struct PlanarBoundary {
+    plane: Plane,
+    segments: Vec<(Point3, Point3)>,
+}
+
+/// Certify straight trims from the two incident support planes of every edge.
+///
+/// A valid edge on two nonparallel planes lies on their intersection line.
+/// Coplanar subdivisions and curved supports deliberately fail this certificate.
+/// Thus the vertices bound the entire trimmed face, not just a sampled mesh.
+fn planar_boundaries<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &Shell<Point3, C, S>,
+) -> Option<Vec<PlanarBoundary>> {
+    let mut incidence: HashMap<EdgeId<C>, (Vector3, usize)> = HashMap::default();
+    let faces = shell
+        .iter()
+        .map(|face| {
+            let surface = face.surface();
+            let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()?
+            else {
+                return None;
+            };
+            let normal = plane.normal();
+            // Verify the whole support, since an analytic recognizer may also
+            // identify nearly planar control nets within its modeling tolerance.
+            let spline = surface.try_into_homogeneous_bspline_surface()?;
+            if !spline.control_points().iter().flatten().all(|control| {
+                if !control.w.is_finite() || control.w == 0.0 {
+                    return false;
+                }
+                let (distance, error) =
+                    planar_projection(control.to_point(), plane.origin(), normal);
+                distance.is_finite() && error.is_finite() && distance.abs() <= error
+            }) {
+                return None;
+            }
+            let segments = face
+                .edge_iter()
+                .map(|edge| {
+                    if let Some((other, count)) = incidence.get_mut(&edge.id()) {
+                        if *count != 1 || normal.cross(*other).so_small() {
+                            return None;
+                        }
+                        *count += 1;
+                    } else {
+                        incidence.insert(edge.id(), (normal, 1));
+                    }
+                    Some((edge.front().point(), edge.back().point()))
+                })
+                .collect::<Option<Vec<_>>>()?;
+            (!segments.is_empty()).then_some(PlanarBoundary { plane, segments })
+        })
+        .collect::<Option<Vec<_>>>()?;
+    incidence
+        .values()
+        .all(|(_, count)| *count == 2)
+        .then_some(faces)
+}
+
+/// Project one point, accounting only for floating-point arithmetic roundoff.
+fn planar_projection(point: Point3, origin: Point3, axis: Vector3) -> (f64, f64) {
+    let distance = (point - origin).dot(axis);
+    let scale = (point.x.abs() + origin.x.abs()) * axis.x.abs()
+        + (point.y.abs() + origin.y.abs()) * axis.y.abs()
+        + (point.z.abs() + origin.z.abs()) * axis.z.abs();
+    (distance, 8.0 * f64::EPSILON * scale)
+}
+
+/// Projection bounds independent of the tessellation tolerance.
+fn planar_interval(face: &PlanarBoundary, origin: Point3, axis: Vector3) -> (f64, f64, f64) {
+    face.segments
+        .iter()
+        .map(|(point, _)| planar_projection(*point, origin, axis))
+        .fold(
+            (f64::INFINITY, f64::NEG_INFINITY, 0.0_f64),
+            |(min, max, error), (distance, roundoff)| {
+                (min.min(distance), max.max(distance), error.max(roundoff))
+            },
+        )
+}
