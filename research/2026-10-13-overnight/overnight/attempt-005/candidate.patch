+/// Certify that every face pair is disjoint or meets only on both boundaries.
+///
+/// Nonparallel faces must each stay on one side of the other's support.
+/// Coplanar faces need a separating in-plane axis. These are sufficient tests
+/// for arbitrary planar domains, including concave faces and multiple wires.
+/// Failure to find a certificate leaves subdivision to the ordinary pipeline.
+fn planar_boundary_contacts<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell0: &Shell<Point3, C, S>,
+    shell1: &Shell<Point3, C, S>,
+) -> Option<()> {
+    let faces0 = planar_boundaries(shell0)?;
+    let faces1 = planar_boundaries(shell1)?;
+    faces0.iter().try_for_each(|a| {
+        faces1.iter().try_for_each(|b| {
+            let normal0 = a.plane.normal();
+            let normal1 = b.plane.normal();
+            let (min0, max0, error0) = planar_interval(a, b.plane.origin(), normal1);
+            let (min1, max1, error1) = planar_interval(b, a.plane.origin(), normal0);
+            if min0 > error0 || max0 < -error0 || min1 > error1 || max1 < -error1 {
+                return Some(());
+            }
+            let parallel = normal0.cross(normal1).magnitude() <= 16.0 * f64::EPSILON;
+            let boundary_only = if parallel {
+                // Shared area cannot be removed without a common subdivision.
+                // A separating axis excludes positive-area overlap even for concave faces.
+                a.segments.iter().chain(&b.segments).any(|(start, end)| {
+                    let axis = normal0.cross(*end - *start);
+                    if axis.magnitude2() == 0.0 {
+                        return false;
+                    }
+                    let (min0, max0, error0) = planar_interval(a, *start, axis);
+                    let (min1, max1, error1) = planar_interval(b, *start, axis);
+                    max0.min(max1) - min0.max(min1) <= error0 + error1
+                })
+            } else {
+                (min0 >= -error0 || max0 <= error0) && (min1 >= -error1 || max1 <= error1)
+            };
+            boundary_only.then_some(())
         })
     })
 }
