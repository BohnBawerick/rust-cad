+/// Assemble one common arrangement of the exact input support planes.
+///
+/// This fallback runs only after the marching pipeline fails. It retains the
+/// input surfaces and constructs exact straight trims. No tessellation enters
+/// classification or output geometry. A bounded work counter limits refinement.
+fn planar_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let mut work = 262_144_usize;
+    let mut projections = 2048_usize;
+    let mut cells = planar_cells(solid0, &mut work)?;
+    let first_len = cells.len();
+    cells.extend(planar_cells(solid1, &mut work)?);
+    let mut retained = Vec::new();
+    cells.iter().enumerate().try_for_each(|(index, source)| {
+        let pieces = cells
+            .iter()
+            .try_fold(vec![source.points.clone()], |pieces, plane| {
+                pieces
+                    .into_iter()
+                    .try_fold(Vec::new(), |mut divided, points| {
+                        work = work.checked_sub(points.len())?;
+                        divided.extend(split_planar_cell(points, plane.points[0], plane.normal));
+                        Some(divided)
+                    })
+            })?;
+        let first = index < first_len;
+        let other = if first {
+            &cells[first_len..]
+        } else {
+            &cells[..first_len]
+        };
+        pieces.into_iter().try_for_each(|mut points| {
+            if points.len() < 3 {
+                return None;
+            }
+            let point = points[0]
+                + points.iter().map(|p| *p - points[0]).sum::<Vector3>() / points.len() as f64;
+            work = work.checked_sub(other.iter().map(|cell| cell.points.len()).sum())?;
+            let shared = other.iter().find(|cell| {
+                let (distance, error) = plane_distance(point, cell.points[0], cell.normal);
+                distance.abs() <= error && planar_domain(&cell.points, cell.normal, point) >= 0
+            });
+            let keep = if let Some(shared) = shared {
+                // Arrangement cells must lie in the relative interior of a shared patch.
+                if planar_domain(&shared.points, shared.normal, point) != 1
+                    || source.normal.cross(shared.normal).magnitude() > 32.0 * f64::EPSILON
+                {
+                    return None;
+                }
+                let same = source.normal.dot(shared.normal) > 0.0;
+                first
+                    && match operation {
+                        Operation::Union | Operation::Intersection => same,
+                        Operation::Difference => !same,
+                    }
+            } else {
+                let inside = planar_inside(point, other)?;
+                match operation {
+                    Operation::Union => !inside,
+                    Operation::Intersection => inside,
+                    Operation::Difference => inside != first,
+                }
+            };
+            if keep {
+                let invert = !first && matches!(operation, Operation::Difference);
+                if invert {
+                    points.reverse();
+                }
+                retained.push((index, source.orientation != invert, points));
+            }
+            Some(())
+        })
+    })?;
+
+    // Share geometric vertices before constructing any edges. The threshold
+    // accounts for arithmetic roundoff only, never the Boolean tolerance.
+    let scale = cells
+        .iter()
+        .flat_map(|cell| &cell.points)
+        .fold(1.0_f64, |scale, p| {
+            scale.max(p.x.abs()).max(p.y.abs()).max(p.z.abs())
+        });
+    let roundoff = 128.0 * f64::EPSILON * scale;
+    let mut vertices: Vec<Vertex<Point3>> = Vec::new();
+    let indexed = retained
+        .into_iter()
+        .map(|(source, orientation, points)| {
+            let indices = points
+                .into_iter()
+                .map(|point| {
+                    work = work.checked_sub(vertices.len())?;
+                    let index = vertices
+                        .iter()
+                        .position(|vertex| vertex.point().distance2(point) <= roundoff * roundoff);
+                    Some(index.unwrap_or_else(|| {
+                        vertices.push(Vertex::new(point));
+                        vertices.len() - 1
+                    }))
+                })
+                .collect::<Option<Vec<_>>>()?;
+            Some((source, orientation, indices))
+        })
+        .collect::<Option<Vec<_>>>()?;
+    let mut edges: HashMap<(usize, usize), (Edge<Point3, C>, usize, usize)> = HashMap::default();
+    let shell = indexed
+        .into_iter()
+        .map(|(source, orientation, indices)| {
+            let cell = &cells[source];
+            let wire = indices
+                .iter()
+                .zip(indices.iter().cycle().skip(1))
+                .map(|(&a, &b)| {
+                    if a == b {
+                        return None;
+                    }
+                    let key = (a.min(b), a.max(b));
+                    if let Some((edge, start, count)) = edges.get_mut(&key) {
+                        // More than two incident faces, or equal directions, is
+                        // independently detected nonmanifold output geometry.
+                        if *count != 1 || *start == a {
+                            return None;
+                        }
+                        *count = 2;
+                        Some(edge.inverse())
+                    } else {
+                        let front = vertices[a].point();
+                        let back = vertices[b].point();
+                        work = work.checked_sub(cells.len())?;
+                        let support = cells.iter().find_map(|other| {
+                            if cell.normal.cross(other.normal).so_small() {
+                                return None;
+                            }
+                            [front, front.midpoint(back), back]
+                                .into_iter()
+                                .try_for_each(|p| {
+                                    let (distance, error) =
+                                        plane_distance(p, other.points[0], other.normal);
+                                    if distance.abs() > error {
+                                        return None;
+                                    }
+                                    projections = projections.checked_sub(1)?;
+                                    other.surface.search_parameter(p, None, 100).map(|_| ())
+                                })?;
+                            Some(other)
+                        })?;
+                        let leader = BsplineCurve::from(Line(front, back));
+                        let boundary0: Option<ParameterCurve<BoundaryCurve2D, S>> = None;
+                        let boundary1: Option<ParameterCurve<BoundaryCurve2D, S>> = None;
+                        let curve = SurfaceCurve::with_boundaries(
+                            cell.surface.clone(),
+                            support.surface.clone(),
+                            leader,
+                            boundary0,
+                            boundary1,
+                        )
+                        .into();
+                        let edge = Edge::try_new(&vertices[a], &vertices[b], curve).ok()?;
+                        if !edge.is_geometric_consistent() {
+                            return None;
+                        }
+                        edges.insert(key, (edge.clone(), a, 1));
+                        Some(edge)
+                    }
+                })
+                .collect::<Option<Wire<_, _>>>()?;
+            let wire = if orientation { wire } else { wire.inverse() };
+            let mut face = Face::try_new(vec![wire], cell.surface.clone()).ok()?;
+            if !orientation {
+                face.invert();
+            }
+            Some(face)
+        })
+        .collect::<Option<Shell<_, _, _>>>()?;
+    if edges.values().any(|(_, _, count)| *count != 2) {
+        None
+    } else {
+        Solid::try_new(shell.connected_components()).ok()
+    }
+}
