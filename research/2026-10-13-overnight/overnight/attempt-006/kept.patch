+/// A certified convex planar face, with its material-side orientation.
+struct PlanarCell<S> {
+    surface: S,
+    orientation: bool,
+    normal: Vector3,
+    points: Vec<Point3>,
+}
+
+/// Bound arithmetic roundoff in a plane predicate, independently of meshing tolerance.
+fn plane_distance(point: Point3, origin: Point3, normal: Vector3) -> (f64, f64) {
+    let scale = (point.x.abs() + origin.x.abs()) * normal.x.abs()
+        + (point.y.abs() + origin.y.abs()) * normal.y.abs()
+        + (point.z.abs() + origin.z.abs()) * normal.z.abs();
+    ((point - origin).dot(normal), 32.0 * f64::EPSILON * scale)
+}
+
+/// Test a convex planar domain: negative outside, zero on its boundary, positive inside.
+fn planar_domain(points: &[Point3], normal: Vector3, point: Point3) -> i8 {
+    points
+        .iter()
+        .zip(points.iter().cycle().skip(1))
+        .fold(1, |state, (a, b)| {
+            let (distance, error) = plane_distance(point, *a, normal.cross(*b - *a));
+            state.min(if distance < -error {
+                -1
+            } else if distance > error {
+                1
+            } else {
+                0
+            })
+        })
+}
+
+/// Certify entire supports and straight trims, not just a vertex bounding box.
+///
+/// The control net proves planarity. Each trim belongs to two nonparallel
+/// planes and therefore is a line segment for a valid simple input boundary.
+/// Convex faces suffice; the solid may be nonconvex and have oriented cavities.
+fn planar_cells<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    work: &mut usize,
+) -> Option<Vec<PlanarCell<S>>> {
+    let mut incidence: HashMap<EdgeId<C>, (Vector3, usize)> = HashMap::default();
+    let cells = solid
+        .face_iter()
+        .map(|face| {
+            if face.absolute_boundaries().len() != 1 {
+                return None;
+            }
+            let edge_count = face.edge_iter().count();
+            *work = work.checked_sub(edge_count.checked_mul(edge_count)?)?;
+            let surface = face.surface();
+            let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()?
+            else {
+                return None;
+            };
+            let spline = surface.try_into_homogeneous_bspline_surface()?;
+            *work = work.checked_sub(spline.control_points().iter().map(Vec::len).sum())?;
+            if !spline.control_points().iter().flatten().all(|control| {
+                if !control.w.is_finite() || control.w == 0.0 {
+                    return false;
+                }
+                let (distance, error) =
+                    plane_distance(control.to_point(), plane.origin(), plane.normal());
+                distance.is_finite() && error.is_finite() && distance.abs() <= error
+            }) {
+                return None;
+            }
+            let points = face
+                .edge_iter()
+                .map(|edge| {
+                    let entry = incidence.entry(edge.id()).or_insert((plane.normal(), 0));
+                    if entry.1 > 1 || (entry.1 == 1 && entry.0.cross(plane.normal()).so_small()) {
+                        return None;
+                    }
+                    entry.1 += 1;
+                    Some(edge.front().point())
+                })
+                .collect::<Option<Vec<_>>>()?;
+            if points.len() < 3 {
+                return None;
+            }
+            let area = points[1..].windows(2).fold(Vector3::zero(), |sum, pair| {
+                sum + (pair[0] - points[0]).cross(pair[1] - points[0])
+            });
+            let normal = plane.normal() * area.dot(plane.normal()).signum();
+            if !area.magnitude2().is_finite()
+                || area.magnitude2() == 0.0
+                || !points.iter().all(|point| {
+                    let (distance, error) = plane_distance(*point, plane.origin(), normal);
+                    distance.abs() <= error && planar_domain(&points, normal, *point) >= 0
+                })
+            {
+                return None;
+            }
+            Some(PlanarCell {
+                surface,
+                orientation: face.orientation(),
+                normal,
+                points,
+            })
+        })
+        .collect::<Option<Vec<_>>>()?;
+    incidence
+        .values()
+        .all(|(_, count)| *count == 2)
+        .then_some(cells)
+}
+
+/// Subdivide an exact convex planar domain without discarding small-area cells.
+fn split_planar_cell(points: Vec<Point3>, origin: Point3, normal: Vector3) -> Vec<Vec<Point3>> {
+    let distances: Vec<_> = points
+        .iter()
+        .map(|point| {
+            let (distance, error) = plane_distance(*point, origin, normal);
+            if distance.abs() <= error {
+                0.0
+            } else {
+                distance
+            }
+        })
+        .collect();
+    if !distances.iter().any(|d| *d < 0.0) || !distances.iter().any(|d| *d > 0.0) {
+        vec![points]
+    } else {
+        [-1.0, 1.0]
+            .into_iter()
+            .map(|side| {
+                (0..points.len())
+                    .flat_map(|i| {
+                        let j = (i + 1) % points.len();
+                        let crossing = distances[i] * distances[j] < 0.0;
+                        let point = (distances[i] * side >= 0.0).then_some(points[i]);
+                        let cut = crossing.then(|| {
+                            points[i]
+                                + (points[j] - points[i])
+                                    * (distances[i] / (distances[i] - distances[j]))
+                        });
+                        point.into_iter().chain(cut)
+                    })
+                    .collect()
+            })
+            .collect()
+    }
+}
+
+/// Sum exact planar ray crossings over all oriented shells.
+fn planar_inside<S>(point: Point3, cells: &[PlanarCell<S>]) -> Option<bool> {
+    [
+        Vector3::new(1.0, 0.371, 0.529),
+        Vector3::new(0.239, 1.0, 0.713),
+        Vector3::new(0.617, 0.419, 1.0),
+    ]
+    .into_iter()
+    .find_map(|direction| {
+        let winding = cells.iter().try_fold(0_isize, |winding, cell| {
+            let denominator = cell.normal.dot(direction);
+            if denominator.abs() <= 32.0 * f64::EPSILON {
+                return None;
+            }
+            let parameter = (cell.points[0] - point).dot(cell.normal) / denominator;
+            if parameter <= 0.0 {
+                Some(winding)
+            } else {
+                match planar_domain(&cell.points, cell.normal, point + direction * parameter) {
+                    -1 => Some(winding),
+                    0 => None,
+                    _ => Some(winding + if denominator > 0.0 { 1 } else { -1 }),
+                }
+            }
+        })?;
+        match winding {
+            0 => Some(false),
+            1 => Some(true),
+            _ => None,
+        }
+    })
+}
