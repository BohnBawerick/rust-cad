+    impl ParameterKind {
+        fn try_new(t: f64, (t0, t1): (f64, f64)) -> Option<ParameterKind> {
+            if t0.near(&t) {
+                Some(ParameterKind::Front)
+            } else if t1.near(&t) {
+                Some(ParameterKind::Back)
+            } else if t0 < t && t < t1 {
+                Some(ParameterKind::Inner(t))
+            } else {
+                None
+            }
+        }
+    }
