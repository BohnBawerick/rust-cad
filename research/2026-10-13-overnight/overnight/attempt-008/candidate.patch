+    /// Find a complete existing trim chain with the same polygonal trace.
+    ///
+    /// Polygons locate topology only. Reused curves must also lie on the other
+    /// exact support. Both directions are checked to exclude a complementary arc.
+    fn boundary_chain<C, S>(
+        polygons: &Loops<Point3, PolylineCurve>,
+        geometry: &Loops<Point3, C>,
+        front: &Vertex<Point3>,
+        back: &Vertex<Point3>,
+        trace: &PolylineCurve,
+        support: &S,
+        tol: f64,
+        work: &mut usize,
+    ) -> Option<Option<(Wire<Point3, PolylineCurve>, Wire<Point3, C>)>>
+    where
+        C: BoundedCurve<Point = Point3> + ParameterDivision1D<Point = Point3> + Clone,
+        S: ShapeOpsSurface,
+    {
+        for (poly, geom) in polygons.iter().zip(geometry.iter()) {
+            if poly.len() != geom.len() {
+                return None;
+            }
+            for reverse in [false, true] {
+                let poly = if reverse {
+                    poly.wire.inverse()
+                } else {
+                    poly.wire.clone()
+                };
+                let geom = if reverse {
+                    geom.wire.inverse()
+                } else {
+                    geom.wire.clone()
+                };
+                for start in 0..poly.len() {
+                    *work = work.checked_sub(1)?;
+                    if poly[start].front() != front {
+                        continue;
+                    }
+                    let length = (0..poly.len())
+                        .position(|offset| poly[(start + offset) % poly.len()].back() == back);
+                    let Some(length) = length.map(|offset| offset + 1) else {
+                        continue;
+                    };
+                    *work = work.checked_sub(length.checked_mul(trace.len())?)?;
+                    let indices = (0..length).map(|offset| (start + offset) % poly.len());
+                    let candidate: Wire<_, _> = indices.clone().map(|i| poly[i].clone()).collect();
+                    let on_trace = candidate.iter().all(|edge| {
+                        edge.curve().windows(2).all(|span| {
+                            [span[0], span[0].midpoint(span[1]), span[1]]
+                                .into_iter()
+                                .all(|point| trace.search_parameter(point, None, 100).is_some())
+                        })
+                    });
+                    let covers_trace = trace.windows(2).all(|span| {
+                        [span[0], span[0].midpoint(span[1]), span[1]]
+                            .into_iter()
+                            .all(|point| {
+                                candidate.iter().any(|edge| {
+                                    edge.curve().search_parameter(point, None, 100).is_some()
+                                })
+                            })
+                    });
+                    if !on_trace || !covers_trace {
+                        continue;
+                    }
+                    let exact: Wire<_, _> = indices.map(|i| geom[i].clone()).collect();
+                    let certified = exact.iter().try_fold(true, |valid, edge| {
+                        let curve = edge.curve();
+                        let (parameters, points) =
+                            curve.parameter_division(curve.range_tuple(), tol);
+                        *work = work.checked_sub(points.len().checked_add(parameters.len())?)?;
+                        Some(
+                            valid
+                                && points
+                                    .into_iter()
+                                    .chain(
+                                        parameters
+                                            .windows(2)
+                                            .map(|span| curve.evaluate((span[0] + span[1]) / 2.0)),
+                                    )
+                                    .all(|point| {
+                                        support.search_parameter(point, None, 100).is_some_and(
+                                            |(u, v)| support.evaluate(u, v).near(&point),
+                                        )
+                                    }),
+                        )
+                    })?;
+                    if certified {
+                        return Some(Some((candidate, exact)));
+                    }
+                }
+            }
+        }
+        Some(None)
+    }
