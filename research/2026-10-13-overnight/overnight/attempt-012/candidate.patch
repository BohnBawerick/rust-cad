+/// Certify a common support on a complete convex arrangement patch.
+///
+/// Unit normals computed from short edges amplify coordinate cancellation.
+/// Comparing their angle therefore needlessly rejects thin coplanar faces.
+/// Three noncollinear points determine a plane. Testing the whole patch in both
+/// supports uses subdivision's coordinate error bounds without extrapolating a
+/// short edge's normal across an unrelated, much larger face.
+fn coplanar_patch<S>(points: &[Point3], first: &PlanarCell<S>, second: &PlanarCell<S>) -> bool {
+    let area = points[1..].windows(2).fold(Vector3::zero(), |sum, pair| {
+        sum + (pair[0] - points[0]).cross(pair[1] - points[0])
+    });
+    area.magnitude2().is_finite()
+        && area.magnitude2() > 0.0
+        && [first, second].into_iter().all(|plane| {
+            points.iter().all(|point| {
+                let (distance, error) = plane_distance(*point, plane.points[0], plane.normal);
+                distance.is_finite() && error.is_finite() && distance.abs() <= error
+            })
+        })
+}
