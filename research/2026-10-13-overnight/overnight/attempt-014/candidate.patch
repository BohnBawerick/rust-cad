+/// Prove that a certified supporting plane contains no open boundary patch.
+///
+/// On an open knot rectangle every active B-spline basis function is positive.
+/// With positive rational weights, one strictly interior control point therefore
+/// puts the whole open rectangle strictly inside the supporting half-space.
+/// Contacts can remain on knot lines, but cannot have positive surface area.
+/// The caller must first certify the complete solid enclosure.
+fn no_support_patch<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    axis: usize,
+    coordinate: f64,
+    upper: bool,
+    work: &mut usize,
+) -> Option<()> {
+    solid.face_iter().try_for_each(|face| {
+        *work = work.checked_sub(1)?;
+        let surface = face.surface();
+        if surface.supports_exact_patch_domains() {
+            let spline = surface.try_into_homogeneous_bspline_surface()?;
+            let controls = spline.control_points();
+            let (udegree, vdegree) = spline.degrees();
+            let (uknots, vknots) = spline.knot_vectors();
+            let rows = controls.len();
+            let columns = controls.first()?.len();
+            if !spline.is_clamped() || rows <= udegree || columns <= vdegree {
+                return None;
+            }
+            *work = work.checked_sub(rows.checked_mul(columns)?)?;
+            let distance = |control: &Vector4| {
+                let value = control.to_point()[axis];
+                if upper {
+                    coordinate - value
+                } else {
+                    value - coordinate
+                }
+            };
+            if !controls.iter().flatten().all(|control| {
+                let distance = distance(control);
+                control.w.is_finite() && control.w > 0.0 && distance.is_finite() && distance >= 0.0
+            }) {
+                return None;
+            }
+            (udegree..rows)
+                .filter(|&u| uknots[u] < uknots[u + 1])
+                .try_for_each(|u| {
+                    (vdegree..columns)
+                        .filter(|&v| vknots[v] < vknots[v + 1])
+                        .try_for_each(|v| {
+                            *work = work.checked_sub((udegree + 1).checked_mul(vdegree + 1)?)?;
+                            controls[u - udegree..=u]
+                                .iter()
+                                .flat_map(|row| &row[v - vdegree..=v])
+                                .any(|control| distance(control) > 0.0)
+                                .then_some(())
+                        })
+                })
+        } else if let Some(AnalyticSurfaceKind::Plane(plane)) =
+            surface.try_into_analytic_surface_kind()
+        {
+            // An unbounded plane needs no trim enclosure for this test: distinct
+            // planes intersect in at most a line, even when their trims overlap.
+            let mut normal = Vector3::zero();
+            normal[axis] = 1.0;
+            let origin = Point3::origin() + normal * coordinate;
+            let (distance, error) = plane_distance(plane.origin(), origin, normal);
+            (!plane.normal().cross(normal).so_small()
+                || (distance.is_finite() && error.is_finite() && distance.abs() > error))
+                .then_some(())
+        } else {
+            None
+        }
+    })
+}
