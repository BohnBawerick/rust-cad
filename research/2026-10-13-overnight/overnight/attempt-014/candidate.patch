+/// Assemble a union whose certified contact has no two-dimensional patch.
+///
+/// Weakly separated interiors have additive oriented boundaries unless a shared
+/// face becomes internal to their union. Ruling out such a face on either operand
+/// makes their original closed shells the regularized union boundary, including
+/// all cavities. Point and curve contacts retain separate topological shells.
+fn touching_union<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+) -> Option<Solid<Point3, C, S>> {
+    let (min0, max0) = solid_enclosure(solid0)?;
+    let (min1, max1) = solid_enclosure(solid1)?;
+    let mut work = 65_536_usize;
+    let certified = (0..3).any(|axis| {
+        [
+            (solid0, max0[axis], solid1, min1[axis]),
+            (solid1, max1[axis], solid0, min0[axis]),
+        ]
+        .into_iter()
+        .any(|(left, upper, right, lower)| {
+            upper <= lower
+                && (no_support_patch(left, axis, upper, true, &mut work).is_some()
+                    || no_support_patch(right, axis, lower, false, &mut work).is_some())
+        })
+    });
+    if certified {
+        Solid::try_new(
+            solid0
+                .boundaries()
+                .iter()
+                .chain(solid1.boundaries())
+                .cloned()
+                .collect(),
+        )
+        .ok()
+    } else {
+        None
+    }
+}
