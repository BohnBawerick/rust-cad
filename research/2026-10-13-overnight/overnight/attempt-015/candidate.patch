+/// Accumulate the oriented boundary chain of a face partition.
+fn add_wire_chain<C>(chain: &mut HashMap<EdgeId<C>, isize>, wire: &Wire<Point3, C>) {
+    wire.iter().for_each(|edge| {
+        *chain.entry(edge.id()).or_default() += if edge.orientation() { 1 } else { -1 };
+    });
+}
