+/// A loop projected into its original support, retaining the exact trim edges.
+struct DivisionLoop<C> {
+    wire: Wire<Point3, C>,
+    status: ShapesOpStatus,
+    polygon: PolylineCurve<Point2>,
+    area: f64,
+}
+
+/// Recover a subdivision from loop orientation and nesting, without area pruning.
+///
+/// A geometric length tolerance is not a measure of area in a surface chart.
+/// The chart only determines orientation and nesting here; all output edges and
+/// surfaces remain the original geometry. Opposite copies of an internal loop
+/// bound adjacent cells and must not cancel solely because their areas agree.
+fn complete_face_division<C, S>(
+    face: &Face<Point3, C, S>,
+    loops: &Loops<Point3, C>,
+    tol: f64,
+    work: &mut usize,
+) -> Option<FacesClassification<Point3, C, S>>
+where
+    C: BoundedCurve<Point = Point3> + ParameterDivision1D<Point = Point3> + Clone,
+    S: ShapeOpsSurface,
+{
+    let surface = face.surface();
+    let mut samples: HashMap<EdgeId<C>, Vec<Point3>> = HashMap::default();
+    let projected = loops
+        .iter()
+        .map(|boundary| {
+            let wire: Wire<Point3, C> = (**boundary).clone();
+            if !wire.is_closed() || !wire.is_simple() {
+                return None;
+            }
+            let start = surface.search_parameter(wire.front_vertex()?.point(), None, 100)?;
+            let points = wire
+                .iter()
+                .try_fold(vec![Point2::from(start)], |mut points, edge| {
+                    let sampled = samples.entry(edge.id()).or_insert_with(|| {
+                        let curve = edge.curve();
+                        curve.parameter_division(curve.range_tuple(), tol).1
+                    });
+                    *work = work.checked_sub(sampled.len())?;
+                    let mut hint = *points.last()?;
+                    let mut project = |point: &Point3| {
+                        hint = surface
+                            .search_parameter(*point, Some(hint.into()), 100)?
+                            .into();
+                        Some(hint)
+                    };
+                    let next = if edge.orientation() {
+                        sampled
+                            .iter()
+                            .skip(1)
+                            .map(&mut project)
+                            .collect::<Option<Vec<_>>>()?
+                    } else {
+                        sampled
+                            .iter()
+                            .rev()
+                            .skip(1)
+                            .map(&mut project)
+                            .collect::<Option<Vec<_>>>()?
+                    };
+                    points.extend(next);
+                    Some(points)
+                })?;
+            let origin = *points.first()?;
+            // A closed spatial loop must also close in this local chart. A
+            // periodic seam requiring another chart is not repaired here.
+            if !origin.near(points.last()?) {
+                return None;
+            }
+            let (area, magnitude) =
+                points
+                    .windows(2)
+                    .fold((0.0, 0.0), |(area, magnitude), pair| {
+                        let a = pair[0] - origin;
+                        let b = pair[1] - origin;
+                        (
+                            area + a.x * b.y - a.y * b.x,
+                            magnitude + (a.x * b.y).abs() + (a.y * b.x).abs(),
+                        )
+                    });
+            // This bounds arithmetic uncertainty, not a geometric feature size.
+            if !area.is_finite() || area.abs() <= 16.0 * f64::EPSILON * magnitude {
+                return None;
+            }
+            Some(DivisionLoop {
+                wire,
+                status: boundary.status(),
+                polygon: PolylineCurve(points),
+                area,
+            })
+        })
+        .collect::<Option<Vec<_>>>()?;
+    let mut regions: Vec<_> = projected
+        .iter()
+        .enumerate()
+        .filter(|(_, boundary)| boundary.area > 0.0)
+        .map(|(index, _)| vec![index])
+        .collect();
+    projected
+        .iter()
+        .enumerate()
+        .filter(|(_, boundary)| boundary.area < 0.0)
+        .try_for_each(|(index, hole)| {
+            // Exclude the opposite copy of the same cut. Its negative copy is
+            // a hole in the enclosing cell, not a cancellation of its own cell.
+            let owner =
+                regions
+                    .iter()
+                    .enumerate()
+                    .try_fold(None, |owner, (region, indices)| {
+                        let outer = &projected[indices[0]];
+                        *work = work.checked_sub(outer.wire.len().checked_mul(hole.wire.len())?)?;
+                        let same = outer.wire.len() == hole.wire.len()
+                            && outer
+                                .wire
+                                .iter()
+                                .all(|edge| hole.wire.iter().any(|other| edge.id() == other.id()));
+                        *work = work.checked_sub(outer.polygon.len())?;
+                        let contains = !same && outer.polygon.include(hole.polygon.front());
+                        Some(
+                            if contains
+                                && owner.is_none_or(|previous: usize| {
+                                    outer.area < projected[regions[previous][0]].area
+                                })
+                            {
+                                Some(region)
+                            } else {
+                                owner
+                            },
+                        )
+                    })??;
+            regions[owner].push(index);
+            Some(())
+        })?;
+    let mut result = FacesClassification::default();
+    regions.into_iter().try_for_each(|indices| {
+        let status = indices
+            .iter()
+            .try_fold(ShapesOpStatus::Unknown, |status, &index| {
+                let next = projected[index].status;
+                if status == ShapesOpStatus::Unknown {
+                    Some(next)
+                } else if next == ShapesOpStatus::Unknown || next == status {
+                    Some(status)
+                } else {
+                    None
+                }
+            })?;
+        let wires = indices
+            .into_iter()
+            .map(|index| projected[index].wire.clone())
+            .collect();
+        let mut divided = Face::try_new(wires, surface.clone()).ok()?;
+        if !face.orientation() {
+            divided.invert();
+        }
+        result.push(divided, status);
+        Some(())
+    })?;
+    Some(result)
+}
+
+/// Require subdivision to conserve each source face's oriented boundary chain.
+///
+/// Internal cuts occur twice with opposite orientations. Their cancellation
+/// leaves exactly the source boundary, independently of chart scale and Boolean
+/// classification. Retry only a division that violates this discrete invariant.
+fn divide_complete_faces<C, S>(
+    shell: &Shell<Point3, C, S>,
+    store: &LoopsStore<Point3, C>,
+    tol: f64,
+    recovered: &mut bool,
+) -> Option<FacesClassification<Point3, C, S>>
+where
+    C: BoundedCurve<Point = Point3> + ParameterDivision1D<Point = Point3> + Clone,
+    S: ShapeOpsSurface,
+{
+    let mut result = FacesClassification::default();
+    let mut work = 65_536_usize;
+    shell.iter().zip(store).try_for_each(|(face, loops)| {
+        if loops
+            .iter()
+            .all(|wire| wire.status() == ShapesOpStatus::Unknown)
+        {
+            result.push(face.clone(), ShapesOpStatus::Unknown);
+            return Some(());
+        }
+        let mut expected = HashMap::default();
+        loops
+            .iter()
+            .for_each(|wire| add_wire_chain(&mut expected, wire));
+        expected.retain(|_, count| *count != 0);
+        let conserves_boundary = |classification: &FacesClassification<Point3, C, S>| {
+            let mut actual = HashMap::default();
+            classification
+                .and_or_unknown()
+                .iter()
+                .flatten()
+                .for_each(|face| {
+                    face.absolute_boundaries()
+                        .iter()
+                        .for_each(|wire| add_wire_chain(&mut actual, wire));
+                });
+            actual.retain(|_, count| *count != 0);
+            actual == expected
+        };
+        let one_shell = iter::once(face.clone()).collect();
+        let mut one_store: LoopsStore<_, _> = iter::once(face).collect();
+        one_store[0] = loops.clone();
+        let classification = divide_face::divide_faces(&one_shell, &one_store, tol)
+            .filter(&conserves_boundary)
+            .or_else(|| {
+                let classification = complete_face_division(face, loops, tol, &mut work)?;
+                *recovered = true;
+                Some(classification)
+            })
+            .filter(conserves_boundary)?;
+        classification
+            .and_or_unknown()
+            .into_iter()
+            .zip([
+                ShapesOpStatus::And,
+                ShapesOpStatus::Or,
+                ShapesOpStatus::Unknown,
+            ])
+            .for_each(|(shell, status)| {
+                shell.into_iter().for_each(|face| result.push(face, status));
+            });
+        Some(())
+    })?;
+    Some(result)
+}
