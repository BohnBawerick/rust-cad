+/// Express a straight trim directly in a certified affine parameter chart.
+///
+/// A single bilinear patch with equal positive weights is affine precisely
+/// when its mixed coefficient vanishes. Check the complete control net and
+/// knot multiplicities, rather than inferring linearity from surface samples.
+/// The arithmetic allowance is the same roundoff bound used for plane tests.
+fn affine_planar_trim<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    surface: &S,
+    front: Point3,
+    back: Point3,
+) -> Option<C> {
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    let rows = spline.control_points();
+    if spline.udegree() != 1
+        || spline.vdegree() != 1
+        || rows.len() != 2
+        || rows.iter().any(|row| row.len() != 2)
+    {
+        return None;
+    }
+    let weight = rows[0][0].w;
+    if !weight.is_finite() || weight <= 0.0 || rows.iter().flatten().any(|point| point.w != weight)
+    {
+        return None;
+    }
+    let clamped = |knots: &KnotVector| {
+        knots.len() == 4
+            && knots[0].is_finite()
+            && knots[3].is_finite()
+            && knots[0] == knots[1]
+            && knots[2] == knots[3]
+            && knots[0] < knots[3]
+    };
+    if !clamped(spline.knot_vector_u()) || !clamped(spline.knot_vector_v()) {
+        return None;
+    }
+    let p00 = rows[0][0].to_point();
+    let p01 = rows[0][1].to_point();
+    let p10 = rows[1][0].to_point();
+    let p11 = rows[1][1].to_point();
+    let mixed = (p11 - p10) - (p01 - p00);
+    let scale = [p00, p01, p10, p11]
+        .into_iter()
+        .map(|point| point.to_vec().map(f64::abs))
+        .sum::<Vector3>();
+    if ![mixed.x, mixed.y, mixed.z]
+        .into_iter()
+        .zip([scale.x, scale.y, scale.z])
+        .all(|(coefficient, scale)| {
+            coefficient.is_finite()
+                && scale.is_finite()
+                && coefficient.abs() <= 32.0 * f64::EPSILON * scale
+        })
+    {
+        return None;
+    }
+    let start = surface.search_parameter(front, None, 100)?;
+    let end = surface.search_parameter(back, Some(start), 100)?;
+    let curve = ParameterCurve::new(
+        Line(Point2::from(start), Point2::from(end)),
+        surface.clone(),
+    );
+    if curve.front().near(&front) && curve.back().near(&back) {
+        C::try_from(curve).ok()
+    } else {
+        None
+    }
+}
