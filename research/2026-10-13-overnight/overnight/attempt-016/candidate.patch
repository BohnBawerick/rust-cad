+/// Restrict an original straight trim to an arrangement segment.
+///
+/// This is used only after complete planar support and incidence certification.
+/// Thus membership of both endpoints in a trim also proves membership of the
+/// whole segment. Cutting the original curve retains its exact representation.
+fn source_planar_trim<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    face: &Face<Point3, C, S>,
+    front: Point3,
+    back: Point3,
+) -> Option<C> {
+    face.edge_iter().find_map(|edge| {
+        let mut curve = edge.curve();
+        let (start, end) = curve.range_tuple();
+        let a = curve.search_parameter(front, None, 100)?;
+        let b = curve.search_parameter(back, None, 100)?;
+        if !a.is_finite()
+            || !b.is_finite()
+            || a == b
+            || a.min(b) < start
+            || a.max(b) > end
+            || !curve.evaluate(a).near(&front)
+            || !curve.evaluate(b).near(&back)
+        {
+            return None;
+        }
+        if a.max(b) < end {
+            let _ = curve.cut(a.max(b));
+        }
+        // `Cut` may reparameterize the retained prefix, as a line does.
+        // Locate the second cut again in the current parameter interval.
+        let lower_point = if a < b { front } else { back };
+        let lower = curve.search_parameter(lower_point, None, 100)?;
+        let (start, end) = curve.range_tuple();
+        if !lower.is_finite() || lower < start || lower >= end {
+            return None;
+        }
+        if lower > start {
+            curve = curve.cut(lower);
+        }
+        if a > b {
+            curve.invert();
+        }
+        (curve.front().near(&front) && curve.back().near(&back)).then_some(curve)
+    })
+}
