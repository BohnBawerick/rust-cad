+/// Recover a failed arrangement at common supporting planes.
+///
+/// Supporting planes cannot cut either interior. March only the remaining
+/// faces, then close their selected boundary chains on the common planes.
+/// Only certified affine intersection traces are accepted in this recovery.
+fn capped_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    tol: f64,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let enclosure0 = solid_enclosure(solid0)?;
+    let enclosure1 = solid_enclosure(solid1)?;
+    let shell0: Shell<Point3, C, S> = solid0.face_iter().cloned().collect();
+    let mut shell1: Shell<Point3, C, S> = solid1.face_iter().cloned().collect();
+    if shell0.len().checked_mul(shell1.len())? > 4096 {
+        return None;
+    }
+    let mut caps: Vec<(S, Plane, i8)> = Vec::new();
+    shell0.iter().for_each(|face| {
+        let surface = face.surface();
+        if let Some(plane) = support_plane(&surface) {
+            let side = enclosure_side(enclosure0, &plane);
+            if side.is_some()
+                && side == enclosure_side(enclosure1, &plane)
+                && shell1
+                    .iter()
+                    .any(|other| in_support_plane(&other.surface(), &plane))
+                && !caps
+                    .iter()
+                    .any(|(_, other, _)| in_support_plane(&surface, other))
+            {
+                if let Some(side) = side {
+                    caps.push((surface, plane, side));
+                }
+            }
+        }
+    });
+    if caps.is_empty() {
+        return None;
+    }
+    let is_cap = |face: &Face<Point3, C, S>| {
+        caps.iter()
+            .any(|(_, plane, _)| in_support_plane(&face.surface(), plane))
+    };
+    let at_infinity = if matches!(operation, Operation::Difference) {
+        shell1.iter_mut().for_each(|face| {
+            face.invert();
+        });
+        1
+    } else {
+        0
+    };
+    let polygons0 = shell0.triangulation(tol);
+    let polygons1 = shell1.triangulation(tol);
+    let sides0: Shell<Point3, C, S> = shell0
+        .iter()
+        .filter(|face| !is_cap(face))
+        .cloned()
+        .collect();
+    let sides1: Shell<Point3, C, S> = shell1
+        .iter()
+        .filter(|face| !is_cap(face))
+        .cloned()
+        .collect();
+    if sides0.is_empty()
+        || sides1.is_empty()
+        || sides0.iter().any(|a| {
+            sides1
+                .iter()
+                .any(|b| same_support(&a.surface(), &b.surface()))
+        })
+    {
+        return None;
+    }
+    let alt0: AltCurveShell<C, S> =
+        sides0.mapped(|p| *p, |c| Alternative::FirstType(c.clone()), Clone::clone);
+    let alt1: AltCurveShell<C, S> =
+        sides1.mapped(|p| *p, |c| Alternative::FirstType(c.clone()), Clone::clone);
+    let stores = loops_store::create_loops_stores(
+        &alt0,
+        &sides0.triangulation(tol),
+        &alt1,
+        &sides1.triangulation(tol),
+    )?;
+    let classes0 = divided_sides(&alt0, &stores.geom_loops_store0, tol)?;
+    let classes1 = divided_sides(&alt1, &stores.geom_loops_store1, tol)?;
+    let union = matches!(operation, Operation::Union);
+    let mut selected = AltCurveShell::default();
+    [
+        (classes0, &polygons1, at_infinity),
+        (classes1, &polygons0, 0),
+    ]
+    .into_iter()
+    .try_for_each(|(classes, other, infinity)| {
+        let [intersection, outside, unknown] = classes;
+        selected.extend(if union { outside } else { intersection });
+        unknown.into_iter().try_for_each(|face| {
+            let (point, _) = interior_point(&face, tol)?;
+            if inside(point, other, infinity)? != union {
+                selected.push(face);
+            }
+            Some(())
+        })
+    })?;
+    if selected.is_empty() {
+        // No complete arrangement has certified that the solid is empty here.
+        return None;
+    }
+    let mut selected = ruling_shell(&selected)?;
+    let mut groups: Vec<Vec<(Wire<Point3, C>, PolylineCurve<Point2>)>> =
+        caps.iter().map(|_| Vec::new()).collect();
+    selected
+        .extract_boundaries()
+        .into_iter()
+        .try_for_each(|wire| {
+            let wire = wire.inverse();
+            if !wire.is_closed() || !wire.is_simple() {
+                return None;
+            }
+            let points: Vec<_> = wire
+                .edge_iter()
+                .flat_map(|edge| {
+                    let curve = edge.oriented_curve();
+                    curve
+                        .parameter_division(curve.range_tuple(), tol)
+                        .1
+                        .into_iter()
+                        .skip(1)
+                })
+                .collect();
+            let index = caps.iter().position(|(_, plane, _)| {
+                points.iter().all(|point| {
+                    let (distance, error) = plane_distance(*point, plane.origin(), plane.normal());
+                    distance.abs() <= error
+                })
+            })?;
+            let (surface, _, _) = &caps[index];
+            let parameters = points
+                .into_iter()
+                .map(|point| surface.search_parameter(point, None, 100).map(Point2::from))
+                .collect::<Option<Vec<_>>>()?;
+            groups[index].push((wire, PolylineCurve(parameters)));
+            Some(())
+        })?;
+    caps.into_iter()
+        .zip(groups)
+        .try_for_each(|((surface, plane, side), loops)| {
+            let (u, v) = surface.search_parameter(plane.origin(), None, 100)?;
+            let orientation = surface.normal(u, v).dot(plane.normal()) * f64::from(side) < 0.0;
+            let sign = if orientation { 1.0 } else { -1.0 };
+            let mut regions: Vec<_> = loops
+                .iter()
+                .filter(|(_, poly)| poly.area() * sign > 0.0)
+                .map(|(wire, poly)| (vec![wire.clone()], poly))
+                .collect();
+            loops
+                .iter()
+                .filter(|(_, poly)| poly.area() * sign <= 0.0)
+                .try_for_each(|(wire, poly)| {
+                    if poly.area() == 0.0 {
+                        return None;
+                    }
+                    let index = regions
+                        .iter()
+                        .enumerate()
+                        .filter(|(_, (_, outer))| outer.include(poly.front()))
+                        .min_by(|(_, (_, a)), (_, (_, b))| {
+                            a.area().abs().total_cmp(&b.area().abs())
+                        })
+                        .map(|(index, _)| index)?;
+                    regions[index].0.push(wire.clone());
+                    Some(())
+                })?;
+            regions.into_iter().try_for_each(|(wires, _)| {
+                let wires = if orientation {
+                    wires
+                } else {
+                    wires.into_iter().map(|wire| wire.inverse()).collect()
+                };
+                let mut face = Face::try_new(wires, surface.clone()).ok()?;
+                if !orientation {
+                    face.invert();
+                }
+                selected.push(face);
+                Some(())
+            })
+        })?;
+    if selected
+        .edge_iter()
+        .all(|edge| edge.is_geometric_consistent())
+    {
+        Solid::try_new(selected.connected_components()).ok()
+    } else {
+        None
+    }
+}
