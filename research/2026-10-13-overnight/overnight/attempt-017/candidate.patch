+/// Recover an affine isoparametric trace from the complete homogeneous net.
+///
+/// A degree-one section with equal positive weights is a straight segment.
+/// This certificate avoids repeated intersection projections along a shared
+/// ruling, while retaining a curve on an original exact support.
+fn affine_trace<S: ShapeOpsSurface>(
+    surface: &S,
+    front: Point3,
+    back: Point3,
+) -> Option<ParameterCurve<Line<Point2>, S>> {
+    if !surface.supports_exact_patch_domains() {
+        return None;
+    }
+    let a = surface.search_parameter(front, None, 100)?;
+    let b = surface.search_parameter(back, Some(a), 100)?;
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    let equal = |x: f64, y: f64| (x - y).abs() <= 32.0 * f64::EPSILON * (1.0 + x.abs() + y.abs());
+    let clamped = |knots: &KnotVector| {
+        knots.len() == 4 && knots[0] == knots[1] && knots[2] == knots[3] && knots[0] < knots[3]
+    };
+    let (start, end, controls) =
+        if equal(a.0, b.0) && spline.vdegree() == 1 && clamped(spline.knot_vector_v()) {
+            (
+                Point2::new(a.0, a.1),
+                Point2::new(a.0, b.1),
+                [
+                    spline.curve_u(0).evaluate(a.0),
+                    spline.curve_u(1).evaluate(a.0),
+                ],
+            )
+        } else if equal(a.1, b.1) && spline.udegree() == 1 && clamped(spline.knot_vector_u()) {
+            (
+                Point2::new(a.0, a.1),
+                Point2::new(b.0, a.1),
+                [
+                    spline.curve_v(0).evaluate(a.1),
+                    spline.curve_v(1).evaluate(a.1),
+                ],
+            )
+        } else {
+            return None;
+        };
+    if !controls
+        .iter()
+        .all(|point| point.w.is_finite() && point.w > 0.0)
+        || controls[0].w != controls[1].w
+        || front.near(&back)
+    {
+        return None;
+    }
+    let curve = ParameterCurve::new(Line(start, end), surface.clone());
+    (curve.front().near(&front) && curve.back().near(&back)).then_some(curve)
+}
