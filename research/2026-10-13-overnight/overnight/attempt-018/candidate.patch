+/// Materialize transverse straight intersections on both exact supports.
+fn ruling_shell<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &AltCurveShell<C, S>,
+) -> Option<Shell<Point3, C, S>> {
+    let converted: Shell<Point3, C, S> = shell.try_mapped(
+        |point| Some(*point),
+        |curve| match curve {
+            Alternative::FirstType(curve) => Some(curve.clone()),
+            Alternative::SecondType(curve) => {
+                let front = curve.leader().front();
+                let back = curve.leader().back();
+                let first = affine_trace(curve.surface0(), front, back)?;
+                let second = affine_trace(curve.surface1(), front, back)?;
+                let middle = first.evaluate(0.5);
+                let uv0 = curve.surface0().search_parameter(middle, None, 100)?;
+                let uv1 = curve.surface1().search_parameter(middle, None, 100)?;
+                let normal0 = curve.surface0().normal(uv0.0, uv0.1);
+                let normal1 = curve.surface1().normal(uv1.0, uv1.1);
+                if normal0.cross(normal1).so_small()
+                    || !first.evaluate(0.5).near(&second.evaluate(0.5))
+                    || !curve
+                        .leader()
+                        .iter()
+                        .all(|point| first.search_parameter(*point, None, 100).is_some())
+                {
+                    return None;
+                }
+                Some(shared_ruling(first, second))
+            }
+        },
+        |surface| Some(surface.clone()),
+    )?;
+    let consistent = converted
+        .edge_iter()
+        .all(|edge| edge.is_geometric_consistent());
+    consistent.then_some(converted)
+}
+
+/// Certify a shared support plane without inferring planarity from trim vertices.
+fn support_plane<S: ShapeOpsSurface>(surface: &S) -> Option<Plane> {
+    let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()? else {
+        return None;
+    };
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    spline
+        .control_points()
+        .iter()
+        .flatten()
+        .all(|control| {
+            let (distance, error) =
+                plane_distance(control.to_point(), plane.origin(), plane.normal());
+            control.w.is_finite()
+                && control.w > 0.0
+                && distance.is_finite()
+                && distance.abs() <= error
+        })
+        .then_some(plane)
+}
+
+/// Certify coincidence with a common plane across the complete support net.
+fn in_support_plane<S: ShapeOpsSurface>(surface: &S, plane: &Plane) -> bool {
+    support_plane(surface).is_some()
+        && surface
+            .try_into_homogeneous_bspline_surface()
+            .is_some_and(|spline| {
+                spline.control_points().iter().flatten().all(|control| {
+                    let (distance, error) =
+                        plane_distance(control.to_point(), plane.origin(), plane.normal());
+                    distance.is_finite() && distance.abs() <= error
+                })
+            })
+}
+
+/// Determine which side of a plane encloses the entire bounded solid.
+fn enclosure_side(enclosure: (Point3, Point3), plane: &Plane) -> Option<i8> {
+    let (min, max) = enclosure;
+    let distances = [min.x, max.x].into_iter().flat_map(|x| {
+        [min.y, max.y].into_iter().flat_map(move |y| {
+            [min.z, max.z]
+                .into_iter()
+                .map(move |z| plane_distance(Point3::new(x, y, z), plane.origin(), plane.normal()))
+        })
+    });
+    let (negative, positive) = distances.fold((true, true), |(negative, positive), (d, e)| {
+        (negative && d <= e, positive && d >= -e)
+    });
+    if negative && !positive {
+        Some(-1)
+    } else if positive && !negative {
+        Some(1)
+    } else {
+        None
+    }
+}
