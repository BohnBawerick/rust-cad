+/// Give every cap seam one shared exact curve with both incident trims.
+fn trim_cap_seams<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &Shell<Point3, C, S>,
+    tol: f64,
+) -> Option<Shell<Point3, C, S>> {
+    if shell.edge_iter().take(4097).count() > 4096 {
+        return None;
+    }
+    let mut corners: HashMap<VertexId<Point3>, Vec<S>> = HashMap::default();
+    shell.iter().for_each(|face| {
+        face.vertex_iter().for_each(|vertex| {
+            corners.entry(vertex.id()).or_default().push(face.surface());
+        });
+    });
+    let vertices: HashMap<_, _> = shell
+        .vertex_iter()
+        .map(|vertex| {
+            let point = shared_corner(vertex.point(), corners.get(&vertex.id())?)?;
+            Some((vertex.id(), Vertex::new(point)))
+        })
+        .collect::<Option<_>>()?;
+    let mut owners: HashMap<EdgeId<C>, [Option<S>; 2]> = HashMap::default();
+    shell.iter().try_for_each(|face| {
+        face.edge_iter().try_for_each(|edge| {
+            let slot = owners
+                .entry(edge.id())
+                .or_insert_with(|| [None, None])
+                .iter_mut()
+                .find(|slot| slot.is_none())?;
+            *slot = Some(face.surface());
+            Some(())
+        })
+    })?;
+    let mut edges: HashMap<EdgeId<C>, Edge<Point3, C>> = HashMap::default();
+    shell
+        .iter()
+        .map(|face| {
+            let wires = face
+                .absolute_boundaries()
+                .iter()
+                .map(|wire| {
+                    wire.iter()
+                        .map(|edge| {
+                            if !edges.contains_key(&edge.id()) {
+                                let surfaces = owners.get(&edge.id())?;
+                                let [Some(first), Some(second)] = surfaces else {
+                                    return None;
+                                };
+                                let front = vertices.get(&edge.absolute_front().id())?;
+                                let back = vertices.get(&edge.absolute_back().id())?;
+                                let source = Edge::try_new(front, back, edge.curve()).ok()?;
+                                let curve = if support_plane(first).is_some()
+                                    && support_plane(second).is_none()
+                                {
+                                    shared_rim(&source, second, first, tol)?
+                                } else if support_plane(second).is_some()
+                                    && support_plane(first).is_none()
+                                {
+                                    shared_rim(&source, first, second, tol)?
+                                } else if let Some((a, b)) =
+                                    affine_trace(first, front.point(), back.point())
+                                        .zip(affine_trace(second, front.point(), back.point()))
+                                {
+                                    shared_ruling(a, b)
+                                } else {
+                                    edge.curve()
+                                };
+                                let rebuilt = Edge::try_new(front, back, curve).ok()?;
+                                edges.insert(edge.id(), rebuilt);
+                            }
+                            let rebuilt = edges.get(&edge.id())?;
+                            Some(if edge.orientation() {
+                                rebuilt.clone()
+                            } else {
+                                rebuilt.inverse()
+                            })
+                        })
+                        .collect::<Option<Wire<_, _>>>()
+                })
+                .collect::<Option<Vec<_>>>()?;
+            let mut rebuilt = Face::try_new(wires, face.surface()).ok()?;
+            if !face.orientation() {
+                rebuilt.invert();
+            }
+            Some(rebuilt)
+        })
+        .collect()
+}
