+/// Project a rational curve into a certified affine planar parameter chart.
+///
+/// An affine map acts on homogeneous control points without changing weights
+/// or knots, so the resulting trim has exactly the same parameterization.
+fn planar_rational_trim<S: ShapeOpsSurface>(
+    surface: &S,
+    curve: &NurbsCurve<Vector4>,
+) -> Option<ParameterCurve<BoundaryCurve2D, S>> {
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    let controls = spline.control_points();
+    if spline.udegree() != 1
+        || spline.vdegree() != 1
+        || controls.len() != 2
+        || controls.iter().any(|row| row.len() != 2)
+    {
+        return None;
+    }
+    let weight = controls[0][0].w;
+    if !weight.is_finite()
+        || weight <= 0.0
+        || controls.iter().flatten().any(|control| control.w != weight)
+    {
+        return None;
+    }
+    let a = controls[0][0].to_point();
+    let b = controls[0][1].to_point();
+    let c = controls[1][0].to_point();
+    let d = controls[1][1].to_point();
+    let scale = 1.0
+        + a.to_vec().magnitude()
+        + b.to_vec().magnitude()
+        + c.to_vec().magnitude()
+        + d.to_vec().magnitude();
+    if ((d - c) - (b - a)).magnitude() > 64.0 * f64::EPSILON * scale {
+        return None;
+    }
+    let points = curve
+        .control_points()
+        .iter()
+        .map(|control| {
+            let point = control.to_point();
+            let (u, v) = surface.search_parameter(point, None, 100)?;
+            surface.evaluate(u, v).near(&point).then_some(Vector3::new(
+                u * control.w,
+                v * control.w,
+                control.w,
+            ))
+        })
+        .collect::<Option<Vec<_>>>()?;
+    let trim = NurbsCurve::new(BsplineCurve::new(curve.knot_vector().clone(), points));
+    Some(ParameterCurve::new(
+        BoundaryCurve2D::NurbsCurve(trim),
+        surface.clone(),
+    ))
+}
