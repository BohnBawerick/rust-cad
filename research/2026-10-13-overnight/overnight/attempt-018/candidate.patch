+/// Keep edge subdivisions even when a face has no classified interior cuts.
+fn divided_sides<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &AltCurveShell<C, S>,
+    loops: &loops_store::LoopsStore<Point3, AltCurve<C, S>>,
+    tol: f64,
+) -> Option<[AltCurveShell<C, S>; 3]> {
+    let rebuilt: AltCurveShell<C, S> = shell
+        .iter()
+        .zip(loops)
+        .map(|(face, loops)| {
+            if loops
+                .iter()
+                .all(|wire| wire.status() == loops_store::ShapesOpStatus::Unknown)
+            {
+                let wires = loops.iter().map(|wire| (**wire).clone()).collect();
+                let mut rebuilt = Face::try_new(wires, face.surface()).ok()?;
+                if !face.orientation() {
+                    rebuilt.invert();
+                }
+                Some(rebuilt)
+            } else {
+                Some(face.clone())
+            }
+        })
+        .collect::<Option<_>>()?;
+    Some(divide_face::divide_faces(&rebuilt, loops, tol)?.and_or_unknown())
+}
+
+/// Recover a failed arrangement at common supporting planes.
+///
+/// Supporting planes cannot cut either interior. March only the remaining
+/// faces, then close their selected boundary chains on the common planes.
+/// Only certified affine intersection traces are accepted in this recovery.
+fn capped_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    tol: f64,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let enclosure0 = solid_enclosure(solid0)?;
+    let enclosure1 = solid_enclosure(solid1)?;
+    let shell0: Shell<Point3, C, S> = solid0.face_iter().cloned().collect();
+    let mut shell1: Shell<Point3, C, S> = solid1.face_iter().cloned().collect();
+    if shell0.len().checked_mul(shell1.len())? > 4096 {
+        return None;
+    }
+    let mut caps: Vec<(S, Plane, i8)> = Vec::new();
+    shell0.iter().for_each(|face| {
+        let surface = face.surface();
+        if let Some(plane) = support_plane(&surface) {
+            let side = enclosure_side(enclosure0, &plane);
+            if side.is_some()
+                && side == enclosure_side(enclosure1, &plane)
+                && shell1
+                    .iter()
+                    .any(|other| in_support_plane(&other.surface(), &plane))
+                && !caps
+                    .iter()
+                    .any(|(_, other, _)| in_support_plane(&surface, other))
+            {
+                if let Some(side) = side {
+                    caps.push((surface, plane, side));
+                }
+            }
+        }
+    });
+    if caps.is_empty() {
+        return None;
+    }
+    let is_cap = |face: &Face<Point3, C, S>| {
+        caps.iter()
+            .any(|(_, plane, _)| in_support_plane(&face.surface(), plane))
+    };
+    let at_infinity = if matches!(operation, Operation::Difference) {
+        shell1.iter_mut().for_each(|face| {
+            face.invert();
+        });
+        1
+    } else {
+        0
+    };
+    let polygons0 = shell0.triangulation(tol);
+    let polygons1 = shell1.triangulation(tol);
+    let sides0: Shell<Point3, C, S> = shell0
+        .iter()
+        .filter(|face| !is_cap(face))
+        .cloned()
+        .collect();
+    let sides1: Shell<Point3, C, S> = shell1
+        .iter()
+        .filter(|face| !is_cap(face))
+        .cloned()
+        .collect();
+    if sides0.is_empty()
+        || sides1.is_empty()
+        || sides0.iter().any(|a| {
+            sides1
+                .iter()
+                .any(|b| same_support(&a.surface(), &b.surface()))
+        })
+    {
+        return None;
+    }
+    let alt0: AltCurveShell<C, S> =
+        sides0.mapped(|p| *p, |c| Alternative::FirstType(c.clone()), Clone::clone);
+    let alt1: AltCurveShell<C, S> =
+        sides1.mapped(|p| *p, |c| Alternative::FirstType(c.clone()), Clone::clone);
+    let stores = loops_store::create_loops_stores(
+        &alt0,
+        &sides0.triangulation(tol),
+        &alt1,
+        &sides1.triangulation(tol),
+    )?;
+    let classes0 = divided_sides(&alt0, &stores.geom_loops_store0, tol)?;
+    let classes1 = divided_sides(&alt1, &stores.geom_loops_store1, tol)?;
+    let union = matches!(operation, Operation::Union);
+    let mut selected = AltCurveShell::default();
+    [
