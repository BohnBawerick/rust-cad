+/// Recover a cap rim from a clamped spline boundary, preserving its exact locus.
+///
+/// Positive weights and strictly one-sided remaining control rows certify
+/// that the supporting plane meets this patch only on the chosen boundary.
+/// This is a support certificate, independent of the shape of the profile.
+fn shared_rim<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    edge: &Edge<Point3, C>,
+    side: &S,
+    cap: &S,
+    tol: f64,
+) -> Option<C> {
+    let plane = support_plane(cap)?;
+    if !side.supports_exact_patch_domains() {
+        return None;
+    }
+    let spline = side.try_into_homogeneous_bspline_surface()?;
+    let net = spline.control_points();
+    if net.len().checked_mul(net.first()?.len())? > 65_536
+        || net.iter().flatten().any(|p| !p.w.is_finite() || p.w <= 0.0)
+    {
+        return None;
+    }
+    let (urange, vrange) = spline.try_range_tuple();
+    let (urange, vrange) = (urange?, vrange?);
+    let clamped = |knots: &KnotVector, degree: usize, range: (f64, f64)| {
+        knots.iter().take(degree + 1).all(|k| *k == range.0)
+            && knots.iter().rev().take(degree + 1).all(|k| *k == range.1)
+    };
+    if !clamped(spline.knot_vector_u(), spline.udegree(), urange)
+        || !clamped(spline.knot_vector_v(), spline.vdegree(), vrange)
+    {
+        return None;
+    }
+    [(true, false), (true, true), (false, false), (false, true)]
+        .into_iter()
+        .find_map(|(fixed_u, upper)| {
+            let index = if upper {
+                if fixed_u {
+                    net.len() - 1
+                } else {
+                    net[0].len() - 1
+                }
+            } else {
+                0
+            };
+            let section = if fixed_u {
+                spline.curve_v(index)
+            } else {
+                spline.curve_u(index)
+            };
+            if !section.control_points().iter().all(|p| {
+                let (distance, error) =
+                    plane_distance(p.to_point(), plane.origin(), plane.normal());
+                distance.is_finite() && distance.abs() <= error
+            }) {
+                return None;
+            }
+            let mut sign = 0_i8;
+            net.iter().enumerate().try_for_each(|(i, row)| {
+                row.iter().enumerate().try_for_each(|(j, p)| {
+                    if (if fixed_u { i } else { j }) == index {
+                        return Some(());
+                    }
+                    let (distance, error) =
+                        plane_distance(p.to_point(), plane.origin(), plane.normal());
+                    let next = if distance > error {
+                        1
+                    } else if distance < -error {
+                        -1
+                    } else {
+                        0
+                    };
+                    if next == 0 || (sign != 0 && sign != next) {
+                        return None;
+                    }
+                    sign = next;
+                    Some(())
+                })
+            })?;
+            let mut leader = NurbsCurve::new(section);
+            let a = leader.search_parameter(edge.absolute_front().point(), None, 100)?;
+            let b = leader.search_parameter(edge.absolute_back().point(), None, 100)?;
+            let range = leader.range_tuple();
+            let (low, high) = (a.min(b), a.max(b));
+            if !(low < high && low >= range.0 && high <= range.1) {
+                return None;
+            }
+            if low > range.0 {
+                leader = leader.cut(low);
+            }
+            if high < range.1 {
+                leader.cut(high);
+            }
+            if b < a {
+                leader.invert();
+            }
+            leader.knot_normalize();
+            let fixed = if fixed_u { urange } else { vrange };
+            let fixed = if upper { fixed.1 } else { fixed.0 };
+            let uv = |t| {
+                if fixed_u {
+                    Point2::new(fixed, t)
+                } else {
+                    Point2::new(t, fixed)
+                }
+            };
+            let boundary0 =
+                ParameterCurve::new(BoundaryCurve2D::Line(Line(uv(a), uv(b))), side.clone());
+            let boundary1 = planar_rational_trim(cap, &leader)?;
+            let original = edge.curve();
+            let middle = original.evaluate({
+                let (a, b) = original.range_tuple();
+                (a + b) / 2.0
+            });
+            let t = leader.search_parameter(middle, None, 100)?;
+            if !(0.0..=1.0).contains(&t) {
+                return None;
+            }
+            let curve: C = SurfaceCurve::with_boundaries(
+                side.clone(),
+                cap.clone(),
+                leader,
+                Some(boundary0),
+                Some(boundary1),
+            )
+            .into();
+            let replacement =
+                Edge::try_new(edge.absolute_front(), edge.absolute_back(), curve.clone()).ok()?;
+            (replacement.is_geometric_consistent() && matching_edges(edge, &replacement, tol))
+                .then_some(curve)
+        })
+}
