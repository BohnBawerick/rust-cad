+/// Solve transverse corner constraints together before restricting their edges.
+///
+/// Marching may stop after each pairwise projection reaches geometric tolerance.
+/// A shared corner instead needs one common point on all incident supports.
+/// Rank-deficient corners retain their original, underdetermined position.
+fn shared_corner<S: ShapeOpsSurface>(point: Point3, surfaces: &[S]) -> Option<Point3> {
+    let mut parameters = surfaces
+        .iter()
+        .map(|surface| surface.search_nearest_parameter(point, None, 100))
+        .collect::<Option<Vec<_>>>()?;
+    let refined = (0..12).try_fold(point, |point, _| {
+        let (matrix, residual) = surfaces.iter().zip(parameters.iter_mut()).try_fold(
+            (Matrix3::zero(), Vector3::zero()),
+            |(matrix, residual), (surface, parameter)| {
+                *parameter = surface.search_nearest_parameter(point, Some(*parameter), 100)?;
+                let (u, v) = *parameter;
+                let normal = surface.normal(u, v).normalize();
+                let distance = (surface.evaluate(u, v) - point).dot(normal);
+                Some((
+                    matrix
+                        + Matrix3::from_cols(
+                            normal * normal.x,
+                            normal * normal.y,
+                            normal * normal.z,
+                        ),
+                    residual + normal * distance,
+                ))
+            },
+        )?;
+        if matrix.determinant().abs() <= 128.0 * f64::EPSILON {
+            Some(point)
+        } else {
+            let correction = matrix.invert()? * residual;
+            (correction.x.is_finite() && correction.y.is_finite() && correction.z.is_finite())
+                .then_some(point + correction)
+        }
+    })?;
+    (point.near(&refined)
+        && surfaces
+            .iter()
+            .all(|surface| surface.search_parameter(refined, None, 100).is_some()))
+    .then_some(refined)
+}
