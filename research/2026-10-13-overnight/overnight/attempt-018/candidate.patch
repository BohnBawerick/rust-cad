+/// Lift one affine trace into a shared curve with a trim on each support.
+fn shared_ruling<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    first: ParameterCurve<Line<Point2>, S>,
+    second: ParameterCurve<Line<Point2>, S>,
+) -> C {
+    let leader = BsplineCurve::from(Line(first.front(), first.back()));
+    let (line0, surface0) = first.decompose();
+    let (line1, surface1) = second.decompose();
+    let boundary0 = ParameterCurve::new(BoundaryCurve2D::Line(line0), surface0.clone());
+    let boundary1 = ParameterCurve::new(BoundaryCurve2D::Line(line1), surface1.clone());
+    SurfaceCurve::with_boundaries(surface0, surface1, leader, Some(boundary0), Some(boundary1))
+        .into()
+}
