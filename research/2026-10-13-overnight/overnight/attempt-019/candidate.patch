+/// Decompose straight planar trims only when their oriented boundary is preserved.
+///
+/// A positive planar triangle chain with the same boundary as a valid trimmed
+/// face represents exactly that face: their difference is a compact planar
+/// two-cycle and therefore vanishes. Tessellation supplies a candidate chain;
+/// support and boundary certificates, rather than its sampling tolerance,
+/// establish that no approximation enters the returned geometry.
+fn planar_chain_cells<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    tol: f64,
+    work: &mut usize,
+) -> Option<Vec<PlanarCell<S>>> {
+    let mut incidence: HashMap<EdgeId<C>, (Vector3, usize)> = HashMap::default();
+    let faces = solid
+        .face_iter()
+        .map(|face| {
+            let surface = face.surface();
+            let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()?
+            else {
+                return None;
+            };
+            let spline = surface.try_into_homogeneous_bspline_surface()?;
+            spline
+                .control_points()
+                .iter()
+                .flatten()
+                .try_for_each(|control| {
+                    *work = work.checked_sub(1)?;
+                    let (distance, error) =
+                        plane_distance(control.to_point(), plane.origin(), plane.normal());
+                    (control.w.is_finite()
+                        && control.w > 0.0
+                        && distance.is_finite()
+                        && error.is_finite()
+                        && distance.abs() <= error)
+                        .then_some(())
+                })?;
+            face.edge_iter().try_for_each(|edge| {
+                *work = work.checked_sub(1)?;
+                let entry = incidence.entry(edge.id()).or_insert((plane.normal(), 0));
+                if entry.1 > 1 || (entry.1 == 1 && entry.0.cross(plane.normal()).so_small()) {
+                    return None;
+                }
+                entry.1 += 1;
+                Some(())
+            })?;
+            let normal = if face.orientation() {
+                plane.normal()
+            } else {
+                -plane.normal()
+            };
+            Some((face, surface, normal))
+        })
+        .collect::<Option<Vec<_>>>()?;
+    if incidence.values().any(|(_, count)| *count != 2) {
+        return None;
+    }
+    faces
+        .into_iter()
+        .try_fold(Vec::new(), |mut cells, (face, surface, normal)| {
+            let shell: Shell<Point3, C, S> = iter::once(face.clone()).collect();
+            let meshed = shell.triangulation(tol);
+            let mesh = meshed.first()?.surface()?;
+            let edges: Vec<_> = face.edge_iter().collect();
+            let scale = edges
+                .iter()
+                .flat_map(|edge| [edge.front().point(), edge.back().point()])
+                .fold(1.0_f64, |scale, p| {
+                    scale.max(p.x.abs()).max(p.y.abs()).max(p.z.abs())
+                });
+            let error = 128.0 * f64::EPSILON * scale;
+            let mut vertices: Vec<Point3> = Vec::new();
+            let mut chain: HashMap<(usize, usize), (isize, usize)> = HashMap::default();
+            mesh.face_iter().try_for_each(|polygon| {
+                (2..polygon.len()).try_for_each(|index| {
+                    let mut points = [polygon[0], polygon[index - 1], polygon[index]]
+                        .map(|vertex| mesh.positions()[vertex.pos]);
+                    let area = (points[1] - points[0])
+                        .cross(points[2] - points[0])
+                        .dot(normal);
+                    if !area.is_finite() || area == 0.0 {
+                        return None;
+                    }
+                    if area < 0.0 {
+                        points.swap(1, 2);
+                    }
+                    let indices = points
+                        .iter()
+                        .map(|point| {
+                            *work = work.checked_sub(vertices.len() + 1)?;
+                            let (distance, bound) =
+                                plane_distance(*point, edges.first()?.front().point(), normal);
+                            if !distance.is_finite() || distance.abs() > bound {
+                                return None;
+                            }
+                            Some(
+                                vertices
+                                    .iter()
+                                    .position(|p| p.distance2(*point) <= error * error)
+                                    .unwrap_or_else(|| {
+                                        vertices.push(*point);
+                                        vertices.len() - 1
+                                    }),
+                            )
+                        })
+                        .collect::<Option<Vec<_>>>()?;
+                    indices
+                        .iter()
+                        .zip(indices.iter().cycle().skip(1))
+                        .try_for_each(|(&a, &b)| {
+                            if a == b {
+                                return None;
+                            }
+                            let entry = chain.entry((a.min(b), a.max(b))).or_insert((0, 0));
+                            entry.0 += if a < b { 1 } else { -1 };
+                            entry.1 += 1;
+                            (entry.1 <= 2).then_some(())
+                        })?;
+                    cells.push(PlanarCell {
+                        surface: surface.clone(),
+                        orientation: face.orientation(),
+                        normal,
+                        points: points.to_vec(),
+                    });
+                    Some(())
+                })
+            })?;
+            let mut coverage: Vec<Vec<(f64, f64)>> = edges.iter().map(|_| Vec::new()).collect();
+            chain.into_iter().try_for_each(|((a, b), (count, uses))| {
+                if count == 0 && uses == 2 {
+                    return Some(());
+                }
+                if count.abs() != 1 || uses != 1 {
+                    return None;
+                }
+                let (a, b) = if count > 0 {
+                    (vertices[a], vertices[b])
+                } else {
+                    (vertices[b], vertices[a])
+                };
+                let (index, interval) = edges.iter().enumerate().find_map(|(index, edge)| {
+                    let origin = edge.front().point();
+                    let direction = edge.back().point() - origin;
+                    let length2 = direction.magnitude2();
+                    if length2 == 0.0 {
+                        return None;
+                    }
+                    let start = (a - origin).dot(direction) / length2;
+                    let end = (b - origin).dot(direction) / length2;
+                    let slack = error / length2.sqrt();
+                    (start < end
+                        && start >= -slack
+                        && end <= 1.0 + slack
+                        && (origin + direction * start).distance2(a) <= error * error
+                        && (origin + direction * end).distance2(b) <= error * error)
+                        .then_some((index, (start, end)))
+                })?;
+                coverage[index].push(interval);
+                Some(())
+            })?;
+            coverage
+                .iter_mut()
+                .zip(&edges)
+                .try_for_each(|(intervals, edge)| {
+                    intervals.sort_by(|a, b| a.0.total_cmp(&b.0));
+                    let slack = error / edge.front().point().distance(edge.back().point());
+                    let end = intervals.iter().try_fold(0.0_f64, |end, &(a, b)| {
+                        ((a - end).abs() <= slack).then_some(b)
+                    })?;
+                    ((end - 1.0).abs() <= slack).then_some(())
+                })?;
+            Some(cells)
+        })
+}
