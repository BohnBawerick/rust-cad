+/// Represent a coplanar subdivision edge in a certified affine surface chart.
+fn planar_chart_line<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    surface: &S,
+    front: Point3,
+    back: Point3,
+) -> Option<C> {
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    let net = spline.control_points();
+    if spline.udegree() != 1
+        || spline.vdegree() != 1
+        || net.len() != 2
+        || net.iter().any(|row| row.len() != 2)
+    {
+        return None;
+    }
+    let weight = net[0][0].w;
+    if weight <= 0.0 || net.iter().flatten().any(|p| p.w != weight) {
+        return None;
+    }
+    let [a, b, c, d] = [net[0][0], net[0][1], net[1][0], net[1][1]].map(|p| p.to_point());
+    let scale = 1.0
+        + a.to_vec().magnitude()
+        + b.to_vec().magnitude()
+        + c.to_vec().magnitude()
+        + d.to_vec().magnitude();
+    if ((d - c) - (b - a)).magnitude() > 64.0 * f64::EPSILON * scale {
+        return None;
+    }
+    let a = surface.search_parameter(front, None, 100)?;
+    let b = surface.search_parameter(back, Some(a), 100)?;
+    C::try_from(ParameterCurve::new(
+        Line(Point2::new(a.0, a.1), Point2::new(b.0, b.1)),
+        surface.clone(),
+    ))
+    .ok()
+}
