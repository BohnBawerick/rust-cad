+/// Verify that subdivision retains the original oriented boundary chain.
+///
+/// Interior cuts cancel by edge identity. The remaining intervals must cover
+/// every original trim exactly once, in its original direction.
+fn preserves_boundary<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    source: &Face<Point3, AltCurve<C, S>, S>,
+    fragments: &[Face<Point3, AltCurve<C, S>, S>],
+    work: &mut usize,
+) -> Option<()> {
+    let mut chain = HashMap::default();
+    fragments.iter().try_for_each(|face| {
+        face.absolute_boundaries()
+            .iter()
+            .flatten()
+            .try_for_each(|edge| {
+                *work = work.checked_sub(1)?;
+                let entry = chain.entry(edge.id()).or_insert((edge.clone(), 0_isize));
+                entry.1 += if edge.orientation() { 1 } else { -1 };
+                Some(())
+            })
+    })?;
+    let originals: Vec<_> = source.absolute_boundaries().iter().flatten().collect();
+    let mut intervals = vec![Vec::new(); originals.len()];
+    chain.values().try_for_each(|(edge, multiplicity)| {
+        if *multiplicity == 0 {
+            return Some(());
+        }
+        if multiplicity.abs() != 1 || !matches!(edge.curve(), Alternative::FirstType(_)) {
+            return None;
+        }
+        let (front, back) = if *multiplicity > 0 {
+            (edge.absolute_front().point(), edge.absolute_back().point())
+        } else {
+            (edge.absolute_back().point(), edge.absolute_front().point())
+        };
+        let curve = edge.curve();
+        let (start, end) = curve.range_tuple();
+        let middle = curve.evaluate((start + end) / 2.0);
+        *work = work.checked_sub(originals.len())?;
+        let (index, a, b) = originals.iter().enumerate().find_map(|(index, original)| {
+            let curve = original.curve();
+            let (start, end) = curve.range_tuple();
+            let a = curve.search_parameter(front, None, 100)?;
+            let b = curve.search_parameter(back, None, 100)?;
+            let m = curve.search_parameter(middle, None, 100)?;
+            ((a < b) == original.orientation()
+                && a.min(b) >= start - TOLERANCE
+                && a.max(b) <= end + TOLERANCE
+                && m >= a.min(b)
+                && m <= a.max(b))
+            .then_some((index, a.min(b), a.max(b)))
+        })?;
+        intervals[index].push((a, b));
+        Some(())
+    })?;
+    originals
+        .iter()
+        .zip(&mut intervals)
+        .try_for_each(|(edge, spans)| {
+            spans.sort_unstable_by(|a, b| a.0.total_cmp(&b.0));
+            let (start, end) = edge.curve().range_tuple();
+            let last = spans
+                .iter()
+                .try_fold(start, |last, &(a, b)| (last.near(&a) && b > a).then_some(b))?;
+            last.near(&end).then_some(())
+        })
+}
