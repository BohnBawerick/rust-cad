+/// Reconstruct all trimmed regions before using any Boolean side labels.
+///
+/// Loop orientation and nesting determine the face domains. A linear modeling
+/// tolerance is not an area predicate in an arbitrary surface chart. Boundary
+/// conservation rejects incomplete arrangements instead of dropping regions.
+fn subdivision_regions<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &AltCurveShell<C, S>,
+    stores: &LoopsStore<Point3, AltCurve<C, S>>,
+    tol: f64,
+    work: &mut usize,
+) -> Option<AltCurveShell<C, S>> {
+    shell
+        .iter()
+        .zip(stores)
+        .try_fold(Shell::default(), |mut result, (face, loops)| {
+            if loops
+                .iter()
+                .all(|wire| wire.status() == ShapesOpStatus::Unknown)
+            {
+                // Neighboring cuts may have subdivided these boundary edges even
+                // though no intersection crosses the relative interior of this face.
+                let wires = loops
+                    .iter()
+                    .map(|wire| wire.iter().cloned().collect())
+                    .collect();
+                let mut fragment = Face::try_new(wires, face.surface()).ok()?;
+                preserves_boundary(face, slice::from_ref(&fragment), work)?;
+                if !face.orientation() {
+                    fragment.invert();
+                }
+                result.push(fragment);
+                return Some(result);
+            }
+            let surface = face.surface();
+            let projected = loops
+                .iter()
+                .map(|wire| {
+                    let mut hint = None;
+                    let points = wire.iter().try_fold(Vec::new(), |mut points, edge| {
+                        *work = work.checked_sub(1)?;
+                        let curve = edge.oriented_curve();
+                        let samples = curve.parameter_division(curve.range_tuple(), tol).1;
+                        *work = work.checked_sub(samples.len())?;
+                        samples.into_iter().skip(1).try_for_each(|point| {
+                            let uv = surface.search_parameter(point, hint, 100)?;
+                            hint = Some(uv);
+                            points.push(Point2::from(uv));
+                            Some(())
+                        })?;
+                        Some(points)
+                    })?;
+                    let polygon = PolylineCurve(points);
+                    let area = polygon.area();
+                    (area.is_finite() && area != 0.0).then_some((polygon, area))
+                })
+                .collect::<Option<Vec<_>>>()?;
+            let mut domains: Vec<_> = projected
+                .iter()
+                .enumerate()
+                .filter_map(|(index, (_, area))| (*area > 0.0).then_some(vec![index]))
+                .collect();
+            projected
+                .iter()
+                .enumerate()
+                .filter(|(_, (_, area))| *area < 0.0)
+                .try_for_each(|(index, (hole, area))| {
+                    *work = work.checked_sub(domains.len())?;
+                    let owner = domains
+                        .iter()
+                        .enumerate()
+                        .filter(|(_, domain)| {
+                            let (outer, outer_area) = &projected[domain[0]];
+                            *outer_area > -*area && outer.include(hole.front())
+                        })
+                        .min_by(|(_, a), (_, b)| projected[a[0]].1.total_cmp(&projected[b[0]].1))
+                        .map(|(index, _)| index)?;
+                    domains[owner].push(index);
+                    Some(())
+                })?;
+            let fragments = domains
+                .into_iter()
+                .map(|domain| {
+                    let wires = domain
+                        .into_iter()
+                        .map(|index| loops[index].iter().cloned().collect())
+                        .collect();
+                    Face::try_new(wires, surface.clone()).ok()
+                })
+                .collect::<Option<Vec<_>>>()?;
+            if fragments.is_empty() {
+                return None;
+            }
+            preserves_boundary(face, &fragments, work)?;
+            result.extend(fragments.into_iter().map(|mut fragment| {
+                if !face.orientation() {
+                    fragment.invert();
+                }
+                fragment
+            }));
+            Some(result)
+        })
+}
