+/// Retry ambiguous intersection labels with independent region membership.
+///
+/// A transverse normal test cannot assign a side at a tangency. Classifying
+/// every reconstructed region against the complete opposite boundary also
+/// avoids propagating one ambiguous label across an entire component.
+fn region_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    tol: f64,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let shell0: Shell<_, _, _> = solid0.face_iter().cloned().collect();
+    let shell1: Shell<_, _, _> = solid1
+        .face_iter()
+        .cloned()
+        .map(|mut face| {
+            if matches!(operation, Operation::Difference) {
+                face.invert();
+            }
+            face
+        })
+        .collect();
+    let mut work = 8192_usize;
+    work = work.checked_sub(shell0.len().checked_mul(shell1.len())?)?;
+    let polygons0 = shell0.triangulation(tol);
+    let polygons1 = shell1.triangulation(tol);
+    let alt0 = shell0.mapped(|p| *p, |c| Alternative::FirstType(c.clone()), Clone::clone);
+    let alt1 = shell1.mapped(|p| *p, |c| Alternative::FirstType(c.clone()), Clone::clone);
+    let stores = loops_store::create_loops_stores(&alt0, &polygons0, &alt1, &polygons1)?;
+    let regions0 = subdivision_regions(&alt0, &stores.geom_loops_store0, tol, &mut work)?;
+    let regions1 = subdivision_regions(&alt1, &stores.geom_loops_store1, tol, &mut work)?;
+    let union = matches!(operation, Operation::Union);
+    let mut selected = Shell::default();
+    [
+        (regions0, &shell1, &polygons1, true),
+        (regions1, &shell0, &polygons0, false),
+    ]
+    .into_iter()
+    .try_for_each(|(regions, other, polygons, first)| {
+        regions.into_iter().try_for_each(|face| {
+            work = work.checked_sub(polygons.len())?;
+            let (point, normal) = interior_point(&face, tol)?;
+            let keep =
+                if let Some(same) = coincident_boundary(&face, point, normal, other, polygons) {
+                    first && same
+                } else {
+                    let exterior = isize::from(first && matches!(operation, Operation::Difference));
+                    inside(point, polygons, exterior)? != union
+                };
+            if keep {
+                selected.push(face);
+            }
+            Some(())
+        })
+    })?;
+    if union && selected.is_empty() {
+        return None;
+    }
+    let shell = altshell_to_shell(&selected)?;
+    work.checked_sub(shell.edge_iter().count().checked_pow(2)?)?;
+    let shell = sew_contacts(shell, tol)?;
+    Solid::try_new(shell.connected_components()).ok()
+}
