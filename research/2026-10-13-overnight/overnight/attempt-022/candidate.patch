+/// Certify a complete tensor patch as a translation between two supporting caps.
+///
+/// Equal positive weights and equal control-point displacements prove the
+/// translation for every parameter, including the interiors of curved patches.
+fn swept_patch<S: ShapeOpsSurface>(surface: &S, caps: &[Plane; 2]) -> Option<bool> {
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    let net = spline.control_points();
+    if net.len().checked_mul(net[0].len())? > 4096
+        || !spline.knot_vectors().0.is_clamped(spline.udegree())
+        || !spline.knot_vectors().1.is_clamped(spline.vdegree())
+    {
+        return None;
+    }
+    [true, false].into_iter().find(|&along_u| {
+        let (degree, count) = if along_u {
+            (spline.udegree(), net.len())
+        } else {
+            (spline.vdegree(), net[0].len())
+        };
+        if degree != 1 || count != 2 {
+            return false;
+        }
+        let pairs: Vec<_> = if along_u {
+            net[0].iter().zip(&net[1]).collect()
+        } else {
+            net.iter().map(|row| (&row[0], &row[1])).collect()
+        };
+        let displacement = pairs[0].1.to_point() - pairs[0].0.to_point();
+        let levels = [pairs[0].0.to_point(), pairs[0].1.to_point()];
+        let on_plane = |point, plane: &Plane| {
+            let (distance, error) = plane_distance(point, plane.origin(), plane.normal());
+            distance.is_finite() && distance.abs() <= error
+        };
+        let order = if on_plane(levels[0], &caps[0]) && on_plane(levels[1], &caps[1]) {
+            Some([0, 1])
+        } else if on_plane(levels[0], &caps[1]) && on_plane(levels[1], &caps[0]) {
+            Some([1, 0])
+        } else {
+            None
+        };
+        order.is_some_and(|order| {
+            pairs.into_iter().all(|(a, b)| {
+                a.w.is_finite()
+                    && a.w > 0.0
+                    && a.w == b.w
+                    && on_plane(a.to_point(), &caps[order[0]])
+                    && on_plane(b.to_point(), &caps[order[1]])
+                    && (b.to_point() - a.to_point() - displacement).magnitude()
+                        <= 128.0
+                            * f64::EPSILON
+                            * (1.0
+                                + a.to_point().to_vec().magnitude()
+                                + b.to_point().to_vec().magnitude())
+            })
+        })
+    })
+}
