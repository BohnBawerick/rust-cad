+/// Recover an arrangement of translated side patches with common supporting caps.
+///
+/// Coplanar caps do not define transverse intersection curves. Intersect only
+/// the certified sides, then recover each cap from the oriented open boundary
+/// of the selected sides. The boundary operator fixes cavity orientations and
+/// keeps disconnected components in the same membership calculation.
+fn swept_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    tol: f64,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let all0: Shell<_, _, _> = solid0.face_iter().cloned().collect();
+    let mut all1: Shell<_, _, _> = solid1.face_iter().cloned().collect();
+    let caps: Vec<_> = all0
+        .iter()
+        .filter_map(|face| {
+            let surface = face.surface();
+            let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()?
+            else {
+                return None;
+            };
+            all1.iter()
+                .any(|other| same_support(&surface, &other.surface()))
+                .then_some((surface, plane, face.orientation()))
+        })
+        .collect();
+    if caps.len() != 2
+        || !caps[0].1.normal().cross(caps[1].1.normal()).so_small()
+        || (caps[0].1.origin() - caps[1].1.origin())
+            .dot(caps[0].1.normal())
+            .so_small()
+    {
+        return None;
+    }
+    let planes = [caps[0].1, caps[1].1];
+    let cap_index = |point: Point3| {
+        planes.iter().position(|plane| {
+            let (distance, error) = plane_distance(point, plane.origin(), plane.normal());
+            distance.is_finite() && distance.abs() <= error
+        })
+    };
+    let sides = |all: &Shell<Point3, C, S>| {
+        all.iter()
+            .filter(|face| {
+                !caps
+                    .iter()
+                    .any(|(cap, _, _)| same_support(cap, &face.surface()))
+            })
+            .map(|face| {
+                swept_patch(&face.surface(), &planes)?;
+                // Full rectangular patches have one rim on each cap and two generators.
+                if face.absolute_boundaries().len() != 1
+                    || face.edge_iter().count() != 4
+                    || !face
+                        .vertex_iter()
+                        .all(|vertex| cap_index(vertex.point()).is_some())
+                {
+                    return None;
+                }
+                Some(face.clone())
+            })
+            .collect::<Option<Shell<_, _, _>>>()
+    };
+    let sides0 = sides(&all0)?;
+    let sides1 = sides(&all1)?;
+    if sides0.is_empty() || sides1.is_empty() || sides0.len() + sides1.len() > 128 {
+        return None;
+    }
+    let infinity = if matches!(operation, Operation::Difference) {
+        all1.iter_mut().for_each(|face| {
+            face.invert();
+        });
+        1
+    } else {
+        0
+    };
+    let sides1 = if infinity == 1 { sides(&all1)? } else { sides1 };
+    let polys0 = all0.triangulation(tol);
+    let polys1 = all1.triangulation(tol);
+    let alt0: AltCurveShell<C, S> =
+        sides0.mapped(|p| *p, |c| Alternative::FirstType(c.clone()), Clone::clone);
+    let alt1: AltCurveShell<C, S> =
+        sides1.mapped(|p| *p, |c| Alternative::FirstType(c.clone()), Clone::clone);
+    let stores = loops_store::create_loops_stores(
+        &alt0,
+        &sides0.triangulation(tol),
+        &alt1,
+        &sides1.triangulation(tol),
+    )?;
+    let select = |shell: &AltCurveShell<C, S>,
+                  stores: &loops_store::LoopsStore<Point3, AltCurve<C, S>>,
+                  other: &PolyShell,
+                  exterior| {
+        shell
+            .iter()
+            .zip(stores)
+            .try_fold(Shell::default(), |mut selected, (face, loops)| {
+                let fragments = if loops
+                    .iter()
+                    .all(|wire| wire.status() == loops_store::ShapesOpStatus::Unknown)
+                {
+                    let wires = loops
+                        .iter()
+                        .map(|wire| wire.iter().cloned().collect())
+                        .collect();
+                    let mut rebuilt = Face::try_new(wires, face.surface()).ok()?;
+                    if !face.orientation() {
+                        rebuilt.invert();
+                    }
+                    iter::once(rebuilt).collect::<AltCurveShell<C, S>>()
+                } else {
+                    let single: AltCurveShell<C, S> = iter::once(face.clone()).collect();
+                    let mut store: loops_store::LoopsStore<_, _> = single.iter().collect();
+                    store[0] = loops.clone();
+                    let parts = divide_face::divide_faces(&single, &store, tol)?.and_or_unknown();
+                    parts.into_iter().flatten().collect()
+                };
+                if fragments.is_empty() {
+                    return None;
+                }
+                // Subdivision must conserve the full oriented boundary chain.
+                // Interior cuts cancel; dropping a small region cannot pass this check.
+                let mut boundary = HashMap::default();
+                loops.iter().flat_map(|wire| wire.iter()).for_each(|edge| {
+                    *boundary.entry(edge.id()).or_insert(0_isize) +=
+                        if edge.orientation() { 1 } else { -1 };
+                });
+                fragments
+                    .iter()
+                    .flat_map(|fragment| fragment.absolute_boundaries().iter())
+                    .flatten()
+                    .for_each(|edge| {
+                        *boundary.entry(edge.id()).or_insert(0_isize) -=
+                            if edge.orientation() { 1 } else { -1 };
+                    });
+                if boundary.values().any(|count| *count != 0) {
+                    return None;
+                }
+                fragments.into_iter().try_for_each(|fragment| {
+                    let (point, _) = interior_point(&fragment, tol)?;
+                    let contained = inside(point, other, exterior)?;
+                    if contained != matches!(operation, Operation::Union) {
+                        selected.push(fragment);
+                    }
+                    Some(())
+                })?;
+                Some(selected)
+            })
+    };
+    let mut selected = select(&alt0, &stores.geom_loops_store0, &polys1, infinity)?;
+    selected.extend(select(&alt1, &stores.geom_loops_store1, &polys0, 0)?);
+    if selected.is_empty() {
+        return None;
+    }
+    let converted = altshell_to_shell(&selected)?;
+    let mut rebuilt_edges = HashMap::default();
+    let mut result: Shell<Point3, C, S> = converted
+        .iter()
+        .map(|face| {
+            let surface = face.surface();
+            let along_u = swept_patch(&surface, &planes)?;
+            let wires = face
+                .absolute_boundaries()
+                .iter()
+                .map(|wire| {
+                    wire.iter()
+                        .map(|edge| {
+                            if !rebuilt_edges.contains_key(&edge.id()) {
+                                let front = cap_index(edge.absolute_front().point());
+                                let back = cap_index(edge.absolute_back().point());
+                                let curve = if front == back {
+                                    swept_rim(edge, &surface, &caps[front?].0, along_u)?
+                                } else {
+                                    edge.curve()
+                                };
+                                let rebuilt = Edge::try_new(
+                                    edge.absolute_front(),
+                                    edge.absolute_back(),
+                                    curve,
+                                )
+                                .ok()?;
+                                if !rebuilt.is_geometric_consistent() {
+                                    return None;
+                                }
+                                rebuilt_edges.insert(edge.id(), rebuilt);
+                            }
+                            let rebuilt = rebuilt_edges.get(&edge.id())?;
+                            Some(if edge.orientation() {
+                                rebuilt.clone()
+                            } else {
+                                rebuilt.inverse()
+                            })
+                        })
+                        .collect::<Option<Wire<_, _>>>()
+                })
+                .collect::<Option<Vec<_>>>()?;
+            let mut rebuilt = Face::try_new(wires, surface).ok()?;
+            if !face.orientation() {
+                rebuilt.invert();
+            }
+            Some(rebuilt)
+        })
+        .collect::<Option<_>>()?;
+    let boundaries = result.extract_boundaries();
+    if boundaries.is_empty() {
+        return None;
+    }
+    caps.iter()
+        .enumerate()
+        .try_for_each(|(index, (surface, _, orientation))| {
+            let loops = boundaries
+                .iter()
+                .filter(|wire| {
+                    wire.vertex_iter()
+                        .all(|vertex| cap_index(vertex.point()) == Some(index))
+                })
+                .map(|wire| {
+                    let wire = if *orientation {
+                        wire.inverse()
+                    } else {
+                        wire.clone()
+                    };
+                    let points = wire.iter().try_fold(Vec::new(), |mut points, edge| {
+                        let curve = edge.oriented_curve();
+                        curve
+                            .parameter_division(curve.range_tuple(), tol)
+                            .1
+                            .into_iter()
+                            .skip(1)
+                            .try_for_each(|point| {
+                                points.push(Point2::from(
+                                    surface.search_parameter(point, None, 100)?,
+                                ));
+                                Some(())
+                            })?;
+                        Some(points)
+                    })?;
+                    let polygon = PolylineCurve(points);
+                    let area = polygon.area();
+                    (area.is_finite() && area != 0.0).then_some((wire, polygon, area))
+                })
+                .collect::<Option<Vec<_>>>()?;
+            let mut regions: Vec<_> = loops
+                .iter()
+                .enumerate()
+                .filter_map(|(i, (_, _, area))| (*area > 0.0).then_some(vec![i]))
+                .collect();
+            loops
+                .iter()
+                .enumerate()
+                .filter(|(_, (_, _, area))| *area < 0.0)
+                .try_for_each(|(i, (_, polygon, area))| {
+                    let owner = regions
+                        .iter_mut()
+                        .filter(|region| {
+                            loops[region[0]].2 > -*area
+                                && loops[region[0]].1.include(polygon.front())
+                        })
+                        .min_by(|a, b| loops[a[0]].2.total_cmp(&loops[b[0]].2))?;
+                    owner.push(i);
+                    Some(())
+                })?;
+            regions.into_iter().try_for_each(|region| {
+                let wires = region.into_iter().map(|i| loops[i].0.clone()).collect();
+                let mut face = Face::try_new(wires, surface.clone()).ok()?;
+                if !orientation {
+                    face.invert();
+                }
+                result.push(face);
+                Some(())
+            })
+        })?;
+    Solid::try_new(result.connected_components()).ok()
+}
