+/// Rebuild a cap rim from the exact rational isoparametric curve of its side.
+///
+/// Both incident faces receive exact trims. This also avoids using a projected
+/// marching leader as the geometry of an edge already present in the input.
+fn swept_rim<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    edge: &Edge<Point3, C>,
+    side: &S,
+    cap: &S,
+    along_u: bool,
+) -> Option<C> {
+    let spline = side.try_into_homogeneous_bspline_surface()?;
+    let a = side.search_parameter(edge.absolute_front().point(), None, 100)?;
+    let b = side.search_parameter(edge.absolute_back().point(), Some(a), 100)?;
+    let ((u0, u1), (v0, v1)) = spline.range_tuple();
+    let (mut curve, start, end) = if along_u {
+        let index = if a.0.near(&u0) && b.0.near(&u0) {
+            0
+        } else if a.0.near(&u1) && b.0.near(&u1) {
+            spline.control_points().len() - 1
+        } else {
+            return None;
+        };
+        (NurbsCurve::new(spline.curve_v(index)), a.1, b.1)
+    } else {
+        let index = if a.1.near(&v0) && b.1.near(&v0) {
+            0
+        } else if a.1.near(&v1) && b.1.near(&v1) {
+            spline.control_points()[0].len() - 1
+        } else {
+            return None;
+        };
+        (NurbsCurve::new(spline.curve_u(index)), a.0, b.0)
+    };
+    let (low, high) = (start.min(end), start.max(end));
+    let (first, last) = curve.range_tuple();
+    if low < first || high > last || low >= high {
+        return None;
+    }
+    if low > first {
+        curve = curve.cut(low);
+    }
+    if high < last {
+        curve.cut(high);
+    }
+    if start > end {
+        curve.invert();
+    }
+    // An affine cap chart preserves rational basis functions under projection.
+    let cap_spline = cap.try_into_homogeneous_bspline_surface()?;
+    let controls = cap_spline.control_points();
+    if cap_spline.degrees() != (1, 1)
+        || controls.len() != 2
+        || controls[0].len() != 2
+        || !controls.iter().flatten().all(|p| p.w == controls[0][0].w)
+        || !(controls[1][1].to_point() - controls[1][0].to_point())
+            .near(&(controls[0][1].to_point() - controls[0][0].to_point()))
+    {
+        return None;
+    }
+    let uv_controls = curve
+        .control_points()
+        .iter()
+        .map(|control| {
+            let (u, v) = cap.search_parameter(control.to_point(), None, 100)?;
+            Some(Vector3::new(u * control.w, v * control.w, control.w))
+        })
+        .collect::<Option<Vec<_>>>()?;
+    let cap_boundary = ParameterCurve::new(
+        BoundaryCurve2D::NurbsCurve(NurbsCurve::new(BsplineCurve::new(
+            curve.knot_vector().clone(),
+            uv_controls,
+        ))),
+        cap.clone(),
+    );
+    let side_boundary = ParameterCurve::new(
+        BoundaryCurve2D::Line(Line(Point2::from(a), Point2::from(b))),
+        side.clone(),
+    );
+    Some(
+        SurfaceCurve::with_boundaries(
+            side.clone(),
+            cap.clone(),
+            curve,
+            Some(side_boundary),
+            Some(cap_boundary),
+        )
+        .into(),
+    )
+}
