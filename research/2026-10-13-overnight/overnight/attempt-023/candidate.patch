+/// Recover a union whose operands meet only in lower-dimensional boundary sets.
+///
+/// A supporting separator excludes an overlap of material interiors. If at
+/// least one operand has no open boundary patch in that plane, there is no
+/// shared face to remove. The regularized union is then represented by the
+/// original closed oriented shells, even at tangencies. In particular, cavity
+/// shells must not be inverted or merged according to component order.
+/// This certificate uses complete supports, never a box of boundary vertices.
+fn contact_union<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+) -> Option<Solid<Point3, C, S>> {
+    let (min0, max0) = solid_enclosure(solid0)?;
+    let (min1, max1) = solid_enclosure(solid1)?;
+    let mut work = 65_536_usize;
+    let certified = [
+        (max0, min1, Vector3::unit_x()),
+        (max1, min0, Vector3::unit_x()),
+        (max0, min1, Vector3::unit_y()),
+        (max1, min0, Vector3::unit_y()),
+        (max0, min1, Vector3::unit_z()),
+        (max1, min0, Vector3::unit_z()),
+    ]
+    .into_iter()
+    .any(|(lower, upper, normal)| {
+        let (gap, _) = plane_distance(upper, lower, normal);
+        if !gap.is_finite() || gap < 0.0 {
+            return false;
+        }
+        // Require weak separation without enlarging either enclosure. A
+        // negative gap, however small, still requires intersection assembly.
+        let origin = lower + (upper - lower) * 0.5;
+        boundary_has_no_planar_patch(solid0, origin, normal, &mut work).is_some()
+            || boundary_has_no_planar_patch(solid1, origin, normal, &mut work).is_some()
+    });
+    if certified {
+        Solid::try_new(
+            solid0
+                .boundaries()
+                .iter()
+                .chain(solid1.boundaries())
+                .cloned()
+                .collect(),
+        )
+        .ok()
+    } else {
+        None
+    }
+}
