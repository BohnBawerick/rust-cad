+/// Certify that a solid boundary has no open patch in a given plane.
+///
+/// Positive spline weights reduce plane incidence to a polynomial numerator on
+/// each knot rectangle. The active basis is linearly independent, so a control
+/// coefficient separated from zero proves that the numerator is not identically
+/// zero there. Its zero set has no surface interior. Checking every rectangle
+/// matters: a curved spline can also contain an entire planar span.
+fn boundary_has_no_planar_patch<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    origin: Point3,
+    normal: Vector3,
+    work: &mut usize,
+) -> Option<()> {
+    solid.face_iter().try_for_each(|face| {
+        *work = work.checked_sub(1)?;
+        let surface = face.surface();
+        let spline = surface.try_into_homogeneous_bspline_surface()?;
+        let controls = spline.control_points();
+        let separated = |control: &Vector4| {
+            let (distance, error) = plane_distance(control.to_point(), origin, normal);
+            distance.is_finite() && error.is_finite() && distance.abs() > error
+        };
+        if surface.supports_exact_patch_domains() {
+            let (udegree, vdegree) = spline.degrees();
+            let (uknots, vknots) = spline.knot_vectors();
+            let nu = controls.len();
+            let nv = controls.first()?.len();
+            if !uknots.is_clamped(udegree) || !vknots.is_clamped(vdegree) {
+                return None;
+            }
+            let count = nu
+                .checked_mul(nv)?
+                .checked_mul(udegree.checked_add(1)?)?
+                .checked_mul(vdegree.checked_add(1)?)?;
+            *work = work.checked_sub(count)?;
+            (udegree < nu
+                && vdegree < nv
+                && (udegree..nu)
+                    .filter(|&u| uknots[u] < uknots[u + 1])
+                    .all(|u| {
+                        (vdegree..nv)
+                            .filter(|&v| vknots[v] < vknots[v + 1])
+                            .all(|v| {
+                                controls[u - udegree..=u]
+                                    .iter()
+                                    .any(|row| row[v - vdegree..=v].iter().any(separated))
+                            })
+                    }))
+            .then_some(())
+        } else {
+            // The enclosure certificate admits only planes in this branch.
+            // Their finite conversion charts establish the identity of the
+            // complete analytic support, including trims outside those charts.
+            let AnalyticSurfaceKind::Plane(_) = surface.try_into_analytic_surface_kind()? else {
+                return None;
+            };
+            *work = work.checked_sub(controls.iter().map(Vec::len).sum())?;
+            controls.iter().flatten().any(separated).then_some(())
+        }
+    })
+}
