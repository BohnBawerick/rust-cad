+/// Return the containing shell's winding only for strict whole-enclosure inclusion.
+fn enclosed_winding(
+    points: &[Point3],
+    boundary: Option<&ConvexBoundary>,
+    work: &mut usize,
+) -> Option<isize> {
+    let Some(boundary) = boundary else {
+        return Some(0);
+    };
+    *work = work.checked_sub(points.len().checked_mul(boundary.planes.len())?)?;
+    let contained = boundary.planes.iter().all(|&(origin, normal)| {
+        points.iter().all(|point| {
+            let (distance, error) = plane_distance(*point, origin, normal);
+            distance.is_finite() && error.is_finite() && distance < -error
+        })
+    });
+    Some(if contained { boundary.winding } else { 0 })
+}
+
+/// Bound all projections, also retaining support points for a separator search.
+fn enclosure_interval(
+    points: &[Point3],
+    origin: Point3,
+    normal: Vector3,
+    work: &mut usize,
+) -> Option<(f64, f64, Point3, Point3)> {
+    *work = work.checked_sub(points.len())?;
+    let first = *points.first()?;
+    points.iter().try_fold(
+        (f64::INFINITY, f64::NEG_INFINITY, first, first),
+        |(low, high, low_point, high_point), point| {
+            let (distance, error) = plane_distance(*point, origin, normal);
+            if !distance.is_finite() || !error.is_finite() {
+                return None;
+            }
+            let lower = distance - error;
+            let upper = distance + error;
+            Some((
+                low.min(lower),
+                high.max(upper),
+                if lower < low { *point } else { low_point },
+                if upper > high { *point } else { high_point },
+            ))
+        },
+    )
+}
