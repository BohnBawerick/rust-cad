+/// Search the Minkowski difference for a strict supporting separator.
+///
+/// Segment minimization proposes directions; only an independently bounded
+/// projection interval can certify separation. Lack of convergence is failure
+/// to certify, never evidence of either intersection or containment.
+fn separated_enclosures(first: &[Point3], second: &[Point3], work: &mut usize) -> Option<bool> {
+    let origin = *first.first()?;
+    let center = |points: &[Point3]| {
+        points.iter().map(|point| *point - origin).sum::<Vector3>() / points.len() as f64
+    };
+    let initial = center(first) - center(second);
+    let (_, separated) = (0..48).try_fold((initial, false), |(closest, separated), _| {
+        if separated || closest.magnitude2() == 0.0 {
+            return Some((closest, separated));
+        }
+        if !closest.magnitude2().is_finite() {
+            return None;
+        }
+        let direction = closest.normalize();
+        let (low0, _, support0, _) = enclosure_interval(first, origin, direction, work)?;
+        let (_, high1, _, support1) = enclosure_interval(second, origin, direction, work)?;
+        if low0 > high1 {
+            Some((closest, true))
+        } else {
+            let delta = (support0 - support1) - closest;
+            let length2 = delta.magnitude2();
+            if !length2.is_finite() {
+                return None;
+            }
+            let step = if length2 == 0.0 {
+                0.0
+            } else {
+                (-closest.dot(delta) / length2).clamp(0.0, 1.0)
+            };
+            Some((closest + delta * step, false))
+        }
+    })?;
+    Some(separated)
+}
