+/// Assemble exact boundaries when every cross-operand shell pair is certified.
+///
+/// Each pair must be strictly separated or nested inside a convex planar shell.
+/// Consequently membership is constant on each complete boundary component.
+/// Summing the containing shells' signed windings includes cavities and islands;
+/// subtraction reverses only retained boundaries from the second operand.
+fn enclosed_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let mut work = 262_144;
+    let mut enclose = |solid: &Solid<Point3, C, S>| {
+        solid
+            .boundaries()
+            .iter()
+            .map(|shell| {
+                let points = support_enclosure(shell.iter(), &mut work)?;
+                let convex = convex_boundary(shell, &points, &mut work);
+                Some((points, convex))
+            })
+            .collect::<Option<Vec<_>>>()
+    };
+    let first = enclose(solid0)?;
+    let second = enclose(solid1)?;
+    let mut winding0 = vec![0_isize; first.len()];
+    let mut winding1 = vec![0_isize; second.len()];
+    first
+        .iter()
+        .zip(&mut winding0)
+        .try_for_each(|((points0, convex0), winding0)| {
+            second
+                .iter()
+                .zip(&mut winding1)
+                .try_for_each(|((points1, convex1), winding1)| {
+                    let inside1 = enclosed_winding(points0, convex1.as_ref(), &mut work)?;
+                    if inside1 != 0 {
+                        *winding0 += inside1;
+                        Some(())
+                    } else {
+                        let inside0 = enclosed_winding(points1, convex0.as_ref(), &mut work)?;
+                        if inside0 != 0 {
+                            *winding1 += inside0;
+                            Some(())
+                        } else {
+                            separated_enclosures(points0, points1, &mut work)?.then_some(())
+                        }
+                    }
+                })
+        })?;
+    if winding0
+        .iter()
+        .chain(&winding1)
+        .any(|winding| !(0..=1).contains(winding))
+    {
+        return None;
+    }
+    let select = |first: bool, winding: isize| match operation {
+        Operation::Union => winding == 0,
+        Operation::Intersection => winding == 1,
+        Operation::Difference => (winding == 0) == first,
+    };
+    let boundaries = solid0
+        .boundaries()
+        .iter()
+        .zip(winding0)
+        .filter(|(_, winding)| select(true, *winding))
+        .map(|(shell, _)| shell.clone())
+        .chain(
+            solid1
+                .boundaries()
+                .iter()
+                .zip(winding1)
+                .filter(|(_, winding)| select(false, *winding))
+                .map(|(shell, _)| {
+                    let mut shell = shell.clone();
+                    if matches!(operation, Operation::Difference) {
+                        shell.iter_mut().for_each(|face| {
+                            face.invert();
+                        });
+                    }
+                    shell
+                }),
+        )
+        .collect();
+    Solid::try_new(boundaries).ok()
+}
