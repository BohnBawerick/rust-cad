+/// A closed convex boundary described by outward support planes and its winding.
+struct ConvexBoundary {
+    planes: Vec<(Point3, Vector3)>,
+    winding: isize,
+}
+
+/// Certify convexity against the complete enclosure of a closed planar shell.
+///
+/// Every face must support the entire enclosure on the same material side.
+/// For a valid closed shell these halfspaces describe its bounded interior.
+/// An inward cavity has the opposite winding but the same bounded interior.
+fn convex_boundary<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &Shell<Point3, C, S>,
+    enclosure: &[Point3],
+    work: &mut usize,
+) -> Option<ConvexBoundary> {
+    let mut winding = 0;
+    let planes = shell
+        .iter()
+        .map(|face| {
+            *work = work.checked_sub(enclosure.len() + face.edge_iter().count())?;
+            let surface = face.surface();
+            let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()?
+            else {
+                return None;
+            };
+            let spline = surface.try_into_homogeneous_bspline_surface()?;
+            *work = work.checked_sub(spline.control_points().iter().map(Vec::len).sum())?;
+            if !spline.control_points().iter().flatten().all(|control| {
+                let (distance, error) =
+                    plane_distance(control.to_point(), plane.origin(), plane.normal());
+                control.w > 0.0
+                    && distance.is_finite()
+                    && error.is_finite()
+                    && distance.abs() <= error
+            }) {
+                return None;
+            }
+            let origin = face.edge_iter().next()?.front().point();
+            let area = face.edge_iter().fold(Vector3::zero(), |area, edge| {
+                area + (edge.front().point() - origin).cross(edge.back().point() - origin)
+            });
+            let orientation = area.dot(plane.normal());
+            if !orientation.is_finite() || orientation == 0.0 {
+                return None;
+            }
+            let normal = plane.normal() * orientation.signum();
+            let (behind, ahead, strict_behind, strict_ahead) = enclosure.iter().try_fold(
+                (true, true, false, false),
+                |(behind, ahead, strict_behind, strict_ahead), point| {
+                    let (distance, error) = plane_distance(*point, plane.origin(), normal);
+                    (distance.is_finite() && error.is_finite()).then_some((
+                        behind && distance <= error,
+                        ahead && distance >= -error,
+                        strict_behind || distance < -error,
+                        strict_ahead || distance > error,
+                    ))
+                },
+            )?;
+            let sign = if behind && strict_behind {
+                1
+            } else if ahead && strict_ahead {
+                -1
+            } else {
+                return None;
+            };
+            if winding != 0 && winding != sign {
+                return None;
+            }
+            winding = sign;
+            Some((plane.origin(), normal * sign as f64))
+        })
+        .collect::<Option<Vec<_>>>()?;
+    (winding != 0).then_some(ConvexBoundary { planes, winding })
+}
