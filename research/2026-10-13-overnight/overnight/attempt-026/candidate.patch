+/// Isolate section intersections with positive-weight rational convex hulls.
+///
+/// Subdivision uses homogeneous de Casteljau, so no chord can certify separation.
+/// Ambiguous, tangent, or unresolved intersections decline the entire fallback.
+fn section_crossings(
+    a: &NurbsCurve<Vector4>,
+    b: &NurbsCurve<Vector4>,
+    normal: Vector3,
+    work: &mut usize,
+) -> Option<Vec<(f64, f64)>> {
+    let spans = |curve: &NurbsCurve<Vector4>| {
+        curve
+            .non_rationalized()
+            .bezier_decomposition()
+            .into_iter()
+            .map(|span| (span.range_tuple(), span.control_points().clone()))
+            .collect::<Vec<_>>()
+    };
+    let spans_a = spans(a);
+    let spans_b = spans(b);
+    *work = work.checked_sub(spans_a.len().checked_mul(spans_b.len())?)?;
+    let mut stack = spans_a
+        .iter()
+        .flat_map(|a| spans_b.iter().map(move |b| (a.clone(), b.clone(), 0)))
+        .collect::<Vec<_>>();
+    let bounds = |controls: &[Vector4]| {
+        controls.iter().try_fold(
+            (
+                Point3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY),
+                Point3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY),
+            ),
+            |(min, max), control| {
+                let p = control.to_point();
+                (control.w > 0.0 && p.x.is_finite() && p.y.is_finite() && p.z.is_finite())
+                    .then_some((
+                        Point3::new(min.x.min(p.x), min.y.min(p.y), min.z.min(p.z)),
+                        Point3::new(max.x.max(p.x), max.y.max(p.y), max.z.max(p.z)),
+                    ))
+            },
+        )
+    };
+    let split = |controls: &[Vector4]| {
+        let mut row = controls.to_vec();
+        let mut left = vec![row[0]];
+        let mut right = vec![row[row.len() - 1]];
+        while row.len() > 1 {
+            row = row
+                .windows(2)
+                .map(|pair| (pair[0] + pair[1]) / 2.0)
+                .collect();
+            left.push(row[0]);
+            right.push(row[row.len() - 1]);
+        }
+        right.reverse();
+        (left, right)
+    };
+    let mut roots: Vec<(f64, f64)> = Vec::new();
+    while let Some(((ra, ca), (rb, cb), depth)) = stack.pop() {
+        *work = work.checked_sub(ca.len() + cb.len())?;
+        let (mina, maxa) = bounds(&ca)?;
+        let (minb, maxb) = bounds(&cb)?;
+        let separated = (0..3).any(|axis| {
+            let error = 64.0
+                * f64::EPSILON
+                * (mina[axis].abs() + maxa[axis].abs() + minb[axis].abs() + maxb[axis].abs());
+            maxa[axis] < minb[axis] - error || maxb[axis] < mina[axis] - error
+        });
+        if separated {
+            continue;
+        }
+        if depth >= 48 || (mina.near(&maxa) && minb.near(&maxb)) {
+            let (mut u, mut v) = ((ra.0 + ra.1) / 2.0, (rb.0 + rb.1) / 2.0);
+            (0..12).try_for_each(|_| {
+                let delta = a.evaluate(u) - b.evaluate(v);
+                let da = a.derivative(u);
+                let db = b.derivative(v);
+                let determinant = da.cross(db).dot(normal);
+                if !determinant.is_finite() || determinant.so_small() {
+                    return None;
+                }
+                u -= delta.cross(db).dot(normal) / determinant;
+                v -= delta.cross(da).dot(normal) / determinant;
+                (u.is_finite() && v.is_finite()).then_some(())
+            })?;
+            let within = |value: f64, range: (f64, f64)| {
+                (value >= range.0 || value.near(&range.0))
+                    && (value <= range.1 || value.near(&range.1))
+            };
+            if !within(u, ra) || !within(v, rb) || !a.evaluate(u).near(&b.evaluate(v)) {
+                return None;
+            }
+            let ar = a.range_tuple();
+            let br = b.range_tuple();
+            u = u.clamp(ar.0, ar.1);
+            v = v.clamp(br.0, br.1);
+            if !roots.iter().any(|(s, t)| u.near(s) && v.near(t)) {
+                roots.push((u, v));
+            }
+        } else if (maxa - mina).magnitude2() >= (maxb - minb).magnitude2() {
+            let (left, right) = split(&ca);
+            let middle = (ra.0 + ra.1) / 2.0;
+            stack.push((((middle, ra.1), right), (rb, cb.clone()), depth + 1));
+            stack.push((((ra.0, middle), left), (rb, cb), depth + 1));
+        } else {
+            let (left, right) = split(&cb);
+            let middle = (rb.0 + rb.1) / 2.0;
+            stack.push(((ra, ca.clone()), ((middle, rb.1), right), depth + 1));
+            stack.push(((ra, ca), ((rb.0, middle), left), depth + 1));
+        }
+    }
+    Some(roots)
+}
