+/// Assemble failed common-sweep operations from exact section curves.
+fn sweep_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+    tol: f64,
+) -> Option<Solid<Point3, C, S>> {
+    if solid0.face_iter().count() > 128 || solid1.face_iter().count() > 128 {
+        return None;
+    }
+    let caps = solid0
+        .face_iter()
+        .filter_map(|face| certified_plane(&face.surface()).map(|plane| (face, plane)))
+        .collect::<Vec<_>>();
+    let (bottom_face, bottom, top_face, translation, arcs0, arcs1) =
+        caps.iter().enumerate().find_map(|(i, (a, pa))| {
+            caps.iter().skip(i + 1).find_map(|(b, pb)| {
+                if !pa.normal().cross(pb.normal()).so_small() {
+                    return None;
+                }
+                let normal = pa.normal().normalize();
+                let translation = normal * (pb.origin() - pa.origin()).dot(normal);
+                if translation.so_small() {
+                    return None;
+                }
+                let arcs0 = sweep_arcs(solid0, pa, translation)?;
+                let arcs1 = sweep_arcs(solid1, pa, translation)?;
+                Some((*a, *pa, *b, translation, arcs0, arcs1))
+            })
+        })?;
+    let count0 = arcs0.len();
+    let arcs = arcs0.into_iter().chain(arcs1).collect::<Vec<_>>();
+    let mut parameters = arcs
+        .iter()
+        .map(|arc| {
+            let (a, b) = arc.curve.range_tuple();
+            vec![a, b]
+        })
+        .collect::<Vec<_>>();
+    let mut work = 262_144;
+    (0..count0).try_for_each(|i| {
+        (count0..arcs.len()).try_for_each(|j| {
+            section_crossings(&arcs[i].curve, &arcs[j].curve, bottom.normal(), &mut work)?
+                .into_iter()
+                .for_each(|(u, v)| {
+                    parameters[i].push(u);
+                    parameters[j].push(v);
+                });
+            Some(())
+        })
+    })?;
+    let polygons0: PolyShell = solid0
+        .face_iter()
+        .cloned()
+        .collect::<Shell<_, _, _>>()
+        .triangulation(tol);
+    let polygons1: PolyShell = solid1
+        .face_iter()
+        .cloned()
+        .collect::<Shell<_, _, _>>()
+        .triangulation(tol);
+    let mut patches = Vec::new();
+    arcs.iter()
+        .zip(&mut parameters)
+        .enumerate()
+        .try_for_each(|(index, (arc, parameters))| {
+            parameters.sort_by(f64::total_cmp);
+            parameters.dedup_by(|a, b| (*a).near(&*b));
+            parameters.windows(2).try_for_each(|span| {
+                let point = arc.curve.evaluate((span[0] + span[1]) / 2.0) + translation / 2.0;
+                let in_other = inside(
+                    point,
+                    if index < count0 {
+                        &polygons1
+                    } else {
+                        &polygons0
+                    },
+                    0,
+                )?;
+                let keep = match operation {
+                    Operation::Intersection => in_other,
+                    Operation::Union => !in_other,
+                    Operation::Difference => in_other == (index >= count0),
+                };
+                if keep {
+                    let reverse = matches!(operation, Operation::Difference) && index >= count0;
+                    let mut curve = section_trim(&arc.curve, span[0], span[1])?;
+                    if reverse {
+                        curve.invert();
+                    }
+                    patches.push(SweepArc {
+                        curve,
+                        surface: arc.surface.clone(),
+                        orientation: arc.orientation != reverse,
+                    });
+                }
+                Some(())
+            })
+        })?;
+    if patches.is_empty() {
+        return if matches!(operation, Operation::Union) {
+            None
+        } else {
+            Solid::try_new(Vec::new()).ok()
+        };
+    }
+    let mut vertices: Vec<(Vertex<Point3>, Vertex<Point3>)> = Vec::new();
+    let indices = patches
+        .iter()
+        .map(|patch| {
+            [patch.curve.front(), patch.curve.back()].map(|point| {
+                if let Some(index) = vertices.iter().position(|(a, _)| a.point().near(&point)) {
+                    index
+                } else {
+                    let index = vertices.len();
+                    vertices.push((Vertex::new(point), Vertex::new(point + translation)));
+                    index
+                }
+            })
+        })
+        .collect::<Vec<_>>();
+    let verticals = vertices
+        .iter()
+        .enumerate()
+        .map(|(index, (a, b))| {
+            let adjacent = indices
+                .iter()
+                .enumerate()
+                .filter(|(_, pair)| pair.contains(&index))
+                .map(|(i, _)| i)
+                .collect::<Vec<_>>();
+            if adjacent.len() != 2 {
+                return None;
+            }
+            let surface0 = patches[adjacent[0]].surface.clone();
+            let surface1 = patches[adjacent[1]].surface.clone();
+            let uv0 = surface0.search_parameter(a.point(), None, 100)?;
+            let uv1 = surface0.search_parameter(b.point(), Some(uv0), 100)?;
+            let other = surface1.search_parameter(a.point(), None, 100)?;
+            let tangent = surface0
+                .normal(uv0.0, uv0.1)
+                .cross(surface1.normal(other.0, other.1))
+                .so_small();
+            let curve = if tangent {
+                // A seam on one smooth support has no transverse SSI derivative.
+                // Its certified sweep generator is an exact parameter line.
+                if !uv0.0.near(&uv1.0) && !uv0.1.near(&uv1.1) {
+                    return None;
+                }
+                let line = ParameterCurve::new(Line(uv0.into(), uv1.into()), surface0);
+                if ![0.25, 0.5, 0.75].into_iter().all(|t| {
+                    line.evaluate(t)
+                        .near(&(a.point() + (b.point() - a.point()) * t))
+                }) {
+                    return None;
+                }
+                C::try_from(line).ok()?
+            } else {
+                let boundary0: Option<ParameterCurve<BoundaryCurve2D, S>> = None;
+                let boundary1: Option<ParameterCurve<BoundaryCurve2D, S>> = None;
+                SurfaceCurve::with_boundaries(
+                    surface0,
+                    surface1,
+                    BsplineCurve::from(Line(a.point(), b.point())),
+                    boundary0,
+                    boundary1,
+                )
+                .into()
+            };
+            Edge::try_new(a, b, curve).ok()
+        })
+        .collect::<Option<Vec<Edge<Point3, C>>>>()?;
+    let mut shell = patches
+        .iter()
+        .zip(indices)
+        .map(|(patch, [a, b])| {
+            let mut top_curve = patch.curve.clone();
+            top_curve.control_points_mut().for_each(|control| {
+                let shift = translation * control.w;
+                control.x += shift.x;
+                control.y += shift.y;
+                control.z += shift.z;
+            });
+            let make_curve = |curve, cap| {
+                let boundary0: Option<ParameterCurve<BoundaryCurve2D, S>> = None;
+                let boundary1: Option<ParameterCurve<BoundaryCurve2D, S>> = None;
+                C::from(SurfaceCurve::with_boundaries(
+                    patch.surface.clone(),
+                    cap,
+                    curve,
+                    boundary0,
+                    boundary1,
+                ))
+            };
+            let lower = Edge::try_new(
+                &vertices[a].0,
+                &vertices[b].0,
+                make_curve(patch.curve.clone(), bottom_face.surface()),
+            )
+            .ok()?;
+            let upper = Edge::try_new(
+                &vertices[a].1,
+                &vertices[b].1,
+                make_curve(top_curve, top_face.surface()),
+            )
+            .ok()?;
+            let wire = Wire::from(vec![
+                lower,
+                verticals[b].clone(),
+                upper.inverse(),
+                verticals[a].inverse(),
+            ]);
+            let wire = if patch.orientation {
+                wire
+            } else {
+                wire.inverse()
+            };
+            let mut face = Face::try_new(vec![wire], patch.surface.clone()).ok()?;
+            if !patch.orientation {
+                face.invert();
+            }
+            Some(face)
+        })
+        .collect::<Option<Shell<Point3, C, S>>>()?;
+    let boundaries = shell.extract_boundaries();
+    [bottom_face, top_face].into_iter().try_for_each(|cap| {
+        let plane = certified_plane(&cap.surface())?;
+        let wires = boundaries
+            .iter()
+            .filter(|wire| {
+                wire.front_vertex().is_some_and(|vertex| {
+                    let (distance, error) =
+                        plane_distance(vertex.point(), plane.origin(), plane.normal());
+                    distance.abs() <= error
+                })
+            })
+            .map(|wire| {
+                let wire = if cap.orientation() {
+                    wire.inverse()
+                } else {
+                    wire.clone()
+                };
+                loops_store::BoundaryWire::new(wire, loops_store::ShapesOpStatus::And)
+            })
+            .collect::<loops_store::Loops<_, _>>();
+        if wires.is_empty() {
+            return None;
+        }
+        let mut store: loops_store::LoopsStore<_, _> = iter::once(cap).collect();
+        store[0] = wires;
+        let cap_shell = iter::once(cap.clone()).collect();
+        let [mut divided, _, _] =
+            divide_face::divide_faces(&cap_shell, &store, tol)?.and_or_unknown();
+        shell.append(&mut divided);
+        Some(())
+    })?;
+    if !shell.edge_iter().all(|edge| edge.is_geometric_consistent()) {
+        return None;
+    }
+    Solid::try_new(shell.connected_components()).ok()
+}
+
 fn boolean_classic<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
     solid0: &Solid<Point3, C, S>,
     solid1: &Solid<Point3, C, S>,
@@ -1347,6 +1934,7 @@
     } else {
         boolean_classic(solid0, solid1, tol, operation)
             .or_else(|error| planar_boolean(solid0, solid1, operation, true).ok_or(error))
+            .or_else(|error| sweep_boolean(solid0, solid1, operation, tol).ok_or(error))
     }
 }
 
