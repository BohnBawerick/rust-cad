+/// Certify a planar support against its complete homogeneous control net.
+fn certified_plane<S: ShapeOpsSurface>(surface: &S) -> Option<Plane> {
+    let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()? else {
+        return None;
+    };
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    spline
+        .control_points()
+        .iter()
+        .flatten()
+        .all(|control| {
+            let (distance, error) =
+                plane_distance(control.to_point(), plane.origin(), plane.normal());
+            control.w > 0.0 && distance.is_finite() && error.is_finite() && distance.abs() <= error
+        })
+        .then_some(plane)
+}
+
+/// Trim a rational section without cutting at an existing domain endpoint.
+fn section_trim(curve: &NurbsCurve<Vector4>, start: f64, end: f64) -> Option<NurbsCurve<Vector4>> {
+    let (a, b) = curve.range_tuple();
+    if start < a || end > b || start >= end || start.near(&end) {
+        return None;
+    }
+    let mut result = curve.clone();
+    if !end.near(&b) {
+        let _ = result.cut(end);
+    }
+    if !start.near(&a) {
+        result = result.cut(start);
+    }
+    Some(result)
+}
+
+/// Recover a section from a control net with weights constant along translation.
+///
+/// Both cap incidences and all four side trims are checked. The support identity
+/// proves the sweep between the caps, rather than inferring it from vertices.
+fn sweep_arcs<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    bottom: &Plane,
+    translation: Vector3,
+) -> Option<Vec<SweepArc<C, S>>> {
+    let normal = translation.normalize();
+    let top_origin = bottom.origin() + translation;
+    let on_plane = |point, origin| {
+        let (distance, error) = plane_distance(point, origin, normal);
+        distance.is_finite() && distance.abs() <= error
+    };
+    let mut cap_edges = HashMap::default();
+    let mut sides = Vec::new();
+    solid.face_iter().try_for_each(|face| {
+        let cap = certified_plane(&face.surface()).and_then(|plane| {
+            if !plane.normal().cross(normal).so_small() {
+                None
+            } else if on_plane(plane.origin(), bottom.origin()) {
+                Some(false)
+            } else if on_plane(plane.origin(), top_origin) {
+                Some(true)
+            } else {
+                None
+            }
+        });
+        if let Some(top) = cap {
+            face.edge_iter()
+                .try_for_each(|edge| cap_edges.insert(edge.id(), top).is_none().then_some(()))
+        } else {
+            sides.push(face);
+            Some(())
+        }
+    })?;
+    if sides.is_empty() || sides.len() > 128 {
+        return None;
+    }
+    let arcs = sides
+        .into_iter()
+        .map(|face| {
+            let edges = face.edge_iter().collect::<Vec<_>>();
+            if edges.len() != 4 || face.absolute_boundaries().len() != 1 {
+                return None;
+            }
+            let lower = edges
+                .iter()
+                .filter(|edge| cap_edges.get(&edge.id()) == Some(&false))
+                .collect::<Vec<_>>();
+            let upper = edges
+                .iter()
+                .filter(|edge| cap_edges.get(&edge.id()) == Some(&true))
+                .collect::<Vec<_>>();
+            if lower.len() != 1 || upper.len() != 1 {
+                return None;
+            }
+            let lower = lower[0];
+            let upper = upper[0];
+            let surface = face.surface();
+            let mut curve = if certified_plane(&surface).is_some() {
+                // Two distinct planes intersect in exactly one straight line.
+                NurbsCurve::new(BsplineCurve::from(Line(
+                    lower.front().point().to_homogeneous(),
+                    lower.back().point().to_homogeneous(),
+                )))
+            } else {
+                if !surface.supports_exact_patch_domains() {
+                    return None;
+                }
+                let spline = surface.try_into_homogeneous_bspline_surface()?;
+                let controls = spline.control_points();
+                if controls.iter().map(Vec::len).sum::<usize>() > 4096
+                    || !spline.knot_vector_u().is_clamped(spline.udegree())
+                    || !spline.knot_vector_v().is_clamped(spline.vdegree())
+                {
+                    return None;
+                }
+                let (a, b) = if spline.udegree() == 1 && controls.len() == 2 {
+                    (spline.curve_v(0), spline.curve_v(1))
+                } else if spline.vdegree() == 1 && controls.iter().all(|row| row.len() == 2) {
+                    (spline.curve_u(0), spline.curve_u(1))
+                } else {
+                    return None;
+                };
+                let is_lower = on_plane(a.control_point(0).to_point(), bottom.origin());
+                let (a, b) = if is_lower { (a, b) } else { (b, a) };
+                if !a
+                    .control_points()
+                    .iter()
+                    .zip(b.control_points())
+                    .all(|(a, b)| {
+                        let scale = a.magnitude() + b.magnitude();
+                        a.w > 0.0
+                            && b.w > 0.0
+                            && (a.w - b.w).abs() <= 32.0 * f64::EPSILON * scale
+                            && on_plane(a.to_point(), bottom.origin())
+                            && (b.to_point() - a.to_point() - translation).magnitude()
+                                <= 64.0 * f64::EPSILON * (scale + translation.magnitude())
+                    })
+                {
+                    return None;
+                }
+                let full = NurbsCurve::new(a);
+                let (start, end) = full.range_tuple();
+                let parameter = |point| {
+                    if full.front().near(&point) {
+                        Some(start)
+                    } else if full.back().near(&point) {
+                        Some(end)
+                    } else {
+                        full.search_parameter(point, None, 100)
+                    }
+                };
+                let a = parameter(lower.front().point())?;
+                let b = parameter(lower.back().point())?;
+                let mut curve = section_trim(&full, a.min(b), a.max(b))?;
+                if a > b {
+                    curve.invert();
+                }
+                curve
+            };
+            // The input's oriented side boundary fixes the section winding.
+            if !curve.front().near(&lower.front().point()) {
+                curve.invert();
+            }
+            if !curve.front().near(&lower.front().point())
+                || !curve.back().near(&lower.back().point())
+                || !(curve.front() + translation).near(&upper.back().point())
+                || !(curve.back() + translation).near(&upper.front().point())
+            {
+                return None;
+            }
+            let (start, end) = curve.range_tuple();
+            [start, (start + end) / 2.0, end]
+                .into_iter()
+                .try_for_each(|t| {
+                    let point = curve.evaluate(t);
+                    (on_edge(point, lower) && on_edge(point + translation, upper)).then_some(())
+                })?;
+            edges
+                .iter()
+                .filter(|edge| !cap_edges.contains_key(&edge.id()))
+                .try_for_each(|edge| {
+                    let a = edge.front().point();
+                    let b = edge.back().point();
+                    let delta = b - a;
+                    (delta.near(&translation) || delta.near(&-translation)).then_some(())?;
+                    let curve = edge.curve();
+                    let (a, b) = curve.range_tuple();
+                    [0.25, 0.5, 0.75]
+                        .into_iter()
+                        .all(|s| {
+                            let point = curve.evaluate(a + (b - a) * s);
+                            (point - edge.front().point()).cross(translation).so_small()
+                        })
+                        .then_some(())
+                })?;
+            Some(SweepArc {
+                curve,
+                surface,
+                orientation: face.orientation(),
+                lower: (*lower).clone(),
+                upper: (*upper).clone(),
+                generators: edges
+                    .iter()
+                    .filter(|edge| !cap_edges.contains_key(&edge.id()))
+                    .cloned()
+                    .collect(),
+            })
+        })
+        .collect::<Option<Vec<_>>>()?;
+    (arcs.len() * 2 == cap_edges.len()).then_some(arcs)
+}
