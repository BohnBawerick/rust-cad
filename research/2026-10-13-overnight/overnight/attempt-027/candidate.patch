+/// Isolate section intersections with positive-weight rational convex hulls.
+///
+/// Subdivision uses homogeneous de Casteljau, so no chord can certify separation.
+/// Ambiguous, tangent, or unresolved intersections decline the entire fallback.
+fn section_crossings(
+    a: &NurbsCurve<Vector4>,
+    b: &NurbsCurve<Vector4>,
+    normal: Vector3,
+    work: &mut usize,
+) -> Option<Vec<(f64, f64)>> {
+    let spans = |curve: &NurbsCurve<Vector4>| {
+        curve
+            .non_rationalized()
+            .bezier_decomposition()
+            .into_iter()
+            .map(|span| (span.range_tuple(), span.control_points().clone()))
+            .collect::<Vec<_>>()
+    };
+    let spans_a = spans(a);
+    let spans_b = spans(b);
+    *work = work.checked_sub(spans_a.len().checked_mul(spans_b.len())?)?;
+    let mut stack = spans_a
+        .iter()
+        .flat_map(|a| spans_b.iter().map(move |b| (a.clone(), b.clone(), 0)))
+        .collect::<Vec<_>>();
+    let bounds = |controls: &[Vector4]| {
+        controls.iter().try_fold(
+            (
+                Point3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY),
+                Point3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY),
+            ),
+            |(min, max), control| {
+                let p = control.to_point();
+                (control.w > 0.0 && p.x.is_finite() && p.y.is_finite() && p.z.is_finite())
+                    .then_some((
+                        Point3::new(min.x.min(p.x), min.y.min(p.y), min.z.min(p.z)),
+                        Point3::new(max.x.max(p.x), max.y.max(p.y), max.z.max(p.z)),
+                    ))
+            },
+        )
+    };
+    let split = |controls: &[Vector4]| {
+        let mut row = controls.to_vec();
+        let mut left = vec![row[0]];
+        let mut right = vec![row[row.len() - 1]];
+        while row.len() > 1 {
+            row = row
+                .windows(2)
+                .map(|pair| (pair[0] + pair[1]) / 2.0)
+                .collect();
+            left.push(row[0]);
+            right.push(row[row.len() - 1]);
+        }
+        right.reverse();
+        (left, right)
+    };
+    let mut roots: Vec<(f64, f64)> = Vec::new();
+    while let Some(((ra, ca), (rb, cb), depth)) = stack.pop() {
+        *work = work.checked_sub(ca.len() + cb.len())?;
+        let (mina, maxa) = bounds(&ca)?;
+        let (minb, maxb) = bounds(&cb)?;
+        let separated = (0..3).any(|axis| {
+            let error = 64.0
+                * f64::EPSILON
+                * (mina[axis].abs() + maxa[axis].abs() + minb[axis].abs() + maxb[axis].abs());
+            maxa[axis] < minb[axis] - error || maxb[axis] < mina[axis] - error
+        });
+        if separated {
+            continue;
+        }
+        if depth >= 48 || (mina.near(&maxa) && minb.near(&maxb)) {
+            let (mut u, mut v) = ((ra.0 + ra.1) / 2.0, (rb.0 + rb.1) / 2.0);
+            (0..12).try_for_each(|_| {
+                let delta = a.evaluate(u) - b.evaluate(v);
+                let da = a.derivative(u);
+                let db = b.derivative(v);
+                let determinant = da.cross(db).dot(normal);
+                if !determinant.is_finite() || determinant.so_small() {
+                    return None;
+                }
+                u -= delta.cross(db).dot(normal) / determinant;
+                v -= delta.cross(da).dot(normal) / determinant;
+                (u.is_finite() && v.is_finite()).then_some(())
+            })?;
+            let within = |value: f64, range: (f64, f64)| {
+                (value >= range.0 || value.near(&range.0))
+                    && (value <= range.1 || value.near(&range.1))
+            };
+            if !within(u, ra) || !within(v, rb) || !a.evaluate(u).near(&b.evaluate(v)) {
+                return None;
+            }
+            let ar = a.range_tuple();
+            let br = b.range_tuple();
+            u = u.clamp(ar.0, ar.1);
+            v = v.clamp(br.0, br.1);
+            if !roots.iter().any(|(s, t)| u.near(s) && v.near(t)) {
+                roots.push((u, v));
+            }
+        } else if (maxa - mina).magnitude2() >= (maxb - minb).magnitude2() {
+            let (left, right) = split(&ca);
+            let middle = (ra.0 + ra.1) / 2.0;
+            stack.push((((middle, ra.1), right), (rb, cb.clone()), depth + 1));
+            stack.push((((ra.0, middle), left), (rb, cb), depth + 1));
+        } else {
+            let (left, right) = split(&cb);
+            let middle = (rb.0 + rb.1) / 2.0;
+            stack.push(((ra, ca.clone()), ((middle, rb.1), right), depth + 1));
+            stack.push(((ra, ca), ((rb.0, middle), left), depth + 1));
+        }
+    }
+    Some(roots)
+}
+
+/// Classify a section cell by signed crossings of exact rational curves.
+///
+/// Convex hulls bound the ray length. A ray through a trim endpoint or tangent
+/// is discarded, avoiding double counts and preserving inward cavity windings.
+fn section_inside<C, S>(
+    point: Point3,
+    arcs: &[SweepArc<C, S>],
+    normal: Vector3,
+    work: &mut usize,
+) -> Option<bool> {
+    let radius = arcs.iter().try_fold(0.0_f64, |radius, arc| {
+        arc.curve
+            .control_points()
+            .iter()
+            .try_fold(radius, |radius, control| {
+                *work = work.checked_sub(1)?;
+                let distance = control.to_point().distance(point);
+                (control.w > 0.0 && distance.is_finite()).then_some(radius.max(distance))
+            })
+    })?;
+    if radius == 0.0 {
+        return None;
+    }
+    [
+        Vector3::zero(),
+        Vector3::new(1.0, 2.0, 3.0),
+        Vector3::new(3.0, 1.0, 2.0),
+    ]
+    .into_iter()
+    .find_map(|offset| {
+        let direction = hash::take_one_unit(point + offset);
+        let direction = direction - normal * direction.dot(normal);
+        if direction.so_small() {
+            return None;
+        }
+        let direction = direction.normalize();
+        let ray = NurbsCurve::new(BsplineCurve::from(Line(
+            point.to_homogeneous(),
+            (point + direction * (2.0 * radius)).to_homogeneous(),
+        )));
+        arcs.iter()
+            .try_fold(0_isize, |winding, arc| {
+                let (start, end) = arc.curve.range_tuple();
+                section_crossings(&arc.curve, &ray, normal, work)?
+                    .into_iter()
+                    .try_fold(winding, |winding, (u, v)| {
+                        if u.near(&start) || u.near(&end) || v.so_small() {
+                            return None;
+                        }
+                        let crossing = direction.cross(arc.curve.derivative(u)).dot(normal);
+                        if !crossing.is_finite() || crossing.so_small() {
+                            None
+                        } else {
+                            Some(winding + if crossing > 0.0 { 1 } else { -1 })
+                        }
+                    })
+            })
+            .map(|winding| winding > 0)
+    })
+}
+
+/// Cut a retained input trim, preserving its original curve representation.
+fn sweep_trim_edge<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    edge: &Edge<Point3, C>,
+    front: &Vertex<Point3>,
+    back: &Vertex<Point3>,
+) -> Option<Edge<Point3, C>> {
+    let mut curve = edge.curve();
+    let (start, end) = curve.range_tuple();
+    let parameter = |point| {
+        if curve.front().near(&point) {
+            Some(start)
+        } else if curve.back().near(&point) {
+            Some(end)
+        } else {
+            curve.search_parameter(point, None, 100)
+        }
+    };
+    let a = parameter(front.point())?;
+    let b = parameter(back.point())?;
+    if a < start || a > end || b < start || b > end || a.near(&b) {
+        return None;
+    }
+    let (lower, upper) = (a.min(b), a.max(b));
+    if !upper.near(&end) {
+        let _ = curve.cut(upper);
+    }
+    if !lower.near(&start) {
+        curve = curve.cut(lower);
+    }
+    if a > b {
+        curve.invert();
+    }
+    let edge = Edge::try_new(front, back, curve).ok()?;
+    edge.is_geometric_consistent().then_some(edge)
+}
+
+/// Retain an exact local chart for a certified affine spline generator.
+///
+/// A degree-one parameter direction with constant rational weights is affine.
+/// The other parameter is fixed, so its endpoints determine the complete line.
+fn sweep_line_boundary<S: ShapeOpsSurface>(
+    surface: &S,
+    front: Point3,
+    back: Point3,
+) -> Option<ParameterCurve<BoundaryCurve2D, S>> {
+    let a = surface.search_parameter(front, None, 100)?;
+    let b = surface.search_parameter(back, Some(a), 100)?;
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    let controls = spline.control_points();
+    let affine = if a.0 == b.0 && spline.vdegree() == 1 {
+        controls
+            .iter()
+            .all(|row| row.len() == 2 && row[0].w > 0.0 && row[0].w == row[1].w)
+    } else if a.1 == b.1 && spline.udegree() == 1 && controls.len() == 2 {
+        controls[0]
+            .iter()
+            .zip(&controls[1])
+            .all(|(a, b)| a.w > 0.0 && a.w == b.w)
+    } else {
+        false
+    };
+    affine.then(|| {
+        ParameterCurve::new(
+            BoundaryCurve2D::Line(Line(a.into(), b.into())),
+            surface.clone(),
+        )
+    })
+}
+
+/// Assemble failed common sweeps by cutting input trims and retaining seam identity.
+fn sweep_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+    tol: f64,
+) -> Option<Solid<Point3, C, S>> {
+    if solid0.face_iter().count() > 128 || solid1.face_iter().count() > 128 {
+        return None;
+    }
+    let caps = solid0
+        .face_iter()
+        .filter_map(|face| {
+            let surface = face.surface();
+            // A merged cap may extend past either operand's original trims.
+            // Only an unbounded planar support can carry it without extending
+            // the parameter domain of a bounded spline patch.
+            if surface.supports_exact_patch_domains() {
+                None
+            } else {
+                certified_plane(&surface).map(|plane| (face, plane))
+            }
+        })
+        .collect::<Vec<_>>();
+    let (bottom_face, bottom, top_face, translation, arcs0, arcs1) =
+        caps.iter().enumerate().find_map(|(i, (a, pa))| {
+            caps.iter().skip(i + 1).find_map(|(b, pb)| {
+                if !pa.normal().cross(pb.normal()).so_small() {
+                    return None;
+                }
+                let normal = pa.normal().normalize();
+                let translation = normal * (pb.origin() - pa.origin()).dot(normal);
+                if translation.so_small() {
+                    return None;
+                }
+                let arcs0 = sweep_arcs(solid0, pa, translation)?;
+                let arcs1 = sweep_arcs(solid1, pa, translation)?;
+                Some((*a, *pa, *b, translation, arcs0, arcs1))
+            })
+        })?;
+    let count0 = arcs0.len();
+    let arcs = arcs0.into_iter().chain(arcs1).collect::<Vec<_>>();
+    let mut parameters = arcs
+        .iter()
+        .map(|arc| {
+            let (a, b) = arc.curve.range_tuple();
+            vec![a, b]
+        })
+        .collect::<Vec<_>>();
+    let mut work = 262_144;
+    (0..count0).try_for_each(|i| {
+        (count0..arcs.len()).try_for_each(|j| {
+            section_crossings(&arcs[i].curve, &arcs[j].curve, bottom.normal(), &mut work)?
+                .into_iter()
+                .for_each(|(u, v)| {
+                    parameters[i].push(u);
+                    parameters[j].push(v);
+                });
+            Some(())
+        })
+    })?;
+    let mut patches = Vec::new();
+    arcs.iter()
+        .zip(&mut parameters)
+        .enumerate()
+        .try_for_each(|(index, (arc, parameters))| {
+            parameters.sort_by(f64::total_cmp);
+            parameters.dedup_by(|a, b| (*a).near(&*b));
+            parameters.windows(2).try_for_each(|span| {
+                let point = arc.curve.evaluate((span[0] + span[1]) / 2.0);
+                let in_other = section_inside(
+                    point,
+                    if index < count0 {
+                        &arcs[count0..]
+                    } else {
+                        &arcs[..count0]
+                    },
+                    translation.normalize(),
+                    &mut work,
+                )?;
+                let keep = match operation {
+                    Operation::Intersection => in_other,
+                    Operation::Union => !in_other,
+                    Operation::Difference => in_other == (index >= count0),
+                };
+                if keep {
+                    let reverse = matches!(operation, Operation::Difference) && index >= count0;
+                    let mut curve = section_trim(&arc.curve, span[0], span[1])?;
+                    if reverse {
+                        curve.invert();
+                    }
+                    patches.push(SweepArc {
+                        curve,
+                        surface: arc.surface.clone(),
+                        orientation: arc.orientation != reverse,
+                        lower: arc.lower.clone(),
+                        upper: arc.upper.clone(),
+                        generators: arc.generators.clone(),
+                    });
+                }
+                Some(())
+            })
+        })?;
+    if patches.is_empty() {
+        return if matches!(operation, Operation::Union) {
+            None
+        } else {
+            Solid::try_new(Vec::new()).ok()
+        };
+    }
+    let mut vertices: Vec<(Vertex<Point3>, Vertex<Point3>)> = Vec::new();
+    let indices = patches
+        .iter()
+        .map(|patch| {
+            [patch.curve.front(), patch.curve.back()].map(|point| {
+                if let Some(index) = vertices.iter().position(|(a, _)| a.point().near(&point)) {
+                    index
+                } else {
+                    let index = vertices.len();
+                    vertices.push((Vertex::new(point), Vertex::new(point + translation)));
+                    index
+                }
+            })
+        })
+        .collect::<Vec<_>>();
+    let verticals = vertices
+        .iter()
+        .enumerate()
+        .map(|(index, (a, b))| {
+            let adjacent = indices
+                .iter()
+                .enumerate()
+                .filter(|(_, pair)| pair.contains(&index))
