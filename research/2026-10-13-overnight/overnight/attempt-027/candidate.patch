+/// One exact section arc of a translational side patch.
+struct SweepArc<C, S> {
+    curve: NurbsCurve<Vector4>,
+    surface: S,
+    orientation: bool,
+    lower: Edge<Point3, C>,
+    upper: Edge<Point3, C>,
+    generators: SmallVec<[Edge<Point3, C>; 2]>,
+}
