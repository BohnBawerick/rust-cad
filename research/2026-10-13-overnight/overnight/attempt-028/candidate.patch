+/// Certify separation using projections of complete rational Bézier control hulls.
+///
+/// Every computed axis is a valid separating-axis candidate, even when it is
+/// not a hull-edge normal. Positive weights enclose each entire curve in its
+/// projected control hull. Arithmetic error expands the projection intervals;
+/// overlapping intervals remain unresolved rather than becoming intersections.
+fn section_hulls_separated(
+    a: &[Vector4],
+    b: &[Vector4],
+    normal: Vector3,
+    subdivision_error: [f64; 2],
+    work: &mut usize,
+) -> Option<bool> {
+    let origin = a.first()?.to_point();
+    [a, b]
+        .into_iter()
+        .flat_map(|controls| controls.windows(2))
+        .try_fold(false, |separated, pair| {
+            if separated {
+                return Some(true);
+            }
+            let axis = (pair[1].to_point() - pair[0].to_point()).cross(normal);
+            *work = work.checked_sub(a.len().checked_add(b.len())?)?;
+            let interval = |controls: &[Vector4], subdivision_error: f64| {
+                let padding = subdivision_error * axis.magnitude();
+                controls.iter().try_fold(
+                    (f64::INFINITY, f64::NEG_INFINITY),
+                    |(min, max), control| {
+                        let (distance, error) = plane_distance(control.to_point(), origin, axis);
+                        let error = error + padding;
+                        (control.w > 0.0 && distance.is_finite() && error.is_finite())
+                            .then_some((min.min(distance - error), max.max(distance + error)))
+                    },
+                )
+            };
+            let (mina, maxa) = interval(a, subdivision_error[0])?;
+            let (minb, maxb) = interval(b, subdivision_error[1])?;
+            Some(maxa < minb || maxb < mina)
+        })
+}
