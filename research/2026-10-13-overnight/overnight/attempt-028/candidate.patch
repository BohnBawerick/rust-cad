+/// Bound accumulated subdivision and rational projection roundoff in world space.
+///
+/// Original homogeneous controls bound the arithmetic even when subdivision
+/// cancels large coordinates. The positive weight lower bound also accounts
+/// for amplification during projection back to Euclidean coordinates.
+fn section_subdivision_error(controls: &[Vector4], depth: usize, work: &mut usize) -> Option<f64> {
+    *work = work.checked_sub(controls.len())?;
+    let (min_weight, max_weight, size) = controls.iter().try_fold(
+        (f64::INFINITY, 0.0_f64, 0.0_f64),
+        |(min_weight, max_weight, size), control| {
+            let magnitude = control.x.abs() + control.y.abs() + control.z.abs();
+            (control.w > 0.0 && control.w.is_finite() && magnitude.is_finite()).then_some((
+                min_weight.min(control.w),
+                max_weight.max(control.w),
+                size.max(3.0 * magnitude),
+            ))
+        },
+    )?;
+    let accumulated = 4.0 * (depth + 1) as f64 * controls.len() as f64 * f64::EPSILON;
+    let relative_error = accumulated / (1.0 - accumulated);
+    let weight_error = relative_error * max_weight;
+    let denominator = min_weight - weight_error;
+    let point_bound = size / min_weight;
+    let error = (relative_error * size + point_bound * weight_error) / denominator
+        + f64::EPSILON * point_bound;
+    (accumulated < 1.0 && denominator > 0.0 && error.is_finite()).then_some(error)
+}
