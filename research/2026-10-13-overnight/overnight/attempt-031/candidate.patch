+/// Restrict a covering sweep to the cap slab of the first operand.
+///
+/// For a solid `A` contained in a slab `H`, both `A ∩ B` and `A \ B` depend
+/// only on `B ∩ H`. The complete translated control nets certify that clipping
+/// `B` merely shortens its generators; its oriented section is unchanged.
+/// This identity does not hold for union, which must retain `B` outside `H`.
+/// New cap trims use exact rational leaders on the original side supports.
+fn covering_sweep_arcs<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    bottom_face: &Face<Point3, C, S>,
+    top_face: &Face<Point3, C, S>,
+    translation: Vector3,
+) -> Option<Vec<SweepArc<C, S>>> {
+    let bottom_surface = bottom_face.surface();
+    let top_surface = top_face.surface();
+    let bottom = certified_plane(&bottom_surface)?;
+    let normal = translation.normalize();
+    let height = translation.magnitude();
+    let caps = solid
+        .face_iter()
+        .filter_map(|face| {
+            certified_plane(&face.surface()).filter(|plane| plane.normal().cross(normal).so_small())
+        })
+        .collect::<Vec<_>>();
+    let (arcs, offset) = caps.iter().find_map(|lower| {
+        caps.iter().find_map(|upper| {
+            let extent = (upper.origin() - lower.origin()).dot(normal);
+            let start = (bottom.origin() - lower.origin()).dot(normal);
+            if !extent.is_finite()
+                || !start.is_finite()
+                || extent <= 0.0
+                || start < 0.0
+                || start + height > extent
+                || (start == 0.0 && height == extent)
+            {
+                return None;
+            }
+            let arcs = sweep_arcs(solid, lower, normal * extent)?;
+            Some((arcs, normal * start))
+        })
+    })?;
+    arcs.into_iter()
+        .map(|mut arc| {
+            arc.curve.transform_by(Matrix4::from_translation(offset));
+            let trim = |curve: NurbsCurve<Vector4>, cap: &S| {
+                let front = Vertex::new(curve.front());
+                let back = Vertex::new(curve.back());
+                let boundary0: Option<ParameterCurve<BoundaryCurve2D, S>> = None;
+                let boundary1: Option<ParameterCurve<BoundaryCurve2D, S>> = None;
+                let curve = SurfaceCurve::with_boundaries(
+                    arc.surface.clone(),
+                    cap.clone(),
+                    curve,
+                    boundary0,
+                    boundary1,
+                );
+                let (start, end) = curve.leader().range_tuple();
+                [start, (start + end) / 2.0, end]
+                    .into_iter()
+                    .try_for_each(|parameter| {
+                        let point = curve.search_triple(parameter, 100)?.0;
+                        point
+                            .near(&curve.leader().evaluate(parameter))
+                            .then_some(())
+                    })?;
+                let edge: Edge<Point3, C> = Edge::try_new(&front, &back, curve.into()).ok()?;
+                edge.is_geometric_consistent().then_some(edge)
+            };
+            let mut upper = arc.curve.clone();
+            upper.transform_by(Matrix4::from_translation(translation));
+            // Each cap trim is oriented along the section here. The side wire
+            // assembly reverses the upper trim after trimming to its endpoints.
+            let lower = trim(arc.curve.clone(), &bottom_surface)?;
+            let upper = trim(upper, &top_surface)?;
+            arc.lower = lower;
+            arc.upper = upper;
+            // Keep the original shared generator identities. Assembly cuts
+            // these curves to the slab instead of inventing a smooth SSI seam.
+            Some(arc)
+        })
+        .collect()
 }
 
