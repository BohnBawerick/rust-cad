+/// Topological vertices and edge sectors of an oriented planar arrangement.
+struct PlanarContactTopology {
+    vertices: Vec<Vertex<Point3>>,
+    corners: Vec<Vec<usize>>,
+    sectors: Vec<Vec<usize>>,
+}
+
+/// One oriented edge use before coincident geometry is assigned topology.
+struct PlanarEdgeUse {
+    face: usize,
+    corner: usize,
+    start: usize,
+    end: usize,
+    normal: Vector3,
+}
+
+/// Find a vertex-link component with path compression and bounded work.
+fn contact_vertex_root(parents: &mut [usize], mut index: usize, work: &mut usize) -> Option<usize> {
+    while parents[index] != index {
+        *work = work.checked_sub(1)?;
+        parents[index] = parents[parents[index]];
+        index = parents[index];
+    }
+    Some(index)
+}
+
+/// Normalize edge contacts by their oriented material sectors.
+///
+/// In a plane perpendicular to an edge, each face is a ray. Material lies
+/// clockwise of a forward edge use and counterclockwise of a reverse use.
+/// Consecutive reverse/forward rays therefore bound one material sector and
+/// share one topological edge. Distinct sectors may touch geometrically.
+/// Vertex identity follows these pairings around each vertex link, rather
+/// than equality of coordinates. This also separates isolated point contacts.
+/// Coincident rays or nonalternating orientations decline the arrangement.
+fn planar_contact_topology<S>(
+    indexed: &[(usize, bool, Vec<usize>)],
+    cells: &[PlanarCell<S>],
+    vertices: &[Vertex<Point3>],
+    work: &mut usize,
+) -> Option<PlanarContactTopology> {
+    let offsets = indexed
+        .iter()
+        .scan(0, |offset, (_, _, indices)| {
+            let start = *offset;
+            *offset += indices.len();
+            Some(start)
+        })
+        .collect::<Vec<_>>();
+    let uses = indexed
+        .iter()
+        .enumerate()
+        .flat_map(|(face, (source, orientation, indices))| {
+            let normal = if *orientation == cells[*source].orientation {
+                cells[*source].normal
+            } else {
+                -cells[*source].normal
+            };
+            indices
+                .iter()
+                .enumerate()
+                .map(move |(corner, &start)| PlanarEdgeUse {
+                    face,
+                    corner,
+                    start,
+                    end: indices[(corner + 1) % indices.len()],
+                    normal,
+                })
+        })
+        .collect::<Vec<_>>();
+    *work = work.checked_sub(uses.len())?;
+    let mut groups: HashMap<(usize, usize), SmallVec<[usize; 4]>> = HashMap::default();
+    uses.iter().enumerate().try_for_each(|(index, edge)| {
+        if edge.start == edge.end {
+            return None;
+        }
+        groups
+            .entry((edge.start.min(edge.end), edge.start.max(edge.end)))
+            .or_default()
+            .push(index);
+        Some(())
+    })?;
+    let mut groups = groups.into_iter().collect::<Vec<_>>();
+    groups.sort_unstable_by_key(|(key, _)| *key);
+    let mut partners = vec![usize::MAX; uses.len()];
+    groups.into_iter().try_for_each(|((a, b), group)| {
+        if group.len() == 2 {
+            let (first, second) = (group[0], group[1]);
+            if uses[first].start != uses[second].end {
+                return None;
+            }
+            partners[first] = second;
+            partners[second] = first;
+            Some(())
+        } else if group.len() < 4 || group.len() & 1 != 0 {
+            None
+        } else {
+            let direction = (vertices[b].point() - vertices[a].point()).normalize();
+            let ray = |index: usize| {
+                let edge = &uses[index];
+                let ray = edge.normal.cross(direction) * if edge.start == a { 1.0 } else { -1.0 };
+                let length = ray.magnitude();
+                (length.is_finite() && length > 0.0).then(|| ray / length)
+            };
+            let reference = ray(group[0])?;
+            let mut ordered = group
+                .into_iter()
+                .map(|index| {
+                    let ray = ray(index)?;
+                    let angle = direction
+                        .dot(reference.cross(ray))
+                        .atan2(reference.dot(ray))
+                        .rem_euclid(TAU);
+                    angle.is_finite().then_some((index, angle))
+                })
+                .collect::<Option<SmallVec<[(usize, f64); 4]>>>()?;
+            ordered.sort_unstable_by(|a, b| a.1.total_cmp(&b.1).then_with(|| a.0.cmp(&b.0)));
+            ordered
+                .iter()
+                .enumerate()
+                .try_for_each(|(position, &(first, angle))| {
+                    *work = work.checked_sub(1)?;
+                    let (second, next_angle) = ordered[(position + 1) % ordered.len()];
+                    let gap = (next_angle - angle).rem_euclid(TAU);
+                    if gap <= 32.0 * f64::EPSILON || uses[first].start == uses[second].start {
+                        return None;
+                    }
+                    if uses[first].start == b {
+                        partners[first] = second;
+                        partners[second] = first;
+                    }
+                    Some(())
+                })
+        }
+    })?;
+    let mut parents = (0..uses.len()).collect::<Vec<_>>();
+    let next_corner = |index: usize| {
+        let edge = &uses[index];
+        offsets[edge.face] + (edge.corner + 1) % indexed[edge.face].2.len()
+    };
+    partners
+        .iter()
+        .enumerate()
+        .try_for_each(|(first, &second)| {
+            if second == usize::MAX || partners[second] != first {
+                return None;
+            }
+            if first < second {
+                [(first, next_corner(second)), (next_corner(first), second)]
+                    .into_iter()
+                    .try_for_each(|(a, b)| {
+                        let a = contact_vertex_root(&mut parents, a, work)?;
+                        let b = contact_vertex_root(&mut parents, b, work)?;
+                        parents[a.max(b)] = a.min(b);
+                        Some(())
+                    })?;
+            }
+            Some(())
+        })?;
+    let mut representatives = HashMap::default();
+    let mut normalized = Vec::new();
+    let corners = indexed
+        .iter()
+        .enumerate()
+        .map(|(face, (_, _, indices))| {
+            indices
+                .iter()
+                .enumerate()
+                .map(|(corner, &vertex)| {
+                    let root = contact_vertex_root(&mut parents, offsets[face] + corner, work)?;
+                    Some(*representatives.entry(root).or_insert_with(|| {
+                        let index = normalized.len();
+                        normalized.push(Vertex::new(vertices[vertex].point()));
+                        index
+                    }))
+                })
+                .collect::<Option<Vec<_>>>()
+        })
+        .collect::<Option<Vec<_>>>()?;
+    let sectors = indexed
+        .iter()
+        .enumerate()
+        .map(|(face, (_, _, indices))| {
+            (0..indices.len())
+                .map(|corner| {
+                    let index = offsets[face] + corner;
+                    index.min(partners[index])
+                })
+                .collect()
+        })
+        .collect();
+    Some(PlanarContactTopology {
+        vertices: normalized,
+        corners,
+        sectors,
+    })
+}
