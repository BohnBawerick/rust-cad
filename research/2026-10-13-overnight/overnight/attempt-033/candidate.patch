+/// Apply certified region identities without discarding oriented inner shells.
+///
+/// For a strictly contained candidate, subtraction reverses its entire boundary
+/// chain. Its cavity shells consequently become material islands in the result.
+fn convex_enclosure_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    [false, true].into_iter().find_map(|swapped| {
+        let (container, candidate) = if swapped {
+            (solid1, solid0)
+        } else {
+            (solid0, solid1)
+        };
+        match convex_enclosure_relation(container, candidate)? {
+            EnclosureRelation::Contained => match operation {
+                Operation::Union => Some(container.clone()),
+                Operation::Intersection => Some(candidate.clone()),
+                Operation::Difference if swapped => Solid::try_new(Vec::new()).ok(),
+                Operation::Difference => {
+                    let cavities = candidate
+                        .boundaries()
+                        .iter()
+                        .map(|shell| shell.iter().map(|face| face.inverse()).collect());
+                    Solid::try_new(
+                        container
+                            .boundaries()
+                            .iter()
+                            .cloned()
+                            .chain(cavities)
+                            .collect(),
+                    )
+                    .ok()
+                }
+            },
+            EnclosureRelation::Separated => match operation {
+                Operation::Difference => Some(solid0.clone()),
+                Operation::Intersection => Solid::try_new(Vec::new()).ok(),
+                Operation::Union => Solid::try_new(
+                    solid0
+                        .boundaries()
+                        .iter()
+                        .chain(solid1.boundaries())
+                        .cloned()
+                        .collect(),
+                )
+                .ok(),
+            },
+        }
+    })
 }
 
