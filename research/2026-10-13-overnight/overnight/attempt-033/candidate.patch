+/// A certified relation to a bounded convex material region.
+#[derive(Clone, Copy)]
+enum EnclosureRelation {
+    Contained,
+    Separated,
+}
+
+/// Certify containment or separation using all outward support halfspaces.
+///
+/// A closed planar shell is convex when every face plane supports every other
+/// face. Complete rational control hulls and certified straight trims then
+/// bound the candidate in each of those halfspaces. Strict inequalities leave
+/// no shared patch to assemble. Unresolved relations require intersection work.
+fn convex_enclosure_relation<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    container: &Solid<Point3, C, S>,
+    candidate: &Solid<Point3, C, S>,
+) -> Option<EnclosureRelation> {
+    if container.boundaries().len() != 1 {
+        return None;
+    }
+    let mut work = 262_144_usize;
+    let cells = planar_cells(container, &mut work)?;
+    if cells.len() < 4 {
+        return None;
+    }
+    cells.iter().try_for_each(|plane| {
+        cells
+            .iter()
+            .flat_map(|cell| &cell.points)
+            .try_for_each(|point| {
+                work = work.checked_sub(1)?;
+                let (distance, error) = plane_distance(*point, plane.points[0], plane.normal);
+                (distance.is_finite() && error.is_finite() && distance <= error).then_some(())
+            })
+    })?;
+    let mut intervals = cells
+        .iter()
+        .map(|_| (f64::INFINITY, f64::NEG_INFINITY))
+        .collect::<Vec<_>>();
+    visit_solid_enclosure(candidate, |point| {
+        cells
+            .iter()
+            .zip(&mut intervals)
+            .try_for_each(|(plane, interval)| {
+                work = work.checked_sub(1)?;
+                let (distance, error) = plane_distance(point, plane.points[0], plane.normal);
+                if !distance.is_finite() || !error.is_finite() {
+                    return None;
+                }
+                interval.0 = interval.0.min(distance - error);
+                interval.1 = interval.1.max(distance + error);
+                Some(())
+            })
+    })?;
+    if intervals.iter().all(|(_, maximum)| *maximum < 0.0) {
+        Some(EnclosureRelation::Contained)
+    } else if intervals.iter().any(|(minimum, _)| *minimum > 0.0) {
+        Some(EnclosureRelation::Separated)
+    } else {
+        None
+    }
+}
