+/// Decompose general straight-trimmed planar faces into exact convex cells.
+///
+/// Every boundary line belongs to an adjacent support plane. Splitting the
+/// convex hull by all those planes therefore makes trim membership constant
+/// on each open cell, even for concave faces and faces with holes. The cells
+/// keep the original supporting surfaces and material-side orientations.
+fn planar_trim_cells<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    work: &mut usize,
+) -> Option<Vec<PlanarCell<S>>> {
+    let mut incidence: HashMap<EdgeId<C>, (Vector3, usize)> = HashMap::default();
+    let domains = solid
+        .face_iter()
+        .map(|face| {
+            *work = work.checked_sub(1)?;
+            let surface = face.surface();
+            let plane = certified_plane(&surface)?;
+            let wires = face
+                .boundary_iters()
+                .into_iter()
+                .map(|wire| {
+                    let points = wire
+                        .map(|edge| {
+                            *work = work.checked_sub(1)?;
+                            let entry = incidence.entry(edge.id()).or_insert((plane.normal(), 0));
+                            if entry.1 > 1
+                                || (entry.1 == 1 && entry.0.cross(plane.normal()).so_small())
+                            {
+                                return None;
+                            }
+                            entry.1 += 1;
+                            let point = edge.front().point();
+                            let (distance, error) =
+                                plane_distance(point, plane.origin(), plane.normal());
+                            (distance.is_finite() && error.is_finite() && distance.abs() <= error)
+                                .then_some(point)
+                        })
+                        .collect::<Option<Vec<_>>>()?;
+                    (points.len() >= 3).then_some(points)
+                })
+                .collect::<Option<Vec<_>>>()?;
+            let area = wires.iter().fold(Vector3::zero(), |area, wire| {
+                wire[1..].windows(2).fold(area, |area, pair| {
+                    area + (pair[0] - wire[0]).cross(pair[1] - wire[0])
+                })
+            });
+            let signed_area = area.dot(plane.normal());
+            if !signed_area.is_finite() || signed_area == 0.0 {
+                return None;
+            }
+            let normal = plane.normal() * signed_area.signum();
+            let hull = planar_trim_hull(&wires, normal, work)?;
+            Some((
+                PlanarCell {
+                    surface,
+                    orientation: face.orientation(),
+                    normal,
+                    points: hull,
+                },
+                wires,
+            ))
+        })
+        .collect::<Option<Vec<_>>>()?;
+    if domains.is_empty() || !incidence.values().all(|(_, count)| *count == 2) {
+        return None;
+    }
+    domains
+        .iter()
+        .try_fold(Vec::new(), |mut cells, (source, wires)| {
+            let previous_count = cells.len();
+            let pieces =
+                domains
+                    .iter()
+                    .try_fold(vec![source.points.clone()], |pieces, (plane, _)| {
+                        pieces
+                            .into_iter()
+                            .try_fold(Vec::new(), |mut divided, points| {
+                                *work = work.checked_sub(points.len())?;
+                                divided.extend(split_planar_cell(
+                                    points,
+                                    plane.points[0],
+                                    plane.normal,
+                                ));
+                                Some(divided)
+                            })
+                    })?;
+            pieces.into_iter().try_for_each(|points| {
+                if points.len() < 3 {
+                    return None;
+                }
+                let point = points[0]
+                    + points.iter().map(|p| *p - points[0]).sum::<Vector3>() / points.len() as f64;
+                *work = work.checked_sub(wires.iter().map(Vec::len).sum())?;
+                if planar_trim_inside(wires, source.normal, point)? {
+                    cells.push(PlanarCell {
+                        surface: source.surface.clone(),
+                        orientation: source.orientation,
+                        normal: source.normal,
+                        points,
+                    });
+                }
+                Some(())
+            })?;
+            (cells.len() > previous_count).then_some(cells)
+        })
+}
