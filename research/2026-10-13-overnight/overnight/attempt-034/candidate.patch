+/// Enclose straight planar wires with an oriented convex hull of their vertices.
+///
+/// This is used only after every trim is certified as the intersection of two
+/// nonparallel planes. Original vertices are retained without reprojecting them.
+fn planar_trim_hull(
+    wires: &[Vec<Point3>],
+    normal: Vector3,
+    work: &mut usize,
+) -> Option<Vec<Point3>> {
+    let axis = (0..3).max_by(|&a, &b| normal[a].abs().total_cmp(&normal[b].abs()))?;
+    let x = (axis + 1) % 3;
+    let y = (axis + 2) % 3;
+    let mut points = wires.iter().flatten().copied().collect::<Vec<_>>();
+    *work = work.checked_sub(points.len().checked_mul(points.len())?)?;
+    points.sort_by(|a, b| a[x].total_cmp(&b[x]).then_with(|| a[y].total_cmp(&b[y])));
+    points.dedup();
+    if points.len() < 3 {
+        return None;
+    }
+    let mut chain = |reverse| {
+        (0..points.len()).try_fold(Vec::<Point3>::new(), |mut hull, index| {
+            let point = points[if reverse {
+                points.len() - 1 - index
+            } else {
+                index
+            }];
+            while hull.len() >= 2 {
+                *work = work.checked_sub(1)?;
+                let a = hull[hull.len() - 2];
+                let b = hull[hull.len() - 1];
+                let (turn, error) = plane_distance(point, a, normal.cross(b - a));
+                if turn > error {
+                    break;
+                }
+                hull.pop();
+            }
+            hull.push(point);
+            Some(hull)
+        })
+    };
+    let lower = chain(false)?;
+    let upper = chain(true)?;
+    let hull = lower[..lower.len() - 1]
+        .iter()
+        .chain(&upper[..upper.len() - 1])
+        .copied()
+        .collect::<Vec<_>>();
+    (hull.len() >= 3
+        && points
+            .iter()
+            .all(|point| planar_domain(&hull, normal, *point) >= 0))
+    .then_some(hull)
+}
