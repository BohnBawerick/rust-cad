+/// Classify an open planar cell against every oriented trim wire.
+///
+/// Half-open ray crossings count a wire vertex once. Oppositely oriented hole
+/// wires cancel the outer winding. A point on a trim remains unresolved.
+fn planar_trim_inside(wires: &[Vec<Point3>], normal: Vector3, point: Point3) -> Option<bool> {
+    let axis = (0..3).max_by(|&a, &b| normal[a].abs().total_cmp(&normal[b].abs()))?;
+    let x = (axis + 1) % 3;
+    let y = (axis + 2) % 3;
+    let winding = wires.iter().try_fold(0_isize, |winding, wire| {
+        wire.iter()
+            .zip(wire.iter().cycle().skip(1))
+            .try_fold(winding, |winding, (a, b)| {
+                let (distance, error) = plane_distance(point, *a, normal.cross(*b - *a));
+                let turn = distance * normal[axis].signum();
+                let upward = a[y] <= point[y] && b[y] > point[y];
+                let downward = b[y] <= point[y] && a[y] > point[y];
+                if distance.abs() <= error
+                    && (upward
+                        || downward
+                        || (point[x] >= a[x].min(b[x])
+                            && point[x] <= a[x].max(b[x])
+                            && point[y] >= a[y].min(b[y])
+                            && point[y] <= a[y].max(b[y])))
+                {
+                    None
+                } else if upward && turn > error {
+                    Some(winding + 1)
+                } else if downward && turn < -error {
+                    Some(winding - 1)
+                } else {
+                    Some(winding)
+                }
+            })
+    })?;
+    match winding {
+        0 => Some(false),
+        -1 | 1 => Some(true),
+        _ => None,
+    }
+}
