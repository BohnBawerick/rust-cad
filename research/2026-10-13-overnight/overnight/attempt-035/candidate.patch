+/// Divide using oriented trim domains rather than a world-space area cutoff.
+///
+/// Surface reparameterization can scale chart area arbitrarily. Its magnitude
+/// cannot decide whether a three-dimensional face exists. Opposed copies of the
+/// same topological wire cancel; other holes belong to their smallest enclosing
+/// positive wire. Geometry and the input material-side orientation are retained.
+fn division_by_domains<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &AltCurveShell<C, S>,
+    stores: &LoopsStore<Point3, AltCurve<C, S>>,
+    tol: f64,
+) -> Option<FacesClassification<Point3, AltCurve<C, S>, S>> {
+    if shell.len() != stores.len() {
+        return None;
+    }
+    let mut work = 262_144_usize;
+    let mut result = FacesClassification::default();
+    shell.iter().zip(stores).try_for_each(|(face, loops)| {
+        if loops
+            .iter()
+            .all(|wire| wire.status() == ShapesOpStatus::Unknown)
+        {
+            result.push(face.clone(), ShapesOpStatus::Unknown);
+            return Some(());
+        }
+        let edge_count = loops
+            .iter()
+            .try_fold(0_usize, |count, wire| count.checked_add(wire.len()))?;
+        work = work.checked_sub(edge_count.checked_mul(edge_count)?)?;
+        let surface = face.surface();
+        let mut canceled = vec![false; loops.len()];
+        (0..loops.len()).for_each(|i| {
+            if !canceled[i]
+                && let Some(j) = (i + 1..loops.len()).find(|&j| {
+                    !canceled[j]
+                        && loops[i].len() == loops[j].len()
+                        && loops[j].iter().enumerate().any(|(start, _)| {
+                            loops[i].iter().enumerate().all(|(offset, edge)| {
+                                let other =
+                                    &loops[j][(start + loops[j].len() - offset) % loops[j].len()];
+                                edge.id() == other.id() && edge.orientation() != other.orientation()
+                            })
+                        })
+                })
+            {
+                canceled[i] = true;
+                canceled[j] = true;
+            }
+        });
+        let domains = loops
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| !canceled[*index])
+            .map(|(_, wire)| {
+                let points = division_boundary(&surface, wire, tol, &mut work)?;
+                let origin = points[0];
+                let area = points
+                    .iter()
+                    .zip(points.iter().cycle().skip(1))
+                    .map(|(a, b)| {
+                        let a = *a - origin;
+                        let b = *b - origin;
+                        a.x * b.y - a.y * b.x
+                    })
+                    .sum::<f64>();
+                (area.is_finite() && area != 0.0).then_some((wire, points, area))
+            })
+            .collect::<Option<Vec<_>>>()?;
+        let mut groups = domains
+            .iter()
+            .enumerate()
+            .filter_map(|(index, (_, _, area))| (*area > 0.0).then_some(vec![index]))
+            .collect::<Vec<_>>();
+        domains
+            .iter()
+            .enumerate()
+            .filter(|(_, (_, _, area))| *area < 0.0)
+            .try_for_each(|(index, (_, hole, _))| {
+                let mut owner = None;
+                groups
+                    .iter()
+                    .enumerate()
+                    .try_for_each(|(group_index, group)| {
+                        let (_, outer, area) = &domains[group[0]];
+                        // A strict interior witness avoids assigning a hole using
+                        // an endpoint shared with another subdivision cell.
+                        let contains = hole
+                            .iter()
+                            .copied()
+                            .chain(
+                                hole.iter()
+                                    .zip(hole.iter().cycle().skip(1))
+                                    .map(|(a, b)| a.midpoint(*b)),
+                            )
+                            .find_map(|point| division_contains(outer, point, &mut work));
+                        let contains = contains?;
+                        if contains && owner.is_none_or(|(_, previous_area)| *area < previous_area)
+                        {
+                            owner = Some((group_index, *area));
+                        }
+                        Some(())
+                    })?;
+                groups[owner?.0].push(index);
+                Some(())
+            })?;
+        groups.into_iter().try_for_each(|group| {
+            let status = group
+                .iter()
+                .try_fold(ShapesOpStatus::Unknown, |status, &index| {
+                    let next = domains[index].0.status();
+                    if status == ShapesOpStatus::Unknown {
+                        Some(next)
+                    } else if next == ShapesOpStatus::Unknown || status == next {
+                        Some(status)
+                    } else {
+                        None
+                    }
+                })?;
+            let wires = group
+                .into_iter()
+                .map(|index| {
+                    let wire: &Wire<_, _> = domains[index].0;
+                    wire.clone()
+                })
+                .collect();
+            let mut divided = Face::try_new(wires, surface.clone()).ok()?;
+            if !face.orientation() {
+                divided.invert();
+            }
+            result.push(divided, status);
+            Some(())
+        })
+    })?;
+    Some(result)
+}
