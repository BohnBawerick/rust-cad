+/// Lift a trim into a continuous surface chart, retaining stored parameter curves.
+///
+/// Periodic coordinates are shifted by whole periods only. A wire that does not
+/// close in a single chart cannot be classified by planar winding here.
+fn division_boundary<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    surface: &S,
+    wire: &Wire<Point3, AltCurve<C, S>>,
+    tol: f64,
+    work: &mut usize,
+) -> Option<Vec<Point2>> {
+    let periods = [surface.u_period(), surface.v_period()];
+    if periods
+        .iter()
+        .flatten()
+        .any(|period| !period.is_finite() || *period <= 0.0)
+    {
+        return None;
+    }
+    let mut points = Vec::<Point2>::new();
+    wire.iter().try_for_each(|edge| {
+        *work = work.checked_sub(1)?;
+        let curve = edge.oriented_curve();
+        let stored = match &curve {
+            Alternative::FirstType(curve) => curve.parameter_boundary_2d(surface, tol),
+            Alternative::SecondType(_) => None,
+        };
+        let boundary = if let Some(mut boundary) = stored {
+            if boundary.len() < 2 {
+                return None;
+            }
+            if let Some(previous) = points.last() {
+                let first = boundary[0];
+                let shift = Vector2::new(
+                    periods[0].map_or(0.0, |period| {
+                        ((previous.x - first.x) / period).round() * period
+                    }),
+                    periods[1].map_or(0.0, |period| {
+                        ((previous.y - first.y) / period).round() * period
+                    }),
+                );
+                boundary.iter_mut().for_each(|point| *point += shift);
+            }
+            boundary
+        } else {
+            let samples = curve.parameter_division(curve.range_tuple(), tol).1;
+            *work = work.checked_sub(samples.len())?;
+            let mut previous = points.last().copied();
+            samples
+                .into_iter()
+                .map(|point| {
+                    let (u, v) = surface.search_parameter(point, previous.map(Into::into), 100)?;
+                    let mut uv = Point2::new(u, v);
+                    if let Some(previous) = previous {
+                        (0..2).for_each(|axis| {
+                            if let Some(period) = periods[axis] {
+                                uv[axis] += ((previous[axis] - uv[axis]) / period).round() * period;
+                            }
+                        });
+                    }
+                    if !surface.evaluate(uv.x, uv.y).near(&point) {
+                        return None;
+                    }
+                    previous = Some(uv);
+                    Some(uv)
+                })
+                .collect::<Option<Vec<_>>>()?
+        };
+        *work = work.checked_sub(boundary.len())?;
+        if boundary.len() < 2
+            || !boundary
+                .iter()
+                .all(|point| point.x.is_finite() && point.y.is_finite())
+            || !surface
+                .evaluate(boundary[0].x, boundary[0].y)
+                .near(&edge.front().point())
+            || !surface
+                .evaluate(boundary.last()?.x, boundary.last()?.y)
+                .near(&edge.back().point())
+            || points.last().is_some_and(|point| !point.near(&boundary[0]))
+        {
+            return None;
+        }
+        let skip = usize::from(!points.is_empty());
+        points.extend(boundary.into_iter().skip(skip));
+        Some(())
+    })?;
+    if points.len() < 4 || !points.first()?.near(points.last()?) {
+        return None;
+    }
+    points.pop();
+    Some(points)
+}
+
+/// Classify a chart point by signed crossings, declining points on the boundary.
+fn division_contains(points: &[Point2], point: Point2, work: &mut usize) -> Option<bool> {
+    *work = work.checked_sub(points.len())?;
+    points
+        .iter()
+        .zip(points.iter().cycle().skip(1))
+        .try_fold(0_isize, |winding, (a, b)| {
+            let edge = *b - *a;
+            let offset = point - *a;
+            let cross = edge.x * offset.y - edge.y * offset.x;
+            if !cross.is_finite() || (cross == 0.0 && offset.dot(point - *b) <= 0.0) {
+                None
+            } else {
+                Some(
+                    winding
+                        + if a.y <= point.y && b.y > point.y && cross > 0.0 {
+                            1
+                        } else if b.y <= point.y && a.y > point.y && cross < 0.0 {
+                            -1
+                        } else {
+                            0
+                        },
+                )
+            }
+        })
+        .map(|winding| winding != 0)
+}
