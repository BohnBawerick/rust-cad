+/// Recover every cell of a face arrangement without inheriting marching labels.
+///
+/// Division must retain every loop edge occurrence on each source face. This
+/// rejects dropped small loops and incomplete partitions before any membership
+/// query can mistake missing geometry for an empty Boolean result. The entire
+/// partition must still form the closed, oriented boundary of the operand.
+fn complete_partition<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &AltCurveShell<C, S>,
+    store: &LoopsStore<Point3, AltCurve<C, S>>,
+    tol: f64,
+) -> Option<AltCurveShell<C, S>> {
+    if shell.len() != store.len() {
+        return None;
+    }
+    let mut work = 65_536_usize;
+    let partition = shell.iter().zip(store.iter()).try_fold(
+        AltCurveShell::default(),
+        |mut partition, (face, loops)| {
+            let source: AltCurveShell<C, S> = iter::once(face.clone()).collect();
+            let mut local: LoopsStore<_, _> = iter::once(face).collect();
+            local[0] = loops.clone();
+            let cells: AltCurveShell<C, S> = divide_face::divide_faces(&source, &local, tol)?
+                .and_or_unknown()
+                .into_iter()
+                .flatten()
+                .collect();
+            if cells.is_empty() || partition.len() + cells.len() > 512 {
+                return None;
+            }
+            let mut occurrences = HashMap::default();
+            loops.iter().try_for_each(|wire| {
+                wire.edge_iter().try_for_each(|edge| {
+                    work = work.checked_sub(1)?;
+                    *occurrences.entry(edge.id()).or_insert(0_isize) += 1;
+                    Some(())
+                })
+            })?;
+            cells.edge_iter().try_for_each(|edge| {
+                work = work.checked_sub(1)?;
+                *occurrences.get_mut(&edge.id())? -= 1;
+                Some(())
+            })?;
+            if occurrences.values().any(|count| *count != 0) {
+                return None;
+            }
+            partition.extend(cells);
+            Some(partition)
+        },
+    )?;
+    Solid::try_new(partition.connected_components()).ok()?;
+    Some(partition)
+}
