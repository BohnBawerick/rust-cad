+/// Retry failed assembly by classifying cells independently of intersection signs.
+///
+/// A marching tangent supplies a local crossing sign, not a global membership
+/// certificate. Once the boundary arrangement is complete, membership is
+/// constant on each open cell. Query those cells against the complete oriented
+/// other operand and retain their original surfaces, curves, and orientations.
+fn reclassified_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+    tol: f64,
+) -> Option<Solid<Point3, C, S>> {
+    if solid0.face_iter().count() + solid1.face_iter().count() > 128 {
+        return None;
+    }
+    let shell0: Shell<Point3, C, S> = solid0.face_iter().cloned().collect();
+    let mut shell1: Shell<Point3, C, S> = solid1.face_iter().cloned().collect();
+    let at_infinity = if matches!(operation, Operation::Difference) {
+        shell1.iter_mut().for_each(|face| {
+            face.invert();
+        });
+        1
+    } else {
+        0
+    };
+    let polygons0 = shell0.triangulation(tol);
+    let polygons1 = shell1.triangulation(tol);
+    let alternate0: AltCurveShell<C, S> = shell0.mapped(
+        |point| *point,
+        |curve| Alternative::FirstType(curve.clone()),
+        Clone::clone,
+    );
+    let alternate1: AltCurveShell<C, S> = shell1.mapped(
+        |point| *point,
+        |curve| Alternative::FirstType(curve.clone()),
+        Clone::clone,
+    );
+    let (store0, store1) =
+        if conforming_contacts(&shell0, &shell1, &polygons0, &polygons1, tol).is_some() {
+            (
+                alternate0.face_iter().collect(),
+                alternate1.face_iter().collect(),
+            )
+        } else {
+            let stores =
+                loops_store::create_loops_stores(&alternate0, &polygons0, &alternate1, &polygons1)?;
+            (stores.geom_loops_store0, stores.geom_loops_store1)
+        };
+    let partition0 = complete_partition(&alternate0, &store0, tol)?;
+    let partition1 = complete_partition(&alternate1, &store1, tol)?;
+    let union = matches!(operation, Operation::Union);
+    let selected = [
+        (partition0, &shell1, &polygons1, at_infinity, true),
+        (partition1, &shell0, &polygons0, 0, false),
+    ]
+    .into_iter()
+    .try_fold(
+        AltCurveShell::default(),
+        |mut selected, (partition, other, polygons, exterior, owner)| {
+            partition.into_iter().try_for_each(|face| {
+                let keep = match cell_relation(&face, other, polygons, exterior, tol)? {
+                    // Shared co-oriented patches have one owner. Opposed patches
+                    // are internal to the union and absent from the intersection.
+                    CellRelation::Cooriented => owner,
+                    CellRelation::Opposed => false,
+                    CellRelation::Inside => !union,
+                    CellRelation::Outside => union,
+                };
+                if keep {
+                    selected.push(face);
+                }
+                Some(())
+            })?;
+            Some(selected)
+        },
+    )?;
+    if union && selected.is_empty() {
+        return None;
+    }
+    let shell = sew_contacts(altshell_to_shell(&selected)?, tol)?;
+    // Distinct closed components can still share a geometric seam. Such a
+    // seam has more than two incident faces after geometric identification;
+    // topological closure alone does not make it a manifold solid boundary.
+    let mut seen = HashMap::default();
+    let edges = shell
+        .edge_iter()
+        .filter(|edge| seen.insert(edge.id(), ()).is_none())
+        .collect::<Vec<_>>();
+    if edges.len() > 1024
+        || edges.iter().enumerate().any(|(index, edge)| {
+            edges
+                .iter()
+                .skip(index + 1)
+                .any(|other| matching_edges(edge, other, tol))
+        })
+    {
+        return None;
+    }
+    Solid::try_new(shell.connected_components()).ok()
 }
 
