+/// Require a binary oriented winding and agreement between independent rays.
+///
+/// All shells participate in each query, including inward cavity shells. The
+/// exterior winding is one for a complement and zero for a bounded operand.
+/// A nonbinary or inconsistent count is an unresolved classification.
+fn agreed_inside(point: Point3, shell: &PolyShell, at_infinity: isize) -> Option<bool> {
+    let mut membership = None;
+    [
+        Vector3::zero(),
+        Vector3::new(1.0, 2.0, 3.0),
+        Vector3::new(3.0, 1.0, 2.0),
+    ]
+    .into_iter()
+    .try_for_each(|offset| {
+        let direction = hash::take_one_unit(point + offset);
+        let winding = shell.iter().try_fold(at_infinity, |winding, face| {
+            let crossings = face.surface()?.signed_crossing_faces(point, direction);
+            Some(
+                winding
+                    + if face.orientation() {
+                        crossings
+                    } else {
+                        -crossings
+                    },
+            )
+        })?;
+        if !(0..=1).contains(&winding)
+            || membership.is_some_and(|previous| previous != (winding == 1))
+        {
+            return None;
+        }
+        membership = Some(winding == 1);
+        Some(())
+    })?;
+    membership
+}
