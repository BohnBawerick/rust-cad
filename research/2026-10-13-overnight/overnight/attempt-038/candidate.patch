+/// The location of an oriented open cell relative to the other operand.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum CellRelation {
+    Inside,
+    Outside,
+    Cooriented,
+    Opposed,
+}
+
+/// Require consistent classifications at distinct interior surface witnesses.
+///
+/// Triangles only locate witnesses in the trimmed parameter domain. Each
+/// witness is evaluated on the original support; no mesh face enters the
+/// output. Disagreement leaves the operation unresolved.
+fn cell_relation<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    face: &Face<Point3, AltCurve<C, S>, S>,
+    other: &Shell<Point3, C, S>,
+    polygons: &PolyShell,
+    exterior: isize,
+    tol: f64,
+) -> Option<CellRelation> {
+    let shell: AltCurveShell<C, S> = iter::once(face.clone()).collect();
+    let meshed = shell.triangulation(tol);
+    let mesh = meshed.first()?.surface()?;
+    let triangle = mesh
+        .face_iter()
+        .flat_map(|polygon| {
+            (2..polygon.len()).map(move |i| [polygon[0], polygon[i - 1], polygon[i]])
+        })
+        .max_by(|lhs, rhs| {
+            let area = |vertices: &[StandardVertex; 3]| {
+                let [a, b, c] = vertices.map(|v| mesh.positions()[v.pos]);
+                (b - a).cross(c - a).magnitude2()
+            };
+            area(lhs).total_cmp(&area(rhs))
+        })?;
+    let surface = face.surface();
+    [
+        [1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0],
+        [0.5, 0.25, 0.25],
+        [0.25, 0.5, 0.25],
+    ]
+    .into_iter()
+    .try_fold(None, |previous, weights| {
+        let (u, v) = match triangle.map(|vertex| vertex.uv.map(|i| mesh.uv_coords()[i])) {
+            [Some(a), Some(b), Some(c)] => {
+                let uv = a * weights[0] + b * weights[1] + c * weights[2];
+                (uv.x, uv.y)
+            }
+            _ => {
+                let [a, b, c] = triangle.map(|vertex| mesh.positions()[vertex.pos]);
+                surface.search_nearest_parameter(
+                    a + (b - a) * weights[1] + (c - a) * weights[2],
+                    None,
+                    100,
+                )?
+            }
+        };
+        let point = surface.evaluate(u, v);
+        let normal = surface.normal(u, v).normalize();
+        if !point.to_vec().magnitude2().is_finite() || !normal.magnitude2().is_finite() {
+            return None;
+        }
+        let normal = if face.orientation() { normal } else { -normal };
+        let relation = match coincident_boundary(face, point, normal, other, polygons) {
+            Some(true) => CellRelation::Cooriented,
+            Some(false) => CellRelation::Opposed,
+            None => {
+                if agreed_inside(point, polygons, exterior)? {
+                    CellRelation::Inside
+                } else {
+                    CellRelation::Outside
+                }
+            }
+        };
+        if previous.is_some_and(|previous| previous != relation) {
+            None
+        } else {
+            Some(Some(relation))
+        }
+    })?
+}
