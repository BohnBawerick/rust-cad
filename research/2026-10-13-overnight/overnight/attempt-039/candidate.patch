+/// Retry failed assembly through the equivalent unbounded De Morgan operation.
+///
+/// The identities are `A | B = !( !A & !B )`, `A & B = !( !A | !B )`,
+/// and `A - B = !( !A | B )`. A complemented operand has exterior winding
+/// one and reversed shells, including its cavities. Reversing the selected
+/// boundary returns to a bounded result without changing any support or trim.
+///
+/// This changes the priority of intersection and union labels during component
+/// propagation. Commutative operations also exchange patch ownership. Complete
+/// partitions and final manifold checks are required; failed construction never
+/// stands for an empty result. Existing successful operations take precedence.
+fn boolean_dual<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    tol: f64,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let faces0 = solid0.face_iter().count();
+    let faces1 = solid1.face_iter().count();
+    if faces0.checked_mul(faces1)? > 1024
+        || solid0.edge_iter().count() + solid1.edge_iter().count() > 1024
+    {
+        return None;
+    }
+    let (first, second, exterior, name) = match operation {
+        Operation::Union => (solid1, solid0, [1, 1], "or"),
+        Operation::Intersection => (solid1, solid0, [1, 1], "and"),
+        Operation::Difference => (solid0, solid1, [1, 0], "difference"),
+    };
+    let shell0: Shell<Point3, C, S> = first.face_iter().map(|face| face.inverse()).collect();
+    let shell1: Shell<Point3, C, S> = second
+        .face_iter()
+        .map(|face| {
+            if exterior[1] == 1 {
+                face.inverse()
+            } else {
+                face.clone()
+            }
+        })
+        .collect();
+    let ([intersection, union], contacts) =
+        process_one_pair_of_shells(&shell0, &shell1, tol, exterior)?;
+    let mut selected = match operation {
+        Operation::Union => intersection,
+        Operation::Intersection | Operation::Difference => union,
+    };
+    selected.iter_mut().for_each(|face| {
+        face.invert();
+    });
+    // The union of nonempty operands cannot have an empty bounded boundary.
+    if matches!(operation, Operation::Union) && selected.is_empty() {
+        return None;
+    }
+    let converted = altshell_to_shell(&selected)?;
+    let shell = if contacts {
+        sew_contacts(converted, tol)?
+    } else {
+        converted
+    };
+    finalize(name, shell).ok()
 }
 
