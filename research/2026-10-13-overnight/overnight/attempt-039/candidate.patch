+/// Check that division retained every oriented trim occurrence of an operand.
+///
+/// A missing loop cannot establish an empty Boolean result. The counts include
+/// both directions separately because intersection cuts occur twice, with
+/// opposite orientations, in a complete partition. Counts use absolute wires,
+/// as does the loop store; reversing a shell changes only its material side.
+/// Closure is checked before any cells are discarded by classification.
+fn complete_division<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    classification: &FacesClassification<Point3, AltCurve<C, S>, S>,
+    loops: &LoopsStore<Point3, AltCurve<C, S>>,
+) -> Option<()> {
+    let mut occurrences = HashMap::default();
+    loops
+        .iter()
+        .flat_map(|wires| wires.iter())
+        .for_each(|wire| {
+            wire.edge_iter().for_each(|edge| {
+                *occurrences
+                    .entry((edge.id(), edge.orientation()))
+                    .or_insert(0_usize) += 1;
+            });
+        });
+    let partition = classification
+        .and_or_unknown()
+        .into_iter()
+        .flatten()
+        .collect::<AltCurveShell<C, S>>();
+    partition
+        .iter()
+        .flat_map(|face| face.absolute_boundaries())
+        .flat_map(|wire| wire.iter())
+        .try_for_each(|edge| {
+            let count = occurrences.get_mut(&(edge.id(), edge.orientation()))?;
+            *count = count.checked_sub(1)?;
+            Some(())
+        })?;
+    if occurrences.values().any(|count| *count != 0) {
+        None
+    } else {
+        Solid::try_new(partition.connected_components())
+            .ok()
+            .map(|_| ())
+    }
+}
