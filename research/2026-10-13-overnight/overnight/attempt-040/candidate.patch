+/// A complete face enclosure, with a spline available for exact subdivision.
+struct BoundaryHull {
+    points: Vec<Point3>,
+    spline: Option<BsplineSurface<Vector4>>,
+    normal: Option<Vector3>,
+}
+
+/// Project a positive-weight control net without dropping any of its controls.
+fn control_hull(spline: &BsplineSurface<Vector4>) -> Option<Vec<Point3>> {
+    spline
+        .control_points()
+        .iter()
+        .flatten()
+        .map(|control| {
+            let point = control.to_point();
+            (control.w.is_finite()
+                && control.w > 0.0
+                && point.x.is_finite()
+                && point.y.is_finite()
+                && point.z.is_finite())
+            .then_some(point)
+        })
+        .collect()
+}
+
+/// Enclose each whole face, including planar caps with curved or multiple wires.
+///
+/// A planar trim lies in the projection of its adjacent bounded support's
+/// control hull. A trim between nonparallel planes is straight. The convex
+/// hull of all these enclosures contains the planar face, including its holes.
+/// Unbounded nonplanar supports and uncertified coplanar seams decline the path.
+fn boundary_hulls<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+) -> Option<Vec<BoundaryHull>> {
+    let faces = solid.face_iter().collect::<Vec<_>>();
+    if faces.len() > 128 {
+        return None;
+    }
+    let mut work = 65_536_usize;
+    let supports = faces
+        .iter()
+        .map(|face| {
+            work = work.checked_sub(face.edge_iter().count())?;
+            let surface = face.surface();
+            if surface.supports_exact_patch_domains() {
+                let spline = surface.try_into_homogeneous_bspline_surface()?;
+                work = work.checked_sub(spline.control_points().iter().map(Vec::len).sum())?;
+                if !spline.knot_vector_u().is_clamped(spline.udegree())
+                    || !spline.knot_vector_v().is_clamped(spline.vdegree())
+                {
+                    return None;
+                }
+                let points = control_hull(&spline)?;
+                Some(BoundaryHull {
+                    points,
+                    spline: Some(spline),
+                    normal: certified_plane(&surface).map(|plane| plane.normal().normalize()),
+                })
+            } else {
+                let plane = certified_plane(&surface)?;
+                Some(BoundaryHull {
+                    points: Vec::new(),
+                    spline: None,
+                    normal: Some(plane.normal().normalize()),
+                })
+            }
+        })
+        .collect::<Option<Vec<_>>>()?;
+    let mut incidence: HashMap<EdgeId<C>, SmallVec<[usize; 2]>> = HashMap::default();
+    faces.iter().enumerate().for_each(|(index, face)| {
+        face.edge_iter().for_each(|edge| {
+            incidence.entry(edge.id()).or_default().push(index);
+        });
+    });
+    if incidence.values().any(|indices| indices.len() != 2) {
+        return None;
+    }
+    supports
+        .iter()
+        .enumerate()
+        .map(|(index, hull)| {
+            if hull.spline.is_some() {
+                return Some(BoundaryHull {
+                    points: hull.points.clone(),
+                    spline: hull.spline.clone(),
+                    normal: hull.normal,
+                });
+            }
+            let normal = hull.normal?;
+            let origin = faces[index].edge_iter().next()?.front().point();
+            let points = faces[index]
+                .edge_iter()
+                .map(|edge| {
+                    let adjacent = incidence.get(&edge.id())?;
+                    let other = adjacent.iter().copied().find(|other| *other != index)?;
+                    let neighbor = &supports[other];
+                    if neighbor.spline.is_some() {
+                        work = work.checked_sub(neighbor.points.len())?;
+                        Some(
+                            neighbor
+                                .points
+                                .iter()
+                                .map(|point| *point - normal * (*point - origin).dot(normal))
+                                .collect::<Vec<_>>(),
+                        )
+                    } else if !normal.cross(neighbor.normal?).so_small() {
+                        Some(vec![edge.front().point(), edge.back().point()])
+                    } else {
+                        None
+                    }
+                })
+                .collect::<Option<Vec<_>>>()?
+                .into_iter()
+                .flatten()
+                .collect();
+            Some(BoundaryHull {
+                points,
+                spline: None,
+                normal: Some(normal),
+            })
+        })
+        .collect()
+}
+
+/// Prove a strict separating plane between complete convex enclosures.
+fn hull_gap(a: &BoundaryHull, b: &BoundaryHull) -> bool {
+    let axes = [Vector3::unit_x(), Vector3::unit_y(), Vector3::unit_z()];
+    axes.into_iter()
+        .chain(a.normal)
+        .chain(b.normal)
+        .any(|axis| {
+            let interval = |points: &[Point3]| {
+                points.iter().fold(
+                    (f64::INFINITY, f64::NEG_INFINITY),
+                    |(minimum, maximum), point| {
+                        let (value, error) = plane_distance(*point, Point3::origin(), axis);
+                        (minimum.min(value - error), maximum.max(value + error))
+                    },
+                )
+            };
+            let (min0, max0) = interval(&a.points);
+            let (min1, max1) = interval(&b.points);
+            !a.points.is_empty() && !b.points.is_empty() && (max0 < min1 || max1 < min0)
+        })
+}
+
+/// Separate whole support patches by exact homogeneous knot subdivision.
+///
+/// No tessellation chord or vertex box is used to certify curved separation.
+/// Subdivision exhaustion and touching hulls are unresolved, never empty space.
+fn separate_hulls(
+    a: &BoundaryHull,
+    b: &BoundaryHull,
+    depth: usize,
+    work: &mut usize,
+) -> Option<()> {
+    *work = work.checked_sub(a.points.len() + b.points.len())?;
+    if hull_gap(a, b) {
+        return Some(());
+    }
+    if depth == 0 {
+        return None;
+    }
+    let split_a = a.spline.is_some() && (b.spline.is_none() || depth % 2 == 0);
+    let (source, other) = if split_a { (a, b) } else { (b, a) };
+    let mut left = source.spline.clone()?;
+    let split_u = (depth / 2) % 2 == 0;
+    let knots = if split_u {
+        left.knot_vector_u()
+    } else {
+        left.knot_vector_v()
+    };
+    let start = *knots.first()?;
+    let end = *knots.last()?;
+    let middle = start + (end - start) / 2.0;
+    if !middle.is_finite() || middle <= start || middle >= end {
+        return None;
+    }
+    let right = if split_u {
+        left.cut_u(middle)
+    } else {
+        left.cut_v(middle)
+    };
+    [left, right].into_iter().try_for_each(|spline| {
+        let child = BoundaryHull {
+            points: control_hull(&spline)?,
+            spline: Some(spline),
+            normal: source.normal,
+        };
+        separate_hulls(&child, other, depth - 1, work)
+    })
+}
