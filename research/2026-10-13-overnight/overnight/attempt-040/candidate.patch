+/// Read winding only where the complete face hulls exclude the witness.
+///
+/// Straight homotopy from each exact face to its tessellation stays inside its
+/// convex enclosure. Excluding the witness from every enclosure therefore
+/// preserves the degree of the closed oriented boundary under tessellation.
+fn enclosed_membership(
+    point: Point3,
+    hulls: &[BoundaryHull],
+    polygons: &PolyShell,
+    work: &mut usize,
+) -> Option<bool> {
+    *work = work.checked_sub(hulls.iter().map(|hull| hull.points.len()).sum())?;
+    let witness = BoundaryHull {
+        points: vec![point],
+        spline: None,
+        normal: None,
+    };
+    if !hulls.iter().all(|hull| hull_gap(hull, &witness)) {
+        return None;
+    }
+    let mut answer = None;
+    [
+        Vector3::zero(),
+        Vector3::new(1.0, 2.0, 3.0),
+        Vector3::new(3.0, 1.0, 2.0),
+    ]
+    .into_iter()
+    .try_for_each(|offset| {
+        let direction = hash::take_one_unit(point + offset);
+        let winding = polygons.iter().try_fold(0_isize, |sum, face| {
+            let mesh = face.surface()?;
+            let crossing = mesh.signed_crossing_faces(point, direction);
+            Some(
+                sum + if face.orientation() {
+                    crossing
+                } else {
+                    -crossing
+                },
+            )
+        })?;
+        if !(0..=1).contains(&winding) {
+            return None;
+        }
+        let inside = winding == 1;
+        if answer.is_some_and(|previous| previous != inside) {
+            None
+        } else {
+            answer = Some(inside);
+            Some(())
+        }
+    })?;
+    answer
+}
+
+/// Assemble separated boundaries by whole connected shells and oriented winding.
+///
+/// Disjoint boundaries make membership constant on each connected shell. This
+/// includes nested cavities and disconnected material components. Reversing only
+/// retained second-operand shells implements subtraction without losing cavities.
+fn separated_boundaries_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+    tol: f64,
+) -> Option<Solid<Point3, C, S>> {
+    let hulls0 = boundary_hulls(solid0)?;
+    let hulls1 = boundary_hulls(solid1)?;
+    let mut work = 262_144_usize;
+    hulls0.iter().try_for_each(|a| {
+        hulls1
+            .iter()
+            .try_for_each(|b| separate_hulls(a, b, 16, &mut work))
+    })?;
+    let shell0: Shell<Point3, C, S> = solid0.face_iter().cloned().collect();
+    let shell1: Shell<Point3, C, S> = solid1.face_iter().cloned().collect();
+    let polygons0 = shell0.triangulation(tol);
+    let polygons1 = shell1.triangulation(tol);
+    if polygons0.iter().chain(&polygons1).any(|face| {
+        face.surface()
+            .is_none_or(|mesh| mesh.face_iter().next().is_none())
+    }) {
+        return None;
+    }
+    let mut result = Vec::new();
+    [
+        (&shell0, &hulls1, &polygons1, true),
+        (&shell1, &hulls0, &polygons0, false),
+    ]
+    .into_iter()
+    .try_for_each(|(shell, hulls, polygons, first)| {
+        shell
+            .connected_components()
+            .into_iter()
+            .try_for_each(|mut component| {
+                // Topological identifiers need not have a stable allocation order.
+                let mut witnesses = component
+                    .vertex_iter()
+                    .map(|vertex| vertex.point())
+                    .collect::<Vec<_>>();
+                witnesses.sort_by(|a, b| {
+                    a.x.total_cmp(&b.x)
+                        .then_with(|| a.y.total_cmp(&b.y))
+                        .then_with(|| a.z.total_cmp(&b.z))
+                });
+                witnesses.dedup();
+                let inside = witnesses
+                    .into_iter()
+                    .take(64)
+                    .find_map(|point| enclosed_membership(point, hulls, polygons, &mut work))?;
+                let keep = match operation {
+                    Operation::Intersection => inside,
+                    Operation::Union => !inside,
+                    Operation::Difference => inside != first,
+                };
+                if keep {
+                    if !first && matches!(operation, Operation::Difference) {
+                        component.iter_mut().for_each(|face| {
+                            face.invert();
+                        });
+                    }
+                    result.push(component);
+                }
+                Some(())
+            })
+    })?;
+    Solid::try_new(result).ok()
 }
 
