+/// Carry inherited trim refinements into faces that need no interior division.
+///
+/// [`divide_face::divide_faces`] preserves the supplied face when every loop
+/// has unknown status. However, inserting an intersection endpoint updates the
+/// [`LoopsStore`] on both incident faces, even if only one face is partitioned.
+/// Reusing the original face would discard the other incidence of that split.
+/// Reconstruct only loops consisting of inherited trims; unresolved intersection
+/// slits still belong to the division pipeline. Absolute wire orientation and
+/// the original surface are retained, including reversed cavity faces.
+fn refined_unpartitioned_faces<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &AltCurveShell<C, S>,
+    loops_store: &LoopsStore<Point3, AltCurve<C, S>>,
+) -> Option<AltCurveShell<C, S>> {
+    if shell.len() != loops_store.len() {
+        return None;
+    }
+    shell
+        .iter()
+        .zip(loops_store)
+        .map(|(face, loops)| {
+            let boundaries = face.absolute_boundaries();
+            let unchanged = loops.len() == boundaries.len()
+                && loops
+                    .iter()
+                    .zip(boundaries)
+                    .all(|(wire, original)| wire.iter().eq(original.iter()));
+            let inherited = !unchanged
+                && loops.len() == boundaries.len()
+                && loops.iter().all(|wire| {
+                    wire.status() == ShapesOpStatus::Unknown
+                        && wire
+                            .iter()
+                            .all(|edge| matches!(edge.curve(), Alternative::FirstType(_)))
+                });
+            if inherited {
+                let boundaries = loops
+                    .iter()
+                    .map(|wire| wire.iter().cloned().collect())
+                    .collect();
+                let mut refined = Face::try_new(boundaries, face.surface()).ok()?;
+                if !face.orientation() {
+                    refined.invert();
+                }
+                Some(refined)
+            } else {
+                Some(face.clone())
+            }
+        })
+        .collect()
+}
