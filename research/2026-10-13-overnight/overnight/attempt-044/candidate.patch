+/// Intersect a rational ruled Bezier patch with a plane in homogeneous space.
+///
+/// For boundary curves `A(t)` and `B(t)` and the homogeneous plane functional
+/// `L`, the section is `L(B(t)) * A(t) - L(A(t)) * B(t)`. Bernstein products
+/// represent this identity exactly, with twice the original profile degree.
+/// Opposed control-hull signs certify that the section stays between the two
+/// ruling endpoints. Positive output weights exclude poles on the whole span.
+fn ruled_section_piece(
+    base: &BsplineCurve<Vector4>,
+    top: &BsplineCurve<Vector4>,
+    plane: &Plane,
+    work: &mut usize,
+) -> Option<NurbsCurve<Vector4>> {
+    let degree = base.degree();
+    if degree == 0 || degree > 16 || top.degree() != degree {
+        return None;
+    }
+    *work = work.checked_sub((degree + 1) * (degree + 1))?;
+    let origin = plane.origin();
+    let normal = plane.normal();
+    let on_side = |curve: &BsplineCurve<Vector4>, sign: f64| {
+        curve.control_points().iter().all(|control| {
+            let (distance, error) = plane_distance(control.to_point(), origin, normal);
+            control.w.is_finite()
+                && control.w > 0.0
+                && distance.is_finite()
+                && error.is_finite()
+                && sign * distance >= -error
+        })
+    };
+    let sign = if on_side(base, -1.0) && on_side(top, 1.0) {
+        1.0
+    } else if on_side(base, 1.0) && on_side(top, -1.0) {
+        -1.0
+    } else {
+        return None;
+    };
+    let binomial = |degree: usize| {
+        (0..=degree)
+            .scan(1.0, |coefficient, index| {
+                if index != 0 {
+                    *coefficient *= (degree + 1 - index) as f64 / index as f64;
+                }
+                Some(*coefficient)
+            })
+            .collect::<SmallVec<[f64; 64]>>()
+    };
+    let coefficients = binomial(degree);
+    let products = binomial(2 * degree);
+    let functional =
+        |control: Vector4| normal.dot(control.truncate() - origin.to_vec() * control.w);
+    let controls = (0..=2 * degree)
+        .map(|index| {
+            let control = (index.saturating_sub(degree)..=index.min(degree))
+                .map(|i| {
+                    let j = index - i;
+                    let a = *base.control_point(i);
+                    let b = *top.control_point(j);
+                    (a * functional(b) - b * functional(a))
+                        * (sign * coefficients[i] * coefficients[j] / products[index])
+                })
+                .fold(Vector4::zero(), |sum, control| sum + control);
+            let point = control.to_point();
+            let (distance, error) = plane_distance(point, origin, normal);
+            (control.w.is_finite()
+                && control.w > 0.0
+                && point.to_vec().magnitude2().is_finite()
+                && distance.is_finite()
+                && error.is_finite()
+                && distance.abs() <= error)
+                .then_some(control)
+        })
+        .collect::<Option<Vec<_>>>()?;
+    let (start, end) = base.range_tuple();
+    let mut knots = KnotVector::bezier_knot(2 * degree);
+    knots.transform(end - start, start);
+    Some(NurbsCurve::new(
+        BsplineCurve::try_new(knots, controls).ok()?,
+    ))
+}
