+/// Recover a bounded plane section of any exact rational ruled support.
+///
+/// The converted surface supplies its own parameter frame, including when an
+/// analytic support uses a different parameterization. Only the selected trim
+/// interval is needed; its complete control hull certifies ruling membership.
+/// The original supports and shell orientations remain unchanged.
+fn ruled_intersection_leader<S: ShapeOpsSurface>(
+    intersection: &IntersectionCurve<PolylineCurve<Point3>, S, S>,
+    projections: &mut usize,
+    work: &mut usize,
+) -> Option<NurbsCurve<Vector4>> {
+    let surface0 = intersection.surface0();
+    let surface1 = intersection.surface1();
+    [(surface0, surface1), (surface1, surface0)]
+        .into_iter()
+        .find_map(|(support, planar)| {
+            let plane = certified_plane(planar)?;
+            let spline = support.try_into_homogeneous_bspline_surface()?;
+            let controls = spline.control_points();
+            let count = controls.iter().map(Vec::len).sum::<usize>();
+            if count > 4096
+                || !spline.knot_vector_u().is_clamped(spline.udegree())
+                || !spline.knot_vector_v().is_clamped(spline.vdegree())
+                || !controls.iter().flatten().all(|control| {
+                    control.w.is_finite()
+                        && control.w > 0.0
+                        && control.to_point().to_vec().magnitude2().is_finite()
+                })
+            {
+                return None;
+            }
+            *work = work.checked_sub(count)?;
+            let (base, top, profile_u) = if spline.udegree() == 1 && controls.len() == 2 {
+                (spline.curve_v(0), spline.curve_v(1), false)
+            } else if spline.vdegree() == 1 && controls.iter().all(|row| row.len() == 2) {
+                (spline.curve_u(0), spline.curve_u(1), true)
+            } else {
+                return None;
+            };
+            if base.degree() == 0 || base.degree() > 16 {
+                return None;
+            }
+            *projections = projections.checked_sub(4)?;
+            let (first, last) = intersection.leader().range_tuple();
+            let middle = intersection.search_triple((first + last) / 2.0, 100)?.0;
+            let rational = NurbsSurface::new(spline);
+            let hint = rational.search_parameter(middle, None, 100)?;
+            let front = intersection.leader().front();
+            let back = intersection.leader().back();
+            let a = rational.search_parameter(front, Some(hint), 100)?;
+            let b = rational.search_parameter(back, Some(hint), 100)?;
+            let (start, end) = if profile_u { (a.0, b.0) } else { (a.1, b.1) };
+            let (minimum, maximum) = base.range_tuple();
+            let lower = start.min(end).max(minimum);
+            let upper = start.max(end).min(maximum);
+            let base = section_trim(&NurbsCurve::new(base), lower, upper)?;
+            let top = section_trim(&NurbsCurve::new(top), lower, upper)?;
+            let mut spans = base
+                .non_rationalized()
+                .bezier_decomposition()
+                .into_iter()
+                .zip(top.non_rationalized().bezier_decomposition());
+            let (a, b) = spans.next()?;
+            let initial = ruled_section_piece(&a, &b, &plane, work)?;
+            let mut section = spans.try_fold(initial, |section, (a, b)| {
+                let next = ruled_section_piece(&a, &b, &plane, work)?;
+                *work =
+                    work.checked_sub(section.control_points().len() + next.control_points().len())?;
+                section.try_concat(&next).ok()
+            })?;
+            if start > end {
+                section.invert();
+            }
+            if !section.front().near(&front) || !section.back().near(&back) {
+                return None;
+            }
+            // The algebra proves support membership; continuation distinguishes
+            // arcs that share endpoints, including opposite arcs at a seam.
+            let (start, end) = section.range_tuple();
+            let samples = intersection.leader().as_slice().len().clamp(3, 16);
+            (1..samples).try_fold(start, |previous, index| {
+                *projections = projections.checked_sub(1)?;
+                let fraction = index as f64 / samples as f64;
+                let point = intersection
+                    .search_triple(first + (last - first) * fraction, 100)?
+                    .0;
+                let parameter = section.search_parameter(point, Some(previous), 100)?;
+                (parameter >= previous
+                    && parameter <= end
+                    && section.evaluate(parameter).near(&point))
+                .then_some(parameter)
+            })?;
+            Some(section)
+        })
+}
