+/// Reconstruct every boundary cell, assigning holes to their immediate container.
+///
+/// A spatial meshing tolerance does not define an area in a surface chart.
+/// Signed area is used only for orientation and containment ordering here.
+/// Every loop must belong to one face; ambiguous or degenerate loops fail the
+/// reconstruction instead of disappearing from an apparently valid result.
+/// Exact input edges and supports carry the output. Polylines only locate the
+/// nesting of trims, using the caller's unchanged subdivision tolerance.
+fn nested_division<C, S>(
+    shell: &Shell<Point3, C, S>,
+    store: &LoopsStore<Point3, C>,
+    tol: f64,
+) -> Option<FacesClassification<Point3, C, S>>
+where
+    C: BoundedCurve<Point = Point3> + ParameterDivision1D<Point = Point3> + Clone,
+    S: ShapeOpsSurface,
+{
+    if shell.len() != store.len() {
+        return None;
+    }
+    let mut result = FacesClassification::default();
+    let mut work = 262_144_usize;
+    let mut projections = 16_384_usize;
+    shell.iter().zip(store).try_for_each(|(face, loops)| {
+        if loops.is_empty() {
+            return None;
+        }
+        let surface = face.surface();
+        let mut samples = HashMap::default();
+        let polygons = loops
+            .iter()
+            .map(|wire| {
+                if !wire.is_closed() || !wire.is_simple() {
+                    return None;
+                }
+                projections = projections.checked_sub(1)?;
+                let front = wire.front_vertex()?.point();
+                let first = surface.search_parameter(front, None, 100)?;
+                let mut hint = first;
+                let mut points = vec![Point2::from(first)];
+                wire.iter().try_for_each(|edge| {
+                    let poly = samples.entry(edge.id()).or_insert_with(|| {
+                        let curve = edge.curve();
+                        curve.parameter_division(curve.range_tuple(), tol).1
+                    });
+                    projections = projections.checked_sub(poly.len())?;
+                    (1..poly.len()).try_for_each(|index| {
+                        let index = if edge.orientation() {
+                            index
+                        } else {
+                            poly.len() - 1 - index
+                        };
+                        hint = surface.search_parameter(poly[index], Some(hint), 100)?;
+                        if !hint.0.is_finite() || !hint.1.is_finite() {
+                            return None;
+                        }
+                        points.push(Point2::from(hint));
+                        Some(())
+                    })
+                })?;
+                if points.len() < 4 || !points.last()?.near(&points[0]) {
+                    return None;
+                }
+                // Close only the inverse-query roundoff at the shared vertex.
+                points.pop();
+                let origin = points[0];
+                let area = points
+                    .iter()
+                    .zip(points.iter().cycle().skip(1))
+                    .map(|(a, b)| {
+                        let a = *a - origin;
+                        let b = *b - origin;
+                        a.x * b.y - a.y * b.x
+                    })
+                    .sum::<f64>()
+                    / 2.0;
+                (area.is_finite() && area != 0.0).then_some((points, area))
+            })
+            .collect::<Option<Vec<_>>>()?;
+        let mut regions = polygons
+            .iter()
+            .enumerate()
+            .filter(|(_, (_, area))| *area > 0.0)
+            .map(|(index, _)| (index, vec![index]))
+            .collect::<Vec<_>>();
+        if regions.is_empty() {
+            return None;
+        }
+        polygons
+            .iter()
+            .enumerate()
+            .filter(|(_, (_, area))| *area < 0.0)
+            .try_for_each(|(hole, (points, area))| {
+                let mut parent: Option<usize> = None;
+                regions
+                    .iter()
+                    .enumerate()
+                    .try_for_each(|(index, (outer, _))| {
+                        let (boundary, outer_area) = &polygons[*outer];
+                        // Independent intersection loops appear in both directions.
+                        // Their positive twin is a neighboring cell, not a parent.
+                        work =
+                            work.checked_sub(loops[hole].len().checked_mul(loops[*outer].len())?)?;
+                        let twin = loops[hole].len() == loops[*outer].len()
+                            && loops[hole].iter().all(|edge| {
+                                loops[*outer].iter().any(|other| {
+                                    edge.id() == other.id()
+                                        && edge.orientation() != other.orientation()
+                                })
+                            });
+                        if twin || *outer_area <= -area {
+                            return Some(());
+                        }
+                        work = work.checked_sub(points.len().checked_mul(boundary.len())?)?;
+                        let contained = points
+                            .iter()
+                            .all(|point| loop_domain(boundary, *point) == 1);
+                        // Vertices inside a concave contour are insufficient:
+                        // a segment may leave the domain and enter it again.
+                        let crossing = contained
+                            && points
+                                .iter()
+                                .zip(points.iter().cycle().skip(1))
+                                .any(|(a, b)| {
+                                    boundary.iter().zip(boundary.iter().cycle().skip(1)).any(
+                                        |(c, d)| {
+                                            let side = |a: Point2, b: Point2, c: Point2| {
+                                                let ab = b - a;
+                                                let ac = c - a;
+                                                ab.x * ac.y - ab.y * ac.x
+                                            };
+                                            let opposite = |a: f64, b: f64| {
+                                                (a < 0.0 && b > 0.0) || (a > 0.0 && b < 0.0)
+                                            };
+                                            opposite(side(*a, *b, *c), side(*a, *b, *d))
+                                                && opposite(side(*c, *d, *a), side(*c, *d, *b))
+                                        },
+                                    )
+                                });
+                        if contained && !crossing {
+                            if parent.is_some_and(|old| *outer_area == polygons[regions[old].0].1) {
+                                return None;
+                            }
+                            if parent.is_none_or(|old| *outer_area < polygons[regions[old].0].1) {
+                                parent = Some(index);
+                            }
+                        }
+                        Some(())
+                    })?;
+                regions.get_mut(parent?)?.1.push(hole);
+                Some(())
+            })?;
+        regions.into_iter().try_for_each(|(_, indices)| {
+            let status = indices
+                .iter()
+                .try_fold(ShapesOpStatus::Unknown, |status, &index| {
+                    let next = loops[index].status();
+                    if status == ShapesOpStatus::Unknown || status == next {
+                        Some(next)
+                    } else if next == ShapesOpStatus::Unknown {
+                        Some(status)
+                    } else {
+                        None
+                    }
+                })?;
+            let wires = indices
+                .into_iter()
+                .map(|index| loops[index].iter().cloned().collect())
+                .collect();
+            let mut rebuilt = Face::try_new(wires, surface.clone()).ok()?;
+            if !face.orientation() {
+                rebuilt.invert();
+            }
+            result.push(rebuilt, status);
+            Some(())
+        })
+    })?;
+    Some(result)
+}
