+/// Locate a point in a polygon without counting a boundary point as interior.
+fn loop_domain(points: &[Point2], point: Point2) -> i8 {
+    let winding =
+        points
+            .iter()
+            .zip(points.iter().cycle().skip(1))
+            .try_fold(0_isize, |winding, (a, b)| {
+                let ab = *b - *a;
+                let ap = point - *a;
+                let cross = ab.x * ap.y - ab.y * ap.x;
+                if cross == 0.0 && ap.dot(point - *b) <= 0.0 {
+                    None
+                } else if a.y <= point.y && b.y > point.y && cross > 0.0 {
+                    Some(winding + 1)
+                } else if b.y <= point.y && a.y > point.y && cross < 0.0 {
+                    Some(winding - 1)
+                } else {
+                    Some(winding)
+                }
+            });
+    match winding {
+        None => 0,
+        Some(0) => -1,
+        Some(_) => 1,
+    }
+}
