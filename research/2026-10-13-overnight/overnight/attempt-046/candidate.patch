+fn divide_boundary_faces<C, S>(
+    shell: &Shell<Point3, C, S>,
+    store: &LoopsStore<Point3, C>,
+    tol: f64,
+    division: FaceDivision,
+) -> Option<FacesClassification<Point3, C, S>>
+where
+    C: BoundedCurve<Point = Point3> + ParameterDivision1D<Point = Point3> + Clone,
+    S: ShapeOpsSurface,
+{
+    match division {
+        FaceDivision::Classic => divide_face::divide_faces(shell, store, tol),
+        FaceDivision::Nested => nested_division(shell, store, tol),
+    }
+}
