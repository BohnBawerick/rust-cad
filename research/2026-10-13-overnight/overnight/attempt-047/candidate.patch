+/// Lift a principal inverse value to the chart containing the previous sample.
+///
+/// Inverse queries may ignore the periodic coordinate of their hint. Integer
+/// period shifts preserve the exact surface point; half-period ties are
+/// ambiguous and must not choose a boundary orientation arbitrarily.
+fn lift_parameter(value: f64, previous: f64, period: Option<f64>) -> Option<f64> {
+    if !value.is_finite() || !previous.is_finite() {
+        return None;
+    }
+    if let Some(period) = period {
+        if !period.is_finite() || period <= 0.0 {
+            return None;
+        }
+        let lifted = value + ((previous - value) / period).round() * period;
+        (lifted.is_finite() && (lifted - previous).abs() < period / 2.0).then_some(lifted)
+    } else {
+        Some(value)
+    }
+}
+
+/// Bound a contractible loop in a chart shorter than each period.
+///
+/// A loop that winds around an entire period needs a cut and additional seam
+/// topology. Do not close such a loop with an invented parameter-space chord.
+fn chart_bounds(points: &[Point2], periods: [Option<f64>; 2]) -> Option<[Point2; 2]> {
+    let first = *points.first()?;
+    let bounds = points.iter().fold([first; 2], |[minimum, maximum], point| {
+        [
+            Point2::new(minimum.x.min(point.x), minimum.y.min(point.y)),
+            Point2::new(maximum.x.max(point.x), maximum.y.max(point.y)),
+        ]
+    });
+    periods
+        .iter()
+        .enumerate()
+        .all(|(axis, period)| {
+            period.is_none_or(|period| bounds[1][axis] - bounds[0][axis] < period)
+        })
+        .then_some(bounds)
+}
+
+/// Place two independently lifted loops in the same chart for containment.
+///
+/// Both spans are shorter than a period, so at most one integer translation
+/// can put the inner bounding interval inside the outer bounding interval.
+fn chart_translation(
+    inner: &[Point2],
+    outer: &[Point2],
+    periods: [Option<f64>; 2],
+) -> Option<Vector2> {
+    let [inner_min, inner_max] = chart_bounds(inner, periods)?;
+    let [outer_min, outer_max] = chart_bounds(outer, periods)?;
+    let mut shift = Vector2::zero();
+    periods.iter().enumerate().try_for_each(|(axis, period)| {
+        if let Some(period) = period {
+            let difference = (outer_min[axis] - inner_min[axis]) / 2.0
+                + (outer_max[axis] - inner_max[axis]) / 2.0;
+            shift[axis] = (difference / period).round() * period;
+        }
+        (shift[axis].is_finite()
+            && inner_min[axis] + shift[axis] >= outer_min[axis]
+            && inner_max[axis] + shift[axis] <= outer_max[axis])
+            .then_some(())
+    })?;
+    Some(shift)
+}
+
+/// Reject crossings in a lifted chart before using its signed area.
+fn simple_chart(points: &[Point2], work: &mut usize) -> Option<()> {
+    let count = points.len();
+    *work = work.checked_sub(count.checked_mul(count)?)?;
+    let cross = |a: Point2, b: Point2, c: Point2| {
+        let ab = b - a;
+        let ac = c - a;
+        ab.x * ac.y - ab.y * ac.x
+    };
+    let opposite = |a: f64, b: f64| (a < 0.0 && b > 0.0) || (a > 0.0 && b < 0.0);
+    (0..count)
+        .all(|i| {
+            let (a, b) = (points[i], points[(i + 1) % count]);
+            a != b
+                && (i + 1..count).all(|j| {
+                    if j == i + 1 || (i == 0 && j == count - 1) {
+                        true
+                    } else {
+                        let (c, d) = (points[j], points[(j + 1) % count]);
+                        let sides = [
+                            cross(a, b, c),
+                            cross(a, b, d),
+                            cross(c, d, a),
+                            cross(c, d, b),
+                        ];
+                        let touches = (sides[0] == 0.0 && (c - a).dot(c - b) <= 0.0)
+                            || (sides[1] == 0.0 && (d - a).dot(d - b) <= 0.0)
+                            || (sides[2] == 0.0 && (a - c).dot(a - d) <= 0.0)
+                            || (sides[3] == 0.0 && (b - c).dot(b - d) <= 0.0);
+                        !touches && !(opposite(sides[0], sides[1]) && opposite(sides[2], sides[3]))
+                    }
+                })
+        })
+        .then_some(())
+}
