+/// Reclassify connected boundary cells without trusting local intersection labels.
+///
+/// A crossing changes membership only at an intersection trim. Every interior
+/// witness of one reconstructed cell must therefore have the same relation to
+/// the entire other operand. Require agreement between three interior points
+/// and three rays, including the winding at infinity for a complement. Reject
+/// nonbinary windings and disagreement rather than voting away ambiguity.
+/// Meshes locate witnesses and count crossings; output geometry is unchanged.
+fn reclassify_cells<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    cells: AltCurveShell<C, S>,
+    operand: (&Shell<Point3, C, S>, &PolyShell),
+    at_infinity: isize,
+    owns_shared: bool,
+    tol: f64,
+    work: &mut usize,
+) -> Option<[AltCurveShell<C, S>; 2]> {
+    if cells.len() > 512 {
+        return None;
+    }
+    let (other, polygons) = operand;
+    // Cache the polygon surfaces once, since extracting a surface clones it.
+    let meshes = polygons
+        .iter()
+        .map(|face| Some((face.surface()?, face.orientation())))
+        .collect::<Option<Vec<_>>>()?;
+    let triangle_count = meshes
+        .iter()
+        .flat_map(|(mesh, _)| mesh.face_iter())
+        .try_fold(0_usize, |count, polygon| {
+            count.checked_add(polygon.len().checked_sub(2)?)
+        })?;
+    if triangle_count == 0 {
+        return None;
+    }
+    cells.into_iter().try_fold(
+        [Shell::default(), Shell::default()],
+        |[mut intersection, mut union], face| {
+            *work = work.checked_sub(1)?;
+            let patch: AltCurveShell<C, S> = iter::once(face.clone()).collect();
+            let triangulated = patch.triangulation(tol);
+            let mesh = triangulated.first()?.surface()?;
+            let triangle = mesh
+                .face_iter()
+                .flat_map(|polygon| {
+                    (2..polygon.len())
+                        .map(move |index| [polygon[0], polygon[index - 1], polygon[index]])
+                })
+                .max_by(|lhs, rhs| {
+                    let area = |triangle: &[StandardVertex; 3]| {
+                        let [a, b, c] = triangle.map(|vertex| mesh.positions()[vertex.pos]);
+                        (b - a).cross(c - a).magnitude2()
+                    };
+                    area(lhs).total_cmp(&area(rhs))
+                })?;
+            let [Some(a), Some(b), Some(c)] =
+                triangle.map(|vertex| vertex.uv.map(|index| mesh.uv_coords()[index]))
+            else {
+                return None;
+            };
+            let area = (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
+            if !area.is_finite() || area == 0.0 {
+                return None;
+            }
+            let surface = face.surface();
+            let witnesses = [
+                (a + b + c) / 3.0,
+                a * 0.5 + b * 0.25 + c * 0.25,
+                a * 0.25 + b * 0.5 + c * 0.25,
+            ];
+            let relation = witnesses.into_iter().try_fold(None, |previous, uv| {
+                *work = work.checked_sub(other.len())?;
+                let point = surface.evaluate(uv.x, uv.y);
+                let normal = surface.normal(uv.x, uv.y);
+                if !point.to_vec().magnitude2().is_finite()
+                    || !normal.magnitude2().is_finite()
+                    || normal.magnitude2() == 0.0
+                {
+                    return None;
+                }
+                let normal = if face.orientation() {
+                    normal.normalize()
+                } else {
+                    -normal.normalize()
+                };
+                let relation = if let Some(aligned) =
+                    coincident_boundary(&face, point, normal, other, polygons)
+                {
+                    // A shared patch is owned once. Opposed patches are internal
+                    // to the union and have no regularized intersection volume.
+                    (owns_shared && aligned, owns_shared && aligned)
+                } else {
+                    *work = work.checked_sub(triangle_count.checked_mul(3)?)?;
+                    let directions = [
+                        hash::take_one_unit(point),
+                        hash::take_one_unit(point + Vector3::new(1.0, 2.0, 3.0)),
+                        hash::take_one_unit(point + Vector3::new(3.0, 1.0, 2.0)),
+                    ];
+                    let winding =
+                        directions
+                            .into_iter()
+                            .try_fold(None, |previous, direction| {
+                                let winding = meshes.iter().try_fold(
+                                    at_infinity,
+                                    |sum, (mesh, orientation)| {
+                                        let crossings =
+                                            mesh.signed_crossing_faces(point, direction);
+                                        sum.checked_add(if *orientation {
+                                            crossings
+                                        } else {
+                                            -crossings
+                                        })
+                                    },
+                                )?;
+                                ((winding == 0 || winding == 1)
+                                    && previous.is_none_or(|previous| previous == winding))
+                                .then_some(Some(winding))
+                            })??;
+                    (winding == 1, winding == 0)
+                };
+                previous
+                    .is_none_or(|previous| previous == relation)
+                    .then_some(Some(relation))
+            })??;
+            if relation.0 {
+                intersection.push(face.clone());
+            }
+            if relation.1 {
+                union.push(face);
+            }
+            Some([intersection, union])
+        },
+    )
 }
 
