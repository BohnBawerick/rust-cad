 type AltCurve<C, S> = Alternative<C, IntersectionCurve<PolylineCurve<Point3>, S, S>>;
 type AltCurveShell<C, S> = Shell<Point3, AltCurve<C, S>, S>;
 type PolyShell = Shell<Point3, PolylineCurve<Point3>, Option<PolygonMesh>>;
+
+/// Retry a failed inverse query without relaxing geometric membership.
+///
+/// A nearest-parameter query can converge when the strict inverse solver fails.
+/// Its result is usable as an inverse only if evaluation recovers the input point.
+fn boundary_parameter<S: ShapeOpsSurface>(
+    surface: &S,
+    point: Point3,
+    hint: Option<(f64, f64)>,
+) -> Option<(f64, f64)> {
+    surface.search_parameter(point, hint, 100).or_else(|| {
+        surface
+            .search_nearest_parameter(point, hint, 100)
+            .filter(|&(u, v)| u.is_finite() && v.is_finite() && surface.evaluate(u, v).near(&point))
+    })
+}
+
+/// Recover missing face meshes while preserving the common boundary discretization.
+///
+/// Winding classification and intersection seeding require every boundary face.
+/// Retry only faces whose strict tessellation failed, using the same tolerance.
+/// A nearest-point mesh is accepted only when all its referenced coordinates
+/// evaluate back to the original support with the kernel's membership predicate.
+/// Copying only the polygon surface retains shared polyline edges, face order,
+/// and orientation. These meshes never replace exact output curves or surfaces.
+fn classification_mesh<C, S>(shell: &Shell<Point3, C, S>, tol: f64) -> Option<PolyShell>
+where
+    C: ParametricCurve3D + BoundedCurve + ParameterDivision1D<Point = Point3> + Send + Sync,
+    S: ShapeOpsSurface,
+{
+    let meshed = shell.triangulation(tol);
+    let mut work = 65_536_usize;
+    let mut recoveries = 32_usize;
+    shell.iter().zip(&meshed).try_for_each(|(face, polygon)| {
+        if polygon.surface().is_some() {
+            return Some(());
+        }
+        recoveries = recoveries.checked_sub(1)?;
+        let patch: Shell<Point3, C, S> = iter::once(face.clone()).collect();
+        let recovered = patch.robust_triangulation(tol);
+        let mesh = recovered.first()?.surface()?;
+        if mesh.face_iter().next().is_none() {
+            return None;
+        }
+        let surface = face.surface();
+        mesh.face_iter().try_for_each(|vertices| {
+            work = work.checked_sub(vertices.len())?;
+            vertices.iter().try_for_each(|vertex| {
+                let point = mesh.positions().get(vertex.pos)?;
+                let uv = mesh.uv_coords().get(vertex.uv?)?;
+                (uv.x.is_finite() && uv.y.is_finite() && surface.evaluate(uv.x, uv.y).near(&point))
+                    .then_some(())
+            })
+        })?;
+        // The retained edges are those tessellated jointly for the whole shell.
+        // Check their samples as well, including any omitted by triangulation.
+        polygon.edge_iter().try_for_each(|edge| {
+            let curve = edge.curve();
+            work = work.checked_sub(curve.len())?;
+            let _ = curve.iter().try_fold(None, |hint, point| {
+                boundary_parameter(&surface, *point, hint).map(Some)
+            })?;
+            Some(())
+        })?;
+        polygon.set_surface(Some(mesh));
+        Some(())
+    })?;
+    Some(meshed)
+}
 
