+/// Check that division retained every directed trim incidence of one face.
+///
+/// Internal cuts occur twice, with opposite directions. Counting directions
+/// separately detects the loss of both sides of a small region, which a signed
+/// boundary sum would miss. Absolute boundaries use the support's orientation,
+/// so inward cavity faces obey the same invariant as outward faces.
+fn division_preserves_trims<C, S>(
+    loops: &Loops<Point3, C>,
+    divided: &FacesClassification<Point3, C, S>,
+) -> bool {
+    let count = |mut counts: HashMap<(EdgeId<C>, bool), usize>, edge: &Edge<Point3, C>| {
+        *counts.entry((edge.id(), edge.orientation())).or_default() += 1;
+        counts
+    };
+    let expected = loops
+        .iter()
+        .flat_map(|wire| wire.iter())
+        .fold(HashMap::default(), count);
+    let actual = divided
+        .and_or_unknown()
+        .iter()
+        .flat_map(|shell| shell.iter())
+        .flat_map(|face| face.absolute_boundaries().iter())
+        .flat_map(|wire| wire.iter())
+        .fold(HashMap::default(), count);
+    expected == actual
+}
+
+/// Recover incomplete divisions locally, before classifying their output.
+///
+/// The classic divider can discard a chart region whose area is below the
+/// spatial tolerance, or leave an untouched face with stale unsplit edges.
+/// Neither defect necessarily prevents the selected result from being closed.
+/// A complete nested reconstruction can repair that face while other faces
+/// retain their established division, including their periodic charts.
+fn conservative_division<C, S>(
+    shell: &Shell<Point3, C, S>,
+    store: &LoopsStore<Point3, C>,
+    tol: f64,
+) -> Option<FacesClassification<Point3, C, S>>
+where
+    C: BoundedCurve<Point = Point3> + ParameterDivision1D<Point = Point3> + Clone,
+    S: ShapeOpsSurface,
+{
+    if shell.len() != store.len() {
+        return None;
+    }
+    let mut result = FacesClassification::default();
+    shell.iter().zip(store).try_for_each(|(face, loops)| {
+        let local_shell = iter::once(face.clone()).collect();
+        let mut local_store: LoopsStore<_, _> = iter::once(face).collect();
+        local_store[0] = loops.clone();
+        let classic = divide_face::divide_faces(&local_shell, &local_store, tol);
+        let divided = if classic
+            .as_ref()
+            .is_some_and(|divided| division_preserves_trims(loops, divided))
+        {
+            classic
+        } else {
+            // Coincident loops can legitimately cancel. Only replace the
+            // established division when a complete reconstruction succeeds.
+            nested_division(&local_shell, &local_store, tol)
+                .filter(|divided| division_preserves_trims(loops, divided))
+                .or(classic)
+        }?;
+        [
+            ShapesOpStatus::And,
+            ShapesOpStatus::Or,
+            ShapesOpStatus::Unknown,
+        ]
+        .into_iter()
+        .zip(divided.and_or_unknown())
+        .for_each(|(status, faces)| {
+            faces.into_iter().for_each(|face| result.push(face, status));
+        });
+        Some(())
+    })?;
+    Some(result)
+}
