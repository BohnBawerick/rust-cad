+/// Prove strict containment of a complete support hull in a convex solid.
+///
+/// The planar certificate covers entire faces and straight trims. Requiring
+/// every boundary vertex behind every outward plane proves convexity of the
+/// valid closed boundary. Positive rational weights make a half-space bound
+/// on all control points a bound on every point of each curved support.
+/// Strict inequalities leave the contact and intersecting cases to assembly.
+fn contains_enclosure<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    container: &Solid<Point3, C, S>,
+    inner: &Solid<Point3, C, S>,
+) -> Option<()> {
+    let mut work = 262_144_usize;
+    let cells = planar_cells(container, &mut work)?;
+    if cells.is_empty() {
+        return None;
+    }
+    cells.iter().try_for_each(|plane| {
+        cells.iter().try_for_each(|cell| {
+            cell.points.iter().try_for_each(|point| {
+                work = work.checked_sub(1)?;
+                let (distance, error) = plane_distance(*point, plane.points[0], plane.normal);
+                (distance.is_finite() && error.is_finite() && distance <= error).then_some(())
+            })
+        })
+    })?;
+    for_each_enclosing_point(inner, |point| {
+        cells.iter().try_for_each(|plane| {
+            work = work.checked_sub(1)?;
+            let (distance, error) = plane_distance(point, plane.points[0], plane.normal);
+            (distance.is_finite() && error.is_finite() && distance < -error).then_some(())
+        })
+    })
+}
