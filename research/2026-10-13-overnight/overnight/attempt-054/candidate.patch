+/// Certify an affine chart before introducing straight parameter-space trims.
+fn affine_plane<S: ShapeOpsSurface>(surface: &S) -> Option<Plane> {
+    let plane = certified_plane(surface)?;
+    let spline = surface.try_into_homogeneous_bspline_surface()?;
+    let controls = spline.control_points();
+    if spline.degrees() != (1, 1)
+        || controls.len() != 2
+        || controls.iter().any(|row| row.len() != 2)
+    {
+        return None;
+    }
+    let weight = controls[0][0].w;
+    if !weight.is_finite() || weight <= 0.0 || controls.iter().flatten().any(|p| p.w != weight) {
+        return None;
+    }
+    let a = controls[0][0].to_point();
+    let b = controls[0][1].to_point();
+    let c = controls[1][0].to_point();
+    let d = controls[1][1].to_point();
+    let residual = (d - c) - (b - a);
+    let scale = [a, b, c, d]
+        .into_iter()
+        .map(|p| p.to_vec().magnitude())
+        .sum::<f64>();
+    (scale.is_finite() && residual.magnitude() <= 32.0 * f64::EPSILON * scale).then_some(plane)
+}
