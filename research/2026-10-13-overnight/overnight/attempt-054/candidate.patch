+/// Partition arbitrary straight planar trims into convex material cells.
+///
+/// Two nonparallel incident support planes certify each complete trim as a
+/// straight segment. Cutting a surrounding rectangle by every trim line makes
+/// winding constant in each open cell, including cells inside holes. The
+/// subdivision retains the original affine surface and material orientation.
+fn planar_trim_cells<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    work: &mut usize,
+) -> Option<(Vec<PlanarCell<S>>, bool)> {
+    let mut incidence: HashMap<EdgeId<C>, (Vector3, usize)> = HashMap::default();
+    let mut complex = false;
+    let faces = solid
+        .face_iter()
+        .map(|face| {
+            *work = work.checked_sub(1)?;
+            let surface = face.surface();
+            let plane = affine_plane(&surface)?;
+            let normal = if face.orientation() {
+                plane.normal().normalize()
+            } else {
+                -plane.normal().normalize()
+            };
+            let axis = if normal.x.abs() < normal.y.abs() {
+                Vector3::unit_x()
+            } else {
+                Vector3::unit_y()
+            };
+            let x = normal.cross(axis).normalize();
+            let y = normal.cross(x);
+            let origin = plane.origin();
+            let project = |point: Point3| {
+                let delta = point - origin;
+                Point2::new(delta.dot(x), delta.dot(y))
+            };
+            let loops = face
+                .boundary_iters()
+                .into_iter()
+                .map(|wire| {
+                    wire.map(|edge| {
+                        *work = work.checked_sub(1)?;
+                        let entry = incidence.entry(edge.id()).or_insert((normal, 0));
+                        if entry.1 > 1 || (entry.1 == 1 && entry.0.cross(normal).so_small()) {
+                            return None;
+                        }
+                        entry.1 += 1;
+                        let point = edge.front().point();
+                        let (distance, error) = plane_distance(point, origin, normal);
+                        (distance.is_finite() && error.is_finite() && distance.abs() <= error)
+                            .then_some(project(point))
+                    })
+                    .collect::<Option<Vec<_>>>()
+                })
+                .collect::<Option<Vec<_>>>()?;
+            if loops.is_empty() || loops.iter().any(|wire| wire.len() < 3) {
+                return None;
+            }
+            complex |= loops.len() > 1
+                || loops.iter().any(|wire| {
+                    wire.iter()
+                        .zip(wire.iter().cycle().skip(1))
+                        .zip(wire.iter().cycle().skip(2))
+                        .any(|((a, b), c)| {
+                            let ab = *b - *a;
+                            let bc = *c - *b;
+                            ab.x * bc.y - ab.y * bc.x < 0.0
+                        })
+                });
+            let (lower, upper) = loops.iter().flatten().fold(
+                (
+                    Point2::new(f64::INFINITY, f64::INFINITY),
+                    Point2::new(f64::NEG_INFINITY, f64::NEG_INFINITY),
+                ),
+                |(a, b), p| {
+                    (
+                        Point2::new(a.x.min(p.x), a.y.min(p.y)),
+                        Point2::new(b.x.max(p.x), b.y.max(p.y)),
+                    )
+                },
+            );
+            if lower.x >= upper.x || lower.y >= upper.y {
+                return None;
+            }
+            let lift = |p: Point2| origin + x * p.x + y * p.y;
+            let rectangle = vec![
+                lift(lower),
+                lift(Point2::new(upper.x, lower.y)),
+                lift(upper),
+                lift(Point2::new(lower.x, upper.y)),
+            ];
+            let pieces = loops.iter().try_fold(vec![rectangle], |pieces, wire| {
+                wire.iter()
+                    .zip(wire.iter().cycle().skip(1))
+                    .try_fold(pieces, |pieces, (a, b)| {
+                        let a = lift(*a);
+                        let b = lift(*b);
+                        if a == b {
+                            return None;
+                        }
+                        let cut_normal = (b - a).cross(normal).normalize();
+                        pieces
+                            .into_iter()
+                            .try_fold(Vec::new(), |mut result, points| {
+                                *work = work.checked_sub(points.len())?;
+                                result.extend(split_planar_cell(points, a, cut_normal));
+                                Some(result)
+                            })
+                    })
+            })?;
+            pieces
+                .into_iter()
+                .try_fold(Vec::new(), |mut cells, points| {
+                    if points.len() < 3 {
+                        return None;
+                    }
+                    let point = project(
+                        points[0]
+                            + points.iter().map(|p| *p - points[0]).sum::<Vector3>()
+                                / points.len() as f64,
+                    );
+                    let winding = loops.iter().try_fold(0_isize, |sum, wire| {
+                        *work = work.checked_sub(wire.len())?;
+                        match loop_domain(wire, point) {
+                            0 => None,
+                            -1 => Some(sum),
+                            _ => {
+                                let area = wire
+                                    .iter()
+                                    .zip(wire.iter().cycle().skip(1))
+                                    .map(|(a, b)| {
+                                        let a = *a - wire[0];
+                                        let b = *b - wire[0];
+                                        a.x * b.y - a.y * b.x
+                                    })
+                                    .sum::<f64>();
+                                (area.is_finite() && area != 0.0)
+                                    .then_some(sum + if area > 0.0 { 1 } else { -1 })
+                            }
+                        }
+                    })?;
+                    if winding != 0 {
+                        cells.push(PlanarCell {
+                            surface: surface.clone(),
+                            orientation: face.orientation(),
+                            normal,
+                            points,
+                        });
+                    }
+                    Some(cells)
+                })
+        })
+        .collect::<Option<Vec<_>>>()?;
+    if incidence.is_empty() || incidence.values().any(|(_, count)| *count != 2) {
+        None
+    } else {
+        Some((faces.into_iter().flatten().collect(), complex))
+    }
+}
