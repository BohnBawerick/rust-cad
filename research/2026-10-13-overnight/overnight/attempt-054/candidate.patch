+/// Retry failed planar operations using all trim lines, including hole boundaries.
+fn planar_trim_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let mut work = 262_144;
+    let (mut cells, complex0) = planar_trim_cells(solid0, &mut work)?;
+    let first_len = cells.len();
+    let (other, complex1) = planar_trim_cells(solid1, &mut work)?;
+    if !complex0 && !complex1 {
+        return None;
+    }
+    cells.extend(other);
+    assemble_planar_cells(cells, first_len, operation, true, work, 2048)
 }
 
