+/// Select an oriented section arc by continuation along the intersection.
+///
+/// Closed sections may cross their parameter seam. Concatenating one translated
+/// copy of the knot vector exposes that arc without changing its geometry.
+fn oriented_section<S: ShapeOpsSurface>(
+    section: &NurbsCurve<Vector4>,
+    intersection: &IntersectionCurve<PolylineCurve<Point3>, S, S>,
+    projections: &mut usize,
+) -> Option<NurbsCurve<Vector4>> {
+    let front = intersection.leader().front();
+    let back = intersection.leader().back();
+    [false, true].into_iter().find_map(|reverse| {
+        let mut curve = section.clone();
+        if reverse {
+            curve.invert();
+        }
+        *projections = projections.checked_sub(2)?;
+        let start = sweep_parameter(&curve, front)?;
+        let mut end = sweep_parameter(&curve, back)?;
+        if end <= start && curve.front().near(&curve.back()) {
+            let (first, last) = curve.range_tuple();
+            let period = last - first;
+            let mut next = curve.clone();
+            next.parameter_transform(1.0, period);
+            curve = curve.try_concat(&next).ok()?;
+            end += period;
+        }
+        let arc = section_trim(&curve, start, end)?;
+        let (first, last) = intersection.leader().range_tuple();
+        let samples = intersection.leader().as_slice().len().clamp(4, 16);
+        (1..samples).try_fold(start, |previous, index| {
+            *projections = projections.checked_sub(1)?;
+            let fraction = index as f64 / samples as f64;
+            let point = intersection
+                .search_triple(first + (last - first) * fraction, 100)?
+                .0;
+            let parameter = arc
+                .search_parameter(point, Some(previous), 100)
+                .or_else(|| arc.search_parameter(point, None, 100))?;
+            (parameter >= previous && parameter <= end && arc.evaluate(parameter).near(&point))
+                .then_some(parameter)
+        })?;
+        (arc.front().near(&front) && arc.back().near(&back)).then_some(arc)
+    })
+}
