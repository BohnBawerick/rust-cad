+/// Certify a convex enclosure of each complete trimmed face.
+///
+/// Bounded positive-weight splines lie in their control hulls. A planar face
+/// lies in the convex hull of its boundary. A curved boundary shared with a
+/// bounded spline lies in the projection of that spline's hull onto the plane;
+/// a boundary shared by two transverse planes is the segment between its ends.
+/// Coplanar seams and unbounded nonplanar supports decline certification.
+fn boundary_enclosures<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    work: &mut usize,
+) -> Option<Vec<(Point3, Point3)>> {
+    let faces = solid.face_iter().collect::<Vec<_>>();
+    let mut incidence: HashMap<EdgeId<C>, SmallVec<[usize; 2]>> = HashMap::default();
+    let supports = faces
+        .iter()
+        .enumerate()
+        .map(|(index, face)| {
+            face.edge_iter().try_for_each(|edge| {
+                *work = work.checked_sub(1)?;
+                let adjacent = incidence.entry(edge.id()).or_default();
+                if adjacent.len() == 2 {
+                    return None;
+                }
+                adjacent.push(index);
+                Some(())
+            })?;
+            let surface = face.surface();
+            if surface.supports_exact_patch_domains() {
+                let spline = surface.try_into_homogeneous_bspline_surface()?;
+                let controls = spline.control_points();
+                *work = work.checked_sub(controls.iter().map(Vec::len).sum())?;
+                if !controls
+                    .iter()
+                    .flatten()
+                    .all(|p| p.w.is_finite() && p.w > 0.0)
+                {
+                    return None;
+                }
+                let bounds = boundary_bounds(controls.iter().flatten().map(|p| p.to_point()))?;
+                Some((None, Some(bounds)))
+            } else {
+                Some((Some(certified_plane(&surface)?), None))
+            }
+        })
+        .collect::<Option<Vec<_>>>()?;
+    if incidence.values().any(|adjacent| adjacent.len() != 2) {
+        return None;
+    }
+    faces
+        .iter()
+        .enumerate()
+        .map(|(index, face)| {
+            if let Some(bounds) = supports[index].1 {
+                Some(bounds)
+            } else {
+                let plane = supports[index].0.as_ref()?;
+                let normal = plane.normal();
+                let points = face
+                    .edge_iter()
+                    .map(|edge| {
+                        *work = work.checked_sub(16)?;
+                        let adjacent = incidence.get(&edge.id())?;
+                        let other = *adjacent.iter().find(|&&other| other != index)?;
+                        let points: SmallVec<[Point3; 16]> =
+                            if let Some((minimum, maximum)) = supports[other].1 {
+                                (0..8)
+                                    .flat_map(|corner| {
+                                        let point = Point3::new(
+                                            if corner & 1 == 0 {
+                                                minimum.x
+                                            } else {
+                                                maximum.x
+                                            },
+                                            if corner & 2 == 0 {
+                                                minimum.y
+                                            } else {
+                                                maximum.y
+                                            },
+                                            if corner & 4 == 0 {
+                                                minimum.z
+                                            } else {
+                                                maximum.z
+                                            },
+                                        );
+                                        let projected = point
+                                            + normal
+                                                * ((plane.origin() - point).dot(normal)
+                                                    / normal.magnitude2());
+                                        // Account for cancellation before bounding the projection.
+                                        let error = 128.0
+                                            * f64::EPSILON
+                                            * (point.to_vec().magnitude()
+                                                + plane.origin().to_vec().magnitude());
+                                        let padding = Vector3::new(error, error, error);
+                                        [projected - padding, projected + padding]
+                                    })
+                                    .collect()
+                            } else {
+                                let other = supports[other].0.as_ref()?;
+                                if normal.cross(other.normal()).so_small() {
+                                    return None;
+                                }
+                                [edge.front().point(), edge.back().point()]
+                                    .into_iter()
+                                    .collect()
+                            };
+                        Some(points)
+                    })
+                    .collect::<Option<Vec<_>>>()?;
+                boundary_bounds(points.into_iter().flatten())
+            }
+        })
+        .collect()
+}
