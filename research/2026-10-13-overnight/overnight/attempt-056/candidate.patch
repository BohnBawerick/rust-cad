+/// Enclose a finite set, rounding the coordinate bounds outwards.
+fn boundary_bounds(points: impl IntoIterator<Item = Point3>) -> Option<(Point3, Point3)> {
+    let (minimum, maximum) = points.into_iter().try_fold(
+        (
+            Point3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY),
+            Point3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY),
+        ),
+        |(minimum, maximum), point| {
+            (point.x.is_finite() && point.y.is_finite() && point.z.is_finite()).then_some((
+                Point3::new(
+                    minimum.x.min(point.x),
+                    minimum.y.min(point.y),
+                    minimum.z.min(point.z),
+                ),
+                Point3::new(
+                    maximum.x.max(point.x),
+                    maximum.y.max(point.y),
+                    maximum.z.max(point.z),
+                ),
+            ))
+        },
+    )?;
+    let padding = Vector3::new(
+        minimum.x.abs() + maximum.x.abs(),
+        minimum.y.abs() + maximum.y.abs(),
+        minimum.z.abs() + maximum.z.abs(),
+    ) * (64.0 * f64::EPSILON);
+    (padding.x.is_finite() && padding.y.is_finite() && padding.z.is_finite())
+        .then_some((minimum - padding, maximum + padding))
+}
