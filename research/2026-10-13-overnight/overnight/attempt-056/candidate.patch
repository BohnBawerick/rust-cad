+/// Assemble components whose boundaries are certified mutually disjoint.
+///
+/// Disjoint face enclosures prove that membership cannot change on a connected
+/// boundary component, even when the enclosing boxes of the whole solids overlap.
+/// Classify against all oriented shells together, then retain exact input faces.
+fn separated_boundaries_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let mut work = 262_144_usize;
+    let bounds0 = boundary_enclosures(solid0, &mut work)?;
+    let bounds1 = boundary_enclosures(solid1, &mut work)?;
+    work = work.checked_sub(bounds0.len().checked_mul(bounds1.len())?)?;
+    if !bounds0.iter().all(|(min0, max0)| {
+        bounds1.iter().all(|(min1, max1)| {
+            (0..3).any(|axis| max0[axis] < min1[axis] || max1[axis] < min0[axis])
+        })
+    }) {
+        return None;
+    }
+    let mut boundaries = Vec::new();
+    [
+        (solid0, solid1, &bounds1, false),
+        (solid1, solid0, &bounds0, true),
+    ]
+    .into_iter()
+    .try_for_each(|(source, other, enclosures, second)| {
+        source.boundaries().iter().try_for_each(|shell| {
+            shell
+                .connected_components()
+                .into_iter()
+                .try_for_each(|mut component| {
+                    let point = component.first()?.edge_iter().next()?.front().point();
+                    let inside = boundary_winding(point, other, enclosures, &mut work)?;
+                    let retain = match operation {
+                        Operation::Intersection => inside,
+                        Operation::Union => !inside,
+                        Operation::Difference => inside == second,
+                    };
+                    if retain {
+                        if second && matches!(operation, Operation::Difference) {
+                            component.iter_mut().for_each(|face| {
+                                face.invert();
+                            });
+                        }
+                        boundaries.push(component);
+                    }
+                    Some(())
+                })
+        })
+    })?;
+    Solid::try_new(boundaries).ok()
+}
