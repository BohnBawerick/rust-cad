+/// Evaluate winding by a deformation certified to avoid the query.
+///
+/// The query must lie outside every face enclosure. Within those convex sets,
+/// each trim can deform to its endpoint chord and each face to a triangle fan.
+/// Shared edges deform together, so the resulting closed chain has exactly the
+/// same winding as the original curved boundary. Holes and inward shells keep
+/// their signs. These fans are only a degree calculation, never output geometry.
+fn boundary_winding<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    point: Point3,
+    solid: &Solid<Point3, C, S>,
+    enclosures: &[(Point3, Point3)],
+    work: &mut usize,
+) -> Option<bool> {
+    let mut terms = 0_usize;
+    let angle =
+        solid
+            .face_iter()
+            .zip(enclosures)
+            .try_fold(0.0, |sum, (face, &(minimum, maximum))| {
+                if !(0..3).any(|axis| point[axis] < minimum[axis] || point[axis] > maximum[axis]) {
+                    return None;
+                }
+                let anchor = minimum.midpoint(maximum);
+                face.edge_iter().try_fold(sum, |sum, edge| {
+                    *work = work.checked_sub(1)?;
+                    terms += 1;
+                    let vectors = [anchor, edge.front().point(), edge.back().point()]
+                        .map(|vertex| vertex - point);
+                    if vectors
+                        .iter()
+                        .any(|v| !v.magnitude2().is_finite() || v.magnitude2() == 0.0)
+                    {
+                        return None;
+                    }
+                    let [a, b, c] = vectors.map(|v| v.normalize());
+                    let numerator = a.dot(b.cross(c));
+                    let denominator = 1.0 + a.dot(b) + b.dot(c) + c.dot(a);
+                    if !numerator.is_finite()
+                        || !denominator.is_finite()
+                        || numerator.abs() + denominator.abs() <= 64.0 * f64::EPSILON
+                    {
+                        None
+                    } else {
+                        Some(sum + 2.0 * numerator.atan2(denominator))
+                    }
+                })
+            })?;
+    let winding = angle / (4.0 * PI);
+    let integer = winding.round();
+    let error = 4096.0 * f64::EPSILON * terms.max(1) as f64;
+    if (winding - integer).abs() > error {
+        None
+    } else if integer == 0.0 {
+        Some(false)
+    } else if integer == 1.0 {
+        Some(true)
+    } else {
+        None
+    }
+}
