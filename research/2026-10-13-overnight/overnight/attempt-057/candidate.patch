+/// Select how a classification mesh obtains its parameter-space boundary.
+#[derive(Clone, Copy)]
+enum BoundaryMeshing {
+    Sampled,
+    Parametric,
+}
+
+/// Tessellate with curve-supplied trims without changing boundary orientation.
+///
+/// The compressed mesher can retain a curve's parameter boundary, which is
+/// unavailable after replacing the curve by its spatial polyline. In particular,
+/// a periodic seam has distinct parameter values at the same spatial point.
+/// Meshes must follow the absolute surface orientation: [`inside`] applies each
+/// face's material-side orientation separately, including inward cavity faces.
+fn classification_mesh<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &Shell<Point3, C, S>,
+    tol: f64,
+    meshing: BoundaryMeshing,
+) -> Option<PolyShell> {
+    match meshing {
+        BoundaryMeshing::Sampled => Some(shell.triangulation(tol)),
+        BoundaryMeshing::Parametric => {
+            let mut compressed = shell.compress();
+            compressed.faces.iter_mut().for_each(|face| {
+                face.orientation = true;
+            });
+            let mut polygons = compressed.triangulation(tol);
+            polygons
+                .faces
+                .iter_mut()
+                .zip(shell)
+                .try_for_each(|(polygon, face)| {
+                    polygon.orientation = face.orientation();
+                    // Missing or empty patches cannot represent a complete winding boundary.
+                    polygon.surface.as_ref()?.face_iter().next().map(|_| ())
+                })?;
+            PolyShell::extract(polygons).ok()
+        }
+    }
+}
