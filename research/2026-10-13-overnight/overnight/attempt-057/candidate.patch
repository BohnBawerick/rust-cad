+/// Require every directed trim occurrence to survive a recovered division.
+///
+/// Opposite uses of an intersection edge bound different cells. Counting them
+/// independently detects lost patches even when their signed boundary cancels.
+fn retains_directed_trims<C, S>(
+    divided: &FacesClassification<Point3, C, S>,
+    store: &LoopsStore<Point3, C>,
+) -> bool {
+    let mut occurrences: HashMap<EdgeId<C>, [usize; 2]> = HashMap::default();
+    store
+        .iter()
+        .flat_map(|loops| loops.iter())
+        .for_each(|wire| {
+            wire.iter().for_each(|edge| {
+                occurrences.entry(edge.id()).or_default()[usize::from(edge.orientation())] += 1;
+            });
+        });
+    let complete = divided.and_or_unknown().iter().try_for_each(|shell| {
+        shell.iter().try_for_each(|face| {
+            face.absolute_boundaries().iter().try_for_each(|wire| {
+                wire.iter().try_for_each(|edge| {
+                    let count =
+                        &mut occurrences.get_mut(&edge.id())?[usize::from(edge.orientation())];
+                    *count = count.checked_sub(1)?;
+                    Some(())
+                })
+            })
+        })
+    });
+    complete.is_some() && occurrences.values().all(|counts| *counts == [0, 0])
+}
