+/// Exclude an open face patch on a certified separating plane.
+///
+/// On each open knot rectangle, the active tensor-product spline basis is
+/// positive. Since the complete control net is on one side of the plane,
+/// one strictly off-plane active control point excludes a coplanar patch.
+/// Knot lines may still touch the plane; they have no surface interior.
+/// The enclosing hull certificate also covers the wires of analytic planes.
+fn excludes_plane_patch<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    origin: Point3,
+    normal: Vector3,
+    roundoff: f64,
+    work: &mut usize,
+) -> Option<()> {
+    solid.face_iter().try_for_each(|face| {
+        *work = work.checked_sub(1)?;
+        let surface = face.surface();
+        if !surface.supports_exact_patch_domains() {
+            let plane = certified_plane(&surface)?;
+            let (distance, error) = plane_distance(plane.origin(), origin, normal);
+            (!plane.normal().cross(normal).so_small() || distance.abs() > error.max(roundoff))
+                .then_some(())
+        } else {
+            let spline = surface.try_into_homogeneous_bspline_surface()?;
+            let controls = spline.control_points();
+            let (p, q) = spline.degrees();
+            if !spline.is_clamped() {
+                return None;
+            }
+            let width = controls[0].len();
+            let off_plane = controls
+                .iter()
+                .flatten()
+                .map(|control| {
+                    *work = work.checked_sub(1)?;
+                    if !control.w.is_finite() || control.w <= 0.0 {
+                        return None;
+                    }
+                    let (distance, error) = plane_distance(control.to_point(), origin, normal);
+                    (distance.is_finite() && error.is_finite())
+                        .then_some(distance.abs() > error.max(roundoff))
+                })
+                .collect::<Option<SmallVec<[bool; 64]>>>()?;
+            let uknots = spline.knot_vector_u();
+            let vknots = spline.knot_vector_v();
+            (p..controls.len()).try_for_each(|i| {
+                if uknots[i] == uknots[i + 1] {
+                    return Some(());
+                }
+                (q..controls[0].len()).try_for_each(|j| {
+                    if vknots[j] == vknots[j + 1] {
+                        return Some(());
+                    }
+                    *work = work.checked_sub((p + 1).checked_mul(q + 1)?)?;
+                    ((i - p..=i).any(|u| (j - q..=j).any(|v| off_plane[u * width + v])))
+                        .then_some(())
+                })
+            })
+        }
+    })
+}
