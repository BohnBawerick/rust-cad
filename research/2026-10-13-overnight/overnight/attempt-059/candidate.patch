+/// Assemble a union whose separating plane contains no open boundary patch.
+///
+/// The input enclosures establish disjoint interiors; [`excludes_plane_patch`]
+/// establishes that no face must be cancelled. All oriented shells therefore
+/// remain in the union, including cavity shells. Shared trim occurrences still
+/// belong to independent material sectors and must retain separate topology.
+/// Cutting the second occurrence changes only its exact curve decomposition.
+/// Trim samples select edges for subdivision, never certify solid separation.
+fn curved_contact_union<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    origin: Point3,
+    normal: Vector3,
+    roundoff: f64,
+) -> Option<Solid<Point3, C, S>> {
+    let mut work = 262_144_usize;
+    excludes_plane_patch(solid0, origin, normal, roundoff, &mut work)?;
+    excludes_plane_patch(solid1, origin, normal, roundoff, &mut work)?;
+    let on_plane = |point| {
+        let (distance, error) = plane_distance(point, origin, normal);
+        distance.is_finite() && distance.abs() <= error.max(roundoff)
+    };
+    let edges0 = solid0
+        .edge_iter()
+        .filter(|edge| on_plane(edge.front().point()) && on_plane(edge.back().point()))
+        .collect::<Vec<_>>();
+    if edges0.is_empty() {
+        return None;
+    }
+    let mut shells1 = solid1.boundaries().clone();
+    let mut visited = HashMap::default();
+    let mut subdivisions = 0_usize;
+    solid1.edge_iter().try_for_each(|edge| {
+        work = work.checked_sub(1)?;
+        if visited.insert(edge.id(), ()).is_some()
+            || !on_plane(edge.front().point())
+            || !on_plane(edge.back().point())
+        {
+            return Some(());
+        }
+        let curve = edge.curve();
+        let (start, end) = curve.range_tuple();
+        let middle = start + (end - start) / 2.0;
+        if !middle.is_finite() || middle <= start || middle >= end {
+            return None;
+        }
+        let point = curve.evaluate(middle);
+        if !on_plane(point) {
+            return Some(());
+        }
+        let coincident = edges0.iter().try_fold(false, |found, other| {
+            work = work.checked_sub(1)?;
+            let a = edge.front().point();
+            let b = edge.back().point();
+            let c = other.front().point();
+            let d = other.back().point();
+            Some(
+                found
+                    || (((a.near(&c) && b.near(&d)) || (a.near(&d) && b.near(&c)))
+                        && on_edge(point, other)),
+            )
+        })?;
+        if coincident {
+            if point.near(&edge.front().point()) || point.near(&edge.back().point()) {
+                return None;
+            }
+            let vertex = Vertex::new(point);
+            let (first, second) = shells1
+                .iter_mut()
+                .find_map(|shell| shell.cut_edge(edge.id(), &vertex))?;
+            if !first.is_geometric_consistent() || !second.is_geometric_consistent() {
+                return None;
+            }
+            subdivisions += 1;
+        }
+        Some(())
+    })?;
+    if subdivisions == 0 {
+        None
+    } else {
+        Solid::try_new(solid0.boundaries().iter().cloned().chain(shells1).collect()).ok()
+    }
+}
