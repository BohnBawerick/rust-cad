+/// Apply nested set identities only after complete geometric containment proof.
+fn contained_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    if convexly_contains(solid1, solid0).is_some() {
+        match operation {
+            Operation::Intersection => Some(solid0.clone()),
+            Operation::Union => Some(solid1.clone()),
+            Operation::Difference => Solid::try_new(Vec::new()).ok(),
+        }
+    } else if convexly_contains(solid0, solid1).is_some() {
+        match operation {
+            Operation::Intersection => Some(solid1.clone()),
+            Operation::Union => Some(solid0.clone()),
+            Operation::Difference => {
+                let reversed = solid1
+                    .boundaries()
+                    .iter()
+                    .map(|shell| shell.iter().map(Face::inverse).collect::<Shell<_, _, _>>());
+                Solid::try_new(
+                    solid0
+                        .boundaries()
+                        .iter()
+                        .cloned()
+                        .chain(reversed)
+                        .collect(),
+                )
+                .ok()
+            }
+        }
+    } else {
+        None
+    }
+}
