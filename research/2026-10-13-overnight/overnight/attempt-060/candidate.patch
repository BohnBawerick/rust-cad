+/// Certify that a converted analytic support has no open nonperiodic ends.
+///
+/// A periodic direction covers its complete orbit. In the other direction,
+/// matching boundary curves or two collapsed boundary curves close the support.
+/// This includes compact revolutions and their transformed carriers, without
+/// treating an incidental line-profile interval as a bound on an analytic cone
+/// or cylinder. The conversion is used only as a geometric enclosure; its knot
+/// coordinates need not agree with the original surface parameters.
+fn closed_support<S: ShapeOpsSurface>(surface: &S, spline: &BsplineSurface<Vector4>) -> bool {
+    let periodic = |period: Option<f64>| period.is_some_and(|p| p.is_finite() && p > 0.0);
+    let periodic_u = periodic(surface.period_u());
+    let periodic_v = periodic(surface.period_v());
+    let controls = spline.control_points();
+    if (!periodic_u && !periodic_v)
+        || !spline.is_clamped()
+        || controls.is_empty()
+        || controls[0].is_empty()
+        || controls.iter().map(Vec::len).sum::<usize>() > 65_536
+        || !controls.iter().flatten().all(|point| {
+            point.w.is_finite()
+                && point.w > 0.0
+                && point.to_point().to_vec().magnitude2().is_finite()
+        })
+    {
+        return false;
+    }
+    let same_point = |a: Vector4, b: Vector4| {
+        let a = a.to_point();
+        let b = b.to_point();
+        let roundoff = 32.0 * f64::EPSILON * (a.to_vec().magnitude() + b.to_vec().magnitude());
+        (a - b).magnitude() <= roundoff
+    };
+    let last_u = controls.len() - 1;
+    let last_v = controls[0].len() - 1;
+    // A line profile can be continued outside its incidental knot interval.
+    // Its finite end circles must never certify a compact analytic support.
+    if (!periodic_u && spline.udegree() < 2) || (!periodic_v && spline.vdegree() < 2) {
+        return false;
+    }
+    let closed_u = (0..=last_v).all(|v| {
+        controls[0][v].w == controls[last_u][v].w && same_point(controls[0][v], controls[last_u][v])
+    }) || (0..=last_v).all(|v| {
+        same_point(controls[0][v], controls[0][0])
+            && same_point(controls[last_u][v], controls[last_u][0])
+    });
+    let closed_v = (0..=last_u).all(|u| {
+        controls[u][0].w == controls[u][last_v].w && same_point(controls[u][0], controls[u][last_v])
+    }) || (0..=last_u).all(|u| {
+        same_point(controls[u][0], controls[0][0])
+            && same_point(controls[u][last_v], controls[0][last_v])
+    });
+    closed_u && closed_v
+}
