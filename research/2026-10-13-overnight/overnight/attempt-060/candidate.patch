+/// Prove strict containment of a complete enclosure in a convex planar solid.
+///
+/// Every boundary vertex must lie behind every oriented support plane. Since
+/// [`planar_cells`] certifies the complete planar faces and their straight
+/// trims, a single closed shell satisfying these inequalities bounds their
+/// convex intersection. All eight enclosure corners strictly inside every
+/// half-space then certify containment of the entire inner solid.
+fn convexly_contains<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    outer: &Solid<Point3, C, S>,
+    inner: &Solid<Point3, C, S>,
+) -> Option<()> {
+    if outer.boundaries().len() != 1 {
+        return None;
+    }
+    let mut work = 65_536_usize;
+    let cells = planar_cells(outer, &mut work)?;
+    if cells.is_empty() {
+        return None;
+    }
+    let (minimum, maximum) = solid_enclosure(inner)?;
+    cells.iter().try_for_each(|plane| {
+        cells.iter().try_for_each(|cell| {
+            cell.points.iter().try_for_each(|point| {
+                work = work.checked_sub(1)?;
+                let (distance, error) = plane_distance(*point, plane.points[0], plane.normal);
+                (distance.is_finite() && error.is_finite() && distance <= error).then_some(())
+            })
+        })?;
+        (0..8).try_for_each(|index| {
+            work = work.checked_sub(1)?;
+            let point = Point3::new(
+                if index & 1 == 0 { minimum.x } else { maximum.x },
+                if index & 2 == 0 { minimum.y } else { maximum.y },
+                if index & 4 == 0 { minimum.z } else { maximum.z },
+            );
+            let (distance, error) = plane_distance(point, plane.points[0], plane.normal);
+            (distance.is_finite() && error.is_finite() && distance < -error).then_some(())
+        })
+    })
+}
