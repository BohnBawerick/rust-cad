+/// Recover missing classification meshes using the input curves' local trims.
+///
+/// The ordinary shell mesher first replaces curves with spatial polylines.
+/// Inverting those polylines can lose a periodic branch or fail at a singular
+/// chart. The compressed mesher can instead use [`ParameterBoundary2D`] before
+/// projecting a boundary. Its meshes remain classification aids; all output
+/// surfaces, curves, and shared topology still come from the exact operands.
+///
+/// [`Shell::compress`] stores absolute wires. Set the temporary faces to the
+/// absolute orientation so that the trim mesher does not reverse those wires.
+/// The original polygon faces retain their signs, which winding applies once.
+fn classification_mesh<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &Shell<Point3, C, S>,
+    polygons: PolyShell,
+    tol: f64,
+) -> Option<PolyShell> {
+    if shell.len() != polygons.len() {
+        return None;
+    }
+    let missing: SmallVec<[usize; 8]> = polygons
+        .iter()
+        .enumerate()
+        .filter_map(|(index, face)| {
+            (!face.surface().as_ref().is_some_and(mesh_has_area)).then_some(index)
+        })
+        .collect();
+    if missing.is_empty() {
+        return Some(polygons);
+    }
+    let mut work = 16_384_usize;
+    let unresolved = missing
+        .iter()
+        .map(|&index| {
+            let mut face = shell[index].clone();
+            work = work.checked_sub(1)?;
+            work = work.checked_sub(
+                face.absolute_boundaries()
+                    .iter()
+                    .map(|wire| wire.len())
+                    .sum(),
+            )?;
+            if !face.orientation() {
+                face.invert();
+            }
+            Some(face)
+        })
+        .collect::<Option<Shell<_, _, _>>>()?
+        .compress();
+    let mut recovered = unresolved.triangulation(tol);
+    if recovered
+        .faces
+        .iter()
+        .any(|face| !face.surface.as_ref().is_some_and(mesh_has_area))
+    {
+        // Nearest-parameter search is a second chart inversion strategy at the
+        // same tolerance. It never supplies replacement B-rep geometry.
+        let nearest = unresolved.robust_triangulation(tol);
+        recovered
+            .faces
+            .iter_mut()
+            .zip(nearest.faces)
+            .for_each(|(face, retry)| {
+                if !face.surface.as_ref().is_some_and(mesh_has_area) {
+                    face.surface = retry.surface;
+                }
+            });
+    }
+    if recovered.faces.len() != missing.len() {
+        return None;
+    }
+    missing
+        .into_iter()
+        .zip(recovered.faces)
+        .try_for_each(|(index, face)| {
+            let mesh = face.surface.filter(mesh_has_area)?;
+            // Preserve the existing polygon edge identities and decompositions.
+            // The marching stores pair those edges with the exact input edges.
+            polygons[index].set_surface(Some(mesh));
+            Some(())
+        })?;
+    Some(polygons)
+}
