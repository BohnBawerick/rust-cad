+/// Distinguish a usable face mesh from a failed or collapsed tessellation.
+fn mesh_has_area(mesh: &PolygonMesh) -> bool {
+    mesh.positions()
+        .iter()
+        .all(|point| point.x.is_finite() && point.y.is_finite() && point.z.is_finite())
+        && mesh.face_iter().any(|polygon| {
+            (2..polygon.len()).any(|index| {
+                let [a, b, c] = [polygon[0], polygon[index - 1], polygon[index]]
+                    .map(|vertex| mesh.positions()[vertex.pos]);
+                let area = (b - a).cross(c - a).magnitude2();
+                area.is_finite() && area > 0.0
+            })
+        })
+}
