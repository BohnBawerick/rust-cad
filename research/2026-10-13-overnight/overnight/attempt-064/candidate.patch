+/// Search the Minkowski difference for a strict supporting-plane certificate.
+///
+/// A closest-point iteration proposes directions only. Every accepted direction
+/// is independently checked against every support point with arithmetic error
+/// bounds, so incomplete convergence cannot assert disjointness. The work cap
+/// and fixed iteration count also apply to intersecting and touching hulls.
+fn support_hulls_separated(first: &[Point3], second: &[Point3], roundoff: f64) -> Option<()> {
+    let mut closest = *first.first()? - *second.first()?;
+    let mut work = 262_144_usize;
+    let mut active = true;
+    (0..64).find_map(|_| {
+        if !active {
+            return None;
+        }
+        let count = first.len().checked_add(second.len())?.checked_mul(2)?;
+        let Some(remaining) = work.checked_sub(count) else {
+            active = false;
+            return None;
+        };
+        work = remaining;
+        let norm = closest.magnitude();
+        if !norm.is_finite() || norm == 0.0 {
+            active = false;
+            return None;
+        }
+        let normal = closest / norm;
+        let anchor = first[0];
+        let projection = |point: &Point3| (*point - anchor).dot(normal);
+        let a = *first
+            .iter()
+            .min_by(|a, b| projection(a).total_cmp(&projection(b)))?;
+        let b = *second
+            .iter()
+            .max_by(|a, b| projection(a).total_cmp(&projection(b)))?;
+        let origin = a + (b - a) / 2.0;
+        let strict = first.iter().all(|point| {
+            let (distance, error) = plane_distance(*point, origin, normal);
+            distance.is_finite() && error.is_finite() && distance > error + roundoff
+        }) && second.iter().all(|point| {
+            let (distance, error) = plane_distance(*point, origin, normal);
+            distance.is_finite() && error.is_finite() && distance < -error - roundoff
+        });
+        if strict {
+            Some(())
+        } else {
+            let support = a - b;
+            let delta = support - closest;
+            let denominator = delta.magnitude2();
+            if !denominator.is_finite() || denominator == 0.0 {
+                active = false;
+            } else {
+                let step = (-closest.dot(delta) / denominator).clamp(0.0, 1.0);
+                if !step.is_finite() || step == 0.0 {
+                    active = false;
+                } else {
+                    closest += delta * step;
+                }
+            }
+            None
+        }
+    })
+}
