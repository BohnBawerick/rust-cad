+/// Apply disjoint set identities after an arbitrary supporting plane is proved.
+///
+/// Refinement is a fallback for loose rational control hulls. It changes only
+/// the certificate: output boundaries retain all exact input surfaces, trims,
+/// and orientations. A failed certificate leaves containment and contact to
+/// the existing classification and assembly paths.
+fn oblique_separated_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    [false, true].into_iter().find_map(|refine| {
+        let (first, first_error) = refined_support_points(solid0, refine)?;
+        let (second, second_error) = refined_support_points(solid1, refine)?;
+        support_hulls_separated(&first, &second, first_error.max(second_error))
+    })?;
+    match operation {
+        Operation::Difference => Some(solid0.clone()),
+        Operation::Intersection => Solid::try_new(Vec::new()).ok(),
+        Operation::Union => Solid::try_new(
+            solid0
+                .boundaries()
+                .iter()
+                .chain(solid1.boundaries())
+                .cloned()
+                .collect(),
+        )
+        .ok(),
+    }
+}
