+/// Retain the support hull instead of replacing it with an axis-aligned box.
+///
+/// The incidence proof in [`solid_enclosure`] covers planar wires as well as
+/// bounded rational faces. Subdivision tightens the latter's hull without
+/// changing the surface. Positive homogeneous weights preserve the convex-hull
+/// property on every child, including faces with holes and inward shells.
+fn refined_support_points<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    refine: bool,
+) -> Option<(Vec<Point3>, f64)> {
+    solid_enclosure(solid)?;
+    let mut work = 16_384_usize;
+    let mut roundoff = 0.0_f64;
+    let points = solid.face_iter().try_fold(Vec::new(), |mut points, face| {
+        let surface = face.surface();
+        if surface.supports_exact_patch_domains() {
+            let spline = surface.try_into_homogeneous_bspline_surface()?;
+            let count = spline.control_points().iter().map(Vec::len).sum::<usize>();
+            work = work.checked_sub(count)?;
+            if !spline.is_clamped() || (refine && (spline.udegree() > 8 || spline.vdegree() > 8)) {
+                return None;
+            }
+            if refine {
+                // Bound subdivision arithmetic using the original homogeneous
+                // scale, including cancellation and unequal rational weights.
+                let (scale, low, high) = spline.control_points().iter().flatten().fold(
+                    (0.0_f64, f64::INFINITY, 0.0_f64),
+                    |(scale, low, high), control| {
+                        (
+                            scale.max(control.to_point().to_vec().magnitude()),
+                            low.min(control.w),
+                            high.max(control.w),
+                        )
+                    },
+                );
+                let error = 65_536.0 * f64::EPSILON * scale * (high / low);
+                if !error.is_finite() {
+                    return None;
+                }
+                roundoff = roundoff.max(error);
+            }
+            let patches = (0..usize::from(refine) * 2).try_fold(vec![spline], |patches, _| {
+                patches
+                    .into_iter()
+                    .try_fold(Vec::new(), |mut children, mut patch| {
+                        let ((u0, u1), (v0, v1)) = patch.range_tuple();
+                        let u = u0 + (u1 - u0) / 2.0;
+                        let v = v0 + (v1 - v0) / 2.0;
+                        if !u.is_finite()
+                            || !v.is_finite()
+                            || u <= u0
+                            || u >= u1
+                            || v <= v0
+                            || v >= v1
+                        {
+                            return None;
+                        }
+                        // Each cut retains both children. No trim or support
+                        // geometry is approximated or discarded by refinement.
+                        let mut right = patch.cut_u(u);
+                        let upper_left = patch.cut_v(v);
+                        let upper_right = right.cut_v(v);
+                        let parts = [patch, right, upper_left, upper_right];
+                        let count = parts
+                            .iter()
+                            .map(|part| part.control_points().iter().map(Vec::len).sum::<usize>())
+                            .sum::<usize>();
+                        work = work.checked_sub(count)?;
+                        children.extend(parts);
+                        Some(children)
+                    })
+            })?;
+            patches.iter().try_for_each(|patch| {
+                patch
+                    .control_points()
+                    .iter()
+                    .flatten()
+                    .try_for_each(|control| {
+                        let point = control.to_point();
+                        if control.w <= 0.0
+                            || !control.w.is_finite()
+                            || !point.to_vec().magnitude2().is_finite()
+                        {
+                            None
+                        } else {
+                            points.push(point);
+                            Some(())
+                        }
+                    })
+            })?;
+        }
+        work = work.checked_sub(face.edge_iter().count().checked_mul(2)?)?;
+        points.extend(
+            face.edge_iter()
+                .flat_map(|edge| [edge.front().point(), edge.back().point()]),
+        );
+        Some(points)
+    })?;
+    Some((points, roundoff))
+}
