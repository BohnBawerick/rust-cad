+/// Compute degree using a boundary chain homologous to the exact solid.
+///
+/// The query must avoid every complete face hull. Inside each convex hull a
+/// face can then deform to fans over its boundary chords without crossing the
+/// query. Shared edges use identical chords, so those homotopies cancel. Holes
+/// and inward shells retain their signs. These triangles are used only for
+/// degree; they never replace any output geometry.
+fn boundary_degree<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    point: Point3,
+    solid: &Solid<Point3, C, S>,
+    hulls: &[BoundaryHull],
+    work: &mut usize,
+) -> Option<bool> {
+    let query = BoundaryHull {
+        minimum: point,
+        maximum: point,
+    };
+    if !hulls.iter().all(|hull| hull.separated(query)) {
+        return None;
+    }
+    let mut sum = 0.0_f64;
+    let mut correction = 0.0_f64;
+    let mut count = 0_usize;
+    solid.face_iter().try_for_each(|face| {
+        let sign = if face.orientation() { 1.0 } else { -1.0 };
+        face.absolute_boundaries().iter().try_for_each(|wire| {
+            let mut vertices = wire.iter().map(|edge| edge.front().point());
+            let origin = vertices.next()?;
+            let mut previous = vertices.next()?;
+            vertices.try_for_each(|next| {
+                *work = work.checked_sub(1)?;
+                let vectors = [origin, previous, next].map(|vertex| vertex - point);
+                let lengths = vectors.map(|vector| vector.magnitude());
+                if lengths
+                    .iter()
+                    .any(|length| !length.is_finite() || *length == 0.0)
+                {
+                    return None;
+                }
+                let [a, b, c] = [
+                    vectors[0] / lengths[0],
+                    vectors[1] / lengths[1],
+                    vectors[2] / lengths[2],
+                ];
+                let numerator = a.dot(b.cross(c));
+                let denominator = 1.0 + a.dot(b) + b.dot(c) + c.dot(a);
+                // Nearly antipodal directions make a fan angle ill-conditioned.
+                if !numerator.is_finite()
+                    || !denominator.is_finite()
+                    || numerator.abs() + denominator.abs() <= 256.0 * f64::EPSILON
+                {
+                    return None;
+                }
+                let angle = sign * 2.0 * numerator.atan2(denominator);
+                let increment = angle - correction;
+                let updated = sum + increment;
+                correction = (updated - sum) - increment;
+                sum = updated;
+                count += 1;
+                previous = next;
+                Some(())
+            })
+        })
+    })?;
+    let winding = sum / (4.0 * PI);
+    let integer = winding.round();
+    let error = 4096.0 * f64::EPSILON * count.max(1) as f64;
+    (winding.is_finite()
+        && (winding - integer).abs() <= error
+        && (integer == 0.0 || integer == 1.0))
+        .then_some(integer == 1.0)
+}
