+/// Assemble whole shell components only after proving boundary disjointness.
+///
+/// Material membership is constant on each connected boundary component.
+/// Degree sums all shells of the other operand, so a cavity is not confused
+/// with material containment. Subtraction reverses each retained cutter shell.
+fn nested_shell_boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Solid<Point3, C, S>> {
+    let hulls0 = boundary_hulls(solid0)?;
+    let hulls1 = boundary_hulls(solid1)?;
+    let mut work = 262_144_usize;
+    hulls0.iter().try_for_each(|a| {
+        hulls1.iter().try_for_each(|b| {
+            work = work.checked_sub(1)?;
+            a.separated(*b).then_some(())
+        })
+    })?;
+    let mut boundaries = Vec::new();
+    [
+        (solid0, solid1, &hulls1, false),
+        (solid1, solid0, &hulls0, true),
+    ]
+    .into_iter()
+    .try_for_each(|(source, other, hulls, second)| {
+        source.boundaries().iter().try_for_each(|shell| {
+            shell
+                .connected_components()
+                .into_iter()
+                .try_for_each(|mut component| {
+                    let point = component
+                        .first()?
+                        .absolute_boundaries()
+                        .first()?
+                        .front_vertex()?
+                        .point();
+                    let inside = boundary_degree(point, other, hulls, &mut work)?;
+                    let keep = match operation {
+                        Operation::Intersection => inside,
+                        Operation::Union => !inside,
+                        Operation::Difference => inside == second,
+                    };
+                    if keep {
+                        if second && matches!(operation, Operation::Difference) {
+                            component.iter_mut().for_each(|face| {
+                                face.invert();
+                            });
+                        }
+                        boundaries.push(component);
+                    }
+                    Some(())
+                })
+        })
+    })?;
+    Solid::try_new(boundaries).ok()
+}
