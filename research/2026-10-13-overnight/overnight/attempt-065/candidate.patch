+/// A convex enclosure of an entire trimmed face, including its curved wires.
+#[derive(Clone, Copy)]
+struct BoundaryHull {
+    minimum: Point3,
+    maximum: Point3,
+}
+
+impl BoundaryHull {
+    fn from_points(points: impl IntoIterator<Item = Point3>) -> Option<Self> {
+        let mut points = points.into_iter();
+        let first = points.next()?;
+        if !first.to_vec().magnitude2().is_finite() {
+            return None;
+        }
+        points.try_fold(
+            Self {
+                minimum: first,
+                maximum: first,
+            },
+            |mut hull, point| {
+                if !point.to_vec().magnitude2().is_finite() {
+                    return None;
+                }
+                (0..3).for_each(|axis| {
+                    hull.minimum[axis] = hull.minimum[axis].min(point[axis]);
+                    hull.maximum[axis] = hull.maximum[axis].max(point[axis]);
+                });
+                Some(hull)
+            },
+        )
+    }
+
+    fn separated(self, other: Self) -> bool {
+        (0..3).any(|axis| {
+            let scale = self.minimum[axis].abs()
+                + self.maximum[axis].abs()
+                + other.minimum[axis].abs()
+                + other.maximum[axis].abs();
+            let error = 256.0 * f64::EPSILON * scale;
+            error.is_finite()
+                && (other.minimum[axis] - self.maximum[axis] > error
+                    || self.minimum[axis] - other.maximum[axis] > error)
+        })
+    }
+}
+
+/// Enclose each face independently, rather than enclosing the solid's interior.
+///
+/// Positive spline weights enclose a bounded support. On a plane, every curved
+/// trim is enclosed by the projected control hull of its neighboring support.
+/// A trim between two nonparallel planes is straight. Coplanar seams and
+/// unbounded curved carriers require another method and decline this proof.
+fn boundary_hulls<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+) -> Option<Vec<BoundaryHull>> {
+    let faces = solid.face_iter().collect::<Vec<_>>();
+    let mut work = 65_536_usize;
+    let supports = faces
+        .iter()
+        .map(|face| {
+            let surface = face.surface();
+            if surface.supports_exact_patch_domains() {
+                let spline = surface.try_into_homogeneous_bspline_surface()?;
+                if !spline.is_clamped() {
+                    return None;
+                }
+                let points = spline
+                    .control_points()
+                    .iter()
+                    .flatten()
+                    .map(|control| {
+                        work = work.checked_sub(1)?;
+                        let point = control.to_point();
+                        (control.w.is_finite()
+                            && control.w > 0.0
+                            && point.to_vec().magnitude2().is_finite())
+                        .then_some(point)
+                    })
+                    .collect::<Option<Vec<_>>>()?;
+                Some((None, points))
+            } else {
+                Some((Some(certified_plane(&surface)?), Vec::new()))
+            }
+        })
+        .collect::<Option<Vec<_>>>()?;
+    let mut incidence: HashMap<EdgeId<C>, SmallVec<[usize; 2]>> = HashMap::default();
+    faces.iter().enumerate().try_for_each(|(index, face)| {
+        face.edge_iter().try_for_each(|edge| {
+            work = work.checked_sub(1)?;
+            let adjacent = incidence.entry(edge.id()).or_default();
+            if adjacent.len() == 2 {
+                return None;
+            }
+            adjacent.push(index);
+            Some(())
+        })
+    })?;
+    if incidence.values().any(|adjacent| adjacent.len() != 2) {
+        return None;
+    }
+    faces
+        .iter()
+        .enumerate()
+        .map(|(index, face)| {
+            let (plane, controls) = &supports[index];
+            if let Some(plane) = plane {
+                let normal = plane.normal();
+                let squared = normal.magnitude2();
+                if !squared.is_finite() || squared == 0.0 {
+                    return None;
+                }
+                let points = face.edge_iter().try_fold(Vec::new(), |mut points, edge| {
+                    work = work.checked_sub(2)?;
+                    points.extend([edge.front().point(), edge.back().point()]);
+                    let adjacent = incidence.get(&edge.id())?;
+                    let neighbor = adjacent.iter().copied().find(|other| *other != index)?;
+                    let (other_plane, controls) = &supports[neighbor];
+                    if let Some(other) = other_plane {
+                        if normal.cross(other.normal()).so_small() {
+                            return None;
+                        }
+                    } else {
+                        work = work.checked_sub(controls.len())?;
+                        points.extend(controls.iter().map(|point| {
+                            *point - normal * ((*point - plane.origin()).dot(normal) / squared)
+                        }));
+                    }
+                    Some(points)
+                })?;
+                BoundaryHull::from_points(points)
+            } else {
+                BoundaryHull::from_points(controls.iter().copied())
+            }
+        })
+        .collect()
+}
