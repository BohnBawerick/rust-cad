+/// Align open seam partitions without altering their supporting geometry.
+///
+/// Intersection insertion can split one occurrence of an input trim while an
+/// unclassified neighboring face retains its original edge. Sewing requires
+/// the same partition on both sides: every open-seam endpoint lying strictly
+/// inside another open trim becomes a cut on that trim. Only existing curves
+/// are cut, and face orientations, including inward cavity faces, are retained.
+/// [`sew_contact_edges`] requires a unique oppositely directed partner for every
+/// resulting interval. Nonmanifold incidences and ambiguous pairings fail.
+fn sew_subdivided_seams<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &Shell<Point3, C, S>,
+    tol: f64,
+) -> Option<Shell<Point3, C, S>> {
+    let mut incidences: HashMap<EdgeId<C>, (usize, bool)> = HashMap::default();
+    shell.edge_iter().try_for_each(|edge| {
+        let entry = incidences
+            .entry(edge.id())
+            .or_insert((0, edge.orientation()));
+        if entry.0 >= 2 || (entry.0 == 1 && entry.1 == edge.orientation()) {
+            None
+        } else {
+            entry.0 += 1;
+            Some(())
+        }
+    })?;
+    // Traverse faces in input order, rather than taking hash-table iteration
+    // order as the tie-break between geometrically coincident vertices.
+    let boundary = shell
+        .edge_iter()
+        .filter(|edge| incidences.get(&edge.id()).is_some_and(|entry| entry.0 == 1))
+        .collect::<Vec<_>>();
+    if boundary.is_empty() || boundary.len() > 128 {
+        return None;
+    }
+    let mut seen = HashMap::default();
+    let vertices = boundary
+        .iter()
+        .flat_map(|edge| [edge.front(), edge.back()])
+        .filter(|vertex| seen.insert(vertex.id(), ()).is_none())
+        .collect::<Vec<_>>();
+    let mut work = 16_384_usize;
+    let mut intervals = 256_usize;
+    let mut replacements: HashMap<EdgeId<C>, Wire<Point3, C>> = HashMap::default();
+    boundary.iter().try_for_each(|edge| {
+        let curve = edge.curve();
+        let (start, end) = curve.range_tuple();
+        if !start.is_finite() || !end.is_finite() || start >= end {
+            return None;
+        }
+        let front = edge.absolute_front();
+        let back = edge.absolute_back();
+        // Charge the maximum number of inverse queries before starting them.
+        work = work.checked_sub(vertices.len())?;
+        let interior = vertices.iter().filter_map(|vertex| {
+            let point = vertex.point();
+            if point.near(&front.point()) || point.near(&back.point()) {
+                None
+            } else {
+                let parameter = sweep_parameter(&curve, point)?;
+                (parameter > start && parameter < end).then(|| (parameter, (*vertex).clone()))
+            }
+        });
+        let mut cuts = iter::once((start, front.clone()))
+            .chain(interior)
+            .chain(iter::once((end, back.clone())))
+            .collect::<SmallVec<[(f64, Vertex<Point3>); 8]>>();
+        cuts.sort_by(|a, b| a.0.total_cmp(&b.0));
+        cuts.dedup_by(|a, b| a.0.near(&b.0) && a.1.point().near(&b.1.point()));
+        intervals = intervals.checked_sub(cuts.len() - 1)?;
+        let pieces = cuts
+            .windows(2)
+            .map(|span| {
+                if span[0].0.near(&span[1].0) {
+                    None
+                } else {
+                    sweep_trim_edge(edge, &span[0].1, &span[1].1)
+                }
+            })
+            .collect::<Option<Wire<_, _>>>()?;
+        replacements.insert(edge.id(), pieces);
+        Some(())
+    })?;
+    let aligned = shell
+        .iter()
+        .map(|face| {
+            let wires = face
+                .absolute_boundaries()
+                .iter()
+                .map(|wire| {
+                    wire.iter()
+                        .flat_map(|edge| {
+                            let replacement = replacements.get(&edge.id());
+                            let count = replacement.map_or(1, |wire| wire.len());
+                            (0..count).map(move |index| match replacement {
+                                None => edge.clone(),
+                                Some(wire) if edge.orientation() => wire[index].clone(),
+                                Some(wire) => wire[count - 1 - index].inverse(),
+                            })
+                        })
+                        .collect()
+                })
+                .collect();
+            let mut rebuilt = Face::try_new(wires, face.surface()).ok()?;
+            if !face.orientation() {
+                rebuilt.invert();
+            }
+            Some(rebuilt)
+        })
+        .collect::<Option<Shell<_, _, _>>>()?;
+    let open: HashMap<_, _> = replacements
+        .values()
+        .flatten()
+        .map(|edge| (edge.id(), ()))
+        .collect();
+    let boundary = aligned
+        .edge_iter()
+        .filter(|edge| open.contains_key(&edge.id()))
+        .collect::<Vec<_>>();
+    sew_contact_edges(aligned, &boundary, tol)
 }
 
