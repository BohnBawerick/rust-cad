+/// Translate a parameter point to the nearest copy of a periodic chart.
+fn chart_translation(point: Point2, reference: Point2, periods: [Option<f64>; 2]) -> Vector2 {
+    let shift = |axis: usize| {
+        periods[axis]
+            .filter(|period| period.is_finite() && *period > 0.0)
+            .map_or(0.0, |period| {
+                ((reference[axis] - point[axis]) / period).round() * period
+            })
+    };
+    Vector2::new(shift(0), shift(1))
+}
+
+/// Bound a chart polygon in parameter space, including every sampled segment.
+fn chart_bounds(points: &[Point2]) -> Option<(Point2, Point2)> {
+    let first = *points.first()?;
+    Some(
+        points
+            .iter()
+            .fold((first, first), |(minimum, maximum), point| {
+                (
+                    Point2::new(minimum.x.min(point.x), minimum.y.min(point.y)),
+                    Point2::new(maximum.x.max(point.x), maximum.y.max(point.y)),
+                )
+            }),
+    )
+}
