+/// Lift a contractible trim loop without changing its spatial boundary.
+///
+/// Native parameter boundaries already select their chart branch. Otherwise,
+/// continuation selects the nearest periodic copy of each inverse query.
+/// Individual edges and their shared endpoints must agree in the lifted chart;
+/// a noncontractible loop is not closed by inventing a seam or a pole edge.
+fn chart_boundary<C, S>(
+    wire: &Wire<Point3, C>,
+    surface: &S,
+    tol: f64,
+    samples: &mut HashMap<EdgeId<C>, Vec<Point3>>,
+    projections: &mut usize,
+    native_boundary: fn(&C, &S, f64) -> Option<Vec<Point2>>,
+) -> Option<Vec<Point2>>
+where
+    C: BoundedCurve<Point = Point3> + ParameterDivision1D<Point = Point3> + Clone,
+    S: ShapeOpsSurface,
+{
+    let periods = [surface.period_u(), surface.period_v()];
+    wire.iter()
+        .try_fold(Vec::<Point2>::new(), |mut points, edge| {
+            let curve = edge.curve();
+            let mut parameters = if let Some(mut native) = native_boundary(&curve, surface, tol) {
+                *projections = projections.checked_sub(native.len())?;
+                if !edge.orientation() {
+                    native.reverse();
+                }
+                native
+            } else {
+                let poly = samples
+                    .entry(edge.id())
+                    .or_insert_with(|| curve.parameter_division(curve.range_tuple(), tol).1);
+                *projections = projections.checked_sub(poly.len())?;
+                let mut hint = points.last().copied();
+                (0..poly.len())
+                    .map(|index| {
+                        let index = if edge.orientation() {
+                            index
+                        } else {
+                            poly.len() - 1 - index
+                        };
+                        let uv = surface
+                            .search_parameter(
+                                poly[index],
+                                hint.map(|point| (point.x, point.y)),
+                                100,
+                            )
+                            .or_else(|| surface.search_parameter(poly[index], None, 100))?;
+                        let mut point = Point2::from(uv);
+                        if let Some(previous) = hint {
+                            point += chart_translation(point, previous, periods);
+                            // Half-period steps do not determine a unique lift.
+                            if periods.iter().enumerate().any(|(axis, period)| {
+                                period.is_some_and(|period| {
+                                    (point[axis] - previous[axis]).abs() >= period / 2.0
+                                })
+                            }) {
+                                return None;
+                            }
+                        }
+                        if !surface.evaluate(point.x, point.y).near(&poly[index]) {
+                            return None;
+                        }
+                        hint = Some(point);
+                        Some(point)
+                    })
+                    .collect::<Option<Vec<_>>>()?
+            };
+            if parameters.len() < 2
+                || parameters
+                    .iter()
+                    .any(|point| !point.x.is_finite() || !point.y.is_finite())
+            {
+                return None;
+            }
+            if let Some(previous) = points.last().copied() {
+                let shift = chart_translation(parameters[0], previous, periods);
+                parameters.iter_mut().for_each(|point| *point += shift);
+                if !parameters[0].near(&previous) {
+                    return None;
+                }
+            }
+            let front = parameters.first()?;
+            let back = parameters.last()?;
+            if !surface
+                .evaluate(front.x, front.y)
+                .near(&edge.front().point())
+                || !surface.evaluate(back.x, back.y).near(&edge.back().point())
+            {
+                return None;
+            }
+            let skip = usize::from(!points.is_empty());
+            points.extend(parameters.into_iter().skip(skip));
+            Some(points)
+        })
 }
 
