+//! Cancel complete shared planar faces and identify only their boundary topology.
+
+use monstertruck_geometry::prelude::*;
+use monstertruck_topology::*;
+use rustc_hash::FxHashMap as HashMap;
+
+use super::{ShapeOpsCurve, ShapeOpsSurface};
+
+type EdgePair<C> = (Edge<Point3, C>, Edge<Point3, C>);
+
+/// Match complete polygonal trims, preserving correspondence between edge uses.
+fn matching_edges<C, S>(
+    first: &Face<Point3, C, S>,
+    second: &Face<Point3, C, S>,
+) -> Option<Vec<EdgePair<C>>> {
+    let edges0: Vec<_> = first.absolute_boundaries().iter().flatten().collect();
+    let edges1: Vec<_> = second.absolute_boundaries().iter().flatten().collect();
+    if edges0.len() != edges1.len() {
+        return None;
+    }
+    edges1
+        .into_iter()
+        .map(|edge1| {
+            let front = edge1.absolute_front().point();
+            let back = edge1.absolute_back().point();
+            let edge0 = edges0.iter().find_map(|edge0| {
+                if edge0.front().point() == front && edge0.back().point() == back {
+                    Some((*edge0).clone())
+                } else if edge0.back().point() == front && edge0.front().point() == back {
+                    Some(edge0.inverse())
+                } else {
+                    None
+                }
+            })?;
+            Some((edge1.absolute_clone(), edge0))
+        })
+        .collect()
+}
+
+/// Join shells only across matching complete faces on a certified separator.
+pub(super) fn join<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell0: &Shell<Point3, C, S>,
+    shell1: &Shell<Point3, C, S>,
+    plane: Plane,
+    level: f64,
+) -> Option<Shell<Point3, C, S>> {
+    let on_plane = |face: &Face<Point3, C, S>| {
+        face.absolute_boundaries()
+            .iter()
+            .flat_map(|wire| wire.vertex_iter())
+            .all(|vertex| (vertex.point() - plane.origin()).dot(plane.normal()) == level)
+    };
+    let faces0: Vec<_> = shell0.iter().filter(|face| on_plane(face)).collect();
+    let faces1: Vec<_> = shell1.iter().filter(|face| on_plane(face)).collect();
+    if faces0.is_empty() || faces0.len() != faces1.len() {
+        return None;
+    }
+    let mut vertices = HashMap::default();
+    let mut edges = HashMap::default();
+    let mut matched = vec![false; faces0.len()];
+    faces1.iter().try_for_each(|face1| {
+        let (index, pairs) = faces0.iter().enumerate().find_map(|(index, face0)| {
+            (!matched[index])
+                .then(|| matching_edges(face0, face1))
+                .flatten()
+                .map(|pairs| (index, pairs))
+        })?;
+        matched[index] = true;
+        pairs.into_iter().try_for_each(|(edge1, edge0)| {
+            [(edge1.front(), edge0.front()), (edge1.back(), edge0.back())]
+                .into_iter()
+                .try_for_each(|(vertex1, vertex0)| {
+                    if let Some(previous) = vertices.insert(vertex1.id(), vertex0.clone())
+                        && previous != *vertex0
+                    {
+                        return None;
+                    }
+                    Some(())
+                })?;
+            if let Some(previous) = edges.insert(edge1.id(), edge0.clone())
+                && previous != edge0
+            {
+                return None;
+            }
+            Some(())
+        })
+    })?;
+    let retained0 = shell0
+        .iter()
+        .filter(|face| !faces0.iter().any(|shared| shared.id() == face.id()));
+    let retained1 = shell1
+        .iter()
+        .filter(|face| !faces1.iter().any(|shared| shared.id() == face.id()));
+    let remapped = retained1
+        .map(|face| {
+            let boundaries = face
+                .absolute_boundaries()
+                .iter()
+                .map(|wire| {
+                    wire.iter()
+                        .map(|edge| {
+                            let mapped = if let Some(mapped) = edges.get(&edge.id()) {
+                                mapped.clone()
+                            } else {
+                                let front = vertices
+                                    .get(&edge.absolute_front().id())
+                                    .unwrap_or(edge.absolute_front());
+                                let back = vertices
+                                    .get(&edge.absolute_back().id())
+                                    .unwrap_or(edge.absolute_back());
+                                let mapped = Edge::try_new(front, back, edge.curve()).ok()?;
+                                edges.insert(edge.id(), mapped.clone());
+                                mapped
+                            };
+                            Some(if edge.orientation() {
+                                mapped
+                            } else {
+                                mapped.inverse()
+                            })
+                        })
+                        .collect::<Option<Wire<_, _>>>()
+                })
+                .collect::<Option<Vec<_>>>()?;
+            let mut mapped = Face::try_new(boundaries, face.surface()).ok()?;
+            if !face.orientation() {
+                mapped.invert();
+            }
+            Some(mapped)
+        })
+        .collect::<Option<Vec<_>>>()?;
+    Some(retained0.cloned().chain(remapped).collect())
+}
