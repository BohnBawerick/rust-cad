+//! Certified separation of planar boundaries before creating intersection edges.
+
+use monstertruck_geometry::prelude::*;
+use monstertruck_topology::*;
+use rustc_hash::FxHashMap as HashMap;
+use smallvec::SmallVec;
+
+use super::{ShapeOpsCurve, ShapeOpsSurface, contact};
+
+/// Certify polygonal faces from their supporting planes and edge incidences.
+///
+/// An edge on two nonparallel planes lies on their intersection line. Thus its
+/// endpoints bound it, and the vertices bound every planar trimmed face. Merely
+/// checking vertices without this certificate is insufficient for curved faces
+/// or curved trims between coplanar faces.
+fn planes<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &Shell<Point3, C, S>,
+) -> Option<Vec<Plane>> {
+    let planes: Vec<_> = shell
+        .iter()
+        .map(
+            |face| match face.surface().try_into_analytic_surface_kind()? {
+                AnalyticSurfaceKind::Plane(plane) => Some(plane),
+                _ => None,
+            },
+        )
+        .collect::<Option<_>>()?;
+    let mut incidences: HashMap<EdgeId<C>, SmallVec<[Vector3; 2]>> = HashMap::default();
+    shell.iter().zip(&planes).for_each(|(face, plane)| {
+        face.absolute_boundaries()
+            .iter()
+            .flatten()
+            .for_each(|edge| {
+                incidences
+                    .entry(edge.id())
+                    .or_default()
+                    .push(plane.normal());
+            });
+    });
+    (!planes.is_empty()
+        && incidences
+            .values()
+            .all(|normals| normals.len() == 2 && !normals[0].cross(normals[1]).so_small()))
+    .then_some(planes)
+}
+
+fn interval(points: &[Point3], plane: Plane) -> (f64, f64) {
+    points
+        .iter()
+        .fold((f64::INFINITY, f64::NEG_INFINITY), |(min, max), point| {
+            let value = (*point - plane.origin()).dot(plane.normal());
+            (min.min(value), max.max(value))
+        })
+}
+
+/// Return exact boundary selections only when supporting planes prove them.
+///
+/// Two independent common supporting planes restrict contact to at most a line.
+/// Such contact cannot join regularized interiors, so topology stays separate.
+/// Ambiguous near-zero gaps fall through to intersection processing; the meshing
+/// tolerance never turns an overlap into a separation.
+pub(super) fn separate<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell0: &Shell<Point3, C, S>,
+    shell1: &Shell<Point3, C, S>,
+    inverted0: bool,
+    inverted1: bool,
+) -> Option<[Shell<Point3, C, S>; 2]> {
+    let planes0 = planes(shell0)?;
+    let planes1 = planes(shell1)?;
+    let points0: Vec<_> = shell0.vertex_iter().map(|vertex| vertex.point()).collect();
+    let points1: Vec<_> = shell1.vertex_iter().map(|vertex| vertex.point()).collect();
+    let mut contact_normal: Option<Vector3> = None;
+    let mut contact_plane = None;
+    let separated = planes0.into_iter().chain(planes1).any(|plane| {
+        let (min0, max0) = interval(&points0, plane);
+        let (min1, max1) = interval(&points1, plane);
+        if (max0 < min1 && !max0.near(&min1)) || (max1 < min0 && !max1.near(&min0)) {
+            true
+        } else if max0 == min1 || max1 == min0 {
+            contact_plane = Some((plane, if max0 == min1 { max0 } else { max1 }));
+            let normal = plane.normal();
+            let independent = contact_normal.is_some_and(|other| !other.cross(normal).so_small());
+            contact_normal = Some(normal);
+            independent || inverted0 != inverted1
+        } else {
+            false
+        }
+    });
+    if separated {
+        let selected = |take0, take1| {
+            shell0
+                .iter()
+                .filter(|_| take0)
+                .chain(shell1.iter().filter(|_| take1))
+                .cloned()
+                .collect()
+        };
+        Some([
+            selected(inverted1, inverted0),
+            selected(!inverted1, !inverted0),
+        ])
+    } else {
+        let (plane, level) = contact_plane?;
+        let joined = contact::join(shell0, shell1, plane, level)?;
+        Some(if inverted0 {
+            [joined, Shell::default()]
+        } else {
+            [Shell::default(), joined]
+        })
+    }
+}
