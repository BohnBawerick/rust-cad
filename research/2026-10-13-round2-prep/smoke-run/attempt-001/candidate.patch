+//! Oriented region classification for faces without intersection loops.
+
+use monstertruck_geometry::prelude::*;
+use monstertruck_meshing::prelude::*;
+use monstertruck_topology::*;
+use std::iter;
+
+use super::{AltCurve, AltCurveShell, ShapeOpsCurve, ShapeOpsSurface};
+
+type PolyShell = Shell<Point3, PolylineCurve<Point3>, Option<PolygonMesh>>;
+
+/// Recover the winding number at infinity from the oriented boundary volume.
+pub(super) fn inverted(shell: &PolyShell) -> Option<bool> {
+    shell
+        .iter()
+        .try_fold(0.0, |volume, face| {
+            let contribution = face.surface()?.volume();
+            Some(
+                volume
+                    + if face.orientation() {
+                        contribution
+                    } else {
+                        -contribution
+                    },
+            )
+        })
+        .map(|volume| volume < 0.0)
+}
+
+/// Sample inside a trimmed face instead of at an intersection or contact vertex.
+fn interior_point<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    face: &Face<Point3, AltCurve<C, S>, S>,
+    tol: f64,
+) -> Option<Point3> {
+    let shell: AltCurveShell<C, S> = iter::once(face.clone()).collect();
+    let mesh = shell.triangulation(tol).first()?.surface()?;
+    let triangle = mesh.faces().triangle_iter().max_by(|a, b| {
+        let area = |t: &[StandardVertex; 3]| {
+            let p = mesh.positions()[t[0].pos];
+            let q = mesh.positions()[t[1].pos];
+            let r = mesh.positions()[t[2].pos];
+            (q - p).cross(r - p).magnitude2()
+        };
+        area(a).total_cmp(&area(b))
+    })?;
+    let point = Point3::from_vec(
+        triangle
+            .iter()
+            .map(|v| mesh.positions()[v.pos].to_vec())
+            .sum::<Vector3>()
+            / 3.0,
+    );
+    let surface = face.surface();
+    let (u, v) = surface.search_nearest_parameter(point, None, 100)?;
+    Some(surface.evaluate(u, v))
+}
+
+/// Complete classification using oriented crossings and the region at infinity.
+pub(super) fn classify<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    unknown: AltCurveShell<C, S>,
+    other: &PolyShell,
+    other_inverted: bool,
+    and: &mut AltCurveShell<C, S>,
+    or: &mut AltCurveShell<C, S>,
+    tol: f64,
+) -> Option<()> {
+    unknown.into_iter().try_for_each(|face| {
+        let point = interior_point(&face, tol)?;
+        let direction = hash::take_one_unit(point);
+        let crossings = other.iter().try_fold(0, |count, face| {
+            let crossing = face.surface()?.signed_crossing_faces(point, direction);
+            Some(
+                count
+                    + if face.orientation() {
+                        crossing
+                    } else {
+                        -crossing
+                    },
+            )
+        })?;
+        if crossings + isize::from(other_inverted) > 0 {
+            and.push(face);
+        } else {
+            or.push(face);
+        }
+        Some(())
+    })
+}
