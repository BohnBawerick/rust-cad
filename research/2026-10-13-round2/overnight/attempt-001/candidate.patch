+//! Membership queries against a complete oriented solid boundary.
+
+use monstertruck_meshing::prelude::{
+    CalcVolume, IncludingPointInDomain, InnerSpace, Invertible, MeshableShape, Point3, PolygonMesh,
+    PolylineCurve, hash,
+};
+use monstertruck_topology::Shell;
+
+use super::{AltCurveShell, ShapeOpsCurve, ShapeOpsSurface};
+
+/// The winding number is relative to the material state at infinity.
+#[derive(Debug)]
+pub(super) struct OrientedBoundary {
+    polygon: PolygonMesh,
+    complemented: bool,
+}
+
+impl OrientedBoundary {
+    pub(super) fn new(
+        shell: &Shell<Point3, PolylineCurve<Point3>, Option<PolygonMesh>>,
+    ) -> Option<Self> {
+        let polygon = shell
+            .iter()
+            .try_fold(PolygonMesh::default(), |mut mesh, face| {
+                let mut polygon = face.surface()?;
+                if !face.orientation() {
+                    polygon.invert();
+                }
+                mesh.merge(polygon);
+                Some(mesh)
+            })?;
+        // A reversed finite solid has negative signed volume and material at infinity.
+        // Cavity shells contribute with the opposite sign to their enclosing shells.
+        let complemented = polygon.volume() < 0.0;
+        Some(Self {
+            polygon,
+            complemented,
+        })
+    }
+
+    fn contains(&self, point: Point3) -> bool {
+        let direction = hash::take_one_unit(point);
+        let winding = self.polygon.signed_crossing_faces(point, direction);
+        winding + isize::from(self.complemented) > 0
+    }
+
+    pub(super) fn classify<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+        &self,
+        unknown: AltCurveShell<C, S>,
+        original: &AltCurveShell<C, S>,
+        meshed: &Shell<Point3, PolylineCurve<Point3>, Option<PolygonMesh>>,
+        tol: f64,
+    ) -> Option<[AltCurveShell<C, S>; 2]> {
+        unknown.into_iter().try_fold(
+            [Shell::default(), Shell::default()],
+            |mut classified, face| {
+                // Boundary vertices can lie on the other solid even when the face
+                // interiors are disjoint. Sample inside the trimmed parameter domain.
+                let source = original
+                    .iter()
+                    .zip(meshed)
+                    .find(|(source, _)| source.id() == face.id());
+                let polygon = if let Some((_, source)) = source {
+                    source.surface()?
+                } else {
+                    let shell: AltCurveShell<C, S> = [face.clone()].into_iter().collect();
+                    shell.triangulation(tol).first()?.surface()?
+                };
+                let point = interior_point(&face.surface(), &polygon)?;
+                let index = usize::from(!self.contains(point));
+                classified[index].push(face);
+                Some(classified)
+            },
+        )
+    }
+}
+
+/// Evaluate a triangle's interior in the original surface parameterization.
+fn interior_point<S: ShapeOpsSurface>(surface: &S, polygon: &PolygonMesh) -> Option<Point3> {
+    polygon
+        .tri_faces()
+        .iter()
+        .filter_map(|triangle| {
+            let [first, second, third] = *triangle;
+            let points = polygon.positions();
+            let area = (points[second.pos] - points[first.pos])
+                .cross(points[third.pos] - points[first.pos])
+                .magnitude2();
+            let parameters = polygon.uv_coords();
+            let uv = (parameters[first.uv?] + parameters[second.uv?] + parameters[third.uv?]) / 3.0;
+            (area > 0.0).then_some((area, uv))
+        })
+        .max_by(|(area0, _), (area1, _)| area0.total_cmp(area1))
+        .map(|(_, uv)| surface.evaluate(uv.x, uv.y))
+}
