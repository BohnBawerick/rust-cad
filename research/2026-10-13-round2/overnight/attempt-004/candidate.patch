+//! Pair boundary half-edges around material sectors before creating topology.
+
+use super::*;
+
+type EdgeUses = BTreeMap<(usize, usize), Vec<(usize, usize, bool)>>;
+
+pub(super) fn assemble<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    patches: Vec<Patch<S>>,
+) -> Option<Shell<Point3, C, S>>
+where
+    Line<Point3>: ToSameGeometry<C>,
+{
+    let mut points: Vec<Point3> = Vec::new();
+    let polygons: Vec<_> = patches
+        .into_iter()
+        .map(|patch| {
+            let indices: Vec<_> = patch
+                .points
+                .iter()
+                .map(|point| {
+                    if let Some(index) = points.iter().position(|known| known.near(point)) {
+                        index
+                    } else {
+                        points.push(*point);
+                        points.len() - 1
+                    }
+                })
+                .collect();
+            (patch, indices)
+        })
+        .collect();
+    if polygons.iter().any(|(_, indices)| {
+        indices.len() < 3
+            || indices
+                .iter()
+                .zip(indices.iter().cycle().skip(1))
+                .take(indices.len())
+                .any(|(first, second)| first == second)
+    }) {
+        return None;
+    }
+    let mut unique = BTreeMap::new();
+    // Insert every collinear arrangement vertex to eliminate hanging endpoints.
+    let polygons: Vec<_> = polygons
+        .into_iter()
+        .filter_map(|(patch, indices)| {
+            let indices = indices
+                .iter()
+                .copied()
+                .zip(indices.iter().copied().cycle().skip(1))
+                .take(indices.len())
+                .flat_map(|(front, back)| {
+                    let direction = points[back] - points[front];
+                    let length2 = direction.magnitude2();
+                    let mut interior: Vec<_> = points
+                        .iter()
+                        .enumerate()
+                        .filter_map(|(index, point)| {
+                            let parameter = (*point - points[front]).dot(direction) / length2;
+                            (parameter > 0.0
+                                && parameter < 1.0
+                                && point.near(&(points[front] + parameter * direction)))
+                            .then_some((parameter, index))
+                        })
+                        .collect();
+                    interior.sort_by(|first, second| first.0.total_cmp(&second.0));
+                    iter::once(front).chain(interior.into_iter().map(|(_, index)| index))
+                })
+                .collect::<Vec<_>>();
+            let mut key = indices.clone();
+            key.sort_unstable();
+            unique.insert(key, ()).is_none().then_some((patch, indices))
+        })
+        .collect();
+    let mut uses = EdgeUses::new();
+    polygons
+        .iter()
+        .enumerate()
+        .for_each(|(face, (_, indices))| {
+            indices
+                .iter()
+                .copied()
+                .zip(indices.iter().copied().cycle().skip(1))
+                .take(indices.len())
+                .enumerate()
+                .for_each(|(slot, (front, back))| {
+                    uses.entry((front.min(back), front.max(back)))
+                        .or_default()
+                        .push((face, slot, front < back));
+                });
+        });
+    let vertices: Vec<_> = points.iter().copied().map(Vertex::new).collect();
+    let mut edges: Vec<Vec<Option<Edge<Point3, C>>>> = polygons
+        .iter()
+        .map(|(_, indices)| vec![None; indices.len()])
+        .collect();
+    uses.into_iter()
+        .try_for_each(|((front, back), incidence)| {
+            let direction = (points[back] - points[front]).normalize();
+            let (forward, mut backward): (Vec<_>, Vec<_>) =
+                incidence.into_iter().partition(|entry| entry.2);
+            if forward.len() != backward.len() || forward.is_empty() {
+                return None;
+            }
+            forward.into_iter().try_for_each(|(face, slot, _)| {
+                let radial = polygons[face].0.normal.cross(direction);
+                let mate = backward
+                    .iter()
+                    .enumerate()
+                    .min_by(|(_, first), (_, second)| {
+                        let angle = |entry: &(usize, usize, bool)| {
+                            let other = -polygons[entry.0].0.normal.cross(direction);
+                            // Material lies clockwise of an outward-oriented half-edge.
+                            (-direction.dot(radial.cross(other)))
+                                .atan2(radial.dot(other))
+                                .rem_euclid(2.0 * PI)
+                        };
+                        angle(first).total_cmp(&angle(second))
+                    })
+                    .map(|(index, _)| index)?;
+                let (other, other_slot, _) = backward.remove(mate);
+                let edge = Edge::new(
+                    &vertices[front],
+                    &vertices[back],
+                    Line(points[front], points[back]).to_same_geometry(),
+                );
+                edges[face][slot] = Some(edge.clone());
+                edges[other][other_slot] = Some(edge.inverse());
+                Some(())
+            })
+        })?;
+    let faces = polygons
+        .into_iter()
+        .zip(edges)
+        .map(|((patch, _), edges)| {
+            let wire: Wire<_, _> = edges.into_iter().collect::<Option<Vec<_>>>()?.into();
+            let face = Face::try_new(vec![wire], patch.surface).ok()?;
+            Some((patch.source, patch.normal, face))
+        })
+        .collect::<Option<Vec<_>>>()?;
+    Some(coalesce::coalesce(faces))
+}
