+//! Regularized boundary selection in an arrangement of planar faces.
+
+use monstertruck_geometry::prelude::*;
+use monstertruck_topology::{Edge, Face, Shell, Solid, Vertex, Wire};
+use std::{collections::BTreeMap, f64::consts::PI, iter};
+
+use super::{ShapeOpsCurve, ShapeOpsSurface};
+
+mod assemble;
+mod coalesce;
+
+#[derive(Clone)]
+struct Patch<S> {
+    points: Vec<Point3>,
+    surface: S,
+    normal: Vector3,
+    source: usize,
+}
+
+#[derive(Clone, Copy)]
+struct Divider {
+    origin: Point3,
+    normal: Vector3,
+}
+
+impl Divider {
+    fn distance(self, point: Point3) -> f64 {
+        (point - self.origin).dot(self.normal)
+    }
+}
+
+fn sides(points: &[Point3]) -> impl Iterator<Item = (Point3, Point3)> + '_ {
+    points
+        .iter()
+        .copied()
+        .zip(points.iter().copied().cycle().skip(1))
+        .take(points.len())
+}
+
+/// Certify straight boundaries through inclusion in two independent planes.
+/// Convexity is required of each face, not of the solid or its components.
+fn patches<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    shell: &Shell<Point3, C, S>,
+    offset: usize,
+) -> Option<Vec<Patch<S>>>
+where
+    Plane: IncludeCurve<C>,
+{
+    shell
+        .iter()
+        .enumerate()
+        .map(|(index, face)| {
+            let surface = face.oriented_surface();
+            let AnalyticSurfaceKind::Plane(plane) = surface.try_into_analytic_surface_kind()?
+            else {
+                return None;
+            };
+            let boundaries = face.boundaries();
+            if boundaries.len() != 1 {
+                return None;
+            }
+            let wire = &boundaries[0];
+            let points: Vec<_> = wire.iter().map(|edge| edge.front().point()).collect();
+            let origin = *points.first()?;
+            let area = sides(&points)
+                .map(|(front, back)| (front - origin).cross(back - origin))
+                .sum::<Vector3>();
+            if area.magnitude2() == 0.0 {
+                return None;
+            }
+            // Analytic recognition need not preserve the surface parameter orientation.
+            // The oriented trim supplies the outward normal of this boundary patch.
+            let normal = area.normalize();
+            if points.len() < 3
+                || !wire.iter().all(|edge| {
+                    let front = edge.front().point();
+                    let back = edge.back().point();
+                    !front.near(&back)
+                        && plane.include(&edge.curve())
+                        && Plane::new(front, back, front + normal).include(&edge.curve())
+                })
+            {
+                return None;
+            }
+            let convex = sides(&points).all(|(front, back)| {
+                let inward = normal.cross(back - front).normalize();
+                points
+                    .iter()
+                    .all(|point| (*point - front).dot(inward) >= -TOLERANCE)
+            });
+            convex.then_some(Patch {
+                points,
+                surface,
+                normal,
+                source: offset + index,
+            })
+        })
+        .collect()
+}
+
+fn split(points: Vec<Point3>, divider: Divider) -> Vec<Vec<Point3>> {
+    let distances: Vec<_> = points
+        .iter()
+        .map(|point| divider.distance(*point))
+        .collect();
+    if !distances.iter().any(|distance| *distance > TOLERANCE)
+        || !distances.iter().any(|distance| *distance < -TOLERANCE)
+    {
+        return vec![points];
+    }
+    [1.0, -1.0]
+        .into_iter()
+        .map(|sign| {
+            sides(&points)
+                .enumerate()
+                .flat_map(|(index, (front, back))| {
+                    let first = distances[index];
+                    let second = distances[(index + 1) % points.len()];
+                    let crossing = (first > TOLERANCE && second < -TOLERANCE)
+                        || (first < -TOLERANCE && second > TOLERANCE);
+                    let start = (sign * first >= -TOLERANCE).then_some(front);
+                    let cut = crossing.then(|| front + (back - front) * (first / (first - second)));
+                    start.into_iter().chain(cut)
+                })
+                .collect()
+        })
+        .collect()
+}
+
+fn partition<S>(patch: &Patch<S>, all: &[Patch<S>]) -> Vec<Vec<Point3>> {
+    let dividers = all.iter().flat_map(|other| {
+        let plane = Divider {
+            origin: other.points[0],
+            normal: other.normal,
+        };
+        let coplanar = patch.normal.cross(other.normal).so_small()
+            && patch
+                .points
+                .iter()
+                .all(|point| plane.distance(*point).abs() <= TOLERANCE);
+        let edges = sides(&other.points)
+            .filter(move |_| coplanar)
+            .map(move |(front, back)| Divider {
+                origin: front,
+                normal: other.normal.cross(back - front).normalize(),
+            });
+        iter::once(plane).chain(edges)
+    });
+    dividers.fold(vec![patch.points.clone()], |pieces, divider| {
+        pieces
+            .into_iter()
+            .flat_map(|points| split(points, divider))
+            .collect()
+    })
+}
+
+/// The solid angle is the exact winding contribution of a planar polygon.
+/// Triangles here integrate a face; they do not replace its boundary geometry.
+fn winding<S>(patches: &[Patch<S>], point: Point3) -> f64 {
+    patches
+        .iter()
+        .map(|patch| {
+            let first = patch.points[0] - point;
+            patch.points[1..]
+                .windows(2)
+                .map(|pair| {
+                    let second = pair[0] - point;
+                    let third = pair[1] - point;
+                    let numerator = first.dot(second.cross(third));
+                    let denominator = first.magnitude() * second.magnitude() * third.magnitude()
+                        + first.dot(second) * third.magnitude()
+                        + second.dot(third) * first.magnitude()
+                        + third.dot(first) * second.magnitude();
+                    2.0 * numerator.atan2(denominator)
+                })
+                .sum::<f64>()
+        })
+        .sum::<f64>()
+        / (4.0 * PI)
+}
+
+fn complemented<S>(patches: &[Patch<S>]) -> bool {
+    let origin = patches[0].points[0];
+    patches
+        .iter()
+        .map(|patch| {
+            let first = patch.points[0] - origin;
+            patch.points[1..]
+                .windows(2)
+                .map(|pair| first.dot((pair[0] - origin).cross(pair[1] - origin)))
+                .sum::<f64>()
+        })
+        .sum::<f64>()
+        < 0.0
+}
+
+fn membership<S>(patches: &[Patch<S>], inverted: bool, point: Point3) -> Option<bool> {
+    let value = winding(patches, point) + if inverted { 1.0 } else { 0.0 };
+    // A nonintegral winding means the sample or input is numerically ambiguous.
+    ((value - value.round()).abs() < TOLERANCE).then_some(value > 0.5)
+}
+
+fn select<S: ShapeOpsSurface>(
+    all: &[Patch<S>],
+    split_index: usize,
+    union: bool,
+) -> Option<Vec<Patch<S>>> {
+    let (first, second) = all.split_at(split_index);
+    let inverted = [complemented(first), complemented(second)];
+    all.iter().try_fold(Vec::new(), |mut result, source| {
+        partition(source, all).into_iter().try_for_each(|points| {
+            let center = Point3::from_vec(
+                points.iter().map(|point| point.to_vec()).sum::<Vector3>() / points.len() as f64,
+            );
+            // Stay inside the arrangement cell on either side of this face.
+            // The offset follows local clearance, independently of meshing tolerance.
+            let edge_clearance = sides(&points)
+                .map(|(front, back)| {
+                    (center - front)
+                        .cross((back - front).normalize())
+                        .magnitude()
+                })
+                .fold(f64::INFINITY, f64::min);
+            let clearance = all
+                .iter()
+                .map(|patch| (center - patch.points[0]).dot(patch.normal).abs())
+                .filter(|distance| *distance > TOLERANCE)
+                .fold(edge_clearance, f64::min);
+            if !clearance.is_finite() || clearance <= 0.0 {
+                return None;
+            }
+            let state = |side| {
+                let point = center + source.normal * (side * clearance / 4.0);
+                let inside0 = membership(first, inverted[0], point)?;
+                let inside1 = membership(second, inverted[1], point)?;
+                Some(if union {
+                    inside0 || inside1
+                } else {
+                    inside0 && inside1
+                })
+            };
+            let states = [state(-1.0)?, state(1.0)?];
+            if states[0] != states[1] {
+                let mut patch = Patch {
+                    points,
+                    surface: source.surface.clone(),
+                    normal: source.normal,
+                    source: source.source,
+                };
+                if states[1] {
+                    patch.points.reverse();
+                    patch.surface.invert();
+                    patch.normal = -patch.normal;
+                    // Oppositely oriented pieces must remain distinct faces.
+                    patch.source += all.len();
+                }
+                result.push(patch);
+            }
+            Some(())
+        })?;
+        Some(result)
+    })
+}
+
+/// Use the analytic path only when every boundary face is certified polygonal.
+/// Assembly failure leaves the existing general surface pipeline available.
+pub(super) fn boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    first: &Shell<Point3, C, S>,
+    second: &Shell<Point3, C, S>,
+    union: bool,
+) -> Option<Shell<Point3, C, S>>
+where
+    Plane: IncludeCurve<C>,
+    Line<Point3>: ToSameGeometry<C>,
+{
+    let mut all = patches(first, 0)?;
+    let split_index = all.len();
+    all.extend(patches(second, split_index)?);
+    if split_index == 0 || split_index == all.len() {
+        return None;
+    }
+    let selected = select(&all, split_index, union)?;
+    let shell = assemble::assemble(selected)?;
+    // Validate individual components, including their vertex links.
+    Solid::try_new(shell.connected_components()).ok()?;
+    Some(shell)
+}
