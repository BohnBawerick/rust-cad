+impl<C: ParametricCurve3D + BoundedCurve> ProjectedCurve<C> {
+    fn search_seed(&self, point: Point2, hint: SearchParameterHint1D) -> Option<f64> {
+        let range = match hint {
+            SearchParameterHint1D::Range(start, end) => (start, end),
+            _ => self.range_tuple(),
+        };
+        let seed = match hint {
+            SearchParameterHint1D::Parameter(parameter) => parameter,
+            _ => algo::curve::presearch(self, point, range, PRESEARCH_DIVISION),
+        };
+        if self.revolution.contains(self.curve.evaluate(seed)) {
+            // Radial distance has a cusp at the axis. Its derivative there is
+            // undefined, and roundoff can select the extension on the opposite
+            // side of a profile endpoint. Start Newton on a regular part of
+            // the requested profile instead of using that pole as a hint.
+            (0..=PRESEARCH_DIVISION)
+                .map(|index| {
+                    let ratio = index as f64 / PRESEARCH_DIVISION as f64;
+                    range.0 * (1.0 - ratio) + range.1 * ratio
+                })
+                .filter(|parameter| !self.revolution.contains(self.curve.evaluate(*parameter)))
+                .min_by(|lhs, rhs| {
+                    self.evaluate(*lhs)
+                        .distance2(point)
+                        .total_cmp(&self.evaluate(*rhs).distance2(point))
+                })
+        } else {
+            Some(seed)
+        }
+    }
+}
