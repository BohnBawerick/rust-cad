+/// Test whether the oriented edge chain cancels exactly.
+///
+/// A retraced edge contributes no boundary. A small closed loop still does,
+/// regardless of the scale of the surface parameters or tessellation error.
+fn has_zero_boundary<'a, C: 'a>(
+    wires: impl IntoIterator<Item = &'a BoundaryWire<Point3, C>>,
+) -> bool {
+    let mut counts = HashMap::<EdgeId<C>, isize>::default();
+    wires.into_iter().for_each(|wire| {
+        wire.iter().for_each(|edge| {
+            *counts.entry(edge.id()).or_default() += if edge.orientation() { 1 } else { -1 };
+        });
+    });
+    counts.values().all(|&count| count == 0)
+}
+
+/// Compute orientation relative to a loop vertex to avoid translation terms.
+fn signed_area(poly: &PolylineCurve<Point2>) -> Option<f64> {
+    let origin = *poly.first()?;
+    Some(
+        poly.windows(2)
+            .map(|pair| {
+                let a = pair[0] - origin;
+                let b = pair[1] - origin;
+                a.x * b.y - a.y * b.x
+            })
+            .sum::<f64>()
+            * 0.5,
+    )
+}
