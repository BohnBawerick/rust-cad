+/// Compute signed area in a local frame to avoid translation cancellation.
+fn signed_area(poly: &PolylineCurve<Point2>) -> Option<f64> {
+    let origin = *poly.first()?;
+    let area = poly
+        .windows(2)
+        .map(|pair| {
+            let a = pair[0] - origin;
+            let b = pair[1] - origin;
+            a.x * b.y - a.y * b.x
+        })
+        .sum::<f64>()
+        * 0.5;
+    area.is_finite().then_some(area)
+}
+
+/// Check cancellation of a directed segment, including subdivided retraces.
+fn segment_cancels((front, back): (Point2, Point2), segments: &[(Point2, Point2)]) -> bool {
+    let direction = back - front;
+    let axis = usize::from(direction.y.abs() > direction.x.abs());
+    let lower = front[axis].min(back[axis]);
+    let upper = front[axis].max(back[axis]);
+    let collinear = |point: Point2| {
+        let offset = point - front;
+        offset.x * direction.y == offset.y * direction.x
+    };
+    // Use coordinates on the supporting line, avoiding division and any
+    // tolerance that could collapse a narrow but nonempty parameter region.
+    let mut events: SmallVec<[(f64, i32); 16]> = segments
+        .iter()
+        .filter(|&&(a, b)| collinear(a) && collinear(b))
+        .filter_map(|&(a, b)| {
+            let start = a[axis].min(b[axis]).max(lower);
+            let end = a[axis].max(b[axis]).min(upper);
+            let sign = if a[axis] < b[axis] { 1 } else { -1 };
+            (start < end).then_some([(start, sign), (end, -sign)])
+        })
+        .flatten()
+        .collect();
+    events.sort_unstable_by(|a, b| a.0.total_cmp(&b.0));
+    events
+        .into_iter()
+        .try_fold((lower, 0), |(previous, balance), (position, change)| {
+            (position == previous || balance == 0).then_some((position, balance + change))
+        })
+        .is_some_and(|(_, balance)| balance == 0)
+}
+
+/// Detect a null boundary chain, independently of its signed area.
+fn boundary_cancels<'a, 'b, C: 'a>(
+    chunks: impl Iterator<Item = &'b WireChunk<'a, C>> + Clone,
+) -> bool
+where
+    'a: 'b,
+{
+    let mut counts = HashMap::<EdgeId<C>, isize>::default();
+    chunks.clone().for_each(|chunk| {
+        chunk.wire.iter().for_each(|edge| {
+            *counts.entry(edge.id()).or_default() += if edge.orientation() { 1 } else { -1 };
+        });
+    });
+    if counts.values().all(|&count| count == 0) {
+        return true;
+    }
+    // Distinct topological edges can trace the same parameter boundary.
+    // Compare directed segment coverage, not equality of enclosed areas.
+    let segments: Vec<_> = chunks
+        .flat_map(|chunk| {
+            chunk
+                .poly
+                .iter()
+                .copied()
+                .zip(chunk.poly.iter().copied().cycle().skip(1))
+                .take(chunk.poly.len())
+        })
+        .filter(|(front, back)| front != back)
+        .collect();
+    segments
+        .iter()
+        .all(|&segment| segment_cancels(segment, &segments))
+}
