+fn point_order(left: &Point3, right: &Point3) -> Ordering {
+    left.x
+        .total_cmp(&right.x)
+        .then_with(|| left.y.total_cmp(&right.y))
+        .then_with(|| left.z.total_cmp(&right.z))
+}
+
+fn finite(point: Point3) -> bool {
+    point.x.is_finite() && point.y.is_finite() && point.z.is_finite()
+}
