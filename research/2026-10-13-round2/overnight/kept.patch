+//! Exact rim arrangements for circular extrusions with coplanar end caps.
+//!
+//! Coplanar caps have no transversal intersection curve. Arrange their exact
+//! circular boundaries in the common section plane, then lift that arrangement
+//! onto the original extrusion surfaces.
+
+use monstertruck_geometry::prelude::*;
+use monstertruck_topology::{Edge, Face, Shell, Solid, Vertex, Wire};
+use smallvec::SmallVec;
+
+use super::{ShapeOpsCurve, ShapeOpsSurface};
+
+mod recognize;
+
+pub(super) enum Operation {
+    Union,
+    Intersection,
+    Difference,
+}
+
+struct Strip<C, S> {
+    lower: C,
+    upper: C,
+    surface: S,
+}
+
+struct Cylinder<C, S> {
+    center: Point3,
+    radius: f64,
+    vector: Vector3,
+    caps: [S; 2],
+    strips: Vec<Strip<C, S>>,
+}
+
+struct Column<C> {
+    lower: Vertex<Point3>,
+    upper: Vertex<Point3>,
+    edge: Edge<Point3, C>,
+}
+
+fn column<C: Clone>(columns: &mut Vec<Column<C>>, point: Point3, vector: Vector3) -> usize
+where
+    Line<Point3>: ToSameGeometry<C>,
+{
+    if let Some(index) = columns
+        .iter()
+        .position(|column| column.lower.point().near(&point))
+    {
+        index
+    } else {
+        let lower = Vertex::new(point);
+        let upper = Vertex::new(point + vector);
+        let edge = Edge::new(
+            &lower,
+            &upper,
+            Line(point, point + vector).to_same_geometry(),
+        );
+        columns.push(Column { lower, upper, edge });
+        columns.len() - 1
+    }
+}
+
+fn trim<C: Cut + Clone>(curve: &C, start: f64, end: f64) -> C {
+    let mut result = curve.clone();
+    let (first, last) = result.range_tuple();
+    if end < last {
+        result.cut(end);
+    }
+    if start > first {
+        result = result.cut(start);
+    }
+    result
+}
+
+fn parameter<C>(curve: &C, point: Point3) -> Option<f64>
+where
+    C: BoundedCurve<Point = Point3> + SearchParameter<CurveParameter, Point = Point3>,
+{
+    let (first, last) = curve.range_tuple();
+    if curve.front().near(&point) {
+        Some(first)
+    } else if curve.back().near(&point) {
+        Some(last)
+    } else {
+        curve
+            .search_parameter(point, None, 100)
+            .filter(|value| first < *value && *value < last)
+    }
+}
+
+/// Return one simple oriented cycle, rejecting any ambiguous vertex incidence.
+fn cycle<C: Clone>(mut edges: Vec<Edge<Point3, C>>) -> Option<Wire<Point3, C>> {
+    let first = edges.pop()?;
+    let mut wire = Wire::from(vec![first]);
+    while !edges.is_empty() {
+        let back = wire.back_vertex()?;
+        let mut candidates = edges
+            .iter()
+            .enumerate()
+            .filter(|(_, edge)| edge.front() == back);
+        let (index, _) = candidates.next()?;
+        if candidates.next().is_some() {
+            return None;
+        }
+        wire.push_back(edges.swap_remove(index));
+    }
+    (wire.is_closed() && wire.is_simple()).then_some(wire)
+}
+
+pub(super) fn boolean<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid0: &Solid<Point3, C, S>,
+    solid1: &Solid<Point3, C, S>,
+    operation: Operation,
+) -> Option<Shell<Point3, C, S>>
+where
+    Line<Point3>: ToSameGeometry<C>,
+{
+    let first = recognize::cylinder(solid0, None)?;
+    let second = recognize::cylinder(solid1, Some(first.vector))?;
+    let axis = first.vector.normalize();
+    let displacement = second.center - first.center;
+    if !first.vector.near(&second.vector) || !displacement.dot(axis).so_small() {
+        return None;
+    }
+    let disjoint_shell = || match operation {
+        Operation::Union => solid0
+            .face_iter()
+            .chain(solid1.face_iter())
+            .cloned()
+            .collect(),
+        Operation::Intersection => Shell::default(),
+        Operation::Difference => solid0.face_iter().cloned().collect(),
+    };
+    // The certified circular sections lie in balls of their respective radii.
+    // Project those balls and their entire extrusion segments onto a candidate
+    // separating normal. Include both segment endpoints even when the axes
+    // differ slightly. Disjoint projection interiors certify disjoint solid
+    // interiors without relying on tessellation or a vertex bounding box.
+    let normal = displacement - axis * displacement.dot(axis);
+    let normal_length = normal.magnitude();
+    let gap = displacement.dot(normal) + second.vector.dot(normal).min(0.0)
+        - first.vector.dot(normal).max(0.0);
+    if normal_length > 0.0 && gap >= (first.radius + second.radius) * normal_length {
+        // Equality is external tangency: the contact has no solid interior.
+        // Preserve the independent edge identities so union has two shells,
+        // even if their point sets touch along an entire generator.
+        return Some(disjoint_shell());
+    }
+    let distance = displacement.magnitude();
+    // The remaining arrangement requires two transversal circle crossings.
+    // Containment and coincidence stay with the general boundary classifier.
+    if distance <= (first.radius - second.radius).abs() || distance >= first.radius + second.radius
+    {
+        return None;
+    }
+    let along = (first.radius * first.radius - second.radius * second.radius + distance * distance)
+        / (2.0 * distance);
+    let height_squared = first.radius * first.radius - along * along;
+    if height_squared <= 0.0 {
+        return None;
+    }
+    let middle = first.center + displacement * (along / distance);
+    let offset = axis.cross(displacement) * (height_squared.sqrt() / distance);
+    let crossings = [middle + offset, middle - offset];
+    if crossings[0].near(&crossings[1]) {
+        // A repeated circle crossing between the centers is external tangency.
+        // Circle recovery can round a double root into two coincident roots;
+        // apply the same regularization as for separated projection interiors.
+        // An internal tangency lies outside the segment between the centers.
+        return (0.0 < along && along < distance).then(disjoint_shell);
+    }
+    // Both input trims must actually contain both analytic intersection points.
+    if [&first, &second].into_iter().any(|cylinder| {
+        crossings.iter().any(|point| {
+            !cylinder
+                .strips
+                .iter()
+                .any(|strip| parameter(&strip.lower, *point).is_some())
+        })
+    }) {
+        return None;
+    }
+    let mut columns = Vec::new();
+    let mut lower_edges = Vec::new();
+    let mut upper_edges = Vec::new();
+    let mut shell = Shell::default();
+    [&first, &second]
+        .into_iter()
+        .enumerate()
+        .try_for_each(|(source, cylinder)| {
+            let other = if source == 0 { &second } else { &first };
+            cylinder.strips.iter().try_for_each(|strip| {
+                let (start, end) = strip.lower.range_tuple();
+                let mut parameters: SmallVec<[f64; 4]> = [start, end]
+                    .into_iter()
+                    .chain(
+                        crossings
+                            .iter()
+                            .filter_map(|point| parameter(&strip.lower, *point)),
+                    )
+                    .collect();
+                parameters.sort_by(f64::total_cmp);
+                parameters.dedup();
+                parameters.windows(2).try_for_each(|range| {
+                    let midpoint = strip.lower.evaluate((range[0] + range[1]) * 0.5);
+                    let inside = midpoint.distance2(other.center) < other.radius * other.radius;
+                    let retain = match operation {
+                        Operation::Union => !inside,
+                        Operation::Intersection => inside,
+                        Operation::Difference => inside == (source == 1),
+                    };
+                    if !retain {
+                        return Some(());
+                    }
+                    let lower = trim(&strip.lower, range[0], range[1]);
+                    let front = lower.front();
+                    let back = lower.back();
+                    let upper_start = parameter(&strip.upper, front + first.vector)?;
+                    let upper_end = parameter(&strip.upper, back + first.vector)?;
+                    if upper_start >= upper_end || front.near(&back) {
+                        return None;
+                    }
+                    let upper = trim(&strip.upper, upper_start, upper_end);
+                    let a = column(&mut columns, front, first.vector);
+                    let b = column(&mut columns, back, first.vector);
+                    let lower = Edge::try_new(&columns[a].lower, &columns[b].lower, lower).ok()?;
+                    let upper = Edge::try_new(&columns[a].upper, &columns[b].upper, upper).ok()?;
+                    let boundary = Wire::from(vec![
+                        lower.clone(),
+                        columns[b].edge.clone(),
+                        upper.inverse(),
+                        columns[a].edge.inverse(),
+                    ]);
+                    let mut face = Face::try_new(vec![boundary], strip.surface.clone()).ok()?;
+                    if matches!(operation, Operation::Difference) && source == 1 {
+                        face.invert();
+                        lower_edges.push(lower.inverse());
+                        upper_edges.push(upper.inverse());
+                    } else {
+                        lower_edges.push(lower);
+                        upper_edges.push(upper);
+                    }
+                    shell.push(face);
+                    Some(())
+                })
+            })
+        })?;
+    let lower = cycle(lower_edges)?.inverse();
+    let upper = cycle(upper_edges)?;
+    shell.push(Face::try_new(vec![lower], first.caps[0].clone()).ok()?);
+    shell.push(Face::try_new(vec![upper], first.caps[1].clone()).ok()?);
+    Some(shell)
+}
