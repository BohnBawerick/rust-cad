+//! Certify circular extrusion boundaries from their rational coefficients.
+
+use monstertruck_geometry::prelude::*;
+use monstertruck_topology::{Face, Solid};
+use std::array;
+
+use super::{Cylinder, Strip};
+use crate::transversal::classic::{ShapeOpsCurve, ShapeOpsSurface};
+
+fn circle(curve: &impl BoundedCurve<Point = Point3>) -> Option<(Point3, f64)> {
+    let (start, end) = curve.range_tuple();
+    let a = curve.front();
+    let b = curve.evaluate((start + end) * 0.5) - a;
+    let c = curve.back() - a;
+    let normal = b.cross(c);
+    if normal.magnitude2() == 0.0 {
+        return None;
+    }
+    let center = a
+        + (b.magnitude2() * c.cross(normal) + c.magnitude2() * normal.cross(b))
+            / (2.0 * normal.magnitude2());
+    Some((center, center.distance(a)))
+}
+
+/// Test every coefficient of the homogeneous circle equation, not just samples.
+fn on_circle(curve: &BsplineCurve<Vector4>, center: Point3, radius: f64) -> bool {
+    curve.bezier_decomposition().iter().all(|piece| {
+        let controls = piece.control_points();
+        if piece.degree() != 2 || controls.iter().any(|point| point.w <= 0.0) {
+            return false;
+        }
+        let scale = controls[0].w;
+        let radial: [Vector3; 3] = array::from_fn(|index| {
+            let point = controls[index];
+            (point.truncate() - center.to_vec() * point.w) / (radius * scale)
+        });
+        let binomial = [1.0, 2.0, 1.0];
+        (0usize..5).all(|degree| {
+            let coefficient: f64 = (degree.saturating_sub(2)..=degree.min(2))
+                .map(|i| {
+                    let j = degree - i;
+                    binomial[i]
+                        * binomial[j]
+                        * (radial[i].dot(radial[j])
+                            - controls[i].w * controls[j].w / (scale * scale))
+                })
+                .sum();
+            coefficient.so_small()
+        })
+    })
+}
+
+fn normal<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(face: &Face<Point3, C, S>) -> Option<Vector3> {
+    let surface = face.oriented_surface();
+    let point = face.boundaries().first()?.front_vertex()?.point();
+    let (u, v) = surface.search_parameter(point, None, 100)?;
+    Some(surface.normal(u, v))
+}
+
+pub(super) fn cylinder<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    solid: &Solid<Point3, C, S>,
+    direction: Option<Vector3>,
+) -> Option<Cylinder<C, S>> {
+    if solid.boundaries().len() != 1 {
+        return None;
+    }
+    let faces = solid.boundaries().first()?;
+    let mut caps: Vec<_> = faces
+        .iter()
+        .filter(|face| {
+            matches!(
+                face.surface().try_into_analytic_surface_kind(),
+                Some(AnalyticSurfaceKind::Plane(_))
+            )
+        })
+        .collect();
+    // A merged cap can extend beyond either input trim. Only use carriers
+    // whose parameter bounds do not restrict the planar domain.
+    if caps.len() != 2
+        || caps.iter().any(|face| {
+            face.boundaries().len() != 1 || face.surface().supports_exact_patch_domains()
+        })
+    {
+        return None;
+    }
+    if direction.is_some_and(|axis| normal(caps[0]).is_some_and(|n| n.dot(axis) > 0.0)) {
+        caps.swap(0, 1);
+    }
+    let bottom = caps[0].boundaries()[0].inverse();
+    let top = caps[1].boundaries()[0].clone();
+    let (center, radius) = circle(&bottom.front()?.oriented_curve())?;
+    let (top_center, top_radius) = circle(&top.front()?.oriented_curve())?;
+    let vector = top_center - center;
+    if vector.so_small()
+        || !radius.near(&top_radius)
+        || !normal(caps[0])?.cross(vector.normalize()).so_small()
+        || normal(caps[0])?.dot(vector) >= 0.0
+        || normal(caps[1])?.dot(vector) <= 0.0
+        || !normal(caps[1])?.cross(vector.normalize()).so_small()
+        || faces.len() != bottom.len() + 2
+        || top.len() != bottom.len()
+    {
+        return None;
+    }
+    let strips = bottom
+        .iter()
+        .map(|edge| {
+            let lower = edge.oriented_curve();
+            let lower_h = lower.try_into_homogeneous_bspline_curve()?;
+            if !on_circle(&lower_h, center, radius) {
+                return None;
+            }
+            let side = faces.iter().find(|face| {
+                face.id() != caps[0].id()
+                    && face.id() != caps[1].id()
+                    && face.edge_iter().any(|other| other.id() == edge.id())
+            })?;
+            let boundaries = side.boundaries();
+            if boundaries.len() != 1 || boundaries[0].len() != 4 {
+                return None;
+            }
+            let upper = top
+                .iter()
+                .find(|candidate| {
+                    boundaries[0]
+                        .iter()
+                        .any(|other| other.id() == candidate.id())
+                })?
+                .oriented_curve();
+            if !upper.front().near(&(lower.front() + vector))
+                || !upper.back().near(&(lower.back() + vector))
+                || !on_circle(
+                    &upper.try_into_homogeneous_bspline_curve()?,
+                    top_center,
+                    radius,
+                )
+            {
+                return None;
+            }
+            let surface = side.oriented_surface();
+            let AnalyticSurfaceKind::HomogeneousExtrusion(extrusion) =
+                surface.try_into_analytic_surface_kind()?
+            else {
+                return None;
+            };
+            if !extrusion.vector.near(&vector) && !extrusion.vector.near(&-vector) {
+                return None;
+            }
+            let base = NurbsCurve::new(extrusion.curve.clone()).front();
+            let base_center = center + vector * ((base - center).dot(vector) / vector.magnitude2());
+            if (!base_center.near(&center) && !base_center.near(&top_center))
+                || !on_circle(&extrusion.curve, base_center, radius)
+            {
+                return None;
+            }
+            Some(Strip {
+                lower,
+                upper,
+                surface,
+            })
+        })
+        .collect::<Option<Vec<_>>>()?;
+    Some(Cylinder {
+        center,
+        radius,
+        vector,
+        caps: [caps[0].oriented_surface(), caps[1].oriented_surface()],
+        strips,
+    })
+}
