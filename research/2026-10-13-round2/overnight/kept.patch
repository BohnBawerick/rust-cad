+                            (-direction.dot(radial.cross(other)))
+                                .atan2(radial.dot(other))
+                                .rem_euclid(2.0 * PI)
+                        };
+                        angle(first).total_cmp(&angle(second))
+                    })
+                    .map(|(index, _)| index)?;
+                let (other, other_slot, _) = backward.remove(mate);
+                let edge = Edge::new(
+                    &vertices[front],
+                    &vertices[back],
+                    Line(points[front], points[back]).to_same_geometry(),
+                );
+                edges[face][slot] = Some(edge.clone());
+                edges[other][other_slot] = Some(edge.inverse());
+                Some(())
+            })
+        })?;
+    let faces = polygons
+        .into_iter()
+        .zip(edges)
+        .map(|((patch, _), edges)| {
+            let wire: Wire<_, _> = edges.into_iter().collect::<Option<Vec<_>>>()?.into();
+            let face = Face::try_new(vec![wire], patch.surface).ok()?;
+            Some((patch.source, patch.normal, face))
+        })
+        .collect::<Option<Vec<_>>>()?;
+    Some(coalesce::coalesce(faces))
+}
