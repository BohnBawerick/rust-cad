+/// Extracts a constant-parameter section in homogeneous coordinates.
+fn isoparametric_section(curve: &ParameterCurveLinear) -> Option<NurbsCurve<Vector4>> {
+    let (line, surface) = (curve.curve(), curve.surface());
+    let homogeneous = surface.non_rationalized();
+    let ((u0, u1), (v0, v1)) = surface.range_tuple();
+    let (mut section, start, end) = if line.0.y.near(&line.1.y) {
+        let v = section_parameter((line.0.y + line.1.y) * 0.5, (v0, v1))?;
+        let points = (0..surface.control_points().len())
+            .map(|i| homogeneous.curve_v(i).subs(v))
+            .collect();
+        (
+            BsplineCurve::new(surface.knot_vector_u().clone(), points),
+            section_parameter(line.0.x, (u0, u1))?,
+            section_parameter(line.1.x, (u0, u1))?,
+        )
+    } else if line.0.x.near(&line.1.x) {
+        let u = section_parameter((line.0.x + line.1.x) * 0.5, (u0, u1))?;
+        let points = (0..surface.control_points().first()?.len())
+            .map(|i| homogeneous.curve_u(i).subs(u))
+            .collect();
+        (
+            BsplineCurve::new(surface.knot_vector_v().clone(), points),
+            section_parameter(line.0.y, (v0, v1))?,
+            section_parameter(line.1.y, (v0, v1))?,
+        )
+    } else {
+        return None;
+    };
+    if start.near(&end) {
+        return None;
+    }
+    let (low, high) = (start.min(end), start.max(end));
+    let (first, last) = section.range_tuple();
+    if !low.near(&first) {
+        section = section.cut(low);
+    }
+    if !high.near(&last) {
+        section.cut(high);
+    }
+    let (mut knots, points) = section.destruct();
+    knots.try_normalize().ok()?;
+    let mut section = BsplineCurve::try_new(knots, points).ok()?;
+    if start > end {
+        section.invert();
+    }
+    let section = NurbsCurve::new(section);
+    // Parameter searches may leave roundoff in the nominally fixed coordinate.
+    // Require the extracted section to retain the original trim endpoints.
+    (section.front().near(&curve.front()) && section.back().near(&curve.back())).then_some(section)
