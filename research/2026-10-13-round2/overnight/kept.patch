+//! Membership in complete oriented solid boundaries.
+
+use monstertruck_meshing::prelude::{
+    CalcVolume, IncludingPointInDomain, InnerSpace, Invertible, Point3, PolygonMesh, PolylineCurve,
+    Vector3, hash,
+};
+use monstertruck_topology::{Shell, shell::ShellCondition};
+
+use super::{AltCurveShell, ShapeOpsCurve, ShapeOpsSurface};
+
+type PolyShell = Shell<Point3, PolylineCurve<Point3>, Option<PolygonMesh>>;
+
+/// An oriented winding field, including the material state at infinity.
+struct OrientedBoundary {
+    polygon: PolygonMesh,
+    complemented: bool,
+}
+
+impl OrientedBoundary {
+    fn new(shell: &PolyShell) -> Option<Self> {
+        let polygon = shell
+            .iter()
+            .try_fold(PolygonMesh::default(), |mut mesh, face| {
+                let mut polygon = face.surface()?;
+                if !face.orientation() {
+                    polygon.invert();
+                }
+                mesh.merge(polygon);
+                Some(mesh)
+            })?;
+        // For a valid finite solid, cavity contributions subtract from its volume.
+        // Reversing the complete boundary changes the sign and fills infinity.
+        let complemented = polygon.volume() < 0.0;
+        Some(Self {
+            polygon,
+            complemented,
+        })
+    }
+
+    fn winding(&self, point: Point3, direction: Vector3) -> isize {
+        self.polygon.signed_crossing_faces(point, direction) + isize::from(self.complemented)
+    }
+
+    fn contains(&self, point: Point3) -> Option<bool> {
+        let direction = hash::take_one_unit(point);
+        let forward = self.winding(point, direction);
+        let backward = self.winding(point, -direction);
+        // Opposite rays must give the same winding away from the boundary.
+        (forward == backward).then_some(forward > 0)
+    }
+}
+
+/// Classify faces left without a classified neighbour by oriented winding.
+pub(super) fn classify_remaining<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    unknown: AltCurveShell<C, S>,
+    other: &PolyShell,
+) -> Option<[AltCurveShell<C, S>; 2]> {
+    if unknown.is_empty() {
+        Some([Shell::default(), Shell::default()])
+    } else {
+        // A filtered strip can leave an uncut cap without a neighbour.
+        // Mesh surfaces retain their parameter orientation, so summing them
+        // without their face orientations does not give the solid's winding.
+        let boundary = OrientedBoundary::new(other)?;
+        unknown.into_iter().try_fold(
+            [Shell::default(), Shell::default()],
+            |mut classified, face| {
+                let point = face.boundaries().first()?.front_vertex()?.point();
+                let inside = boundary.winding(point, hash::take_one_unit(point)) > 0;
+                classified[usize::from(!inside)].push(face);
+                Some(classified)
+            },
+        )
+    }
+}
+
+/// Separate closed original components from faces that still need local classification.
+pub(super) fn classify_closed<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    unknown: AltCurveShell<C, S>,
+    original: &AltCurveShell<C, S>,
+    meshed: &PolyShell,
+    other: &PolyShell,
+) -> Option<[AltCurveShell<C, S>; 3]> {
+    let mut boundary = None;
+    unknown.connected_components().into_iter().try_fold(
+        [Shell::default(), Shell::default(), Shell::default()],
+        |mut classified, mut component| {
+            // A cut component is classified by intersection-side propagation.
+            // Only whole original faces with closed incidence belong here.
+            let uncut = component.shell_condition() == ShellCondition::Closed
+                && component
+                    .iter()
+                    .all(|face| original.iter().any(|source| source.id() == face.id()));
+            let index = if uncut {
+                if boundary.is_none() {
+                    boundary = Some(OrientedBoundary::new(other)?);
+                }
+                let boundary = boundary.as_ref()?;
+                let mut membership = None;
+                component.iter().try_for_each(|face| {
+                    let (_, polygon) = original
+                        .iter()
+                        .zip(meshed)
+                        .find(|(source, _)| source.id() == face.id())?;
+                    let point = interior_point(&face.surface(), &polygon.surface()?)?;
+                    let inside = boundary.contains(point)?;
+                    if membership.is_some_and(|previous| previous != inside) {
+                        None
+                    } else {
+                        membership = Some(inside);
+                        Some(())
+                    }
+                })?;
+                usize::from(!membership?)
+            } else {
+                2
+            };
+            classified[index].append(&mut component);
+            Some(classified)
+        },
+    )
+}
+
+/// Sample the trimmed face interior on its original surface, away from shared vertices.
+fn interior_point<S: ShapeOpsSurface>(surface: &S, polygon: &PolygonMesh) -> Option<Point3> {
+    polygon
+        .tri_faces()
+        .iter()
+        .filter_map(|triangle| {
+            let [first, second, third] = *triangle;
+            let points = polygon.positions();
+            let area = (points[second.pos] - points[first.pos])
+                .cross(points[third.pos] - points[first.pos])
+                .magnitude2();
+            let parameters = polygon.uv_coords();
+            let uv = (parameters[first.uv?] + parameters[second.uv?] + parameters[third.uv?]) / 3.0;
+            (area > 0.0).then_some((area, uv))
+        })
+        .max_by(|(area0, _), (area1, _)| area0.total_cmp(area1))
+        .map(|(_, uv)| surface.evaluate(uv.x, uv.y))
+}
