+//! Remove arrangement edges internal to a surviving source face.
+
+use std::collections::{BTreeMap, HashMap};
+
+use super::*;
+
+/// Preserve the source face decomposition, including disconnected remainders.
+pub(super) fn coalesce<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    faces: Vec<(usize, Vector3, Face<Point3, C, S>)>,
+) -> Shell<Point3, C, S> {
+    let mut sources = BTreeMap::<usize, (Vector3, Shell<Point3, C, S>)>::new();
+    faces.into_iter().for_each(|(source, normal, face)| {
+        sources
+            .entry(source)
+            .or_insert_with(|| (normal, Shell::default()))
+            .1
+            .push(face);
+    });
+    sources
+        .into_values()
+        .flat_map(|(normal, shell)| {
+            shell
+                .connected_components()
+                .into_iter()
+                .flat_map(move |component| match merge(&component, normal) {
+                    Some(face) => vec![face],
+                    None => component.into_iter().collect(),
+                })
+        })
+        .collect()
+}
+
+/// Cancel paired edges only after material-sector adjacency has been resolved.
+fn merge<C: ShapeOpsCurve<S>, S: ShapeOpsSurface>(
+    component: &Shell<Point3, C, S>,
+    normal: Vector3,
+) -> Option<Face<Point3, C, S>> {
+    let first = component.first()?;
+    if component.len() == 1 {
+        return Some(first.clone());
+    }
+    let origin = first.boundaries().first()?.front()?.front().point();
+    let mut uses = HashMap::new();
+    component.edge_iter().for_each(|edge| {
+        *uses.entry(edge.id()).or_insert(0usize) += 1;
+    });
+    let mut boundaries = component.extract_boundaries();
+    // A pinched boundary cannot be represented by simple, disjoint face wires.
+    // Keep the original cells if boundary extraction lost any branching edges.
+    if boundaries.iter().map(|wire| wire.len()).sum::<usize>()
+        != uses.values().filter(|count| **count == 1).count()
+    {
+        return None;
+    }
+    let area = |wire: &Wire<Point3, C>| {
+        wire.iter()
+            .map(|edge| {
+                (edge.front().point() - origin)
+                    .cross(edge.back().point() - origin)
+                    .dot(normal)
+            })
+            .sum::<f64>()
+    };
+    // A connected planar region has one positive outer loop and negative holes.
+    // Put the outer loop first for consumers that use the first wire as a trim.
+    if boundaries.iter().filter(|wire| area(wire) > 0.0).count() != 1
+        || boundaries.iter().any(|wire| area(wire) == 0.0)
+    {
+        return None;
+    }
+    boundaries.sort_by(|first, second| area(second).total_cmp(&area(first)));
+    Face::try_new(boundaries, first.oriented_surface()).ok()
+}
