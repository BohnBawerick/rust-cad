+//! Geometry reached from a product through non-transforming representations.
+
+use std::collections::{BTreeMap, BTreeSet, HashSet};
+
+use super::{ProductEntity, Table};
+
+/// Completes each product's geometry without traversing assembly placements.
+pub(super) fn complete_shapes(table: &Table, products: &mut [ProductEntity]) {
+    // A relationship without a transformation relates geometry in the same
+    // coordinates. Either endpoint can be the product's representation.
+    let mut neighbors = BTreeMap::<u64, BTreeSet<u64>>::new();
+    table
+        .shape_representation_relationship
+        .values()
+        .filter_map(|relationship| {
+            Some((
+                Table::ref_id(&relationship.rep_1)?,
+                Table::ref_id(&relationship.rep_2)?,
+            ))
+        })
+        .for_each(|(first, second)| {
+            neighbors.entry(first).or_default().insert(second);
+            neighbors.entry(second).or_default().insert(first);
+        });
+
+    if neighbors.is_empty() {
+        return;
+    }
+
+    // A different product's representation is an ownership boundary. Its
+    // geometry must be reached through its assembly occurrence and transform.
+    let roots: HashSet<_> = products
+        .iter()
+        .filter_map(|product| product.attrs.shape_representation)
+        .collect();
+
+    products.iter_mut().for_each(|product| {
+        let Some(root) = product.attrs.shape_representation else {
+            return;
+        };
+        let mut visited = HashSet::from([root]);
+        let mut items: HashSet<_> = product.shape.iter().copied().collect();
+        let mut pending = vec![root];
+
+        while let Some(current) = pending.pop() {
+            if let Some(representation) = table.shape_representation.get(&current) {
+                product.shape.extend(
+                    representation
+                        .items
+                        .iter()
+                        .filter_map(Table::ref_id)
+                        .filter(|id| {
+                            table.manifold_solid_brep.contains_key(id)
+                                || table.shell_based_surface_model.contains_key(id)
+                        })
+                        .filter(|id| items.insert(*id)),
+                );
+            }
+
+            if let Some(adjacent) = neighbors.get(&current) {
+                // Reverse insertion visits sibling representations in ascending
+                // order, independent of hash-map iteration order.
+                pending.extend(adjacent.iter().rev().copied().filter(|id| {
+                    !roots.contains(id)
+                        && table.shape_representation.contains_key(id)
+                        && visited.insert(*id)
+                }));
+            }
+        }
+    });
+}
